diff --git a/opencode-server/src/config.ts b/opencode-server/src/config.ts
new file mode 100644
index 0000000000..89847e2be0
--- /dev/null
+++ b/opencode-server/src/config.ts
@@ -0,0 +1,147 @@
+import { CATALOG } from './catalog'
+import type { Env } from './types'
+
+export type Provider = {
+  id: string
+  baseUrl: string
+  apiKey: string
+  /** Model ids this upstream serves. Empty means "route by explicit provider prefix only". */
+  models: string[]
+}
+
+type ProviderDefaults = {
+  id: string
+  baseUrl: string
+  keyEnv: keyof Env
+  models: string[]
+}
+
+/**
+ * Providers are only active when their API key is present, so an unconfigured
+ * deployment still boots and reports an empty model list instead of failing.
+ */
+const BUILT_INS: ProviderDefaults[] = [
+  { id: 'openai', baseUrl: 'https://api.openai.com/v1', keyEnv: 'OPENAI_API_KEY', models: [] },
+  {
+    id: 'openrouter',
+    baseUrl: 'https://openrouter.ai/api/v1',
+    keyEnv: 'OPENROUTER_API_KEY',
+    models: [],
+  },
+  {
+    id: 'nous',
+    baseUrl: 'https://inference-api.nousresearch.com/v1',
+    keyEnv: 'NOUS_API_KEY',
+    models: [],
+  },
+  { id: 'groq', baseUrl: 'https://api.groq.com/openai/v1', keyEnv: 'GROQ_API_KEY', models: [] },
+]
+
+function trimSlash(value: string): string {
+  return value.replace(/\/+$/, '')
+}
+
+function fromJson(raw: string): Provider[] {
+  const parsed: unknown = JSON.parse(raw)
+  if (!Array.isArray(parsed)) throw new Error('PROVIDERS must be a JSON array')
+  const providers: Provider[] = []
+  for (const entry of parsed) {
+    if (!entry || typeof entry !== 'object') continue
+    const record = entry as Record<string, unknown>
+    const id = typeof record.id === 'string' ? record.id : undefined
+    const baseUrl = typeof record.baseUrl === 'string' ? record.baseUrl : undefined
+    if (!id || !baseUrl) continue
+    const apiKey = typeof record.apiKey === 'string' ? record.apiKey : ''
+    const models = Array.isArray(record.models)
+      ? record.models.filter((model): model is string => typeof model === 'string')
+      : []
+    providers.push({ id, baseUrl: trimSlash(baseUrl), apiKey, models })
+  }
+  return providers
+}
+
+export function readProviders(env: Env): Provider[] {
+  if (env.PROVIDERS && env.PROVIDERS.trim().length > 0) {
+    return fromJson(env.PROVIDERS)
+  }
+
+  const providers: Provider[] = []
+  for (const preset of BUILT_INS) {
+    const apiKey = env[preset.keyEnv]
+    if (typeof apiKey !== 'string' || apiKey.length === 0) continue
+    const baseUrl =
+      preset.id === 'openai' && env.OPENAI_BASE_URL ? env.OPENAI_BASE_URL : preset.baseUrl
+    providers.push({
+      id: preset.id,
+      baseUrl: trimSlash(baseUrl),
+      apiKey,
+      // Explicit models win; otherwise advertise the generated catalog.
+      models: preset.models.length > 0 ? preset.models : (CATALOG[preset.id] ?? []),
+    })
+  }
+
+  if (env.CLOUDFLARE_ACCOUNT_ID && env.CLOUDFLARE_API_TOKEN) {
+    providers.push({
+      id: 'workers-ai',
+      baseUrl: trimSlash(
+        `https://api.cloudflare.com/client/v4/accounts/${env.CLOUDFLARE_ACCOUNT_ID}/ai/v1`,
+      ),
+      apiKey: env.CLOUDFLARE_API_TOKEN,
+      models: [],
+    })
+  }
+
+  return providers
+}
+
+export type Route = { provider: Provider; model: string }
+
+/**
+ * Resolves a requested model to an upstream. An explicit `<provider>/<model>`
+ * prefix always wins; otherwise the default provider handles the request, so a
+ * client can use plain ids like `gpt-4.1-mini` without knowing the provider.
+ */
+export function resolveRoute(
+  providers: Provider[],
+  requestedModel: string,
+  defaultProviderId: string | undefined,
+): Route | { error: string } {
+  if (providers.length === 0) {
+    return { error: 'No upstream providers configured. Set an API key such as OPENAI_API_KEY.' }
+  }
+
+  const slash = requestedModel.indexOf('/')
+  if (slash > 0) {
+    const prefix = requestedModel.slice(0, slash)
+    const match = providers.find((provider) => provider.id === prefix)
+    if (match) {
+      // `openrouter/auto` is an OpenRouter model id, not a provider prefix, so
+      // an exact catalog hit keeps the id intact.
+      const keepWholeId = match.models.includes(requestedModel)
+      return { provider: match, model: keepWholeId ? requestedModel : requestedModel.slice(slash + 1) }
+    }
+  }
+
+  const owning = providers.find((provider) => provider.models.includes(requestedModel))
+  if (owning) return { provider: owning, model: requestedModel }
+
+  const fallback =
+    providers.find((provider) => provider.id === defaultProviderId) ?? providers[0]
+  if (!fallback) {
+    return { error: 'No upstream providers configured.' }
+  }
+  return { provider: fallback, model: requestedModel }
+}
+
+export function listModels(providers: Provider[]): Array<{ id: string; owned_by: string }> {
+  const seen = new Set<string>()
+  const models: Array<{ id: string; owned_by: string }> = []
+  for (const provider of providers) {
+    for (const model of provider.models) {
+      if (seen.has(model)) continue
+      seen.add(model)
+      models.push({ id: model, owned_by: provider.id })
+    }
+  }
+  return models
+}
diff --git a/opencode-server/src/index.ts b/opencode-server/src/index.ts
new file mode 100644
index 0000000000..7cc87542df
--- /dev/null
+++ b/opencode-server/src/index.ts
@@ -0,0 +1,190 @@
+import { listModels, readProviders } from './config'
+import {
+  checkLimits,
+  createKey,
+  ensureSchema,
+  keyFromRequest,
+  listKeys,
+  revokeKey,
+  summarizeUsage,
+} from './keys'
+import { forward } from './proxy'
+import type { Env } from './types'
+
+const CORS_HEADERS: Record<string, string> = {
+  'access-control-allow-origin': '*',
+  'access-control-allow-methods': 'GET, POST, DELETE, OPTIONS',
+  'access-control-allow-headers': 'authorization, content-type, x-admin-token',
+  'access-control-max-age': '86400',
+}
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'content-type': 'application/json; charset=utf-8', ...CORS_HEADERS },
+  })
+}
+
+function errorResponse(status: number, message: string, type = 'invalid_request_error'): Response {
+  return json({ error: { message, type } }, status)
+}
+
+/** Length-independent comparison so a wrong token cannot be timed. */
+function sameToken(provided: string, expected: string): boolean {
+  if (provided.length !== expected.length) return false
+  let diff = 0
+  for (let i = 0; i < provided.length; i++) {
+    diff |= provided.charCodeAt(i) ^ expected.charCodeAt(i)
+  }
+  return diff === 0
+}
+
+function isAdmin(request: Request, env: Env): 'ok' | 'missing' | 'denied' {
+  const expected = env.ADMIN_TOKEN
+  if (!expected || expected.length === 0) return 'missing'
+  const header = request.headers.get('x-admin-token') ?? ''
+  const bearer = request.headers.get('authorization')?.replace(/^Bearer\s+/i, '') ?? ''
+  if (sameToken(header, expected) || sameToken(bearer, expected)) return 'ok'
+  return 'denied'
+}
+
+function optionalNumber(value: unknown): number | null {
+  if (typeof value === 'number' && Number.isFinite(value) && value > 0) return Math.floor(value)
+  return null
+}
+
+async function handleAdmin(
+  request: Request,
+  env: Env,
+  url: URL,
+): Promise<Response | null> {
+  if (!url.pathname.startsWith('/api/')) return null
+
+  const admin = isAdmin(request, env)
+  if (admin === 'missing') {
+    return errorResponse(503, 'ADMIN_TOKEN is not configured on this deployment.', 'configuration_error')
+  }
+  if (admin === 'denied') {
+    return errorResponse(401, 'Invalid admin token.', 'authentication_error')
+  }
+
+  if (request.method === 'GET' && url.pathname === '/api/me') {
+    return json({ ok: true })
+  }
+
+  if (request.method === 'GET' && url.pathname === '/api/models') {
+    const providers = readProviders(env)
+    return json({
+      providers: providers.map((provider) => ({
+        id: provider.id,
+        baseUrl: provider.baseUrl,
+        models: provider.models,
+      })),
+      models: listModels(providers),
+      defaultProvider: env.DEFAULT_PROVIDER ?? null,
+    })
+  }
+
+  if (url.pathname === '/api/keys') {
+    if (request.method === 'GET') {
+      return json({ keys: await listKeys(env.DB) })
+    }
+    if (request.method === 'POST') {
+      let body: Record<string, unknown> = {}
+      try {
+        body = (await request.json()) as Record<string, unknown>
+      } catch {
+        // Empty body is fine: name defaults below.
+      }
+      const name =
+        typeof body.name === 'string' && body.name.trim().length > 0
+          ? body.name.trim().slice(0, 64)
+          : `key-${new Date().toISOString().slice(0, 10)}`
+      const created = await createKey(env.DB, {
+        name,
+        rateLimitRpm: optionalNumber(body.rateLimitRpm),
+        monthlyTokenBudget: optionalNumber(body.monthlyTokenBudget),
+      })
+      return json({ key: created.key, record: created.row }, 201)
+    }
+    return errorResponse(405, 'Method not allowed.', 'method_error')
+  }
+
+  const revokeMatch = /^\/api\/keys\/([A-Za-z0-9]+)\/revoke$/.exec(url.pathname)
+  if (revokeMatch && request.method === 'POST') {
+    const id = revokeMatch[1]
+    if (!id) return errorResponse(400, 'Missing key id.')
+    const revoked = await revokeKey(env.DB, id)
+    if (!revoked) return errorResponse(404, 'Key not found or already revoked.')
+    return json({ ok: true })
+  }
+
+  if (request.method === 'GET' && url.pathname === '/api/usage') {
+    const requested = Number(url.searchParams.get('days') ?? '7')
+    const days = Number.isFinite(requested) ? Math.max(1, Math.min(Math.floor(requested), 365)) : 7
+    return json(await summarizeUsage(env.DB, days))
+  }
+
+  return errorResponse(404, 'Unknown admin route.', 'not_found_error')
+}
+
+export default {
+  async fetch(request: Request, env: Env, ctx: ExecutionContext): Promise<Response> {
+    const url = new URL(request.url)
+
+    if (request.method === 'OPTIONS') {
+      return new Response(null, { status: 204, headers: CORS_HEADERS })
+    }
+
+    await ensureSchema(env.DB)
+
+    if (url.pathname === '/healthz') {
+      const providers = readProviders(env)
+      return json({
+        ok: true,
+        providers: providers.map((provider) => provider.id),
+        configured: providers.length > 0,
+      })
+    }
+
+    const adminResponse = await handleAdmin(request, env, url)
+    if (adminResponse) return adminResponse
+
+    if (url.pathname === '/v1/models') {
+      const key = await keyFromRequest(env.DB, request)
+      if (!key) return errorResponse(401, 'Missing or invalid API key.', 'authentication_error')
+      const providers = readProviders(env)
+      const models = listModels(providers)
+      return json({
+        object: 'list',
+        data: models.map((model) => ({
+          id: model.id,
+          object: 'model',
+          owned_by: model.owned_by,
+          created: 0,
+        })),
+      })
+    }
+
+    if (url.pathname.startsWith('/v1/') && request.method === 'POST') {
+      const key = await keyFromRequest(env.DB, request)
+      if (!key) return errorResponse(401, 'Missing or invalid API key.', 'authentication_error')
+
+      const providers = readProviders(env)
+      if (providers.length === 0) {
+        return errorResponse(
+          503,
+          'No upstream providers configured. Set OPENAI_API_KEY (or PROVIDERS) as a secret.',
+          'configuration_error',
+        )
+      }
+
+      const limits = await checkLimits(env.DB, key)
+      if (!limits.ok) return errorResponse(limits.status, limits.message, 'rate_limit_error')
+
+      return forward(request, env, ctx, key, url.pathname.slice('/v1/'.length), providers)
+    }
+
+    return env.ASSETS.fetch(request)
+  },
+}
diff --git a/opencode-server/src/keys.ts b/opencode-server/src/keys.ts
new file mode 100644
index 0000000000..d228b8017f
--- /dev/null
+++ b/opencode-server/src/keys.ts
@@ -0,0 +1,285 @@
+export type ApiKeyRow = {
+  id: string
+  name: string
+  key_prefix: string
+  created_at: number
+  last_used_at: number | null
+  revoked_at: number | null
+  rate_limit_rpm: number | null
+  monthly_token_budget: number | null
+}
+
+const SCHEMA = [
+  `CREATE TABLE IF NOT EXISTS api_keys (
+    id TEXT PRIMARY KEY,
+    name TEXT NOT NULL,
+    key_prefix TEXT NOT NULL,
+    key_hash TEXT NOT NULL UNIQUE,
+    created_at INTEGER NOT NULL,
+    last_used_at INTEGER,
+    revoked_at INTEGER,
+    rate_limit_rpm INTEGER,
+    monthly_token_budget INTEGER
+  )`,
+  `CREATE INDEX IF NOT EXISTS api_keys_hash_idx ON api_keys (key_hash)`,
+  `CREATE TABLE IF NOT EXISTS usage (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    key_id TEXT,
+    provider TEXT NOT NULL,
+    model TEXT NOT NULL,
+    prompt_tokens INTEGER NOT NULL DEFAULT 0,
+    completion_tokens INTEGER NOT NULL DEFAULT 0,
+    status INTEGER NOT NULL,
+    latency_ms INTEGER NOT NULL DEFAULT 0,
+    created_at INTEGER NOT NULL
+  )`,
+  `CREATE INDEX IF NOT EXISTS usage_created_idx ON usage (created_at)`,
+  `CREATE INDEX IF NOT EXISTS usage_key_idx ON usage (key_id, created_at)`,
+]
+
+let schemaReady: Promise<void> | null = null
+
+/** Idempotent, cached per isolate so local dev needs no migration step. */
+export function ensureSchema(db: D1Database): Promise<void> {
+  schemaReady ??= (async () => {
+    for (const statement of SCHEMA) {
+      await db.prepare(statement).run()
+    }
+  })().catch((error: unknown) => {
+    schemaReady = null
+    throw error
+  })
+  return schemaReady
+}
+
+function hex(bytes: Uint8Array): string {
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+export function randomId(): string {
+  return hex(crypto.getRandomValues(new Uint8Array(8)))
+}
+
+export function randomKey(): string {
+  return `sk-oc-${hex(crypto.getRandomValues(new Uint8Array(24)))}`
+}
+
+export async function hashKey(key: string): Promise<string> {
+  const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(key))
+  return hex(new Uint8Array(digest))
+}
+
+export function parseBearer(request: Request): string | null {
+  const header = request.headers.get('authorization')
+  if (!header) return null
+  const match = /^Bearer\s+(.+)$/i.exec(header.trim())
+  return match?.[1]?.trim() ?? null
+}
+
+export async function createKey(
+  db: D1Database,
+  input: { name: string; rateLimitRpm: number | null; monthlyTokenBudget: number | null },
+): Promise<{ key: string; row: ApiKeyRow }> {
+  const key = randomKey()
+  const row: ApiKeyRow = {
+    id: randomId(),
+    name: input.name,
+    key_prefix: key.slice(0, 12),
+    created_at: Date.now(),
+    last_used_at: null,
+    revoked_at: null,
+    rate_limit_rpm: input.rateLimitRpm,
+    monthly_token_budget: input.monthlyTokenBudget,
+  }
+  await db
+    .prepare(
+      `INSERT INTO api_keys (id, name, key_prefix, key_hash, created_at, revoked_at, rate_limit_rpm, monthly_token_budget)
+       VALUES (?, ?, ?, ?, ?, NULL, ?, ?)`,
+    )
+    .bind(
+      row.id,
+      row.name,
+      row.key_prefix,
+      await hashKey(key),
+      row.created_at,
+      row.rate_limit_rpm,
+      row.monthly_token_budget,
+    )
+    .run()
+  return { key, row }
+}
+
+export async function listKeys(db: D1Database): Promise<ApiKeyRow[]> {
+  const result = await db
+    .prepare(
+      `SELECT id, name, key_prefix, created_at, last_used_at, revoked_at, rate_limit_rpm, monthly_token_budget
+       FROM api_keys ORDER BY created_at DESC`,
+    )
+    .all<ApiKeyRow>()
+  return result.results ?? []
+}
+
+export async function revokeKey(db: D1Database, id: string): Promise<boolean> {
+  const result = await db
+    .prepare('UPDATE api_keys SET revoked_at = ? WHERE id = ? AND revoked_at IS NULL')
+    .bind(Date.now(), id)
+    .run()
+  return (result.meta.changes ?? 0) > 0
+}
+
+export async function keyFromRequest(db: D1Database, request: Request): Promise<ApiKeyRow | null> {
+  const token = parseBearer(request)
+  if (!token) return null
+  const row = await db
+    .prepare(
+      `SELECT id, name, key_prefix, created_at, last_used_at, revoked_at, rate_limit_rpm, monthly_token_budget
+       FROM api_keys WHERE key_hash = ? AND revoked_at IS NULL`,
+    )
+    .bind(await hashKey(token))
+    .first<ApiKeyRow>()
+  return row ?? null
+}
+
+export type LimitCheck = { ok: true } | { ok: false; status: number; message: string }
+
+function monthStart(): number {
+  const now = new Date()
+  return Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1)
+}
+
+/**
+ * Per-key limits are opt-in: a key with NULL limits has none, which is the
+ * default. They exist so an owner can cap a key they hand out, not to hide
+ * the upstream provider's own quotas.
+ */
+export async function checkLimits(db: D1Database, key: ApiKeyRow): Promise<LimitCheck> {
+  if (key.rate_limit_rpm !== null) {
+    const since = Date.now() - 60_000
+    const row = await db
+      .prepare('SELECT COUNT(*) AS count FROM usage WHERE key_id = ? AND created_at > ?')
+      .bind(key.id, since)
+      .first<{ count: number }>()
+    if ((row?.count ?? 0) >= key.rate_limit_rpm) {
+      return {
+        ok: false,
+        status: 429,
+        message: `Key rate limit reached (${key.rate_limit_rpm} requests/minute).`,
+      }
+    }
+  }
+
+  if (key.monthly_token_budget !== null) {
+    const row = await db
+      .prepare(
+        `SELECT COALESCE(SUM(prompt_tokens + completion_tokens), 0) AS tokens
+         FROM usage WHERE key_id = ? AND created_at >= ?`,
+      )
+      .bind(key.id, monthStart())
+      .first<{ tokens: number }>()
+    if ((row?.tokens ?? 0) >= key.monthly_token_budget) {
+      return {
+        ok: false,
+        status: 429,
+        message: `Key monthly token budget reached (${key.monthly_token_budget} tokens).`,
+      }
+    }
+  }
+
+  return { ok: true }
+}
+
+export async function recordUsage(
+  db: D1Database,
+  entry: {
+    keyId: string | null
+    provider: string
+    model: string
+    promptTokens: number
+    completionTokens: number
+    status: number
+    latencyMs: number
+  },
+): Promise<void> {
+  await db
+    .prepare(
+      `INSERT INTO usage (key_id, provider, model, prompt_tokens, completion_tokens, status, latency_ms, created_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+    )
+    .bind(
+      entry.keyId,
+      entry.provider,
+      entry.model,
+      entry.promptTokens,
+      entry.completionTokens,
+      entry.status,
+      entry.latencyMs,
+      Date.now(),
+    )
+    .run()
+  if (entry.keyId) {
+    await db
+      .prepare('UPDATE api_keys SET last_used_at = ? WHERE id = ?')
+      .bind(Date.now(), entry.keyId)
+      .run()
+  }
+}
+
+export type UsageSummary = {
+  days: number
+  totals: { requests: number; promptTokens: number; completionTokens: number }
+  byKey: Array<{ keyId: string | null; name: string; requests: number; tokens: number }>
+  byDay: Array<{ day: string; requests: number; tokens: number }>
+  byModel: Array<{ model: string; requests: number; tokens: number }>
+}
+
+export async function summarizeUsage(db: D1Database, days: number): Promise<UsageSummary> {
+  const since = Date.now() - Math.max(1, Math.min(days, 365)) * 86_400_000
+
+  const totalRow = await db
+    .prepare(
+      `SELECT COUNT(*) AS requests,
+              COALESCE(SUM(prompt_tokens), 0) AS promptTokens,
+              COALESCE(SUM(completion_tokens), 0) AS completionTokens
+       FROM usage WHERE created_at >= ?`,
+    )
+    .bind(since)
+    .first<{ requests: number; promptTokens: number; completionTokens: number }>()
+
+  const byKey = await db
+    .prepare(
+      `SELECT u.key_id AS keyId, COALESCE(k.name, 'unknown key') AS name,
+              COUNT(*) AS requests,
+              COALESCE(SUM(u.prompt_tokens + u.completion_tokens), 0) AS tokens
+       FROM usage u LEFT JOIN api_keys k ON k.id = u.key_id
+       WHERE u.created_at >= ? GROUP BY u.key_id ORDER BY tokens DESC LIMIT 50`,
+    )
+    .bind(since)
+    .all<{ keyId: string | null; name: string; requests: number; tokens: number }>()
+
+  const byDay = await db
+    .prepare(
+      `SELECT date(created_at / 1000, 'unixepoch') AS day,
+              COUNT(*) AS requests,
+              COALESCE(SUM(prompt_tokens + completion_tokens), 0) AS tokens
+       FROM usage WHERE created_at >= ? GROUP BY day ORDER BY day`,
+    )
+    .bind(since)
+    .all<{ day: string; requests: number; tokens: number }>()
+
+  const byModel = await db
+    .prepare(
+      `SELECT model, COUNT(*) AS requests,
+              COALESCE(SUM(prompt_tokens + completion_tokens), 0) AS tokens
+       FROM usage WHERE created_at >= ? GROUP BY model ORDER BY tokens DESC LIMIT 20`,
+    )
+    .bind(since)
+    .all<{ model: string; requests: number; tokens: number }>()
+
+  return {
+    days,
+    totals: totalRow ?? { requests: 0, promptTokens: 0, completionTokens: 0 },
+    byKey: byKey.results ?? [],
+    byDay: byDay.results ?? [],
+    byModel: byModel.results ?? [],
+  }
+}
diff --git a/opencode-server/src/proxy.ts b/opencode-server/src/proxy.ts
new file mode 100644
index 0000000000..95b5c527b4
--- /dev/null
+++ b/opencode-server/src/proxy.ts
@@ -0,0 +1,194 @@
+import { resolveRoute, type Provider } from './config'
+import { recordUsage, type ApiKeyRow } from './keys'
+import type { Env } from './types'
+
+type Usage = { prompt_tokens?: number; completion_tokens?: number }
+
+function jsonResponse(body: unknown, status: number): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'content-type': 'application/json; charset=utf-8' },
+  })
+}
+
+function upstreamHeaders(provider: Provider): HeadersInit {
+  const headers: Record<string, string> = {
+    'content-type': 'application/json',
+    authorization: `Bearer ${provider.apiKey}`,
+  }
+  if (provider.id === 'openrouter') {
+    headers['http-referer'] = 'https://opencode.ai'
+    headers['x-title'] = 'opencode-server'
+  }
+  return headers
+}
+
+/** Pulls token counts out of a non-streaming response body. */
+function usageFromJson(text: string): Usage {
+  try {
+    const parsed: unknown = JSON.parse(text)
+    if (parsed && typeof parsed === 'object' && 'usage' in parsed) {
+      const usage = (parsed as { usage?: Usage }).usage
+      if (usage) return usage
+    }
+  } catch {
+    // Not JSON: no usage to report.
+  }
+  return {}
+}
+
+/** Pulls the last `usage` object out of an SSE stream. */
+async function usageFromStream(stream: ReadableStream<Uint8Array>): Promise<Usage> {
+  const reader = stream.getReader()
+  const decoder = new TextDecoder()
+  let buffer = ''
+  let usage: Usage = {}
+  for (;;) {
+    const { done, value } = await reader.read()
+    if (done) break
+    buffer += decoder.decode(value, { stream: true })
+    let newline = buffer.indexOf('\n')
+    while (newline >= 0) {
+      const line = buffer.slice(0, newline).trim()
+      buffer = buffer.slice(newline + 1)
+      if (line.startsWith('data:')) {
+        const payload = line.slice(5).trim()
+        if (payload.length > 0 && payload !== '[DONE]') {
+          const candidate = usageFromJson(payload)
+          if (candidate.completion_tokens !== undefined) usage = candidate
+        }
+      }
+      newline = buffer.indexOf('\n')
+    }
+  }
+  return usage
+}
+
+const PASSTHROUGH_HEADERS = ['content-type', 'cache-control', 'x-request-id']
+
+/**
+ * Proxies any POST /v1/<path> to the resolved upstream, recording usage.
+ * Streaming responses are teed so the client keeps its SSE stream while the
+ * gateway reads the trailing usage chunk.
+ */
+export async function forward(
+  request: Request,
+  env: Env,
+  ctx: ExecutionContext,
+  key: ApiKeyRow,
+  upstreamPath: string,
+  providers: Provider[],
+): Promise<Response> {
+  const startedAt = Date.now()
+
+  let body: Record<string, unknown>
+  try {
+    body = (await request.json()) as Record<string, unknown>
+  } catch {
+    return jsonResponse({ error: { message: 'Request body must be JSON.', type: 'invalid_request_error' } }, 400)
+  }
+
+  const requestedModel = typeof body.model === 'string' ? body.model : ''
+  if (!requestedModel) {
+    return jsonResponse(
+      { error: { message: 'Missing required field: model.', type: 'invalid_request_error' } },
+      400,
+    )
+  }
+
+  const route = resolveRoute(providers, requestedModel, env.DEFAULT_PROVIDER)
+  if ('error' in route) {
+    return jsonResponse({ error: { message: route.error, type: 'configuration_error' } }, 500)
+  }
+
+  const streaming = body.stream === true
+  const upstreamUrl = `${route.provider.baseUrl}/${upstreamPath}`
+  const upstreamBody = JSON.stringify({ ...body, model: route.model })
+
+  let upstream: Response
+  try {
+    upstream = await fetch(upstreamUrl, {
+      method: 'POST',
+      headers: upstreamHeaders(route.provider),
+      body: upstreamBody,
+    })
+  } catch (error) {
+    ctx.waitUntil(
+      recordUsage(env.DB, {
+        keyId: key.id,
+        provider: route.provider.id,
+        model: route.model,
+        promptTokens: 0,
+        completionTokens: 0,
+        status: 502,
+        latencyMs: Date.now() - startedAt,
+      }),
+    )
+    return jsonResponse(
+      {
+        error: {
+          message: `Upstream ${route.provider.id} is unreachable: ${String(error)}`,
+          type: 'upstream_error',
+        },
+      },
+      502,
+    )
+  }
+
+  const headers = new Headers()
+  for (const name of PASSTHROUGH_HEADERS) {
+    const value = upstream.headers.get(name)
+    if (value) headers.set(name, value)
+  }
+  if (streaming) headers.set('cache-control', 'no-cache')
+
+  if (!upstream.ok || !upstream.body) {
+    const text = await upstream.text()
+    ctx.waitUntil(
+      recordUsage(env.DB, {
+        keyId: key.id,
+        provider: route.provider.id,
+        model: route.model,
+        promptTokens: 0,
+        completionTokens: 0,
+        status: upstream.status,
+        latencyMs: Date.now() - startedAt,
+      }),
+    )
+    return new Response(text, { status: upstream.status, headers })
+  }
+
+  if (streaming) {
+    const [clientStream, meterStream] = upstream.body.tee()
+    ctx.waitUntil(
+      (async () => {
+        const usage = await usageFromStream(meterStream)
+        await recordUsage(env.DB, {
+          keyId: key.id,
+          provider: route.provider.id,
+          model: route.model,
+          promptTokens: usage.prompt_tokens ?? 0,
+          completionTokens: usage.completion_tokens ?? 0,
+          status: upstream.status,
+          latencyMs: Date.now() - startedAt,
+        })
+      })(),
+    )
+    return new Response(clientStream, { status: upstream.status, headers })
+  }
+
+  const text = await upstream.text()
+  const usage = usageFromJson(text)
+  ctx.waitUntil(
+    recordUsage(env.DB, {
+      keyId: key.id,
+      provider: route.provider.id,
+      model: route.model,
+      promptTokens: usage.prompt_tokens ?? 0,
+      completionTokens: usage.completion_tokens ?? 0,
+      status: upstream.status,
+      latencyMs: Date.now() - startedAt,
+    }),
+  )
+  return new Response(text, { status: upstream.status, headers })
+}
