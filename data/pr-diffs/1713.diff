diff --git a/opencode-hub/public/app.js b/opencode-hub/public/app.js
new file mode 100644
index 0000000000..e513c85f65
--- /dev/null
+++ b/opencode-hub/public/app.js
@@ -0,0 +1,157 @@
+const $ = (id) => document.getElementById(id);
+
+function setBadge(el, state, text) {
+  el.className = `badge ${state}`;
+  el.textContent = text;
+}
+
+function fmtUptime(seconds) {
+  if (seconds == null) return "—";
+  const s = Number(seconds);
+  if (s < 60) return `${s}s`;
+  if (s < 3600) return `${Math.floor(s / 60)}m ${s % 60}s`;
+  return `${Math.floor(s / 3600)}j ${Math.floor((s % 3600) / 60)}m`;
+}
+
+async function loadState() {
+  try {
+    const res = await fetch("/api/state", { cache: "no-store" });
+    const s = await res.json();
+
+    const oc = s.opencode;
+    setBadge($("oc-badge"), oc.reachable ? "ok" : "bad", oc.reachable ? "online" : "offline");
+    $("oc-url").textContent = oc.url;
+    $("oc-version").textContent = oc.version ?? "—";
+    $("oc-sessions").textContent = oc.reachable ? String(oc.sessionCount) : "—";
+    $("oc-latency").textContent = `${oc.latencyMs} ms`;
+    $("oc-auth").textContent = oc.passwordProtected ? "aktif" : "tidak diset";
+
+    const d = s.data;
+    setBadge($("data-badge"), d.reachable ? "ok" : "bad", d.reachable ? "online" : "offline");
+    $("data-url").textContent = d.url;
+    $("data-uptime").textContent = fmtUptime(d.uptimeSeconds);
+    $("data-groups").textContent = d.groups ?? "—";
+    $("data-items").textContent = d.resources ?? "—";
+    $("data-latency").textContent = `${d.latencyMs} ms`;
+
+    $("hub-port").textContent = String(s.hub.port);
+    $("hub-uptime").textContent = fmtUptime(s.hub.uptimeSeconds);
+    $("hub-node").textContent = s.hub.node;
+    $("hub-checked").textContent = new Date(s.checkedAt).toLocaleTimeString("id-ID");
+
+    const both = oc.reachable && d.reachable;
+    const any = oc.reachable || d.reachable;
+    const pill = $("overall");
+    pill.className = `pill ${both ? "ok" : any ? "warn" : "bad"}`;
+    $("overall-text").textContent = both
+      ? "semua server online"
+      : any
+        ? "sebagian server offline"
+        : "semua server offline";
+  } catch {
+    const pill = $("overall");
+    pill.className = "pill bad";
+    $("overall-text").textContent = "hub tidak merespons";
+  }
+}
+
+function hostOf(url) {
+  try {
+    return new URL(url).host;
+  } catch {
+    return url;
+  }
+}
+
+async function loadResources() {
+  const box = $("resources");
+  try {
+    const res = await fetch("/api/resources", { cache: "no-store" });
+    if (!res.ok) throw new Error(String(res.status));
+    const data = await res.json();
+    box.innerHTML = "";
+
+    for (const group of data.groups) {
+      const wrap = document.createElement("div");
+      wrap.className = "res-group";
+      const h = document.createElement("h3");
+      h.textContent = group.label;
+      wrap.appendChild(h);
+
+      for (const item of group.items) {
+        const row = document.createElement("div");
+        row.className = "res-item";
+
+        const meta = document.createElement("div");
+        meta.className = "meta";
+        const a = document.createElement("a");
+        a.className = "title";
+        a.href = item.url;
+        a.target = "_blank";
+        a.rel = "noreferrer";
+        a.textContent = item.title;
+        const desc = document.createElement("div");
+        desc.className = "desc";
+        desc.textContent = item.desc;
+        meta.append(a, desc);
+
+        const host = document.createElement("div");
+        host.className = "host";
+        host.textContent = hostOf(item.url);
+
+        row.append(meta, host);
+        wrap.appendChild(row);
+      }
+      box.appendChild(wrap);
+    }
+
+    $("resources-source").textContent = `sumber: server data · ${data.groups.length} grup`;
+  } catch {
+    box.innerHTML = '<p class="muted">server data tidak terjangkau — jalankan <code>node data-server.mjs</code>.</p>';
+  }
+}
+
+async function loadSessions() {
+  const box = $("sessions");
+  try {
+    const res = await fetch("/api/opencode/sessions", { cache: "no-store" });
+    if (!res.ok) throw new Error(String(res.status));
+    const data = await res.json();
+    if (!data.sessions.length) {
+      box.innerHTML = '<p class="muted">belum ada sesi.</p>';
+      return;
+    }
+    box.innerHTML = "";
+    for (const s of data.sessions) {
+      const row = document.createElement("div");
+      row.className = "res-item";
+      const meta = document.createElement("div");
+      meta.className = "meta";
+      const title = document.createElement("div");
+      title.className = "title";
+      title.textContent = s.title;
+      const desc = document.createElement("div");
+      desc.className = "desc";
+      desc.textContent = s.id;
+      meta.append(title, desc);
+      const when = document.createElement("div");
+      when.className = "host";
+      when.textContent = s.updated ? new Date(s.updated).toLocaleString("id-ID") : "—";
+      row.append(meta, when);
+      box.appendChild(row);
+    }
+  } catch {
+    box.innerHTML = '<p class="muted">server opencode tidak terjangkau.</p>';
+  }
+}
+
+$("refresh").addEventListener("click", () => {
+  loadState();
+  loadSessions();
+});
+
+loadResources();
+loadState();
+loadSessions();
+setInterval(loadState, 5000);
+setInterval(loadSessions, 20000);
diff --git a/opencode-hub/public/chat.html b/opencode-hub/public/chat.html
new file mode 100644
index 0000000000..e67e424c9d
--- /dev/null
+++ b/opencode-hub/public/chat.html
@@ -0,0 +1,460 @@
+<!doctype html>
+<html lang="id">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>opencode chat</title>
+    <style>
+      :root {
+        --bg: #0b0d10;
+        --panel: #12151a;
+        --panel-2: #171b21;
+        --line: #232833;
+        --text: #e6e9ef;
+        --muted: #8b94a3;
+        --accent: #6ea8ff;
+        --ok: #4ade80;
+        --err: #f87171;
+      }
+      * { box-sizing: border-box; }
+      html, body { height: 100%; margin: 0; }
+      body {
+        background: var(--bg);
+        color: var(--text);
+        font: 14px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+        display: flex;
+        overflow: hidden;
+      }
+      aside {
+        width: 250px;
+        flex: 0 0 250px;
+        border-right: 1px solid var(--line);
+        background: var(--panel);
+        display: flex;
+        flex-direction: column;
+        min-height: 0;
+      }
+      aside header {
+        padding: 14px;
+        border-bottom: 1px solid var(--line);
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 8px;
+      }
+      .brand { font-weight: 700; letter-spacing: 0.2px; }
+      .brand span { color: var(--accent); }
+      button {
+        font: inherit;
+        color: var(--text);
+        background: var(--panel-2);
+        border: 1px solid var(--line);
+        border-radius: 8px;
+        padding: 7px 10px;
+        cursor: pointer;
+      }
+      button:hover { border-color: #39404d; }
+      button.primary { background: #1d3a63; border-color: #2c5a96; color: #dcebff; }
+      button:disabled { opacity: 0.55; cursor: default; }
+      #sessions { overflow: auto; padding: 8px; display: flex; flex-direction: column; gap: 4px; }
+      .session {
+        text-align: left;
+        background: transparent;
+        border: 1px solid transparent;
+        border-radius: 8px;
+        padding: 8px 10px;
+        white-space: nowrap;
+        overflow: hidden;
+        text-overflow: ellipsis;
+        color: var(--muted);
+      }
+      .session:hover { background: var(--panel-2); color: var(--text); }
+      .session.active { background: #1a2432; border-color: #2a3a52; color: var(--text); }
+      aside footer { padding: 10px 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
+      aside footer a { color: var(--accent); text-decoration: none; }
+
+      main { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+      main header {
+        padding: 12px 18px;
+        border-bottom: 1px solid var(--line);
+        display: flex;
+        align-items: center;
+        gap: 12px;
+        flex-wrap: wrap;
+      }
+      #title { font-weight: 600; margin-right: auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+      select {
+        font: inherit;
+        color: var(--text);
+        background: var(--panel-2);
+        border: 1px solid var(--line);
+        border-radius: 8px;
+        padding: 7px 9px;
+        max-width: 260px;
+      }
+      #log { flex: 1; overflow: auto; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
+      .msg { display: flex; gap: 10px; }
+      .msg .who {
+        flex: 0 0 auto;
+        width: 34px;
+        height: 34px;
+        border-radius: 9px;
+        display: grid;
+        place-items: center;
+        font-size: 11px;
+        font-weight: 700;
+        border: 1px solid var(--line);
+        background: var(--panel-2);
+        color: var(--muted);
+      }
+      .msg.user .who { color: #cfe0ff; border-color: #2c5a96; background: #17242f; }
+      .msg.assistant .who { color: #b9f5cf; border-color: #276b45; background: #13231a; }
+      .bubble {
+        flex: 1;
+        min-width: 0;
+        background: var(--panel);
+        border: 1px solid var(--line);
+        border-radius: 12px;
+        padding: 10px 14px;
+        white-space: pre-wrap;
+        overflow-wrap: anywhere;
+      }
+      .msg.user .bubble { background: #131a24; }
+      .bubble code {
+        font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
+        background: #0d1015;
+        border: 1px solid var(--line);
+        border-radius: 5px;
+        padding: 1px 5px;
+      }
+      .meta { color: var(--muted); font-size: 11px; margin-top: 6px; }
+      .empty { margin: auto; text-align: center; color: var(--muted); max-width: 460px; }
+      .empty h1 { color: var(--text); font-size: 20px; margin: 0 0 8px; }
+      form {
+        border-top: 1px solid var(--line);
+        padding: 12px 18px 16px;
+        display: flex;
+        gap: 10px;
+        align-items: flex-end;
+        background: var(--panel);
+      }
+      textarea {
+        flex: 1;
+        resize: none;
+        min-height: 46px;
+        max-height: 180px;
+        font: inherit;
+        color: var(--text);
+        background: var(--panel-2);
+        border: 1px solid var(--line);
+        border-radius: 10px;
+        padding: 11px 13px;
+        outline: none;
+      }
+      textarea:focus { border-color: #2c5a96; }
+      #log { overflow-y: auto; overflow-x: hidden; }
+      #status { padding: 0 18px 14px; font-size: 12px; min-height: 16px; }
+
+      @media (max-width: 760px) {
+        body { flex-direction: column; }
+        aside {
+          width: auto;
+          flex: 0 0 auto;
+          max-height: 34vh;
+          border-right: none;
+          border-bottom: 1px solid var(--line);
+        }
+        aside header { padding: 10px 12px; }
+        #sessions { flex-direction: row; overflow-x: auto; overflow-y: hidden; padding: 8px; }
+        .session { max-width: 60vw; }
+        aside footer { padding: 6px 12px; border-top: none; display: flex; gap: 8px; }
+        main { flex: 1 1 auto; }
+        main header { padding: 10px 12px; gap: 8px; }
+        #title { flex: 1 1 100%; }
+        select { max-width: 100%; flex: 1 1 auto; }
+        #log { padding: 12px; gap: 10px; }
+        .msg .who { width: 26px; height: 26px; font-size: 10px; }
+        .bubble { padding: 8px 11px; border-radius: 10px; }
+        form { padding: 10px 12px 12px; }
+        #status { padding: 0 12px 10px; }
+      }
+      #status.err { color: var(--err); }
+      #status.busy { color: var(--accent); }
+    </style>
+  </head>
+  <body>
+    <aside>
+      <header>
+        <div class="brand">open<span>code</span></div>
+        <button id="new" title="Sesi baru">+ Baru</button>
+      </header>
+      <div id="sessions"></div>
+      <footer>
+        <span id="conn">menghubungkan…</span><br />
+        <a href="/hub">dashboard hub</a>
+      </footer>
+    </aside>
+
+    <main>
+      <header>
+        <div id="title">Chat</div>
+        <select id="model" title="Model"></select>
+      </header>
+      <div id="log">
+        <div class="empty" id="empty">
+          <h1>Mulai ngobrol dengan opencode</h1>
+          <p>Tulis pesan di bawah. Sesi dibuat otomatis kalau belum ada.</p>
+        </div>
+      </div>
+      <div id="status"></div>
+      <form id="composer">
+        <textarea id="input" rows="1" placeholder="Tulis pesan… (Enter kirim, Shift+Enter baris baru)"></textarea>
+        <button class="primary" id="send" type="submit">Kirim</button>
+      </form>
+    </main>
+
+    <script>
+      const $ = (id) => document.getElementById(id);
+      const state = {
+        sessionID: null,
+        model: { providerID: "opencode", modelID: "big-pickle" },
+        models: [],
+        busy: false,
+      };
+
+      async function api(path, options = {}) {
+        const res = await fetch(path, {
+          ...options,
+          headers: { "content-type": "application/json", ...(options.headers ?? {}) },
+        });
+        const text = await res.text();
+        let body = null;
+        try { body = text ? JSON.parse(text) : null; } catch { body = text; }
+        if (!res.ok) {
+          const detail = body?.data?.message ?? body?.error ?? body?.message ?? res.statusText;
+          throw new Error(`${res.status} ${detail}`);
+        }
+        return body;
+      }
+
+      function setStatus(text, kind) {
+        const el = $("status");
+        el.textContent = text ?? "";
+        el.className = kind ?? "";
+      }
+
+      function textOf(parts) {
+        return (parts ?? [])
+          .filter((p) => p.type === "text" && typeof p.text === "string")
+          .map((p) => p.text)
+          .join("\n\n")
+          .trim();
+      }
+
+      function renderMessage(info, parts) {
+        const role = info?.role === "user" ? "user" : "assistant";
+        const text = textOf(parts);
+        if (!text) return null;
+        const wrap = document.createElement("div");
+        wrap.className = `msg ${role}`;
+        const who = document.createElement("div");
+        who.className = "who";
+        who.textContent = role === "user" ? "YOU" : "OC";
+        const bubble = document.createElement("div");
+        bubble.className = "bubble";
+        bubble.textContent = text;
+        if (role === "assistant" && info?.modelID) {
+          const meta = document.createElement("div");
+          meta.className = "meta";
+          const usage = info.tokens?.total ? ` · ${info.tokens.total} token` : "";
+          meta.textContent = `${info.providerID ?? ""}/${info.modelID}${usage}`;
+          bubble.append(meta);
+        }
+        wrap.append(who, bubble);
+        return wrap;
+      }
+
+      async function loadModels() {
+        try {
+          const data = await api("/provider");
+          const connected = new Set(data.connected ?? []);
+          const list = [];
+          for (const provider of data.all ?? []) {
+            if (connected.size && !connected.has(provider.id)) continue;
+            for (const model of Object.values(provider.models ?? {})) {
+              list.push({ providerID: provider.id, modelID: model.id, name: `${provider.name} · ${model.name}` });
+            }
+          }
+          state.models = list;
+          const select = $("model");
+          select.innerHTML = "";
+          for (const item of list) {
+            const option = document.createElement("option");
+            option.value = `${item.providerID}/${item.modelID}`;
+            option.textContent = item.name;
+            select.append(option);
+          }
+          const preferred =
+            list.find((m) => m.providerID === "opencode" && m.modelID === "big-pickle") ??
+            list.find((m) => m.providerID === "opencode") ??
+            list[0];
+          if (preferred) {
+            state.model = { providerID: preferred.providerID, modelID: preferred.modelID };
+            select.value = `${preferred.providerID}/${preferred.modelID}`;
+          }
+          $("conn").textContent = `${list.length} model · ${connected.size || "?"} provider`;
+        } catch (error) {
+          $("conn").textContent = "model gagal dimuat";
+          setStatus(`Gagal memuat model: ${error.message}`, "err");
+        }
+      }
+
+      async function loadSessions() {
+        try {
+          const list = await api("/session");
+          const box = $("sessions");
+          box.innerHTML = "";
+          for (const session of (Array.isArray(list) ? list : []).slice(-50).reverse()) {
+            const button = document.createElement("button");
+            button.className = "session" + (session.id === state.sessionID ? " active" : "");
+            button.textContent = session.title || "(tanpa judul)";
+            button.onclick = () => openSession(session.id);
+            box.append(button);
+          }
+          return list;
+        } catch (error) {
+          setStatus(`Gagal memuat sesi: ${error.message}`, "err");
+          return [];
+        }
+      }
+
+      async function openSession(id) {
+        state.sessionID = id;
+        $("title").textContent = "memuat…";
+        const log = $("log");
+        log.innerHTML = "";
+        try {
+          const messages = await api(`/session/${id}/message`);
+          for (const item of messages ?? []) {
+            const node = renderMessage(item.info, item.parts);
+            if (node) log.append(node);
+          }
+          if (!log.childElementCount) {
+            log.innerHTML = '<div class="empty"><h1>Sesi kosong</h1><p>Tulis pesan untuk memulai.</p></div>';
+          }
+          const sessions = await api("/session");
+          const current = (sessions ?? []).find((s) => s.id === id);
+          $("title").textContent = current?.title || "Chat";
+          log.scrollTop = log.scrollHeight;
+          loadSessions();
+        } catch (error) {
+          $("title").textContent = "Chat";
+          setStatus(`Gagal memuat sesi: ${error.message}`, "err");
+        }
+      }
+
+      async function newSession() {
+        const session = await api("/session", {
+          method: "POST",
+          body: JSON.stringify({ title: "Chat baru" }),
+        });
+        state.sessionID = session.id;
+        $("title").textContent = session.title || "Chat baru";
+        $("log").innerHTML = '<div class="empty"><h1>Sesi baru</h1><p>Tulis pesan untuk memulai.</p></div>';
+        await loadSessions();
+        return session.id;
+      }
+
+      async function send(text) {
+        if (state.busy) return;
+        state.busy = true;
+        $("send").disabled = true;
+        setStatus("menunggu balasan opencode…", "busy");
+        const log = $("log");
+        const empty = log.querySelector(".empty");
+        if (empty) empty.remove();
+
+        const mine = document.createElement("div");
+        mine.className = "msg user";
+        mine.innerHTML = '<div class="who">YOU</div><div class="bubble"></div>';
+        mine.querySelector(".bubble").textContent = text;
+        log.append(mine);
+        log.scrollTop = log.scrollHeight;
+
+        try {
+          let id = state.sessionID;
+          if (!id) id = await newSession();
+          const reply = await api(`/session/${id}/message`, {
+            method: "POST",
+            body: JSON.stringify({
+              model: state.model,
+              parts: [{ type: "text", text }],
+            }),
+          });
+          const node = renderMessage(reply.info, reply.parts);
+          if (node) log.append(node);
+          else {
+            const note = document.createElement("div");
+            note.className = "msg assistant";
+            note.innerHTML = '<div class="who">OC</div><div class="bubble"></div>';
+            note.querySelector(".bubble").textContent = "(balasan tanpa teks)";
+            log.append(note);
+          }
+          log.scrollTop = log.scrollHeight;
+          setStatus("");
+          loadSessions();
+          if (state.sessionID) {
+            const sessions = await api("/session").catch(() => []);
+            const current = (sessions ?? []).find((s) => s.id === state.sessionID);
+            if (current) $("title").textContent = current.title || "Chat";
+          }
+        } catch (error) {
+          setStatus(`Gagal mengirim: ${error.message}`, "err");
+        } finally {
+          state.busy = false;
+          $("send").disabled = false;
+        }
+      }
+
+      $("composer").addEventListener("submit", (event) => {
+        event.preventDefault();
+        const input = $("input");
+        const text = input.value.trim();
+        if (!text) return;
+        input.value = "";
+        input.style.height = "auto";
+        send(text);
+      });
+
+      $("input").addEventListener("keydown", (event) => {
+        if (event.key === "Enter" && !event.shiftKey) {
+          event.preventDefault();
+          $("composer").requestSubmit();
+        }
+      });
+
+      $("input").addEventListener("input", (event) => {
+        const el = event.target;
+        el.style.height = "auto";
+        el.style.height = `${Math.min(el.scrollHeight, 180)}px`;
+      });
+
+      $("model").addEventListener("change", (event) => {
+        const [providerID, ...rest] = event.target.value.split("/");
+        state.model = { providerID, modelID: rest.join("/") };
+        setStatus(`model: ${providerID}/${state.model.modelID}`);
+      });
+
+      $("new").addEventListener("click", () => {
+        newSession().catch((error) => setStatus(`Gagal membuat sesi: ${error.message}`, "err"));
+      });
+
+      (async () => {
+        await loadModels();
+        const sessions = await loadSessions();
+        const latest = (sessions ?? []).slice(-1)[0];
+        if (latest) openSession(latest.id);
+      })();
+    </script>
+  </body>
+</html>
diff --git a/opencode-hub/public/index.html b/opencode-hub/public/index.html
new file mode 100644
index 0000000000..95228bd14f
--- /dev/null
+++ b/opencode-hub/public/index.html
@@ -0,0 +1,139 @@
+<!doctype html>
+<html lang="id">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>opencode Server Hub</title>
+    <link rel="stylesheet" href="/styles.css" />
+  </head>
+  <body>
+    <div class="glow"></div>
+
+    <header class="topbar">
+      <div class="brand">
+        <span class="mark">oc</span>
+        <div>
+          <strong>opencode <span class="slash">×</span> Freebuff Hub</strong>
+          <p>Halaman server untuk agen opencode &amp; server data terpisah</p>
+        </div>
+      </div>
+      <div class="pill" id="overall">
+        <span class="dot"></span><span id="overall-text">memeriksa…</span>
+      </div>
+    </header>
+
+    <main>
+      <section class="cards">
+        <article class="card">
+          <div class="card-head">
+            <h2>Server opencode</h2>
+            <span class="badge" id="oc-badge">—</span>
+          </div>
+          <dl>
+            <div><dt>Endpoint</dt><dd id="oc-url">—</dd></div>
+            <div><dt>Versi</dt><dd id="oc-version">—</dd></div>
+            <div><dt>Sesi aktif</dt><dd id="oc-sessions">—</dd></div>
+            <div><dt>Latensi</dt><dd id="oc-latency">—</dd></div>
+            <div><dt>Password</dt><dd id="oc-auth">—</dd></div>
+          </dl>
+          <p class="hint">
+            Mode <code>opencode web</code> di port 4096, disajikan hub di akar origin (<code>/</code>).
+            Dashboard ini ada di <code>/hub</code>.
+          </p>
+          <a class="open-ui" href="/" target="_blank" rel="noreferrer">Buka server opencode →</a>
+        </article>
+
+        <article class="card">
+          <div class="card-head">
+            <h2>Server data</h2>
+            <span class="badge" id="data-badge">—</span>
+          </div>
+          <dl>
+            <div><dt>Endpoint</dt><dd id="data-url">—</dd></div>
+            <div><dt>Uptime</dt><dd id="data-uptime">—</dd></div>
+            <div><dt>Grup tautan</dt><dd id="data-groups">—</dd></div>
+            <div><dt>Total entri</dt><dd id="data-items">—</dd></div>
+            <div><dt>Latensi</dt><dd id="data-latency">—</dd></div>
+          </dl>
+          <p class="hint">Proses terpisah, port terpisah (8788), data sendiri.</p>
+        </article>
+
+        <article class="card">
+          <div class="card-head">
+            <h2>Hub</h2>
+            <span class="badge ok">online</span>
+          </div>
+          <dl>
+            <div><dt>Port</dt><dd id="hub-port">—</dd></div>
+            <div><dt>Uptime</dt><dd id="hub-uptime">—</dd></div>
+            <div><dt>Runtime</dt><dd id="hub-node">—</dd></div>
+            <div><dt>Terakhir cek</dt><dd id="hub-checked">—</dd></div>
+          </dl>
+          <p class="hint">Halaman ini memantau kedua server tiap 5 detik.</p>
+        </article>
+      </section>
+
+      <section class="panel warning">
+        <h2>Sebelum membuka ke publik</h2>
+        <p>
+          <code>opencode serve</code> / <code>opencode web</code> memberi kendali penuh atas sesi agen
+          dan filesystem. Jangan menaruhnya langsung di internet. Minimal:
+        </p>
+        <pre><code>OPENCODE_SERVER_PASSWORD='ganti-ini' \
+  opencode web --port 4096 --hostname 127.0.0.1</code></pre>
+        <p>
+          Lalu taruh reverse proxy (Caddy/Nginx) dengan HTTPS dan basic-auth di depannya. Repo
+          <a href="https://github.com/nexusrootlab/incident" target="_blank" rel="noreferrer"
+            >nexusrootlab/incident</a
+          >
+          mendokumentasikan kebocoran data lintas-sesi pada OpenCode Zen — alasan tambahan untuk
+          tidak mengekspos instance tanpa autentikasi.
+        </p>
+      </section>
+
+      <section class="panel">
+        <div class="panel-head">
+          <h2>Referensi &amp; tautan</h2>
+          <span class="muted" id="resources-source">sumber: server data</span>
+        </div>
+        <div id="resources" class="resources"><p class="muted">memuat…</p></div>
+      </section>
+
+      <section class="panel">
+        <div class="panel-head">
+          <h2>Sesi opencode terbaru</h2>
+          <button id="refresh" type="button">Muat ulang</button>
+        </div>
+        <div id="sessions" class="resources"><p class="muted">memuat…</p></div>
+      </section>
+
+      <section class="panel">
+        <h2>Menjalankan permanen</h2>
+        <p>Dua proses, dua port. Contoh systemd di mesin/VPS Anda sendiri:</p>
+        <pre><code>[Unit]
+Description=opencode headless server
+After=network.target
+
+[Service]
+Environment=OPENCODE_SERVER_PASSWORD=RAHASIA
+ExecStart=/usr/local/bin/opencode serve --port 4096 --hostname 127.0.0.1
+Restart=always
+
+[Install]
+WantedBy=multi-user.target</code></pre>
+        <p>Untuk hub dan server data (dari folder ini):</p>
+        <pre><code>node data-server.mjs &amp;
+node hub-server.mjs</code></pre>
+      </section>
+
+      <footer>
+        <p>
+          Halaman ini bukan produk resmi opencode maupun Freebuff, dan tidak berafiliasi dengan
+          tim opencode.
+        </p>
+      </footer>
+    </main>
+
+    <script src="/app.js"></script>
+  </body>
+</html>
diff --git a/opencode-hub/public/styles.css b/opencode-hub/public/styles.css
new file mode 100644
index 0000000000..11d3a4e2ba
--- /dev/null
+++ b/opencode-hub/public/styles.css
@@ -0,0 +1,240 @@
+:root {
+  --bg: #0b0d12;
+  --bg-soft: #11141c;
+  --card: #151925;
+  --line: #232a3a;
+  --text: #e8ecf5;
+  --muted: #8b93a7;
+  --accent: #7c9cff;
+  --accent-2: #4fd1a5;
+  --warn: #ffb86b;
+  --bad: #ff6b81;
+  --radius: 14px;
+  --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
+}
+
+* { box-sizing: border-box; }
+
+html, body { margin: 0; }
+
+body {
+  background: var(--bg);
+  color: var(--text);
+  font: 15px/1.6 "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
+  -webkit-font-smoothing: antialiased;
+  min-height: 100vh;
+}
+
+.glow {
+  position: fixed;
+  inset: -30% -10% auto -10%;
+  height: 520px;
+  background: radial-gradient(60% 60% at 50% 0%, rgba(124, 156, 255, 0.22), transparent 70%);
+  pointer-events: none;
+  z-index: 0;
+}
+
+.topbar {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 16px;
+  align-items: center;
+  justify-content: space-between;
+  padding: 28px clamp(16px, 4vw, 48px) 12px;
+  max-width: 1120px;
