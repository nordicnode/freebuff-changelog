diff --git a/cli/src/utils/__tests__/preload-guard.test.ts b/cli/src/utils/__tests__/preload-guard.test.ts
new file mode 100644
index 0000000000..ad2ba5c063
--- /dev/null
+++ b/cli/src/utils/__tests__/preload-guard.test.ts
@@ -0,0 +1,163 @@
+import { describe, expect, test } from 'bun:test'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { describeForeignPreload, foreignPreloadFrom } from '../preload-guard'
+
+describe('foreignPreloadFrom', () => {
+  test('finds a --preload outside the bundle', () => {
+    expect(
+      foreignPreloadFrom({ execArgv: ['--preload', '/tmp/hook.ts'] }),
+    ).toBe('/tmp/hook.ts')
+  })
+
+  test('ignores a preload inside the compiled bundle', () => {
+    expect(
+      foreignPreloadFrom({
+        execArgv: ['--preload', '/$bunfs/root/embedded.ts'],
+      }),
+    ).toBeNull()
+  })
+
+  test('finds the -r form', () => {
+    expect(foreignPreloadFrom({ execArgv: ['-r', '/tmp/hook.js'] })).toBe(
+      '/tmp/hook.js',
+    )
+  })
+
+  test('finds the --require= form', () => {
+    expect(
+      foreignPreloadFrom({ execArgv: ['--require=/tmp/hook.js'] }),
+    ).toBe('/tmp/hook.js')
+  })
+
+  test('ignores an empty flag value and an empty argv', () => {
+    expect(foreignPreloadFrom({ execArgv: ['--preload=', '-e', 'x'] })).toBeNull()
+    expect(foreignPreloadFrom({ execArgv: [] })).toBeNull()
+  })
+
+  test('finds a loaded module outside the bundle', () => {
+    expect(
+      foreignPreloadFrom({
+        execArgv: [],
+        loadedModules: ['/tmp/hook.ts', '/$bunfs/root/freebuff'],
+      }),
+    ).toBe('/tmp/hook.ts')
+  })
+
+  test('ignores loaded modules that are all inside the bundle', () => {
+    expect(
+      foreignPreloadFrom({
+        execArgv: [],
+        loadedModules: ['/$bunfs/root/freebuff', '/$bunfs/root/a.ts'],
+      }),
+    ).toBeNull()
+  })
+
+  test('ignores a module inside the working directory (a repo bunfig preload)', () => {
+    // Bun reads `preload` from a bunfig.toml in cwd, so the CLI run inside a
+    // user's own repository must not refuse on that repository's setup file.
+    expect(
+      foreignPreloadFrom({
+        execArgv: [],
+        loadedModules: ['/repo/setup.ts'],
+        cwd: '/repo',
+      }),
+    ).toBeNull()
+    expect(
+      foreignPreloadFrom({
+        execArgv: [],
+        loadedModules: ['/repo/setup.ts'],
+        cwd: '/repo/',
+      }),
+    ).toBeNull()
+    // A sibling whose name merely starts with the cwd is NOT inside it.
+    expect(
+      foreignPreloadFrom({
+        execArgv: [],
+        loadedModules: ['/repository/setup.ts'],
+        cwd: '/repo',
+      }),
+    ).toBe('/repository/setup.ts')
+  })
+
+  test('prefers the command line over the cache', () => {
+    expect(
+      foreignPreloadFrom({
+        execArgv: ['--preload', '/tmp/from-argv.ts'],
+        loadedModules: ['/tmp/from-cache.ts'],
+      }),
+    ).toBe('/tmp/from-argv.ts')
+  })
+})
+
+describe('describeForeignPreload', () => {
+  test('names the path and, when enforcing, says the CLI refused', () => {
+    const message = describeForeignPreload('/tmp/hook.ts', { enforced: true })
+    expect(message).toContain('/tmp/hook.ts')
+    expect(message).toContain('refused to start')
+  })
+
+  test('does not claim a refusal on the warn-only default', () => {
+    const message = describeForeignPreload('/tmp/hook.ts', { enforced: false })
+    expect(message).toContain('/tmp/hook.ts')
+    expect(message).toContain('warning')
+    expect(message).not.toContain('refused to start')
+    expect(message).toContain('FREEBUFF_PRELOAD_GUARD=enforce')
+  })
+})
+
+/**
+ * The parser tests above feed `execArgv` by hand, so they prove the parser.
+ * This one spawns a real Bun with `BUN_OPTIONS=--preload` and asserts the two
+ * things the guard rests on: Bun runs the hook before the entry point, and it
+ * reports the flag in `process.execArgv`. If a Bun release stops doing either,
+ * the guard silently stops detecting and this test is what says so.
+ */
+describe('the BUN_OPTIONS channel', () => {
+  test('a preload from BUN_OPTIONS runs and lands in execArgv', () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'preload-guard-'))
+    const hook = path.join(dir, 'hook.ts')
+    const ran = path.join(dir, 'hook-ran')
+    const probe = path.join(dir, 'probe.ts')
+    const guardModule = new URL('../preload-guard.ts', import.meta.url).href
+
+    fs.writeFileSync(hook, `await Bun.write(${JSON.stringify(ran)}, 'yes')\n`)
+    fs.writeFileSync(
+      probe,
+      [
+        `const mod = await import(${JSON.stringify(guardModule)})`,
+        'const found = mod.foreignPreloadFrom({ execArgv: process.execArgv })',
+        'console.log(JSON.stringify({ argv: process.execArgv, found }))',
+      ].join('\n'),
+    )
+
+    const run = (bunOptions: string) =>
+      Bun.spawnSync([process.execPath, probe], {
+        env: { ...process.env, BUN_OPTIONS: bunOptions },
+        stdout: 'pipe',
+        stderr: 'pipe',
+      })
+
+    try {
+      const injected = run(`--preload ${hook}`)
+      expect(injected.exitCode).toBe(0)
+      expect(
+        JSON.parse(injected.stdout.toString()) as {
+          argv: string[]
+          found: string | null
+        },
+      ).toEqual({ argv: ['--preload', hook], found: hook })
+      expect(fs.existsSync(ran)).toBe(true)
+
+      const clean = run('')
+      expect(clean.exitCode).toBe(0)
+      expect(
+        (JSON.parse(clean.stdout.toString()) as { found: string | null }).found,
+      ).toBeNull()
+    } finally {
+      fs.rmSync(dir, { recursive: true, force: true })
+    }
+  })
+})
diff --git a/cli/src/utils/preload-guard.ts b/cli/src/utils/preload-guard.ts
new file mode 100644
index 0000000000..b4f9bf9800
--- /dev/null
+++ b/cli/src/utils/preload-guard.ts
@@ -0,0 +1,99 @@
+/**
+ * Refuse to start under an injected Bun preload.
+ *
+ * `BUN_OPTIONS=--preload <file>` runs caller code inside this process before
+ * the first line of the shipped entry, which is how a capture bridge takes a
+ * sponsored grant without ever sending a request (poc/claude-code-bridge;
+ * `poc/cli-env-inheritance` measured the channel on the published binaries).
+ *
+ * This is a SPEED BUMP, not a barrier, and it says so on purpose: a preload
+ * runs before this check, so it can rewrite `process.execArgv` and drop itself
+ * from `require.cache`. What it buys is that capture stops being one
+ * environment variable and becomes a patched binary — a different act, with a
+ * different ban story.
+ *
+ * Every module the compiled binary ships lives under `/$bunfs/`; a path
+ * outside it was not loaded by this build.
+ */
+
+/** The prefix of every module inside a compiled Bun binary. */
+export const BUNDLE_PREFIX = '/$bunfs/'
+
+/** The flags Bun honours as "load this file before the entry point". */
+const PRELOAD_FLAGS = ['--preload', '-r', '--require'] as const
+
+function foreignPath(candidate: string | undefined): string | null {
+  if (typeof candidate !== 'string') return null
+  const trimmed = candidate.trim()
+  if (!trimmed) return null
+  return trimmed.startsWith(BUNDLE_PREFIX) ? null : trimmed
+}
+
+/**
+ * The first injected preload path, or null. Pure: the caller supplies both
+ * channels, so this is testable without a Bun process.
+ *
+ * `execArgv` is the channel measured on the published binary. `loadedModules`
+ * (the keys of `require.cache`) is best-effort: a compiled binary reports its
+ * own modules under the bundle prefix, and may report none at all.
+ *
+ * `cwd` excludes that module channel under the working directory, and it is
+ * there for one measured reason: Bun also reads `preload` from a `bunfig.toml`
+ * in the current directory, so the CLI run inside a user's own repository
+ * would otherwise see that repository's setup file in the cache and refuse to
+ * start — a false stop on ordinary use. Measured 2026-10-27: a `bunfig.toml`
+ * preload executes in this process and never appears in `execArgv`, so this
+ * check cannot tell a repository's own setup file from an injection anyway;
+ * excluding `cwd` states that instead of pretending otherwise.
+ */
+export function foreignPreloadFrom(input: {
+  execArgv: readonly string[]
+  loadedModules?: readonly string[]
+  cwd?: string
+}): string | null {
+  const argv = input.execArgv
+  for (let index = 0; index < argv.length; index++) {
+    const arg = argv[index] as string
+    if ((PRELOAD_FLAGS as readonly string[]).includes(arg)) {
+      const next = foreignPath(argv[index + 1])
+      if (next) return next
+      continue
+    }
+    for (const flag of PRELOAD_FLAGS) {
+      const prefix = `${flag}=`
+      if (!arg.startsWith(prefix)) continue
+      const value = foreignPath(arg.slice(prefix.length))
+      if (value) return value
+    }
+  }
+  const cwd = input.cwd?.replace(/\/+$/, '')
+  for (const modulePath of input.loadedModules ?? []) {
+    if (cwd && (modulePath === cwd || modulePath.startsWith(`${cwd}/`)))
+      continue
+    const foreign = foreignPath(modulePath)
+    if (foreign) return foreign
+  }
+  return null
+}
+
+/**
+ * One line for stderr. Names the path; does not explain how to evade it.
+ *
+ * `enforced: false` is the default path: the CLI reports what was injected and
+ * keeps running. Saying "refused to start" there would be false, and an
+ * operator reading it would go looking for a preload that is not the problem.
+ */
+export function describeForeignPreload(
+  preloadPath: string,
+  { enforced }: { enforced: boolean },
+): string {
+  return enforced
+    ? [
+        `freebuff refused to start: code was injected into this process before it began (${preloadPath}).`,
+        'The CLI runs only as the build ships it; remove the preload from BUN_OPTIONS, NODE_OPTIONS or the bunfig and start it again.',
+      ].join('\n')
+    : [
+        `freebuff warning: code was injected into this process before it began (${preloadPath}).`,
+        'The CLI is running this turn anyway. Set FREEBUFF_PRELOAD_GUARD=enforce to refuse instead.',
+      ].join('\n')
+}
