+
+    <header class="topbar">
+      <div class="brand">
+        <span class="mark">oc</span>
+        <div>
+          <strong>opencode <span class="slash">×</span> Freebuff Hub</strong>
+          <p>Halaman server untuk agen opencode &amp; server data terpisah</p>
+        </div>
+      </div>
+      <div class="pill" id="overall">
+        <span class="dot"></span><span id="overall-text">memeriksa…</span>
+      </div>
+    </header>
+
+    <main>
+      <section class="cards">
+        <article class="card">
