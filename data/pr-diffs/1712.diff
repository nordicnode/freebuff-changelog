diff --git a/opencode-hub/start.sh b/opencode-hub/start.sh
new file mode 100755
index 0000000000..2b0f6ee08f
--- /dev/null
+++ b/opencode-hub/start.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# Menjalankan tiga proses: server data, server opencode, dan server halaman hub.
+# Password opencode dibuat otomatis dan tidak pernah ditulis ke dalam kode.
+set -euo pipefail
+cd "$(dirname "$0")"
+
+mkdir -p .runtime
+
+PASS_FILE=.opencode-server-password
+if [ ! -f "$PASS_FILE" ]; then
+  head -c 24 /dev/urandom | base64 | tr -d '/+=\n' >"$PASS_FILE"
+  chmod 600 "$PASS_FILE"
+  echo "[start] password opencode dibuat di $PASS_FILE (jangan di-commit)"
+fi
+
+export OPENCODE_SERVER_PASSWORD="$(tr -d '\n' <"$PASS_FILE")"
+export OPENCODE_URL="${OPENCODE_URL:-http://127.0.0.1:4096}"
+export OPENCODE_HOST="${OPENCODE_HOST:-0.0.0.0}"
+export OPENCODE_PORT="${OPENCODE_PORT:-4096}"
+export DATA_URL="${DATA_URL:-http://127.0.0.1:8788}"
+export DATA_PORT="${DATA_PORT:-8788}"
+export HUB_PORT="${HUB_PORT:-3000}"
+export DATA_HOST="${DATA_HOST:-127.0.0.1}"
+export HUB_HOST="${HUB_HOST:-0.0.0.0}"
+
+is_running() {
+  [ -f ".runtime/$1.pid" ] && kill -0 "$(cat ".runtime/$1.pid")" 2>/dev/null
+}
+
+launch() {
+  local name=$1
+  shift
+  if is_running "$name"; then
+    echo "[start] $name sudah jalan (pid $(cat ".runtime/$name.pid"))"
+    return
+  fi
+  nohup "$@" >".runtime/$name.log" 2>&1 &
+  echo $! >".runtime/$name.pid"
+  echo "[start] $name pid $(cat ".runtime/$name.pid")"
+}
+
+launch data node data-server.mjs
+
+if command -v opencode >/dev/null 2>&1; then
+  launch opencode opencode web --port "$OPENCODE_PORT" --hostname "$OPENCODE_HOST"
+else
+  echo "[start] peringatan: perintah 'opencode' tidak ditemukan."
+  echo "        pasang dulu: npm i -g @opencode/cli@latest  (atau lihat https://opencode.ai/docs)"
+fi
+
+launch hub node hub-server.mjs
+
+echo "[start] selesai. Halaman: http://127.0.0.1:${HUB_PORT}"
+echo "[start] log: .runtime/*.log"
diff --git a/opencode-hub/stop.sh b/opencode-hub/stop.sh
new file mode 100755
index 0000000000..c820292f67
--- /dev/null
+++ b/opencode-hub/stop.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+# Menghentikan proses yang diluncurkan start.sh (hanya PID yang dicatat sendiri).
+set -euo pipefail
+cd "$(dirname "$0")"
+
+for name in hub opencode data; do
+  pid_file=".runtime/$name.pid"
+  [ -f "$pid_file" ] || continue
+  pid="$(cat "$pid_file")"
+  if kill -0 "$pid" 2>/dev/null; then
+    kill "$pid" 2>/dev/null || true
+    echo "[stop] $name (pid $pid) dihentikan"
+  fi
+  rm -f "$pid_file"
+done
diff --git a/opencode-hub/tunnel.sh b/opencode-hub/tunnel.sh
new file mode 100755
index 0000000000..10ed96f824
--- /dev/null
+++ b/opencode-hub/tunnel.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+# Tunnel publik untuk hub (port 3000) yang auto-reconnect.
+#
+# Free tier serveo memutus port forwarding setelah beberapa saat; loop di bawah
+# langsung menyambung lagi dan mencatat URL terbaru di .runtime/public-url.txt.
+# Subdomain tetap tidak bisa tanpa akun serveo (butuh SSH key terdaftar), jadi
+# URL-nya berganti setiap reconnect. Untuk alamat yang benar-benar tetap, pakai
+# deploy/ (Docker + Caddy + domain sendiri) di VPS.
+#
+# cloudflared quick tunnel tidak bisa dipakai di VM ini: edge Cloudflare hanya
+# lewat UDP/TCP 7844 dan port itu diblokir (precheck hard_fail, halaman 1033).
+set -uo pipefail
+cd "$(dirname "$0")"
+mkdir -p .runtime
+
+: > .runtime/tunnel.log
+
+log() { echo "[$(date -u +%H:%M:%SZ)] $*" >> .runtime/tunnel.log; }
+URL=""
+while :; do
+  : > .runtime/lhr.log
+  ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
+      -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
+      -o ExitOnForwardFailure=yes \
+      -R 80:localhost:3000 serveo.net > .runtime/lhr.log 2>&1 &
+  SSH_PID=$!
+  echo "$SSH_PID" > .runtime/tunnel.pid
+
+  NEW=""
+  for _ in $(seq 1 20); do
+    NEW=$(tr -d '\r' < .runtime/lhr.log \
+          | grep -aoE "https://[a-z0-9.-]+serveousercontent\.com" | sort -u | head -1 || true)
+    [ -n "$NEW" ] && break
+    kill -0 "$SSH_PID" 2>/dev/null || break
+    sleep 2
+  done
+
+  if [ -n "$NEW" ]; then
+    URL="$NEW"
+    echo "$URL" > .runtime/public-url.txt
+    log "tunnel up: $URL (ssh pid $SSH_PID)"
+  else
+    log "tunnel gagal naik, ulang 3s"
+  fi
+
+  wait "$SSH_PID"
+  log "tunnel putus (ssh pid $SSH_PID), sambung ulang 3s"
+  sleep 3
+done
