+# Jangan diedit manual kalau memakai install.sh: skrip itu yang menulis .env.
+#   sudo ./install.sh --domain opencode.contoh.com --email anda@contoh.com
+#
+# Kalau mengisi sendiri: salin ke .env (chmod 600) lalu isi.
+# Domain yang mau dipakai (harus dimiliki + record A ke IP VPS).
+HUB_DOMAIN=opencode.contoh.com
+ACME_EMAIL=you@example.com
+
+# Wajib: dipakai opencode serve dan hub. Buat dengan:
+#   openssl rand -base64 32 | tr -d '/+=\n'
+OPENCODE_SERVER_PASSWORD=
+
+# Login untuk domain hub ada di berkas auth.caddy (diisi install.sh), bukan di sini.
+# Dua variabel berikut hanya dipakai kalau blok oc.* di Caddyfile diaktifkan.
+OC_BASIC_USER=admin
+# docker compose run --rm caddy caddy hash-password --plaintext 'PASSWORD-PANJANG'
+OC_BASIC_HASH=
+
+# Profil "hermes": docker compose --profile hermes up -d
+NOUS_API_KEY=
+OPENROUTER_API_KEY=
diff --git a/opencode-hub/deploy/Caddyfile b/opencode-hub/deploy/Caddyfile
new file mode 100644
index 0000000000..d5198b58a6
--- /dev/null
+++ b/opencode-hub/deploy/Caddyfile
@@ -0,0 +1,43 @@
+# Domain custom sepenuhnya milik Anda: cukup arahkan DNS ke IP server ini.
+# Caddy menerbitkan sertifikat HTTPS otomatis (Let's Encrypt / ZeroSSL).
+
+{
+	email {$ACME_EMAIL}
+	servers {
+		protocols h1 h2
+	}
+}
+
+# Halaman hub publik.
+{$HUB_DOMAIN} {
+	encode zstd gzip
+
+	# Login untuk SEMUA rute (UI opencode, /chat, /hub, /api).
+	# Isi berkas ini ditulis oleh install.sh, atau buat hash manual:
+	#   docker compose run --rm caddy caddy hash-password --plaintext 'PASSWORD-PANJANG'
+	# Kalau berkas hanya berisi komentar, situs terbuka tanpa login.
+	import auth.caddy
+
+	header {
+		Strict-Transport-Security "max-age=31536000; includeSubDomains"
+		X-Content-Type-Options "nosniff"
+		Referrer-Policy "no-referrer"
+		X-Frame-Options "SAMEORIGIN"
+		-Server
+	}
+
+	reverse_proxy hub:3000
+}
+
+# --- API opencode publik (opsional) -----------------------------------------
+# API opencode memberi kendali penuh atas sesi agen dan filesystem. Jangan
+# aktifkan tanpa basic auth + password server. Buat hash dulu:
+#   docker compose run --rm caddy caddy hash-password --plaintext 'PASSWORD-PANJANG'
+# lalu isi OC_BASIC_HASH di .env dan hapus tanda komentar di bawah.
+#
+# oc.{$HUB_DOMAIN} {
+# 	basic_auth {
+# 		{$OC_BASIC_USER:admin} {$OC_BASIC_HASH}
+# 	}
+# 	reverse_proxy opencode:4096
+# }
