@@ -0,0 +1,495 @@
+#!/usr/bin/env bash
+# doctor.sh — periksa sendiri kenapa https://domain-anda.com belum jalan.
+#
+# Skrip ini hanya MEMBACA keadaan VPS: DNS, port 80/443, container, sertifikat
+# Caddy, dan /api/health. Tidak mengubah apa pun, jadi aman dijalankan kapan saja.
+# Tiap kegagalan disertai saran perbaikan.
+#
+# Contoh:
+#   sudo ./doctor.sh                       # domain dibaca dari deploy/.env
+#   ./doctor.sh --domain opencode.contoh.com
+#   ./doctor.sh --help
+#
+# Kode keluar: 0 = semua lolos, 1 = ada yang gagal, 2 = salah pemakaian.
+set -uo pipefail
+cd "$(dirname "$0")"
+
+DOMAIN=""
+
+usage() {
+  cat <<'EOF'
+Pemakaian: ./doctor.sh [opsi]
+
+  --domain NAMA   domain yang diperiksa (default: HUB_DOMAIN dari deploy/.env)
+  -h, --help      tampilkan bantuan ini
+
+Skrip hanya membaca keadaan (tidak mengubah konfigurasi). Jalankan dengan sudo
+supaya nama proses pemilik port 80/443 terlihat.
+EOF
+}
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --domain) DOMAIN="${2:?--domain butuh nilai}"; shift 2 ;;
+    --domain=*) DOMAIN="${1#*=}"; shift ;;
+    -h|--help) usage; exit 0 ;;
+    *) usage >&2; printf 'opsi tidak dikenal: %s\n' "$1" >&2; exit 2 ;;
+  esac
+done
+
+FAILS=0
+WARNS=0
+
+section() { printf '\n== %s ==\n' "$*"; }
+ok() { printf '[ ok ] %s\n' "$*"; }
+note() { printf '[info] %s\n' "$*"; }
+warn() { printf '[WARN] %s\n' "$*"; WARNS=$((WARNS + 1)); }
+bad() { printf '[FAIL] %s\n' "$*"; FAILS=$((FAILS + 1)); }
+hint() { printf '       -> %s\n' "$*"; }
+
+BODY_FILE="$(mktemp 2>/dev/null || echo /tmp/doctor-body.$$)"
+trap 'rm -f "$BODY_FILE"' EXIT
+
+env_get() { # env_get KEY  -> nilai dari .env (tanpa tanda kutip)
+  [ -f .env ] || return 0
+  grep -E "^$1=" .env 2>/dev/null | head -n1 | cut -d= -f2- || true
+}
+
+# --- 1. berkas konfigurasi ----------------------------------------------------
+section "Berkas konfigurasi"
+
+if [ -f .env ]; then
+  MODE="$(stat -c '%a' .env 2>/dev/null || true)"
+  ok ".env ditemukan"
+  if [ -n "$MODE" ] && [ "$MODE" != "600" ] && [ "$MODE" != "400" ]; then
+    warn ".env bermode $MODE (berisi password opencode)"
+    hint "chmod 600 .env"
+  fi
+else
+  bad ".env tidak ada di $(pwd)"
+  hint "jalankan installer: sudo ./install.sh --domain DOMAIN --email EMAIL"
+fi
+
+[ -z "$DOMAIN" ] && DOMAIN="$(env_get HUB_DOMAIN)"
+DOMAIN="$(printf '%s' "$DOMAIN" | tr '[:upper:]' '[:lower:]' | sed 's#^https\?://##; s#/.*$##')"
+
+ACME_EMAIL="$(env_get ACME_EMAIL)"
+OC_PASS="$(env_get OPENCODE_SERVER_PASSWORD)"
+# Nilai pengganti supaya saran perintah tetap bisa disalin walau .env belum ada.
+D_ARG="${DOMAIN:-DOMAIN}"
+E_ARG="${ACME_EMAIL:-EMAIL}"
+
+if [ -z "$DOMAIN" ]; then
+  bad "domain belum diketahui (HUB_DOMAIN kosong dan --domain tidak diisi)"
+  hint './doctor.sh --domain opencode.contoh.com'
+  hint "atau isi HUB_DOMAIN di .env lewat: sudo ./install.sh --domain ... --email ..."
+elif [ "$DOMAIN" = "opencode.contoh.com" ]; then
+  bad "HUB_DOMAIN masih nilai contoh: $DOMAIN"
+  hint "ganti: sudo ./install.sh --domain domain-anda.com --email anda@domain-anda.com"
+else
+  ok "domain: $DOMAIN"
+fi
+
+if [ -z "$ACME_EMAIL" ] || [ "$ACME_EMAIL" = "you@example.com" ]; then
+  warn "ACME_EMAIL kosong/masih contoh — Let's Encrypt tidak bisa menerbitkan sertifikat"
+  hint "sudo ./install.sh --domain $D_ARG --email $E_ARG"
+else
+  ok "email ACME: $ACME_EMAIL"
+fi
+
+if [ -z "$OC_PASS" ]; then
+  bad "OPENCODE_SERVER_PASSWORD kosong di .env"
+  hint "jalankan ulang: sudo ./install.sh --domain $D_ARG --email $E_ARG"
+else
+  ok "password server opencode terisi (tidak ditampilkan)"
+fi
+
+if [ -f auth.caddy ] && grep -qE '^[[:space:]]*basic_auth' auth.caddy; then
+  AUTH_USER="$(awk '/basic_auth/{f=1; next} f&&/}/{exit} f&&NF{print $1; exit}' auth.caddy)"
+  ok "login basic auth aktif${AUTH_USER:+ (user: $AUTH_USER)}"
+elif [ -f auth.caddy ]; then
+  warn "auth.caddy tanpa basic_auth: siapa pun yang tahu domain bisa memakai opencode"
+  hint "sudo ./install.sh --domain $D_ARG --email $E_ARG   (membuat password login)"
+else
+  bad "auth.caddy tidak ada — Caddy akan menolak start (import auth.caddy)"
+  hint "sudo ./install.sh --domain $D_ARG --email $E_ARG"
+fi
+
+# --- 2. docker ----------------------------------------------------------------
+section "Docker"
+
+DK="docker"
+HAVE_DOCKER=0
+HAVE_COMPOSE=0
+
+if ! command -v docker >/dev/null 2>&1; then
+  bad "docker tidak terpasang"
+  hint "installer memasangnya otomatis: sudo ./install.sh --domain $D_ARG --email $E_ARG"
+else
+  HAVE_DOCKER=1
+  if docker info >/dev/null 2>&1; then
+    DK="docker"
+    ok "daemon docker jalan (tanpa sudo)"
+  elif [ "$(id -u)" -eq 0 ]; then
+    DK="docker"
+    bad "daemon docker tidak menjawab (walaupun berjalan sebagai root)"
+    hint "sudo systemctl enable --now docker"
+    hint "sudo journalctl -u docker --no-pager -n 50"
+  elif command -v sudo >/dev/null 2>&1 && sudo -n docker info >/dev/null 2>&1; then
+    DK="sudo docker"
+    ok "daemon docker jalan (lewat sudo)"
+  else
+    bad "tidak bisa mengakses daemon docker"
+    hint "jalankan skrip ini dengan sudo: sudo ./doctor.sh"
+    hint "atau: sudo usermod -aG docker \$USER ; lalu logout dan login lagi"
+    hint "kalau service mati: sudo systemctl enable --now docker"
+  fi
+
+  if $DK compose version >/dev/null 2>&1; then
+    HAVE_COMPOSE=1
+    ok "plugin docker compose tersedia"
+  else
+    bad "plugin 'docker compose' tidak tersedia"
+    hint "sudo apt install docker-compose-plugin   (Debian/Ubuntu)"
+  fi
+fi
+
+COMPOSE_OK=0
+[ "$HAVE_DOCKER" -eq 1 ] && [ "$HAVE_COMPOSE" -eq 1 ] && $DK info >/dev/null 2>&1 && COMPOSE_OK=1
+
+# --- 3. container -------------------------------------------------------------
+section "Container"
+
+RUNNING=""
+if [ "$COMPOSE_OK" -eq 1 ]; then
+  PS_OUT="$($DK compose ps --format '{{.Service}}|{{.State}}|{{.Status}}|{{.Health}}' 2>/dev/null || true)"
+  if [ -z "$PS_OUT" ]; then
+    bad "tidak ada container stack ini yang berjalan"
+    hint "cd $(pwd) && sudo docker compose up -d --build"
+    hint "atau lihat sebabnya: sudo docker compose logs --tail=80"
+  else
+    for svc in caddy hub data opencode; do
+      ROW="$(printf '%s\n' "$PS_OUT" | awk -F'|' -v s="$svc" '$1 == s {print; exit}')"
+      if [ -z "$ROW" ]; then
+        bad "container '$svc' tidak ada / tidak jalan"
+        hint "sudo docker compose up -d --build $svc"
+        hint "sudo docker compose logs --tail=50 $svc"
+        continue
+      fi
+      STATE="$(printf '%s' "$ROW" | cut -d'|' -f2)"
+      STATUS="$(printf '%s' "$ROW" | cut -d'|' -f3)"
+      HEALTH="$(printf '%s' "$ROW" | cut -d'|' -f4)"
+
+      if [ "$STATE" != "running" ]; then
+        bad "$svc: state '$STATE' ($STATUS)"
+        case "$STATUS" in
+          *Restarting*) hint "$svc crash-loop. Lihat: sudo docker compose logs --tail=80 $svc" ;;
+          *) hint "sudo docker compose up -d $svc ; sudo docker compose logs --tail=50 $svc" ;;
+        esac
+        continue
+      fi
+
+      RUNNING="$RUNNING $svc"
+      case "$HEALTH" in
+        ""|"<no value>") ok "$svc: running (tanpa healthcheck compose)" ;;
+        healthy) ok "$svc: running, healthy" ;;
+        *) bad "$svc: running tapi health '$HEALTH'"; hint "sudo docker compose logs --tail=50 $svc" ;;
+      esac
+    done
+  fi
+else
+  note "pemeriksaan container dilewati (docker/compose tidak siap)"
+fi
+
+# Probe HTTP internal: membuktikan tiap layanan benar-benar menjawab, bukan cuma hidup.
+if [ "$COMPOSE_OK" -eq 1 ] && [ -n "$RUNNING" ]; then
+  case " $RUNNING " in
+    *" caddy "*)
+      case " $RUNNING " in
+        *" hub "*)
+          if $DK compose exec -T caddy wget -q -T 5 -O /dev/null http://hub:3000/api/health >/dev/null 2>&1; then
+            ok "hub menjawab http://hub:3000/api/health"
+          else
+            bad "caddy tidak bisa menghubungi hub:3000"
+            hint "sudo docker compose logs --tail=80 hub"
+            hint "pastikan container hub ada di network 'edge' (docker compose config)"
+          fi
+          ;;
+      esac
+      ;;
+  esac
+  case " $RUNNING " in
+    *" hub "*)
+      if $DK compose exec -T hub wget -q -T 5 -O /dev/null http://opencode:4096/ >/dev/null 2>&1; then
+        ok "opencode menjawab di :4096 (UI web)"
+      else
+        bad "hub tidak bisa menghubungi opencode:4096"
+        hint "sudo docker compose logs --tail=80 opencode"
+        hint "kalau log menampilkan 'serve' atau 404 di akar, image lama: sudo docker compose build --no-cache opencode && sudo docker compose up -d opencode"
+      fi
+      if $DK compose exec -T hub wget -q -T 5 -O /dev/null http://data:8788/health >/dev/null 2>&1; then
+        ok "server data menjawab di :8788/health"
+      else
+        bad "hub tidak bisa menghubungi data:8788"
+        hint "sudo docker compose logs --tail=80 data"
+      fi
+      ;;
+  esac
+fi
+
+# --- 4. port 80/443 -----------------------------------------------------------
+section "Port 80 dan 443"
+
+if ! command -v ss >/dev/null 2>&1; then
+  warn "perintah 'ss' tidak ada, pemeriksaan port dilewati"
+  hint "sudo apt install iproute2"
+else
+  for p in 80 443; do
+    BUSY_LINE="$(ss -ltnH 2>/dev/null | grep -E "[:.]$p[[:space:]]" | head -n1 || true)"
+    OWNER_LINE="$(ss -ltnpH 2>/dev/null | grep -E "[:.]$p[[:space:]]" | head -n1 || true)"
+    if [ -z "$BUSY_LINE" ]; then
+      bad "tidak ada yang mendengarkan di port $p"
+      if [ "$p" = "80" ]; then
+        hint "port 80 wajib terbuka untuk verifikasi sertifikat (HTTP-01)"
+        hint "kalau provider memblokir 80: pakai DNS-01 atau Cloudflare Tunnel"
+      else
+        hint "container caddy belum jalan: sudo docker compose ps"
+        hint "cek firewall: sudo iptables -S ; sudo ufw status"
+      fi
+      continue
+    fi
+    case "$OWNER_LINE" in
+      *docker-proxy*|*caddy*)
+        ok "port $p dipakai container caddy"
+        ;;
+      "")
+        warn "port $p sudah terpakai, pemilik proses tidak terlihat"
+        hint "ulangi dengan sudo supaya nama prosesnya muncul: sudo ss -ltnp | grep :$p"
+        ;;
+      *)
+        PROC="$(printf '%s' "$OWNER_LINE" | grep -o 'users:(([^)]*)' | head -n1)"
+        bad "port $p dipakai proses lain: ${PROC:-tidak diketahui}"
+        hint "sudo ss -ltnp | grep :$p"
+        hint "hentikan pemakainya, mis. sudo systemctl stop nginx   (atau apache2)"
+        hint "kalau ternyata itu caddy milik stack ini, abaikan saja"
+        ;;
+    esac
+  done
+fi
+
+# --- 5. DNS -------------------------------------------------------------------
+PUBLIC_IP="$(curl -4 -fsS --max-time 8 https://api.ipify.org 2>/dev/null || true)"
+[ -z "$PUBLIC_IP" ] && PUBLIC_IP="$(curl -4 -fsS --max-time 8 https://ifconfig.me/ip 2>/dev/null || true)"
+
+if [ -z "$DOMAIN" ] || [ "$DOMAIN" = "opencode.contoh.com" ]; then
+  section "DNS"
+  note "pemeriksaan DNS dilewati karena domain belum valid"
+else
+  section "DNS: $DOMAIN"
+  RESOLVED="$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' | sed 's/ $//')"
+  PUBLIC_DNS=""
+  if command -v dig >/dev/null 2>&1; then
+    PUBLIC_DNS="$(dig +short A "$DOMAIN" @1.1.1.1 2>/dev/null | grep -E '^[0-9.]+$' | sort -u | tr '\n' ' ' | sed 's/ $//')"
+  fi
+
+  if [ -z "$RESOLVED" ]; then
+    bad "$DOMAIN belum punya record A (resolver server ini tidak menemukannya)"
+    hint "buat di DNS: A  $DOMAIN  ->  ${PUBLIC_IP:-IP-PUBLIK-VPS}"
+    hint "tunggu propagasi (TTL, biasanya 1-10 menit), lalu jalankan lagi"
+    hint "uji dari luar: dig +short $DOMAIN   atau   nslookup $DOMAIN 1.1.1.1"
+  elif [ -z "$PUBLIC_IP" ]; then
+    warn "DNS $DOMAIN -> $RESOLVED, tetapi IP publik server tidak terdeteksi"
+    hint "bandingkan manual dengan IP VPS Anda (ip addr / panel provider)"
+  else
+    case " $RESOLVED " in
+      *" $PUBLIC_IP "*)
+        ok "$DOMAIN -> $RESOLVED (sama dengan IP publik server ini)"
+        ;;
+      *)
+        bad "$DOMAIN -> $RESOLVED, tetapi IP publik server ini $PUBLIC_IP"
+        hint "perbaiki record A menjadi: A  $DOMAIN  ->  $PUBLIC_IP"
+        case " $RESOLVED " in
+          *" 104."*|*" 172.6"*|*" 172.7"*)
+            note "IP 104.x / 172.6x-172.7x biasanya proxy Cloudflare: matikan proxy (awan oranye -> abu-abu)"
+            ;;
+        esac
+        hint "kalau VPS di balik NAT/load balancer, pastikan port 80/443 diteruskan ke server ini"
+        ;;
+    esac
+  fi
+
+  if [ -n "$PUBLIC_DNS" ] && [ -n "$RESOLVED" ] && [ "$PUBLIC_DNS" != "$RESOLVED" ]; then
+    warn "resolver lokal ($RESOLVED) beda dengan 1.1.1.1 ($PUBLIC_DNS): propagasi belum merata"
+    hint "tunggu beberapa menit; Caddy akan mencoba lagi sendiri"
+  fi
+fi
+
+# --- 6. sertifikat HTTPS ------------------------------------------------------
+if [ -z "$DOMAIN" ] || [ "$DOMAIN" = "opencode.contoh.com" ]; then
+  section "Sertifikat HTTPS"
+  note "pemeriksaan sertifikat dilewati karena domain belum valid"
+else
+  section "Sertifikat HTTPS (127.0.0.1:443)"
+  if ! command -v openssl >/dev/null 2>&1; then
+    warn "openssl tidak ada, pemeriksaan sertifikat dilewati"
+    hint "sudo apt install openssl"
+  else
+    TLS_RAW="$(echo | timeout 12 openssl s_client -connect 127.0.0.1:443 -servername "$DOMAIN" 2>/dev/null || true)"
+    if ! printf '%s' "$TLS_RAW" | grep -q 'BEGIN CERTIFICATE'; then
+      bad "TLS di 127.0.0.1:443 tidak memberikan sertifikat"
+      hint "container caddy jalan? sudo docker compose ps caddy"
+      hint "log penerbitan: sudo docker compose logs --tail=80 caddy"
+      hint "kalau log menyebut 'no such host'/'NXDOMAIN', perbaiki DNS dulu (bagian di atas)"
+    else
+      CERT="$(printf '%s\n' "$TLS_RAW" | openssl x509 -noout -subject -issuer -dates 2>/dev/null || true)"
+      SUBJECT="$(printf '%s\n' "$CERT" | sed -n 's/^subject=//p')"
+      ISSUER="$(printf '%s\n' "$CERT" | sed -n 's/^issuer=//p')"
+      NOT_AFTER="$(printf '%s\n' "$CERT" | sed -n 's/^notAfter=//p')"
+      VERIFY="$(printf '%s\n' "$TLS_RAW" | grep -o 'Verify return code: [0-9]* ([^)]*)' | tail -n1 || true)"
+
+      note "subject: ${SUBJECT:-?}"
+      note "issuer : ${ISSUER:-?}"
+      note "berakhir: ${NOT_AFTER:-?}"
+
+      case "$SUBJECT" in
+        *"$DOMAIN"*) ok "sertifikat berlaku untuk $DOMAIN" ;;
+        *) warn "sertifikat tidak menyebut $DOMAIN — kemungkinan domain belum cocok dengan HUB_DOMAIN" ;;
+      esac
+
+      case "$ISSUER" in
+        *"Let's Encrypt"*|*"ZeroSSL"*)
+          ok "sertifikat publik (${ISSUER})"
+          ;;
+        *"Caddy"*|*"local"*|*"Local"*)
+          bad "sertifikat internal Caddy, bukan sertifikat publik"
+          hint "ini terjadi kalau ACME gagal. Lihat: sudo docker compose logs --tail=80 caddy"
+          hint "penyebab umum: DNS belum menunjuk server ini, atau port 80 diblokir"
+          ;;
+        *)
+          warn "penerbit sertifikat tidak dikenali (${ISSUER:-kosong})"
+          ;;
+      esac
+
+      case "$VERIFY" in
+        *"code: 0"*) ok "rantai sertifikat valid di mesin ini" ;;
+        "") note "status verifikasi rantai tidak terbaca" ;;
+        *) warn "verifikasi rantai: $VERIFY"
+           hint "sering karena CA lokal belum dikenal; cek juga dari browser/HP" ;;
+      esac
+
+      END_EPOCH="$(date -d "$NOT_AFTER" +%s 2>/dev/null || true)"
+      NOW_EPOCH="$(date +%s)"
+      if [ -n "$END_EPOCH" ]; then
+        DAYS=$(( (END_EPOCH - NOW_EPOCH) / 86400 ))
+        if [ "$DAYS" -lt 0 ]; then
+          bad "sertifikat sudah kedaluwarsa $((-DAYS)) hari lalu"
+          hint "sudo docker compose restart caddy ; atau sudo docker compose down && sudo docker compose up -d"
+        elif [ "$DAYS" -lt 14 ]; then
+          warn "sertifikat tinggal $DAYS hari — perpanjangan otomatis Caddy mungkin gagal"
+          hint "sudo docker compose logs --tail=80 caddy"
+        else
+          ok "sertifikat masih berlaku $DAYS hari"
+        fi
+      fi
+    fi
+  fi
+fi
+
+# --- 7. HTTP /api/health ------------------------------------------------------
+if [ -z "$DOMAIN" ] || [ "$DOMAIN" = "opencode.contoh.com" ]; then
+  section "HTTP /api/health"
+  note "pemeriksaan HTTP dilewati karena domain belum valid"
+else
+  section "HTTP https://$DOMAIN/api/health"
+
+  CODE_LOCAL="$(curl -s -o "$BODY_FILE" -w '%{http_code}' --max-time 12 \
+    --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/api/health" 2>/dev/null || true)"
+  case "$CODE_LOCAL" in
+    200)
+      ok "200 dari Caddy lokal: $(head -c 200 "$BODY_FILE" 2>/dev/null)"
+      ;;
+    401)
+      ok "401 tanpa password = login basic auth aktif, hub sehat di baliknya"
+      ;;
+    000|"")
+      bad "tidak ada jawaban HTTPS dari Caddy lokal"
+      hint "cek bagian sertifikat/port di atas"
+      hint "sudo docker compose logs --tail=80 caddy"
+      ;;
+    502|503|504)
+      bad "$CODE_LOCAL: Caddy hidup tetapi hub tidak menjawab"
+      hint "sudo docker compose logs --tail=80 hub opencode"
+      hint "sudo docker compose ps hub opencode"
+      ;;
+    404)
+      bad "404 di /api/health — rute hub tidak ada (image hub lama?)"
+      hint "sudo docker compose build --no-cache hub && sudo docker compose up -d hub"
+      ;;
+    *)
+      warn "kode tak terduga dari jalur lokal: $CODE_LOCAL"
+      hint "sudo docker compose logs --tail=80 caddy hub"
+      ;;
+  esac
+
+  # Pengalihan HTTP -> HTTPS (dibutuhkan juga oleh ACME HTTP-01).
+  REDIR_CODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 \
+    --resolve "$DOMAIN:80:127.0.0.1" "http://$DOMAIN/" 2>/dev/null || true)"
+  case "$REDIR_CODE" in
+    301|302|307|308)
+      ok "port 80 mengalihkan ke HTTPS ($REDIR_CODE)"
+      ;;
+    000|"")
+      bad "port 80 tidak menjawab — HTTP-01 bisa gagal"
+      hint "pastikan tidak ada firewall provider yang menutup 80"
+      hint "sudo ss -ltnp | grep :80"
+      ;;
+    *)
+      warn "port 80 menjawab $REDIR_CODE (biasanya 308)"
+      hint "kalau halaman http://$DOMAIN tampil tanpa redirect, cek blok domain di Caddyfile"
+      ;;
+  esac
+
+  # Jalur internet sebenarnya: DNS publik + port terbuka dari luar.
+  CODE_PUBLIC="$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 \
+    "https://$DOMAIN/api/health" 2>/dev/null || true)"
+  case "$CODE_PUBLIC" in
+    200) ok "200 lewat DNS publik (alamat bisa diakses dari internet)" ;;
+    401) ok "401 lewat DNS publik = login aktif, alamat bisa diakses dari internet" ;;
+    000|"")
+      bad "domain tidak bisa dihubungi lewat internet"
+      hint "DNS/port/firewall: cek record A dan port 80/443 di firewall provider"
+      hint "kalau memakai Cloudflare proxy, matikan sementara (awan oranye -> abu-abu)"
+      ;;
+    502|503|504)
+      bad "$CODE_PUBLIC lewat internet — permintaan sampai tapi hub tidak menjawab"
+      hint "sudo docker compose logs --tail=80 caddy hub"
+      ;;
+    *)
+      warn "kode $CODE_PUBLIC lewat internet (lokal: ${CODE_LOCAL:-?})"
+      hint "bandingkan dengan hasil di browser; cek log caddy"
+      ;;
+  esac
+fi
+
+# --- 8. ringkasan -------------------------------------------------------------
+section "Ringkasan"
+if [ "$FAILS" -eq 0 ]; then
+  if [ "$WARNS" -eq 0 ]; then
+    echo "Semua pemeriksaan lolos. Buka https://$DOMAIN dan login."
+  else
+    echo "Tidak ada kegagalan, tetapi ada $WARNS peringatan — lihat baris [WARN] di atas."
+  fi
+  exit 0
+fi
+
+echo "$FAILS pemeriksaan gagal, $WARNS peringatan."
+echo
+echo "Urutan perbaikan yang paling sering menyelesaikan:"
+echo "  1. DNS     : A  ${DOMAIN:-domain-anda.com}  ->  ${PUBLIC_IP:-IP-PUBLIK-VPS}"
+echo "  2. Port    : pastikan 80 dan 443 bebas (hentikan nginx/apache) dan dibuka firewall"
+echo "  3. Stack   : sudo docker compose up -d --build"
+echo "  4. Log     : sudo docker compose logs --tail=80 caddy hub opencode"
+echo "  5. Ulangi  : sudo ./doctor.sh"
+echo
+echo "Panduan lengkap: deploy/README.md (bagian Troubleshooting)."
+exit 1
diff --git a/opencode-hub/deploy/install.sh b/opencode-hub/deploy/install.sh
new file mode 100755
index 0000000000..101f91bf55
--- /dev/null
+++ b/opencode-hub/deploy/install.sh
@@ -0,0 +1,316 @@
+#!/usr/bin/env bash
+# install.sh — satu perintah untuk VPS baru:
+#   1. memasang Docker + plugin compose (kalau belum ada)
+#   2. mengisi deploy/.env (domain, email ACME, password server opencode)
+#   3. menulis deploy/auth.caddy (login basic auth untuk domain Anda)
+#   4. menjalankan Caddy + hub + data + opencode lewat docker compose
+#
+# Contoh:
+#   sudo ./install.sh --domain opencode.contoh.com --email saya@contoh.com
+#   ./install.sh --help
+set -euo pipefail
+cd "$(dirname "$0")"
+
+DOMAIN=""
+EMAIL=""
+AUTH_USER="admin"
+AUTH_PASSWORD=""
+ENABLE_AUTH=1
+WITH_HERMES=0
+SKIP_DNS=0
+ASSUME_YES=0
+FORCE=0
+
+usage() {
+  cat <<'EOF'
+Pemakaian: ./install.sh [opsi]
+
+  --domain NAMA          domain yang dipakai, mis. opencode.contoh.com
+  --email ALAMAT         email untuk Let's Encrypt (ACME)
+  --auth-user NAMA       user login basic auth (default: admin)
+  --auth-password PASS   password login; kalau tidak diisi, dibuatkan acak
+  --no-auth              jangan pasang basic auth (SIAPA PUN bisa memakai opencode)
+  --hermes               sekaligus build image Hermes Agent (setup manual sesudahnya)
+  --skip-dns-check       lewati pemeriksaan record A (DNS belum propagasi)
+  -y, --yes              jangan bertanya, pakai default
+  --force                tetap lanjut walau port 80/443 terpakai atau DNS tidak cocok
+  -h, --help             tampilkan bantuan ini
+
+Tanpa opsi, skrip menanyakan domain dan email. Password opencode untuk API
+dibuat otomatis dan hanya disimpan di deploy/.env (mode 600).
+EOF
+}
+
+info() { printf '[deploy] %s\n' "$*"; }
+warn() { printf '[deploy] peringatan: %s\n' "$*" >&2; }
+die() { printf '[deploy] GAGAL: %s\n' "$*" >&2; exit 1; }
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --domain) DOMAIN="${2:?--domain butuh nilai}"; shift 2 ;;
+    --domain=*) DOMAIN="${1#*=}"; shift ;;
+    --email) EMAIL="${2:?--email butuh nilai}"; shift 2 ;;
+    --email=*) EMAIL="${1#*=}"; shift ;;
+    --auth-user) AUTH_USER="${2:?--auth-user butuh nilai}"; shift 2 ;;
+    --auth-password) AUTH_PASSWORD="${2:?--auth-password butuh nilai}"; shift 2 ;;
+    --no-auth) ENABLE_AUTH=0; shift ;;
+    --hermes) WITH_HERMES=1; shift ;;
+    --skip-dns-check) SKIP_DNS=1; shift ;;
+    -y|--yes) ASSUME_YES=1; shift ;;
+    --force) FORCE=1; shift ;;
+    -h|--help) usage; exit 0 ;;
+    *) usage >&2; die "opsi tidak dikenal: $1" ;;
+  esac
+done
+
+# --- 1. hak akses -------------------------------------------------------------
+if [ "$(id -u)" -eq 0 ]; then
+  SUDO=""
+else
+  command -v sudo >/dev/null 2>&1 || die "jalankan sebagai root, atau pasang sudo dulu"
+  SUDO="sudo"
+fi
+
+install_pkg() {
+  local pkgs=("$@")
+  if command -v apt-get >/dev/null 2>&1; then
+    $SUDO apt-get update -y && $SUDO apt-get install -y "${pkgs[@]}"
+  elif command -v dnf >/dev/null 2>&1; then
+    $SUDO dnf install -y "${pkgs[@]}"
+  elif command -v yum >/dev/null 2>&1; then
+    $SUDO yum install -y "${pkgs[@]}"
+  elif command -v zypper >/dev/null 2>&1; then
+    $SUDO zypper --non-interactive install "${pkgs[@]}"
+  else
+    die "tidak tahu cara memasang paket di distro ini; pasang manual: ${pkgs[*]}"
+  fi
+}
+
+# --- 2. Docker ----------------------------------------------------------------
+if ! command -v docker >/dev/null 2>&1; then
+  info "Docker belum ada — memasang dari https://get.docker.com"
+  command -v curl >/dev/null 2>&1 || install_pkg curl
+  curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
+  $SUDO sh /tmp/get-docker.sh
+  rm -f /tmp/get-docker.sh
+  if [ -n "$SUDO" ] && ! id -nG "$USER" 2>/dev/null | grep -qw docker; then
+    $SUDO usermod -aG docker "$USER" || true
+    info "user $USER ditambahkan ke grup docker (aktif setelah login ulang)"
+  fi
+fi
+
+# Pakai sudo kalau daemon docker belum bisa diakses user ini.
+if docker info >/dev/null 2>&1; then
+  DK="docker"
+else
+  $SUDO docker info >/dev/null 2>&1 || die "daemon docker tidak jalan. Coba: sudo systemctl enable --now docker"
+  DK="$SUDO docker"
+fi
+
+$DK compose version >/dev/null 2>&1 || die \
+  "plugin 'docker compose' tidak ada. Pasang: sudo apt install docker-compose-plugin (Debian/Ubuntu) atau lihat https://docs.docker.com/compose/install/linux/"
+
+command -v curl >/dev/null 2>&1 || install_pkg curl
+
+# --- 3. port 80/443 harus bebas ----------------------------------------------
+port_busy() {
+  command -v ss >/dev/null 2>&1 || return 1
+  ss -ltnH 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$1\$"
+}
+BUSY=""
+for p in 80 443; do
+  port_busy "$p" && BUSY="$BUSY $p"
+done
+if [ -n "$BUSY" ]; then
+  if [ "$FORCE" -eq 1 ]; then
+    warn "port$BUSY sudah dipakai proses lain — lanjut karena --force"
+  else
+    die "port$BUSY sudah dipakai proses lain (nginx/apache/caddy lama?). Hentikan dulu, atau pakai --force kalau itu Caddy milik stack ini."
+  fi
+fi
+
+# --- 4. domain + email --------------------------------------------------------
+ask() {
+  local prompt=$1 default=${2:-} answer=""
+  if [ -n "$default" ]; then
+    read -r -p "$prompt [$default]: " answer || true
+  else
+    read -r -p "$prompt: " answer || true
+  fi
+  printf '%s' "${answer:-$default}"
+}
+
+ask_secret() {
+  local prompt=$1 answer=""
+  read -r -s -p "$prompt: " answer || true
+  printf '\n' >&2
+  printf '%s' "$answer"
+}
+
+if [ -z "$DOMAIN" ]; then
+  if [ ! -t 0 ] || [ "$ASSUME_YES" -eq 1 ]; then
+    die "domain belum diisi. Jalankan: ./install.sh --domain opencode.contoh.com --email anda@contoh.com"
+  fi
+  DOMAIN="$(ask 'Domain (mis. opencode.contoh.com)')"
+fi
+DOMAIN="$(printf '%s' "$DOMAIN" | tr '[:upper:]' '[:lower:]' | sed 's#^https\?://##; s#/.*$##')"
+printf '%s' "$DOMAIN" | grep -Eq '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$' \
+  || die "domain tidak valid: '$DOMAIN' (contoh yang benar: opencode.contoh.com)"
+
+if [ -z "$EMAIL" ]; then
+  if [ -t 0 ] && [ "$ASSUME_YES" -eq 0 ]; then
+    EMAIL="$(ask 'Email untuk sertifikat HTTPS (Let'"'"'s Encrypt)')"
+  else
+    die "email belum diisi. Tambahkan --email anda@contoh.com"
+  fi
+fi
+case "$EMAIL" in
+  *@*.*) ;;
+  *) die "email tidak valid: '$EMAIL'" ;;
+esac
+
+# --- 5. DNS harus menunjuk ke server ini -------------------------------------
+if [ "$SKIP_DNS" -eq 0 ]; then
+  info "memeriksa DNS $DOMAIN"
+  RESOLVED="$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' | sed 's/ $//' || true)"
+  if [ -z "$RESOLVED" ]; then
+    die "DNS $DOMAIN belum punya record A. Buat dulu: A $DOMAIN -> IP publik VPS ini, tunggu propagasi, lalu jalankan lagi. (Paksa lewat: --skip-dns-check)"
+  fi
+  PUBLIC_IP="$(curl -4 -fsS --max-time 8 https://api.ipify.org 2>/dev/null || true)"
+  if [ -z "$PUBLIC_IP" ]; then
+    warn "IP publik server tidak terdeteksi; DNS tidak bisa dicocokkan"
+  else
+    case " $RESOLVED " in
+      *" $PUBLIC_IP "*) info "DNS cocok: $DOMAIN -> $PUBLIC_IP" ;;
+      *)
+        if [ "$FORCE" -eq 1 ]; then
+          warn "DNS $DOMAIN -> $RESOLVED, IP server $PUBLIC_IP (lanjut karena --force)"
+        else
+          die "DNS $DOMAIN -> $RESOLVED, tetapi IP publik server ini $PUBLIC_IP. Perbaiki record A dulu, atau pakai --force / --skip-dns-check."
+        fi
+        ;;
+    esac
+  fi
+fi
+
+# --- 6. .env ------------------------------------------------------------------
+umask 077
+if [ -f .env ]; then
+  BACKUP=".env.bak.$(date +%Y%m%d%H%M%S)"
+  cp .env "$BACKUP"
+  info ".env sudah ada — disimpan cadangannya di $BACKUP"
+else
+  cp .env.example .env
+  info ".env dibuat dari .env.example"
+fi
+
+set_env() { # set_env KEY VALUE  -> upsert satu baris, aman untuk nilai apa pun
+  local key=$1 value=$2
+  if grep -qE "^${key}=" .env; then
+    awk -v k="$key" -v v="$value" '$0 ~ "^"k"=" {print k"="v; next} {print}' .env > .env.tmp
+    mv .env.tmp .env
+  else
+    printf '%s=%s\n' "$key" "$value" >> .env
+  fi
+}
+
+gen_pass() {
+  if command -v openssl >/dev/null 2>&1; then
+    openssl rand -base64 32 | tr -d '/+=\n'
+  else
+    head -c 32 /dev/urandom | base64 | tr -d '/+=\n'
+  fi
+}
+
+set_env HUB_DOMAIN "$DOMAIN"
+set_env ACME_EMAIL "$EMAIL"
+
+CUR_PASS="$(grep -E '^OPENCODE_SERVER_PASSWORD=' .env | head -n1 | cut -d= -f2- || true)"
+if [ -z "$CUR_PASS" ]; then
+  set_env OPENCODE_SERVER_PASSWORD "$(gen_pass)"
+  info "password API opencode dibuat acak dan disimpan di deploy/.env (mode 600)"
+fi
+chmod 600 .env
+
+# --- 7. login basic auth di Caddy --------------------------------------------
+AUTH_GENERATED=0
+if [ "$ENABLE_AUTH" -eq 1 ]; then
+  if [ -z "$AUTH_PASSWORD" ] && [ -t 0 ] && [ "$ASSUME_YES" -eq 0 ]; then
+    AUTH_PASSWORD="$(ask_secret "Password login https://$DOMAIN (kosongkan = dibuatkan acak)")"
+  fi
+  if [ -z "$AUTH_PASSWORD" ]; then
+    AUTH_PASSWORD="$(gen_pass)"
+    AUTH_GENERATED=1
+  fi
+  info "membuat hash password login (butuh image caddy:2-alpine)"
+  HASH="$($DK run --rm caddy:2-alpine caddy hash-password --plaintext "$AUTH_PASSWORD" | tr -d '\r\n')"
+  case "$HASH" in
+    \$2*) ;;
+    *) die "gagal membuat hash password Caddy (keluaran: '$HASH')" ;;
+  esac
+  {
+    printf '# Dibuat otomatis oleh install.sh. Jalankan ulang install.sh untuk mengganti password.\n'
+    printf 'basic_auth {\n\t%s %s\n}\n' "$AUTH_USER" "$HASH"
+  } > auth.caddy
+  chmod 600 auth.caddy
+  info "basic auth aktif untuk user '$AUTH_USER'"
+else
+  printf '# Basic auth dimatikan (install.sh --no-auth). Siapa pun bisa memakai opencode di domain ini.\n' > auth.caddy
+  warn "basic auth dimatikan: domain Anda terbuka untuk siapa saja yang tahu alamatnya"
+fi
+
+# --- 8. jalankan stack --------------------------------------------------------
+info "build + start: caddy, hub, data, opencode"
+$DK compose up -d --build caddy hub data opencode
+
+if [ "$WITH_HERMES" -eq 1 ]; then
+  info "build image Hermes Agent (tanpa start; setup butuh terminal interaktif)"
+  $DK compose --profile hermes build hermes
+fi
+
+# --- 9. tunggu sertifikat + health -------------------------------------------
+CURL_AUTH=()
+[ "$ENABLE_AUTH" -eq 1 ] && CURL_AUTH=(-u "$AUTH_USER:$AUTH_PASSWORD")
+
+info "menunggu https://$DOMAIN siap (sertifikat Let's Encrypt bisa butuh ~30 detik)"
+READY=0
+for _ in $(seq 1 60); do
+  CODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 \
+    --resolve "$DOMAIN:443:127.0.0.1" "${CURL_AUTH[@]}" \
+    "https://$DOMAIN/api/health" 2>/dev/null || true)"
+  if [ "$CODE" = "200" ]; then READY=1; break; fi
+  sleep 3
+done
+
+echo
+if [ "$READY" -eq 1 ]; then
+  echo "=== Selesai — opencode sudah online di domain Anda ==="
+else
+  echo "=== Stack sudah jalan, tetapi https://$DOMAIN belum menjawab 200 ==="
+  echo "Cek log sertifikat:  $DK compose logs --tail=50 caddy"
+fi
+echo "URL        : https://$DOMAIN"
+if [ "$ENABLE_AUTH" -eq 1 ]; then
+  echo "Login      : user '$AUTH_USER'"
+  if [ "$AUTH_GENERATED" -eq 1 ]; then
+    echo "Password   : $AUTH_PASSWORD"
+    echo "             (hanya ditampilkan sekali; ganti dengan menjalankan install.sh lagi)"
+  else
+    echo "Password   : yang Anda masukkan tadi"
+  fi
+else
+  echo "Login      : tidak ada (--no-auth)"
+fi
+echo
+echo "Perintah harian (jalankan di folder ini):"
+echo "  $DK compose ps"
+echo "  $DK compose logs -f hub opencode caddy"
+echo "  $DK compose up -d --build          # update"
+echo "  $DK compose restart                # restart"
+echo "  $DK compose down                   # stop (volume tetap)"
+if [ "$WITH_HERMES" -eq 1 ]; then
+  echo
+  echo "Hermes Agent (image sudah dibangun, belum start):"
+  echo "  $DK compose run --rm -it hermes hermes setup"
+  echo "  $DK compose --profile hermes up -d hermes"
+fi
diff --git a/opencode-hub/hub-server.mjs b/opencode-hub/hub-server.mjs
new file mode 100644
index 0000000000..ce97b5faef
--- /dev/null
+++ b/opencode-hub/hub-server.mjs
@@ -0,0 +1,289 @@
+/**
+ * opencode-hub — server halaman (port 3000).
+ *
+ * Menyajikan:
+ *  - halaman dashboard (public/)
+ *  - /api/state        : status server opencode + status server data
+ *  - /api/resources    : proxy ke server data (port terpisah)
+ *  - /api/opencode/sessions : daftar sesi opencode (read-only)
+ *
+ * Server opencode TIDAK diproksi mentah-mentah: hanya endpoint read-only yang
+ * dibutuhkan halaman ini. API opencode memberi kendali penuh atas filesystem
+ * dan sesi agen, jadi jangan pernah diekspos publik tanpa OPENCODE_SERVER_PASSWORD.
+ */
+import { createServer, request as httpRequest } from "node:http";
+import { readFile } from "node:fs/promises";
+import { fileURLToPath } from "node:url";
+import { dirname, join } from "node:path";
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+
+const HUB_PORT = Number(process.env.HUB_PORT ?? 3000);
+const HUB_HOST = process.env.HUB_HOST ?? "0.0.0.0";
+const OPENCODE_URL = (process.env.OPENCODE_URL ?? "http://127.0.0.1:4096").replace(/\/+$/, "");
+const OPENCODE_PASSWORD = process.env.OPENCODE_SERVER_PASSWORD ?? "";
+const DATA_URL = (process.env.DATA_URL ?? "http://127.0.0.1:8788").replace(/\/+$/, "");
+const STARTED_AT = new Date();
+
+const PUBLIC_FILES = new Map([
+  ["/chat", { file: "chat.html", type: "text/html; charset=utf-8" }],
+  ["/hub", { file: "index.html", type: "text/html; charset=utf-8" }],
+  ["/hub/", { file: "index.html", type: "text/html; charset=utf-8" }],
+  ["/styles.css", { file: "styles.css", type: "text/css; charset=utf-8" }],
+  ["/app.js", { file: "app.js", type: "text/javascript; charset=utf-8" }],
+]);
+
+/** Password opencode dipakai hub sendiri, jadi UI di akar origin tidak perlu login. */
+const OPENCODE_AUTH = OPENCODE_PASSWORD
+  ? `Basic ${Buffer.from(`opencode:${OPENCODE_PASSWORD}`).toString("base64")}`
+  : null;
+
+async function getJson(url, timeoutMs = 2500, headers = {}) {
+  const started = Date.now();
+  try {
+    const res = await fetch(url, {
+      headers: { accept: "application/json", ...headers },
+      signal: AbortSignal.timeout(timeoutMs),
+    });
+    const text = await res.text();
+    let body = null;
+    try {
+      body = text ? JSON.parse(text) : null;
+    } catch {
+      body = text.slice(0, 200);
+    }
+    return { ok: res.ok, status: res.status, body, latencyMs: Date.now() - started };
+  } catch (error) {
+    return { ok: false, status: 0, body: null, latencyMs: Date.now() - started, error: error.name };
+  }
+}
+
+/** opencode accepts the password as a bearer token; basic auth is the fallback. */
+function authVariants() {
+  if (!OPENCODE_PASSWORD) return [{}];
+  return [
+    { authorization: `Bearer ${OPENCODE_PASSWORD}` },
+    { authorization: `Basic ${Buffer.from(`opencode:${OPENCODE_PASSWORD}`).toString("base64")}` },
+  ];
+}
+
+async function probeOpencode(path) {
+  let last;
+  for (const headers of authVariants()) {
+    last = await getJson(`${OPENCODE_URL}${path}`, 2500, headers);
+    if (last.status !== 401) return last;
+  }
+  return last;
+}
+
+async function buildState() {
+  const [health, sessions, dataHealth] = await Promise.all([
+    probeOpencode("/global/health"),
+    probeOpencode("/session"),
+    getJson(`${DATA_URL}/health`),
+  ]);
+
+  const sessionList = Array.isArray(sessions.body) ? sessions.body : [];
+
+  return {
+    checkedAt: new Date().toISOString(),
+    hub: {
+      uptimeSeconds: Math.round(process.uptime()),
+      startedAt: STARTED_AT.toISOString(),
+      port: HUB_PORT,
+      node: process.version,
+    },
+    opencode: {
+      url: OPENCODE_URL,
+      reachable: health.ok,
+      healthy: health.body?.healthy === true,
+      version: health.body?.version ?? null,
+      passwordProtected: OPENCODE_PASSWORD.length > 0,
+      sessionCount: sessionList.length,
+      latencyMs: health.latencyMs,
+      httpStatus: health.status,
+      error: health.error ?? null,
+    },
+    data: {
+      url: DATA_URL,
+      reachable: dataHealth.ok,
+      uptimeSeconds: dataHealth.body?.uptimeSeconds ?? null,
+      groups: dataHealth.body?.groups ?? null,
+      resources: dataHealth.body?.resources ?? null,
+      latencyMs: dataHealth.latencyMs,
+      error: dataHealth.error ?? null,
+    },
+  };
+}
+
+let cache = { at: 0, value: null };
+async function state() {
+  if (cache.value && Date.now() - cache.at < 2000) return cache.value;
+  cache = { at: Date.now(), value: await buildState() };
+  return cache.value;
+}
+
+/**
+ * Pintu /oc: memproksi UI web opencode lewat port hub, supaya bisa dibuka dari satu
+ * origin. Browser tetap harus mengirim Basic auth (user "opencode" + password server),
+ * dan header itu diteruskan apa adanya ke opencode — password tidak pernah disuntikkan
+ * oleh hub, jadi tidak ada jalan masuk tanpa kredensial.
+ */
+function basicAuthOk(req) {
+  if (!OPENCODE_PASSWORD) return true;
+  const match = /^Basic (.+)$/i.exec(req.headers.authorization ?? "");
+  if (!match) return false;
+  const decoded = Buffer.from(match[1], "base64").toString();
+  const separator = decoded.indexOf(":");
+  if (separator < 0) return false;
+  return decoded.slice(0, separator) === "opencode" && decoded.slice(separator + 1) === OPENCODE_PASSWORD;
+}
+
+function requireAuth(res) {
+  res.writeHead(401, {
+    "www-authenticate": 'Basic realm="OpenCode", charset="UTF-8"',
+    "content-type": "text/plain; charset=utf-8",
+    "cache-control": "no-store",
+  });
+  res.end("Butuh password server opencode (user: opencode).\n");
+}
+
+function proxyOpencode(req, res, upstreamPath) {
+  const target = new URL(OPENCODE_URL);
+  const headers = { ...req.headers, host: target.host };
+  if (OPENCODE_AUTH) headers.authorization = OPENCODE_AUTH;
+  const upstream = httpRequest(
+    {
+      protocol: target.protocol,
+      hostname: target.hostname,
+      port: target.port || 80,
+      path: upstreamPath,
+      method: req.method,
+      headers,
+    },
+    (up) => {
+      res.writeHead(up.statusCode ?? 502, up.headers);
+      up.pipe(res);
+    },
+  );
+  upstream.on("error", (error) => {
+    console.error("[hub] proxy opencode gagal", error.message);
+    if (!res.headersSent) json(res, 502, { error: "opencode_unreachable", detail: error.message });
+    else res.end();
+  });
+  req.pipe(upstream);
+}
+
+function json(res, status, body) {
+  const payload = JSON.stringify(body);
+  res.writeHead(status, {
+    "content-type": "application/json; charset=utf-8",
+    "content-length": Buffer.byteLength(payload),
+    "cache-control": "no-store",
+  });
+  res.end(payload);
+}
+
+const server = createServer(async (req, res) => {
+  const url = new URL(req.url ?? "/", `http://${req.headers.host ?? "localhost"}`);
+
+  try {
+    if (url.pathname === "/api/state") {
+      return json(res, 200, await state());
+    }
+
+    if (url.pathname === "/api/resources") {
+      const upstream = await getJson(`${DATA_URL}/api/resources`, 3000);
+      if (!upstream.ok) {
+        return json(res, 502, {
+          error: "data_server_unreachable",
+          url: DATA_URL,
+          detail: upstream.error ?? upstream.status,
+        });
+      }
+      return json(res, 200, upstream.body);
+    }
+
+    if (url.pathname === "/api/opencode/sessions") {
+      const upstream = await probeOpencode("/session");
+      if (!upstream.ok) {
+        return json(res, 502, {
+          error: "opencode_unreachable",
+          url: OPENCODE_URL,
+          detail: upstream.error ?? upstream.status,
+        });
+      }
+      const list = (Array.isArray(upstream.body) ? upstream.body : []).slice(0, 20).map((s) => ({
+        id: s.id,
+        title: s.title ?? "(tanpa judul)",
+        updated: s.time?.updated ?? null,
+      }));
+      return json(res, 200, { url: OPENCODE_URL, count: list.length, sessions: list });
+    }
+
+    if (url.pathname === "/api/health") {
+      return json(res, 200, { ok: true, service: "opencode-hub", uptimeSeconds: Math.round(process.uptime()) });
+    }
+
+    // UI opencode asli dilayani di akar origin.
+    if (url.pathname === "/oc" || url.pathname === "/app") {
+      res.writeHead(302, { location: "/", "cache-control": "no-store" });
+      return res.end();
+    }
+
+    const asset = PUBLIC_FILES.get(url.pathname);
+    if (asset) {
+      const body = await readFile(join(__dirname, "public", asset.file));
+      res.writeHead(200, {
+        "content-type": asset.type,
+        "content-length": body.length,
+        "cache-control": "no-store",
+      });
+      return res.end(body);
+    }
+
+    // Sisanya milik opencode: /, /assets/*, /favicon*, /session, /event, dan rute SPA-nya.
+    return proxyOpencode(req, res, req.url ?? "/");
+  } catch (error) {
+    console.error("[hub] request failed", error);
+    return json(res, 500, { error: "internal_error" });
+  }
+});
+
+// WebSocket/upgrade (kalau UI opencode memakainya) ikut diteruskan, tetap dengan auth.
+server.on("upgrade", (req, socket, head) => {
+  const target = new URL(OPENCODE_URL);
+  const upstreamHeaders = { ...req.headers, host: target.host };
+  if (OPENCODE_AUTH) upstreamHeaders.authorization = OPENCODE_AUTH;
+  const upstream = httpRequest({
+    protocol: target.protocol,
+    hostname: target.hostname,
+    port: target.port || 80,
+    path: (req.url ?? "/").replace(/^\/oc(?=\/|$)/, "") || "/",
+    method: req.method,
+    headers: upstreamHeaders,
+  });
+  upstream.on("upgrade", (up, upSocket, upHead) => {
+    socket.write("HTTP/1.1 101 Switching Protocols\r\n" + Object.entries(up.headers).map(([k, v]) => `${k}: ${v}`).join("\r\n") + "\r\n\r\n");
+    if (upHead?.length) socket.write(upHead);
+    upSocket.pipe(socket).pipe(upSocket);
+  });
+  upstream.on("error", () => socket.destroy());
+  upstream.end();
+});
+
+server.listen(HUB_PORT, HUB_HOST, () => {
+  console.log(`[hub] page on http://${HUB_HOST}:${HUB_PORT} (pid ${process.pid})`);
+  console.log(`[hub] opencode target: ${OPENCODE_URL}${OPENCODE_PASSWORD ? " (password set)" : ""}`);
+  console.log(`[hub] data   target: ${DATA_URL}`);
+  console.log(`[hub] UI opencode asli di / (akar origin)`);
+  console.log(`[hub] chat ringkas buatan hub di /chat`);
+  console.log(`[hub] dashboard hub di /hub`);
+});
+
+for (const signal of ["SIGINT", "SIGTERM"]) {
+  process.on(signal, () => {
+    console.log(`[hub] ${signal} -> shutdown`);
+    server.close(() => process.exit(0));
+  });
+}
