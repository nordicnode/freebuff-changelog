diff --git a/cli/src/components/__tests__/multiline-input.test.tsx b/cli/src/components/__tests__/multiline-input.test.tsx
index 7fcf7eaa17..6f994713fc 100644
--- a/cli/src/components/__tests__/multiline-input.test.tsx
+++ b/cli/src/components/__tests__/multiline-input.test.tsx
@@ -1130,3 +1130,145 @@ describe('MultilineInput - newline keyboard shortcuts', () => {
     expect(isAltModifier({ option: false })).toBe(false)
   })
 })
+
+/**
+ * Tests for Vietnamese IME compose-and-replace input handling.
+ *
+ * Vietnamese IMEs (Unikey, EVKey) replace the base char with the accented
+ * version by sending two events per diacritic keystroke:
+ *   1. backspace ('\x7f') — delete the base char
+ *   2. composed char ('à') — insert the accented version
+ *
+ * These arrive in a single stdin chunk and fire as separate key events within
+ * one React batch. The handlers must read from synchronous refs (not stale
+ * props) so that event N+1 sees the result of event N.
+ *
+ * Without ref-based reads, backspace operates on the stale prop value (before
+ * the batch started), so the base char is never removed — producing "chaà"
+ * instead of "chà".
+ */
+describe('MultilineInput - Vietnamese IME compose-and-replace', () => {
+  /**
+   * Simulates the ref-based state pattern from multiline-input.tsx.
+   * onChange callbacks are deferred (batched), refs are updated synchronously.
+   */
+  function createBatchedState(initial: string, initialCursor: number) {
+    let state = { text: initial, cursorPosition: initialCursor }
+    const valueRef = { current: initial }
+    const cursorRef = { current: initialCursor }
+    const pendingChanges: Array<{ text: string; cursorPosition: number }> = []
+
+    const onChange = (v: { text: string; cursorPosition: number }) => {
+      pendingChanges.push(v)
+      // Simulate React batching: state does NOT update until flush
+    }
+
+    const flush = () => {
+      const last = pendingChanges[pendingChanges.length - 1]
+      if (last) state = last
+      pendingChanges.length = 0
+      // Simulate React re-render: refs refreshed from props
+      valueRef.current = state.text
+      cursorRef.current = state.cursorPosition
+    }
+
+    // Mirrors insertTextAtCursor: reads refs, updates refs before onChange
+    const insertText = (text: string) => {
+      const v = valueRef.current
+      const c = cursorRef.current
+      const newText = v.slice(0, c) + text + v.slice(c)
+      valueRef.current = newText
+      cursorRef.current = c + text.length
+      onChange({ text: newText, cursorPosition: c + text.length })
+    }
+
+    // Mirrors handleDeletionKeys backspace (fixed version):
+    // reads refs, updates refs before onChange
+    const backspace = () => {
+      const v = valueRef.current
+      const c = cursorRef.current
+      if (c > 0) {
+        const newText = v.slice(0, c - 1) + v.slice(c)
+        valueRef.current = newText
+        cursorRef.current = c - 1
+        onChange({ text: newText, cursorPosition: c - 1 })
+      }
+    }
+
+    // Simulates the OLD buggy backspace: reads from a stale snapshot (props)
+    // instead of refs. Only used to verify the regression.
+    const staleBackspace = (staleText: string, staleCursor: number) => {
+      if (staleCursor > 0) {
+        const newText = staleText.slice(0, staleCursor - 1) + staleText.slice(staleCursor)
+        onChange({ text: newText, cursorPosition: staleCursor - 1 })
+        // Note: valueRef and cursorRef are NOT updated (old code path)
+      }
+    }
+
+    const getState = () => state
+    return { insertText, backspace, staleBackspace, flush, getState, valueRef, cursorRef }
+  }
+
+  test('IME DEL+à after "cha" produces "chà" (ref-based backspace)', () => {
+    const s = createBatchedState('', 0)
+
+    for (const ch of 'cha') s.insertText(ch)
+
+    // IME compose-and-replace: DEL, then 'à' — both in one batch
+    s.backspace()
+    s.insertText('à')
+
+    s.flush()
+
+    expect(s.getState().text).toBe('chà')
+    expect(s.getState().cursorPosition).toBe('chà'.length)
+  })
+
+  test('IME DEL+à after "xin cha" produces "xin chà"', () => {
+    const s = createBatchedState('', 0)
+
+    for (const ch of 'xin cha') s.insertText(ch)
+
+    s.backspace()
+    s.insertText('à')
+
+    s.flush()
+
+    expect(s.getState().text).toBe('xin chà')
+  })
+
+  test('stale backspace produces "chaà" (regression guard)', () => {
+    const s = createBatchedState('', 0)
+
+    for (const ch of 'cha') s.insertText(ch)
+
+    // Simulate OLD bug: backspace reads stale props (text='cha', cursor=3)
+    // instead of refs. After the batch, refs are 'cha'/3 (no prior event).
+    s.staleBackspace('cha', 3)
+    // refs NOT updated — still 'cha'/3
+    s.insertText('à')
+
+    s.flush()
+
+    // Stale backspace deleted from 'cha' → 'ch', but valueRef still 'cha',
+    // so 'à' inserted at cursor 3 → 'chaà'
+    expect(s.getState().text).toBe('chaà')
+  })
+
+  test('multiple IME diacritics across batches', () => {
+    const s = createBatchedState('', 0)
+
+    // Type "cha" then accent to "chà"
+    for (const ch of 'cha') s.insertText(ch)
+    s.backspace()
+    s.insertText('à')
+    s.flush()
+
+    // Continue: "o" → "chào"
+    s.insertText('o')
+    s.flush()
+
+    expect(s.getState().text).toBe('chào')
+    expect(s.getState().cursorPosition).toBe('chào'.length)
+  })
+})
