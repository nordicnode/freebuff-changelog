@@ -0,0 +1,92 @@
+import { describe, test, expect, beforeEach } from 'bun:test'
+
+import {
+  requestShellApproval,
+  submitShellApproval,
+  cancelAllShellApprovals,
+  getActiveShellApproval,
+  __resetShellApprovalBridge,
+} from '../shell-approval-bridge'
+
+function req(id: string, extra: Partial<Parameters<typeof requestShellApproval>[0]> = {}) {
+  return { id, command: 'echo hi', cwd: '/tmp/p', processType: 'SYNC' as const, ...extra }
+}
+
+describe('shell-approval-bridge', () => {
+  beforeEach(() => __resetShellApprovalBridge())
+
+  test('approve resolves only the matching id', async () => {
+    const p = requestShellApproval(req('a'))
+    expect(getActiveShellApproval()?.id).toBe('a')
+    expect(submitShellApproval('wrong', 'approve')).toBe(false)
+    expect(submitShellApproval('a', 'approve')).toBe(true)
+    expect(await p).toBe('approve')
+  })
+
+  test('deny resolves deny', async () => {
+    const p = requestShellApproval(req('a'))
+    submitShellApproval('a', 'deny')
+    expect(await p).toBe('deny')
+  })
+
+  test('timeout resolves deny without any submit', async () => {
+    const p = requestShellApproval(req('a'), { timeoutMs: 10 })
+    expect(await p).toBe('deny')
+  })
+
+  test('abort resolves deny', async () => {
+    const controller = new AbortController()
+    const p = requestShellApproval(req('a', { signal: controller.signal }))
+    controller.abort()
+    expect(await p).toBe('deny')
+  })
+
+  test('already-aborted signal denies without queueing', async () => {
+    const controller = new AbortController()
+    controller.abort()
+    const p = requestShellApproval(req('a', { signal: controller.signal }))
+    expect(await p).toBe('deny')
+    expect(getActiveShellApproval()).toBeNull()
+  })
+
+  test('two concurrent requests: neither is lost; FIFO order', async () => {
+    const p1 = requestShellApproval(req('a'))
+    const p2 = requestShellApproval(req('b'))
+    // First is active, second queued.
+    expect(getActiveShellApproval()?.id).toBe('a')
+    submitShellApproval('a', 'approve')
+    expect(await p1).toBe('approve')
+    // Second becomes active after the first settles.
+    expect(getActiveShellApproval()?.id).toBe('b')
+    submitShellApproval('b', 'deny')
+    expect(await p2).toBe('deny')
+  })
+
+  test('a submit for a queued id is ignored (cannot approve a non-active request)', async () => {
+    const p1 = requestShellApproval(req('a'))
+    const p2 = requestShellApproval(req('b'))
+    expect(submitShellApproval('b', 'approve')).toBe(false)
+    submitShellApproval('a', 'approve')
+    await p1
+    // b is now active and still unresolved until explicitly decided.
+    expect(submitShellApproval('b', 'approve')).toBe(true)
+    expect(await p2).toBe('approve')
+  })
+
+  test('cancelAll denies every pending request (UI shutdown)', async () => {
+    const p1 = requestShellApproval(req('a'))
+    const p2 = requestShellApproval(req('b'))
+    cancelAllShellApprovals()
+    expect(await p1).toBe('deny')
+    expect(await p2).toBe('deny')
+    expect(getActiveShellApproval()).toBeNull()
+  })
+
+  test('stale approval after settle does not re-resolve', async () => {
+    const p = requestShellApproval(req('a'))
+    submitShellApproval('a', 'deny')
+    expect(await p).toBe('deny')
+    // A late UI action for the same id is ignored.
+    expect(submitShellApproval('a', 'approve')).toBe(false)
+  })
+})
diff --git a/common/src/utils/shell-approval-bridge.ts b/common/src/utils/shell-approval-bridge.ts
new file mode 100644
index 0000000000..a9db3a3756
--- /dev/null
+++ b/common/src/utils/shell-approval-bridge.ts
@@ -0,0 +1,160 @@
+/**
+ * Shell Approval Bridge
+ *
+ * A correlated, concurrency-safe bridge for shell-command approvals.
+ *
+ * The generic AskUserBridge holds a single `pendingRequest`, so a second
+ * concurrent request silently replaces the first and the first caller never
+ * resolves. That is unsafe for approvals: a lost request must never be treated
+ * as granted. This bridge:
+ *   - correlates every request by a unique id,
+ *   - serializes requests (the UI shows one at a time) in FIFO order,
+ *   - resolves 'deny' on timeout, abort, or UI shutdown,
+ *   - never resolves 'approve' unless an explicit submit says so.
+ */
+
+export type ShellApprovalVerdict = 'approve' | 'deny'
+
+export interface ShellApprovalRequest {
+  id: string
+  command: string
+  cwd: string
+  processType: 'SYNC' | 'BACKGROUND'
+  signal?: AbortSignal
+}
+
+export interface PendingShellApproval extends ShellApprovalRequest {}
+
+type Listener = (active: PendingShellApproval | null, queued: number) => void
+
+interface Entry {
+  request: ShellApprovalRequest
+  resolve: (verdict: ShellApprovalVerdict) => void
+  settled: boolean
+  timer: ReturnType<typeof setTimeout> | null
+  onAbort: (() => void) | null
+}
+
+const DEFAULT_TIMEOUT_MS = 5 * 60 * 1000
+
+let active: Entry | null = null
+const queue: Entry[] = []
+const listeners: Listener[] = []
+
+function notify() {
+  const snapshot = active ? { ...active.request } : null
+  for (const l of listeners) l(snapshot, queue.length)
+}
+
+function settle(entry: Entry, verdict: ShellApprovalVerdict) {
+  if (entry.settled) return
+  entry.settled = true
+  if (entry.timer) clearTimeout(entry.timer)
+  if (entry.onAbort && entry.request.signal) {
+    entry.request.signal.removeEventListener('abort', entry.onAbort)
+  }
+  entry.resolve(verdict)
+}
+
+function activateNext() {
+  while (queue.length > 0) {
+    const next = queue.shift()!
+    if (next.settled) continue
+    if (next.request.signal?.aborted) {
+      settle(next, 'deny')
+      continue
+    }
+    active = next
+    notify()
+    return
+  }
+  active = null
+  notify()
+}
+
+/**
+ * Request approval for one command. Resolves 'approve' only when the matching
+ * id is submitted with that verdict; otherwise 'deny' (timeout/abort/shutdown).
+ */
+export function requestShellApproval(
+  request: ShellApprovalRequest,
+  options: { timeoutMs?: number } = {},
+): Promise<ShellApprovalVerdict> {
+  const timeoutMs = options.timeoutMs ?? DEFAULT_TIMEOUT_MS
+  return new Promise<ShellApprovalVerdict>((resolve) => {
+    const entry: Entry = {
+      request,
+      resolve,
+      settled: false,
+      timer: null,
+      onAbort: null,
+    }
+
+    // If the run is already aborted, deny without queueing.
+    if (request.signal?.aborted) {
+      entry.settled = true
+      resolve('deny')
+      return
+    }
+
+    if (request.signal) {
+      entry.onAbort = () => settle(entry, 'deny')
+      request.signal.addEventListener('abort', entry.onAbort, { once: true })
+    }
+
+    entry.timer = setTimeout(() => settle(entry, 'deny'), timeoutMs)
+    entry.timer.unref?.()
+
+    if (active) {
+      queue.push(entry)
+      notify()
+    } else {
+      active = entry
+      notify()
+    }
+  })
+}
+
+/**
+ * Submit a verdict for a specific approval id. Ids that do not match the active
+ * request are ignored, so a stale UI action cannot approve a different command.
+ */
+export function submitShellApproval(
+  id: string,
+  verdict: ShellApprovalVerdict,
+): boolean {
+  if (!active || active.request.id !== id || active.settled) return false
+  const current = active
+  settle(current, verdict)
+  activateNext()
+  return true
+}
+
+/** Deny every pending request. Called on UI shutdown so no caller hangs. */
+export function cancelAllShellApprovals(): void {
+  if (active) settle(active, 'deny')
+  for (const entry of queue) settle(entry, 'deny')
+  queue.length = 0
+  active = null
+  notify()
+}
+
+export function getActiveShellApproval(): PendingShellApproval | null {
+  return active ? { ...active.request } : null
+}
+
+export function subscribeShellApprovals(listener: Listener): () => void {
+  listeners.push(listener)
+  listener(active ? { ...active.request } : null, queue.length)
+  return () => {
+    const idx = listeners.indexOf(listener)
+    if (idx !== -1) listeners.splice(idx, 1)
+  }
+}
+
+/** Test-only: reset all state. */
+export function __resetShellApprovalBridge(): void {
+  active = null
+  queue.length = 0
+  listeners.length = 0
+}
