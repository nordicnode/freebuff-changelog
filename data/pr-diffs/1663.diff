diff --git a/cli/src/hooks/use-program-status.ts b/cli/src/hooks/use-program-status.ts
new file mode 100644
index 0000000000..453fed5fe1
--- /dev/null
+++ b/cli/src/hooks/use-program-status.ts
@@ -0,0 +1,47 @@
+/**
+ * Reports the CLI's lifecycle to terminals that understand OSC 7501.
+ *
+ * `isChainInProgress` covers a whole turn (including subagents and queued
+ * follow-ups); `askUserState` overrides it while Freebuff waits for an answer.
+ */
+
+import { useEffect, useRef } from 'react'
+
+import { useChatStore } from '../state/chat-store'
+import {
+  nextProgramStatusUpdate,
+  reportBlocked,
+  reportDone,
+  reportIdle,
+  reportWorking,
+} from '../utils/program-status'
+
+export function useProgramStatus(): void {
+  const isChainInProgress = useChatStore((state) => state.isChainInProgress)
+  const isAsking = useChatStore((state) => state.askUserState !== null)
+  const wasWorkingRef = useRef(false)
+
+  useEffect(() => {
+    const next = nextProgramStatusUpdate({
+      isChainInProgress,
+      isAsking,
+      wasWorking: wasWorkingRef.current,
+    })
+    wasWorkingRef.current = next.wasWorking
+
+    switch (next.update.state) {
+      case 'blocked':
+        reportBlocked(next.update.kind)
+        break
+      case 'working':
+        reportWorking()
+        break
+      case 'done':
+        reportDone()
+        break
+      case 'idle':
+        reportIdle()
+        break
+    }
+  }, [isAsking, isChainInProgress])
+}
diff --git a/cli/src/utils/__tests__/program-status.test.ts b/cli/src/utils/__tests__/program-status.test.ts
new file mode 100644
index 0000000000..176fe9fcc0
--- /dev/null
+++ b/cli/src/utils/__tests__/program-status.test.ts
@@ -0,0 +1,125 @@
+import { describe, expect, test } from 'bun:test'
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+
+import {
+  PROGRAM_STATUS_APP,
+  buildProgramStatusSequence,
+  nextProgramStatusUpdate,
+  reportProgramStatus,
+} from '../program-status'
+
+const ST = '\x1b\\'
+
+function withTtyFile(run: (ttyPath: string) => void): void {
+  const directory = mkdtempSync(join(tmpdir(), 'program-status-'))
+  const ttyPath = join(directory, 'tty')
+  writeFileSync(ttyPath, '')
+
+  try {
+    run(ttyPath)
+  } finally {
+    rmSync(directory, { recursive: true, force: true })
+  }
+}
+
+describe('program status', () => {
+  test('builds the idle report for the running program', () => {
+    expect(buildProgramStatusSequence('idle')).toBe(
+      `\x1b]7501;state=idle:app=${PROGRAM_STATUS_APP}${ST}`,
+    )
+  })
+
+  test('adds the blocked kind only while blocked', () => {
+    expect(buildProgramStatusSequence('blocked', { kind: 'question' })).toBe(
+      `\x1b]7501;state=blocked:app=${PROGRAM_STATUS_APP}:kind=question${ST}`,
+    )
+    expect(buildProgramStatusSequence('working', { kind: 'question' })).toBe(
+      `\x1b]7501;state=working:app=${PROGRAM_STATUS_APP}${ST}`,
+    )
+  })
+
+  test('builds clear reports', () => {
+    expect(buildProgramStatusSequence('clear')).toBe(
+      `\x1b]7501;state=clear:app=${PROGRAM_STATUS_APP}${ST}`,
+    )
+  })
+
+  test('writes a report to a tty path', () => {
+    withTtyFile((ttyPath) => {
+      expect(reportProgramStatus('working', { ttyPath })).toBe(true)
+      expect(readFileSync(ttyPath, 'utf8')).toBe(
+        buildProgramStatusSequence('working'),
+      )
+    })
+  })
+
+  test('returns false when the terminal cannot be opened', () => {
+    expect(
+      reportProgramStatus('done', {
+        ttyPath: '/path/that/does/not/exist',
+      }),
+    ).toBe(false)
+  })
+
+  test('reports idle before the first turn', () => {
+    expect(
+      nextProgramStatusUpdate({
+        isChainInProgress: false,
+        isAsking: false,
+        wasWorking: false,
+      }),
+    ).toEqual({ update: { state: 'idle' }, wasWorking: false })
+  })
+
+  test('reports working for a running turn', () => {
+    expect(
+      nextProgramStatusUpdate({
+        isChainInProgress: true,
+        isAsking: false,
+        wasWorking: false,
+      }),
+    ).toEqual({ update: { state: 'working' }, wasWorking: true })
+  })
+
+  test('reports blocked while a question waits for the user', () => {
+    expect(
+      nextProgramStatusUpdate({
+        isChainInProgress: true,
+        isAsking: true,
+        wasWorking: true,
+      }),
+    ).toEqual({
+      update: { state: 'blocked', kind: 'question' },
+      wasWorking: true,
+    })
+  })
+
+  test('returns to working after the question is answered', () => {
+    expect(
+      nextProgramStatusUpdate({
+        isChainInProgress: true,
+        isAsking: false,
+        wasWorking: true,
+      }),
+    ).toEqual({ update: { state: 'working' }, wasWorking: true })
+  })
+
+  test('reports done only on the transition out of a turn', () => {
+    expect(
+      nextProgramStatusUpdate({
+        isChainInProgress: false,
+        isAsking: false,
+        wasWorking: true,
+      }),
+    ).toEqual({ update: { state: 'done' }, wasWorking: false })
+    expect(
+      nextProgramStatusUpdate({
+        isChainInProgress: false,
+        isAsking: false,
+        wasWorking: false,
+      }),
+    ).toEqual({ update: { state: 'idle' }, wasWorking: false })
+  })
+})
diff --git a/cli/src/utils/program-status.ts b/cli/src/utils/program-status.ts
new file mode 100644
index 0000000000..31642f4bee
--- /dev/null
+++ b/cli/src/utils/program-status.ts
@@ -0,0 +1,100 @@
+/**
+ * Program Status Protocol (OSC 7501) reporting.
+ *
+ * Terminals such as Herdr treat a program as an agent only when it reports its
+ * lifecycle through OSC 7501. We write directly to /dev/tty, like
+ * terminal-title.ts, because OpenTUI captures stdout.
+ *
+ * Sequence: ESC ] 7501 ; state=<state>:app=<program>[:kind=<kind>] ESC \
+ */
+
+import { IS_FREEBUFF } from './constants'
+import { writeTerminalControlSync } from './terminal-io'
+
+export type ProgramStatusState =
+  | 'idle'
+  | 'working'
+  | 'blocked'
+  | 'done'
+  | 'clear'
+
+/** Only sent alongside `blocked`. */
+export type BlockedKind = 'permission' | 'question'
+
+export type ProgramStatusUpdate =
+  | { state: 'idle' | 'working' | 'done' }
+  | { state: 'blocked'; kind: BlockedKind }
+
+export const PROGRAM_STATUS_APP = IS_FREEBUFF ? 'freebuff' : 'codebuff'
+
+const OSC_7501 = '\x1b]7501;'
+const OSC_TERMINATOR = '\x1b\\' // ST
+
+/**
+ * Decide the next report from the CLI's turn and prompt state.
+ *
+ * A turn that just ended reports `done`; only a CLI that has not worked yet
+ * reports `idle`.
+ */
+export function nextProgramStatusUpdate(params: {
+  isChainInProgress: boolean
+  isAsking: boolean
+  wasWorking: boolean
+}): { update: ProgramStatusUpdate; wasWorking: boolean } {
+  if (params.isAsking) {
+    return { update: { state: 'blocked', kind: 'question' }, wasWorking: true }
+  }
+  if (params.isChainInProgress) {
+    return { update: { state: 'working' }, wasWorking: true }
+  }
+  if (params.wasWorking) {
+    return { update: { state: 'done' }, wasWorking: false }
+  }
+  return { update: { state: 'idle' }, wasWorking: false }
+}
+
+export function buildProgramStatusSequence(
+  state: ProgramStatusState,
+  options: { kind?: BlockedKind } = {},
+): string {
+  const fields = [`state=${state}`, `app=${PROGRAM_STATUS_APP}`]
+  if (state === 'blocked' && options.kind) {
+    fields.push(`kind=${options.kind}`)
+  }
+  return `${OSC_7501}${fields.join(':')}${OSC_TERMINATOR}`
+}
+
+/**
+ * Report one state transition. Unknown terminals ignore OSC 7501, and a
+ * non-interactive process has no /dev/tty, so failures are silent.
+ */
+export function reportProgramStatus(
+  state: ProgramStatusState,
+  options: { kind?: BlockedKind; ttyPath?: string } = {},
+): boolean {
+  return writeTerminalControlSync(
+    buildProgramStatusSequence(state, { kind: options.kind }),
+    options.ttyPath,
+  )
+}
+
+export function reportIdle(): boolean {
+  return reportProgramStatus('idle')
+}
+
+export function reportWorking(): boolean {
+  return reportProgramStatus('working')
+}
+
+export function reportBlocked(kind: BlockedKind): boolean {
+  return reportProgramStatus('blocked', { kind })
+}
+
+export function reportDone(): boolean {
+  return reportProgramStatus('done')
+}
+
+/** Stop being an agent in terminals that track agents by status. */
+export function reportClear(): boolean {
+  return reportProgramStatus('clear')
+}
