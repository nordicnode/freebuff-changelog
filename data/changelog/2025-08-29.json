      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Relicense Codebuff SDK to Apache-2.0",
        "summary": "Root `package.json` switches `license` from `UNLICENSED` to `Apache-2.0`. `sdk/package.json` updates from `MIT` to `Apache-2.0`. Redundant `UNLICENSED` fields removed from 8 private workspaces (`backend`, `common`, `evals`, `packages/bigquery`, `packages/billing`, `packages/code-map`, `packages/internal`, `scripts`, `web`).",
        "significance": "notable",
        "at": "2026-09-15T10:16:57.214Z"
      },
      "eli5": {
        "text": "The Codebuff software project has officially adopted an open-source license, making its code freely available under standard terms that allow anyone to use, share, and modify it. If you are a developer or company wanting to build on or include parts of Codebuff, you now have clear legal permission to do so without needing special approval. This is a one-time licensing switch, not a new feature, so day-to-day users will not notice any difference in how the assistant behaves.",
