      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Improve prompt caching via file versioning",
        "summary": "Refactors system prompt generation to use `fileVersions` instead of a flat file map, enabling stable prompt caching for Anthropic models. `getSearchSystemPrompt` now constructs ephemeral cache blocks around static project context while isolating dynamic file content, preventing cache invalidation from minor file changes. `requestRelevantFiles` updates to track unique file paths from versioned contexts, and `openai-api` increases timeout to 200s. Core backend files `system-prompt.ts`, `main-prompt.ts`, and `request-files-prompt.ts` carry these changes.",
        "significance": "notable",
        "at": "2026-09-15T18:28:36.654Z"
      },
      "eli5": {
        "text": "When you ask follow-up questions that depend on files the assistant already looked at, responses will now come back faster and with less wasted work by the AI, because the system now caches the background instructions more reliably instead of rebuilding them from scratch each time. The assistant now organizes project files by their actual versions, so small edits to a file no longer invalidate the reusable portions of the prompt; this affects every session that loads multiple files before answering. If you watched the system internally, you'd see it reuse cached prompt blocks around stable project context while only swapping in the specific file content that changed; the timeout for gathering files also increased to 200 seconds, so slower file sets have more room to complete.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "4a649f22e089",
        "at": "2026-09-17T21:22:36.818Z"
      },
