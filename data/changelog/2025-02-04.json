      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Add browser automation with Puppeteer and auto-screenshot handling",
        "summary": "Implemented `browser_action` tool using Puppeteer for web interaction and debugging. Added `screenshot-formatter.ts` and `parse-tool-call-xml.ts` to handle XML-based browser instructions and convert screenshots to image blocks. Updated `claude.ts`, `deepseek-api.ts`, `gemini-api.ts`, and `openai-api.ts` to strip unsupported image blocks from messages before API calls, preventing token errors.",
        "significance": "major",
        "at": "2026-09-15T17:10:18.701Z"
      },
      "eli5": {
        "text": "The assistant can now control a web browser to click around websites and take pictures of what it sees, which helps debug tricky problems. When it does, the system automatically shrinks the picture files so they work with every AI model you can talk to, and each model gets the picture in the exact format it understands. You'd notice this today as the assistant handling tasks that used to require you to describe what's on your screen.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "f7b9a76018df",
        "at": "2026-09-17T21:25:23.721Z"
