      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Reduce parallel file requests in non-lite modes",
        "summary": "Disables example and test/config file request promises in generateFileRequests for non-lite cost modes. Increases countPerRequest for pro and lite modes to compensate for reduced parallelism. Addresses unreliable haiku latency by limiting concurrent calls. Scope: backend/src/request-files-prompt.ts.",
        "significance": "minor",
        "at": "2026-09-15T17:46:28.330Z"
      },
      "eli5": {
        "text": "The assistant now makes fewer file-reading requests at once when you use the standard (non-lite) mode, so each request asks for more files instead. If you were watching the backend, you'd notice that two optional searches, example files and test/config files, are currently paused, and the remaining search batch sizes were bumped up to compensate. This reduces the number of requests happening in parallel which helps when response speed is inconsistent. The change is live today for standard mode users; lite mode behavior is unchanged.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "06637ad135f3",
        "at": "2026-09-18T00:36:06.861Z"
