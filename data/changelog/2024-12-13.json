      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "CLI exits on Ctrl+Z via SIGTSTP handler",
        "summary": "Added `process.on('SIGTSTP', ...)` to `npm-app/src/cli.ts` to trigger `handleExit()` when the user presses Ctrl+Z. This ensures the CLI terminates cleanly on suspend signals rather than backgrounding or freezing. Scope is limited to the CLI surface. The handler maps the POSIX stop signal directly to the existing exit logic.",
        "significance": "minor",
        "at": "2026-09-15T17:46:25.550Z"
      },
      "eli5": {
        "text": "When you press Ctrl+Z while running the command-line tool, it will now shut down completely instead of getting stuck or freezing in the background. This affects anyone using the command-line version of the tool, you would notice that pressing Ctrl+Z cleanly stops the program instead of leaving it hanging. The fix was applied today to the command-line interface only.",
        "model": "vyce/deepseek-v4.1",
