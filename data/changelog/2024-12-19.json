      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Add o1 model support and complex change planning tool",
        "summary": "Added `o1` model to cost tracker (input $15/M, output $60/M) and implemented `planComplexChange` in `backend/src/planning.ts` to generate detailed solutions using `o1` via streaming. Refactored `promptOpenAI` into `promptOpenAIStream` async generator in `backend/src/openai-api.ts`, removing manual timeout logic in favor of native streaming and updated token accounting. `main-prompt.ts` now integrates planning tools, while `conversation-progress.ts` requires explicit `costMode` for system prompt generation.",
        "significance": "notable",
        "at": "2026-09-15T17:43:47.868Z"
      },
      "eli5": {
        "text": "When you ask the assistant to figure out a big, tricky code task, it can now use a smarter, more careful planning model to lay out a detailed step-by-step solution and stream the whole plan back to you piece by piece. The assistant also now correctly charges you for how expensive that new model is per word of input and output. Behind the scenes, when you ask for progress on a long-running task, the assistant now requires you to explicitly say how you want to be billed before it builds its next message.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "1fd60cb0a7c6",
        "at": "2026-09-17T21:21:04.012Z"
