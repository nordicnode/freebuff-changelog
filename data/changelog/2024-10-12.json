      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Add double-dipping check to referral redemption",
        "summary": "RedeemReferralCode now rejects cases where the referrer was already referred by the current user. The check queries schema.referral for a matching referrer_id and referred_id pair using and() from drizzle-orm. Returns 429 with a specific error if double dipping is detected.",
        "significance": "minor",
        "at": "2026-09-15T18:43:01.211Z"
      },
      "eli5": {
        "text": "If you try to redeem a referral code from someone you already referred, the system now blocks you with a message telling you not to double dip. The system checks whether the person giving you credit was previously credited by you, and if so, returns a 429 error with a reminder to refer someone new instead.",
        "model": "vyce/deepseek-v4.1",
