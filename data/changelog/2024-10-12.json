      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Skip websocket middleware in local",
        "summary": "Added early return in backend/src/websockets/middleware.ts when env.ENVIRONMENT is 'local'. Skips match(action) and associated protection logic during local development. Internal change affecting only local websocket connections.",
        "significance": "minor",
        "at": "2026-09-15T18:41:37.746Z"
      },
      "eli5": {
        "text": "Developers working on their own computers have a smoother time testing parts of the app that let people connect in real time, like chat features. The system used to check extra permission rules even during local testing, which slowed things down or got in the way. Now those checks are automatically skipped when the app detects you're running it locally, letting developers test faster without affecting real users.",
        "model": "vyce/deepseek-v4.1",
