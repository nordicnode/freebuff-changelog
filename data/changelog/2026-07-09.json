      "hasDiff": true,
      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Add session model admission guards and trusted acting-user header",
        "summary": "New session admission helpers (isFreebuffSessionModelId, resolveFreebuffSessionModelForAccessTier) enforce model access for CLI/Desktop/Web/Cloud. A trusted x-freebuff-acting-user-id header is added for server-to-server calls, restricted to the Codebuff API when authenticating as the Freebuff Web service account. Three new model IDs (HY3, HY3 Atlas, Kat Coder Pro V2) are registered in free-agents.ts. The admission logic accepts the union of supported and Web-only model IDs without altering the CLI picker.",
        "significance": "minor",
        "at": "2026-09-14T15:50:55.330Z"
      },
      "eli5": {
        "text": "When you use Freebuff through a web browser or cloud service, a new safety check now makes sure you're only connected to the specific session models you're allowed to access, so you can't accidentally end up in someone else's workspace. Three new AI assistants (HY3, HY3 Atlas, and Kat Coder Pro V2) are now available for selection in your free desktop and agent lists. Behind the scenes, a secure, invisible header is added for the website's internal communication that prevents regular users or browsers from posing as someone else to peek into private sessions, and this protection is only used by the Codebuff API when it's acting on behalf of the Freebuff Web service.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "c26dfddea1bb",
        "at": "2026-09-17T20:20:53.894Z"
      },
