      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Imprezia sandbox allowlist gate",
        "summary": "Adds allowSandbox opt-in and isImpreziaSandboxTester helper to gate Imprezia sandbox creatives in production. Sandbox keys previously blocked unless testMode; now require explicit session pinning plus email allowlist match. Changes confined to common/src/util/imprezia-client.ts. Allowlist reads from IMPREZIA_SANDBOX_TESTERS env var; absent or empty defaults to deny.",
        "significance": "minor",
        "at": "2026-09-14T04:33:56.181Z"
      },
      "eli5": {
        "text": "If you are one of Imprezia's house-ad partners and you want to see their internal promotional creatives (the \"Developers. Earn money with your AI app.\" banner) while working in a live production environment, your email now needs to be added to a special list before those ads will show. Previously the system only checked whether a developer was running in a test mode, which meant anyone with a sandbox key could see the house ads during development; now an additional gate requires both a matching email on that list and an explicit session flag, so a stray link or an old bookmark alone will no longer accidentally surface a house ad to real traffic. The list lives in an environment variable the partner controls, so adding someone does not require a new code release, and if that variable is",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "ccfc4f679138",
        "at": "2026-09-17T20:08:08.156Z"
      },
