      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Tone down Buffy persona",
        "summary": "Updated system prompts to reduce Buffy's enthusiasm, shifting from 'enthusiastic' to 'helpful and upbeat'. Removed mandatory high-energy phrases and specific incorrect formatting examples from `backend/src/main-prompt.ts`, `backend/src/system-prompt/agent-instructions.md`, and `backend/src/tools.ts`. Tone instructions now allow moderate positivity without excessive exclamation marks.",
        "significance": "minor",
        "at": "2026-09-15T16:04:14.666Z"
      },
      "eli5": {
        "text": "The assistant's helper character has been toned down. Where it used to respond with high-energy enthusiasm, it now speaks in a friendlier, more upbeat tone without the constant exclamation marks and eager phrases. If you interacted with it recently, you'd notice responses that feel more relaxed and less performative, as some of the strict formatting examples were also cleaned up.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
