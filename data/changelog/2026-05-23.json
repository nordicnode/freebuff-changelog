      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Numpad Enter and printable key handling in CLI",
        "summary": "CLI now correctly intercepts numpad Enter keys and filters printable sequences using new `keypad-keys.ts` and `terminal-enter-detection.ts` utilities. Affected components (`chat-input-bar`, `multiline-input`, `ask-user`, etc.) replace manual key checks with `isPlainEnterKey` and `shouldInterceptChatInputKey`. CI cache keys bumped to `v2` for Bun compile runtime.",
        "significance": "notable",
        "at": "2026-09-14T23:57:36.606Z"
      },
      "eli5": {
        "text": "When you press Enter on the numpad (the number pad on the right side of many keyboards), the command-line chat now treats it the same as the regular Enter key, so your message sends instead of doing nothing or inserting a line break unexpectedly. Also, the input bar now ignores accidental printable-character keypresses that used to slip through when special keys overlapped, making the chat input smoother to use. If you use the command-line interface today and type with a full keyboard, presses of the numpad Enter will work like a normal Enter, and stray characters won't interrupt your typing.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "f4baf31f9f48",
