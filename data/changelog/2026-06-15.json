      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Smoke binary accepts OpenTUI terminal handshakes as boot signals",
        "summary": "cli/scripts/smoke-binary.ts adds OpenTUI alternate-screen and Kitty keyboard protocol escape sequences to BOOT_SIGNAL_PATTERNS. Fixes flaky Windows GitHub Actions smoke tests where the binary emits terminal setup but fails to flush static React text before timeout. Accepting these handshakes proves the renderer reached the post-init terminal surface. Fatal markers and tree-sitter checks still fail the smoke if async startup breaks later.",
        "significance": "minor",
        "at": "2026-09-14T16:16:16.556Z"
      },
      "hasDiff": true,
      "eli5": {
        "text": "When you launch the assistant on a Windows computer, the startup check used to time out because it missed the early terminal-setup signals the program sends. It now also recognizes the specific escape codes that tell the terminal to switch to full-screen mode and enable advanced keyboard handling, so the launch test can confirm the interface reached the screen instead of waiting for slower text to appear. You would only notice this if you were watching the automated startup tests, where they will stop failing intermittently on Windows servers.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "bdd038a05de7",
