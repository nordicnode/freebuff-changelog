      "ai": {
        "model": "deepseek-v4.1",
        "v": 11,
        "title": "Ads now skip two nodes before the first placement, then every three",
        "summary": "The ad interspersion logic in the streamed-response renderer now waits two nodes before the first ad, then spaces subsequent ads every three nodes. `RESPONSE_AD_NODE_STEP` rose from 2 to 3 and the new `RESPONSE_AD_FIRST_NODE_COUNT` constant sets the first-ad offset separately from the recurring spacing. `responseAdSlotCount` and `responseAdNodePositions` both gained a `firstAdAfterNodes` parameter, defaulting to that constant, so callers can override the offset while the step stays fixed. New tests cover short responses, stable append-order positions, and uncapped eligible slots.",
        "significance": "notable",
        "audience": "advertisers",
        "evidence": "`common/src/util/response-ad-positions.ts` changes `RESPONSE_AD_NODE_STEP` from 2 to 3, adds `RESPONSE_AD_FIRST_NODE_COUNT = 2`, and threads `firstAdAfterNodes` through `responseAdSlotCount` and `responseAdNodePositions`; new tests assert \"keeps the first ad after two nodes, then spaces ads every three nodes\" and \"allows the first-ad offset to differ from recurring spacing\".",
        "userVisible": true,
        "confidence": "high",
        "unknowns": "No consumer of the new first-ad offset wiring is shown in the diff.",
        "changes": [
          {
            "area": "Response ad interspersion",
            "what": "Reworked where first-party ads land inside a streamed assistant response.",
            "files": [
              "common/src/util/response-ad-positions.ts"
            ]
          }
        ],
