      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Reduce file token budgets in lite cost mode",
        "summary": "getSearchSystemPrompt, getAgentSystemPrompt, and getProjectFileTreePrompt now accept costMode to scale token limits. Lite mode lowers file version budgets from 90,000 to 30,000, file tree truncation from 80,000 to 30,000, and agent context inclusion threshold from 40,000 to 10,000. Updates backend/src/main-prompt.ts and backend/src/system-prompt.ts. The FILE_TOKEN_BUDGET constant was moved into getFileVersionUpdates to enable per-mode evaluation.",
        "significance": "minor",
        "at": "2026-09-15T17:38:58.629Z"
      },
      "eli5": {
        "text": "When you use the lite cost mode, the assistant now reads fewer words from your project files before responding, which keeps your session cheaper to run. The amount of file text it pulls in for files, the project folder view, and the agent’s context are all set lower in this mode. You won’t see this switch unless you’re already using the lite cost mode today.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "65c0482aa026",
        "at": "2026-09-18T00:34:30.020Z"
      },
      "structured": {
        "constants": [
          {
            "name": "FILE_TOKEN_BUDGET",
            "from": "90_000",
            "to": "costMode === 'lite' ? 30_000 : 90_000",
            "path": "backend/src/main-prompt.ts"
          }
        ],
