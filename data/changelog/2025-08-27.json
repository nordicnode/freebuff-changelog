      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Fix negative dash length in spawn-agent-utils",
        "summary": "Clamp dash length to zero in `executeAgent` to prevent `RangeError` when agent names exceed width. Fixes start and end notification formatting in `backend/src/tools/handlers/tool/spawn-agent-utils.ts`. Uses `Math.max(0, ...)` for dash calculation.",
        "significance": "minor",
        "at": "2026-09-15T10:14:32.964Z"
      },
      "eli5": {
        "text": "When the system announces that an assistant has started or finished working, it draws a line of dashes around the message to make it look neat. If the assistant's name was long enough, that line of dashes ran out of room and the whole message broke. Now the system makes sure the dashes never go below zero, so those start and finish announcements print correctly even for long names. You would only notice this if you were reading the internal logs where those messages appear.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "f30f8449546a",
