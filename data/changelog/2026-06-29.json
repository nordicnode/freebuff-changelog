      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Desktop premium concurrency slot and multi-session headers",
        "summary": "Added FREEBUFF_DESKTOP_PREMIUM_BUCKET_MODEL_IDS and isFreebuffDesktopPremiumBucketModelId to enforce a one-per-user concurrency cap for premium models plus MiniMax M3 and GLM 5.2 in Freebuff Desktop multi-session mode. Introduced wire headers FREEBUFF_INSTANCE_HEADER, FREEBUFF_MODEL_HEADER, and FREEBUFF_MULTI_SESSION_HEADER for /api/v1/freebuff/session to synchronize server and client literals. Defined premium_slot_taken status in FreebuffSessionServerResponse with currentInstanceId to enable tab switching or closing. Scope covers common/src/constants/freebuff-models.ts and common/src/types/freebuff-session.ts.",
        "significance": "notable",
        "at": "2026-09-14T16:07:17.951Z"
      },
      "eli5": {
        "text": "When you use Freebuff Desktop in multi-session mode, you can now only run one premium model at a time per account, like DeepSeek V4 Pro or MiniMax M3, but you can still open as many tabs as you want of the free models like DeepSeek V4 Flash. If you try to start a second premium session, the system will stop you and tell the desktop app to switch you to a free model or close the tab. This only affects the desktop app; web and command-line users, who already get one session at a time, are unchanged. The change is live today for anyone using Freebuff Desktop's multi-session mode.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "303009a2caf7",
