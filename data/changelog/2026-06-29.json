      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Add desktop analytics events with 100% sampling",
        "summary": "Adds nine new `desktop.*` analytics events to `AnalyticsEvent` enum in `common/src/constants/analytics-events.ts` and updates `MESSAGE_SENT` comment to include `desktop` surface. These events are added to `ALWAYS_TRACK_EVENTS` set in `common/src/util/analytics-sampling.ts` to bypass the default 1% sampling rate. This ensures low-volume desktop app launch, login, and activity funnels are fully tracked without statistical noise.",
        "significance": "minor",
        "at": "2026-09-14T16:05:02.959Z"
      },
      "eli5": {
        "text": "If you use the desktop app, your activity now shows up in the company's usage reports alongside web and mobile users. Previously, only about 1 in 100 desktop app actions were being recorded to save computing resources. Now, every time you launch the app, log in, start a new conversation, open a project, or switch models, that action is fully tracked rather than randomly sampled out. This ensures the analytics team can actually see how people are using the desktop app, since only a small number of people use it compared to the website.",
