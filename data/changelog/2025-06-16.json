      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Fix extra checkpoints with submodules",
        "summary": "Refactored submodule handling in `npm-app/src/checkpoints/file-manager.ts` to prevent duplicate checkpoints. Extracted `exposeSubmodules` and `restoreSubmodules` helpers to temporarily rename `.git` directories and remove submodule entries from the index during status checks and staging. `hasUnsavedChanges` now relies exclusively on native git commands, removing the `isomorphic-git` fallback.",
        "significance": "minor",
        "at": "2026-09-15T13:20:13.157Z"
      },
      "eli5": {
        "text": "When you open a project that contains smaller projects inside it (called submodules), the system used to create extra, duplicate save points and sometimes got confused about which files had unsaved changes. Now it temporarily hides those inner projects while it checks your files and creates save points, so you won't get pointless duplicate saves and status checks will be accurate. This only applies when using the built-in assistant project tools, and it is live today whenever you open or save checkpoints in a project with submodules.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "7c836c6d92ed",
        "at": "2026-09-17T23:38:33.003Z"
