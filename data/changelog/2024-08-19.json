      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Fix saveFilesChanged to initialize file state when missing",
        "summary": "saveFilesChanged in chat-storage.ts now initializes a new FileVersion via addNewFileState when getCurrentVersion returns null, instead of returning an empty array. This ensures file changes are tracked correctly even when no prior version exists, preventing undo failures. Scope limited to npm-app/src/chat-storage.ts.",
        "significance": "minor",
        "at": "2026-09-15T19:29:24.688Z"
      },
      "eli5": {
        "text": "When you make changes to files in the app and there wasn't a previous version saved, the app used to skip tracking those changes, causing the undo feature to fail. Now, it creates a fresh version to record on before saving your changes, so undo works correctly even when starting from no prior state. This fix is live today as part of the latest app update.",
        "model": "vyce/deepseek-v4.1",
