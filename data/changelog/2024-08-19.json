      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Fix undo boundary check in chat storage",
        "summary": "Corrected `navigateVersion` undo logic in `npm-app/src/chat-storage.ts` to allow reverting from index 0. Changed condition from `> 0` to `>= 0`. Removed unused `messageIndex` from `FileVersion` interface and state creation.",
        "significance": "minor",
        "at": "2026-09-15T19:30:54.466Z"
      },
      "eli5": {
        "text": "You can now undo your very first edit to a conversation's file history instead of getting stuck. The app previously refused to step backward when it had already gone all the way back to the start, so it now treats that starting position as a valid place to undo from. The change only adjusts that single check; everything else about how files are saved and restored stays the same.",
        "model": "vyce/deepseek-v4.1",
