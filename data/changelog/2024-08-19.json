      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Raise paste detection threshold to 10ms",
        "summary": "Paste detection threshold in `npm-app/src/cli.ts` increased from 5ms to 10ms. This accommodates slower input timing to reduce false negatives in fast consecutive input detection. Affects CLI input processing only.",
        "significance": "minor",
        "at": "2026-09-15T19:30:57.506Z"
      },
      "eli5": {
        "text": "When you paste text into the command-line tool, it needs to figure out what counts as a quick burst of keystrokes versus a slower typing session. The tool used to flag anything that happened within 5 milliseconds of the previous key as a paste signal, which was too strict and missed some pastes. It now waits up to 10 milliseconds, so pastes that arrive at a slightly slower pace are correctly recognized. This only affects how the command-line interface reads what you type, and it is already live today.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "f7736b1b36ec",
        "at": "2026-09-18T00:59:57.185Z"
