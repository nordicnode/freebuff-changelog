      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Simplify npm-app login prompt",
        "summary": "Login prompt in `npm-app/src/client.ts` replaced with single-line `Press ENTER` instruction. Fallback URL display moved to post-Enter confirmation step. Affects only `npm-app` CLI client.",
        "significance": "minor",
        "at": "2026-09-15T16:46:08.635Z"
      },
      "eli5": {
        "text": "Now when you sign in through the command-line tool, you just see a simple message telling you to press Enter to open your browser, instead of a confusing line showing a web address right away. After you press Enter and your browser opens to finish logging in, the tool then prints out the same web address you could copy and paste by hand if the automatic opening doesn't work. You only see the fallback address when you actually need it, not before.",
        "model": "vyce/deepseek-v4.1",
