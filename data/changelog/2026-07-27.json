      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Add Freebuff Cloud custom-stack planner constants",
        "summary": "Exports CLOUD_PLANNER_AGENT_ID and CLOUD_PLANNER_MODEL_ID in common/src/constants/free-agents.ts, pinning full access to MiniMax M3 and limited regions to LIMITED_FREEBUFF_MODEL_ID. Helpers cloudPlannerModelForAccessTier and cloudPlannerAgentIdForModel ensure agent definitions and UI hand-offs agree, preventing session_model_mismatch. Adds FREEBUFF_CLOUD_BLANK_PROJECT_DAILY_LIMIT=5 in freebuff-models.ts to cap blank Cloud projects, mitigating VM boot abuse. Includes new planner IDs in FREEBUFF_ROOT_AGENT_IDS to authorize context-pruner subagents.",
        "significance": "minor",
        "at": "2026-09-14T16:37:34.391Z"
      },
      "eli5": {
        "text": "Free users in regions that were previously blocked from the Cloud custom-stack planner can now use it, while everyone else is moved to MiniMax M3 as the model the planner writes code with. If you pick the planner, the model it promises and the model your build actually runs are now locked together, so a mismatch that would have silently failed is instead caught before your session starts. New sign-ups also hit a daily cap of five blank Cloud projects (the kind that spin up a full virtual machine), replacing the prior shared limit that effectively let about ten boot in a row; the counter resets at midnight Pacific time.",
        "model": "vyce/deepseek-v4.1",
