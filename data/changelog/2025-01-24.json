      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Error handling for gitignore checks",
        "summary": "Added try/catch block around `ig.ignores` call in `getFiles` to handle exceptions during gitignore evaluation. Errors result in `[ERROR_LOADING_FILE]` status instead of crashing. Scope limited to `npm-app/src/project-files.ts`.",
        "significance": "minor",
        "at": "2026-09-15T17:18:14.050Z"
      },
      "eli5": {
        "text": "When the tool that checks which project files to pay attention to runs into a problem reading a file, it now skips that file with a clear error marker [ERROR_LOADING_FILE] instead of crashing the whole file-checking step. Developers working in the main app workspace may notice previously-fatal interruptions now continue smoothly, simply bypassing the problematic entry.",
        "model": "vyce/deepseek-v4.1",
