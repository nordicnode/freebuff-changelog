      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Add --create flag for project templates",
        "summary": "Introduces `--create <template> [name]` CLI flag to initialize projects from community templates. New `create-template-project.ts` clones `CodebuffAI/codebuff-community`, copies `starter-templates` or `showcase` dirs, strips `.git`, and runs `npm install` if lockfile exists. `chat-storage.ts` guards against missing project root to prevent crash in non-project contexts. Updates `index.ts` help text and `knowledge.md` docs.",
        "significance": "notable",
        "at": "2026-09-15T17:18:30.010Z"
      },
      "eli5": {
        "text": "When you run the program without pointing it at an existing project folder, it used to crash while setting up where to store your chat history. Now it notices there's no project folder and falls back to storing that history in the current directory instead. The net effect: you can run the --create command to scaffold a new project from a template even when you're standing outside any existing project, and the program won't blow up just because it can't find a root folder.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "f3a022cfae70",
        "at": "2026-09-17T21:19:31.772Z"
