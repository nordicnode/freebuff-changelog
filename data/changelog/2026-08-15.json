      "ai": {
        "model": "bai/qwen3.8-flash",
        "v": 5,
        "title": "Add desktop.loginstarted event to analytics",
        "summary": "Added DESKTOP_LOGIN_STARTED to analytics events to capture sign-in attempts. Included in ALWAYS_TRACK_EVENTS to ensure funnel conversion rates remain accurate by preventing differential sampling between start and completion events. Applies to common/src/constants/analytics-events.ts and common/src/util/analytics-sampling.ts.",
        "significance": "minor",
        "at": "2026-09-14T05:10:57.377Z"
      },
      "eli5": {
        "text": "Desktop sign-in now records both the moment you start signing in and the moment you finish, so the team can tell how many people are actually trying to sign in rather than only counting those who succeed. Before this, a redesigned first-run screen could look successful even if sign-in itself broke for most people, because only the completion was tracked. Now you, as someone signing in on desktop, produce one extra analytics event at the start, and the company sees an accurate sign-in conversion rate. This is live today.",
        "model": "vyce/deepseek-v4.1",
        "v": 4,
        "src": "f187ff65869d",
