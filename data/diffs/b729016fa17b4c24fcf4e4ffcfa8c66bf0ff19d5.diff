+export function sponsoredRefusedGitSubcommand(command: string): string | null {
+  return (
+    sponsoredGitSubcommands(command).find((subcommand) =>
+      SPONSORED_REFUSED_GIT_SUBCOMMANDS.has(subcommand),
+    ) ?? null
+  )
+}
