+export const HOOK_COMMAND_MAX = HOOK_COMMAND_MAX_CHARS
+export const HOOK_MATCHER_MAX = 200
+export const HOOK_TIMEOUT_MAX_S = 60
+export const HOOK_NAME_MAX = 80
+
