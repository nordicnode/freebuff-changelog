diff --git a/common/src/desktop-cloud/project-name.test.ts b/common/src/desktop-cloud/project-name.test.ts
new file mode 100644
index 000000000..7d799c557
--- /dev/null
+++ b/common/src/desktop-cloud/project-name.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, test } from 'bun:test'
+import { nextUntitledProjectName } from './project-name'
+
+describe('automatic project names', () => {
+  test('starts with Untitled and increments after the highest existing number', () => {
+    expect(nextUntitledProjectName([])).toBe('Untitled')
+    expect(nextUntitledProjectName(['Untitled'])).toBe('Untitled 2')
+    expect(nextUntitledProjectName(['Untitled 2', 'Untitled', 'Untitled 9'])).toBe('Untitled 10')
+  })
+
+  test('does not reuse gaps or depend on catalog ordering', () => {
+    expect(nextUntitledProjectName(['Untitled 5', 'Untitled 2'])).toBe('Untitled 6')
+  })
+
+  test('matches case and surrounding whitespace without counting other titles', () => {
+    expect(nextUntitledProjectName([
+      null, undefined, 'My project', 'Untitled notes', 'Untitled 0',
+      'Untitled 02', 'Untitled -3', 'Untitled 2.5', 'Untitled 1e3',
+      'Untitled 99999999999999999999999', ' untitled 3 ',
+    ])).toBe('Untitled 4')
+  })
+})
diff --git a/common/src/desktop-cloud/project-name.ts b/common/src/desktop-cloud/project-name.ts
new file mode 100644
index 000000000..0b5605ccf
--- /dev/null
+++ b/common/src/desktop-cloud/project-name.ts
@@ -0,0 +1,14 @@
+/** Number blank projects after the highest existing Untitled name. */
+export function nextUntitledProjectName(
+  existingNames: Iterable<string | null | undefined>,
+): string {
+  let highest = 0
+  for (const name of existingNames) {
+    const match = name?.trim().match(/^untitled(?: ([1-9]\d*))?$/i)
+    if (!match) continue
+    const number = match[1] ? Number(match[1]) : 1
+    if (Number.isSafeInteger(number) && number < Number.MAX_SAFE_INTEGER)
+      highest = Math.max(highest, number)
+  }
+  return highest === 0 ? 'Untitled' : `Untitled ${highest + 1}`
+}
