+  moveTab(ctx, op) {
+    const tab = findTab(ctx, op.tab)
+    if (isResult(tab)) return tab
+    if (typeof op.to !== 'number' || !Number.isInteger(op.to) || op.to < 0) return fail('to is the tab’s new position, 0 first')
