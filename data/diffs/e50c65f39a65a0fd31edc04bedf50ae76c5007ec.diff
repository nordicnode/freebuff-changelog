+++ b/common/src/desktop-cloud/artifact-kinds/whiteboard-lint.ts
@@ -0,0 +1,247 @@
+/**
+ * Board checks (round 5): what a reader would notice is wrong with a board, measured the way the
+ * editor draws it. The editor's Checks panel lists them (each with "Ask Buffy to fix", carrying
+ * the element ids) and the agent's read returns them, so both see the same issues:
+ *   overlap          two boxes cover each other (not a sticker on a note, not text on a shape,
+ *                    not members of one group, never a section and what sits in it);
+ *   text-overflow    a note's, shape's or table cell's text does not fit its box even at the
+ *                    smallest size (it is clipped);
+ *   tiny-text        the text only fits by shrinking below 12 px;
+ *   section-edge     an element straddles a section's edge: half in, so it looks like a member
+ *                    but does not move with the section (or sticks out of it);
+ *   dangling-arrow   an arrow end points at nothing (a free point, not an element);
+ *   duplicate-arrow  two arrows join the same two elements the same way;
+ *   low-contrast     a custom (#rrggbb) line colour that almost vanishes on the light or dark canvas.
+ * Hidden elements are not checked. Pure and deterministic; O(n log n + overlaps) with a sweep, so
+ * it runs off the drag path (the panel computes it when shown, the server on read).
+ */
+
+import { tableCellRect, tableMerges, tableSize } from './whiteboard-arrange'
+import {
+  center,
+  elementBounds,
+  estimateMeasure,
+  fitTextInBox,
+  geometryContext,
+  NOTE_PADDING,
+  pointInRect,
+  rectContains,
+  shapeTextBox,
+  wrapText,
+  type GeometryContext,
+  type Measure,
+} from './whiteboard-geometry'
+import { visibleBoard } from './whiteboard-r5'
+import { plainRichText } from './whiteboard-richtext'
+import { isBoundEnd, isHexColor, TEXT_SIZE_PX, type Rect, type WhiteboardBoard, type WhiteboardElement } from './whiteboard'
+
+export const LINT_RULES = [
+  'overlap',
+  'text-overflow',
+  'tiny-text',
+  'section-edge',
+  'dangling-arrow',
+  'duplicate-arrow',
+  'low-contrast',
+] as const
+export type LintRule = (typeof LINT_RULES)[number]
+
+export type BoardIssue = {
+  rule: LintRule
+  /** The elements it is about (first the one to fix). */
+  ids: string[]
+  message: string
+  /** What would fix it, in a few words. */
+  fix: string
+}
+
+/** Most issues listed (the rest are counted). */
+export const MAX_BOARD_ISSUES = 60
+
+const NOTE_STEPS = [22, 18, 16, 14, 12, 10]
+const SHAPE_STEPS = [16, 14, 12, 10]
+const CELL_STEPS = [14, 13, 12, 11, 10]
+const TINY_PX = 12
+
+const area = (r: Rect) => Math.max(0, r.w) * Math.max(0, r.h)
+function overlapArea(a: Rect, b: Rect): number {
+  const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x)
+  const h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y)
+  return w > 0 && h > 0 ? w * h : 0
+}
+
+function name(element: WhiteboardElement): string {
+  const text =
+    element.type === 'note' || element.type === 'text'
+      ? element.text
+      : element.type === 'shape'
+        ? element.text ?? ''
+        : element.type === 'section' || element.type === 'link'
+          ? element.title
+          : ''
+  const clean = plainRichText(text).replace(/\s+/g, ' ').trim()
+  const noun = element.type === 'stroke' ? 'sketch' : element.type === 'link' ? 'link card' : element.type
+  return clean ? `${noun} "${clean.length > 30 ? `${clean.slice(0, 29)}…` : clean}"` : `${noun} ${element.id}`
+}
+
+/** Relative luminance of `#rrggbb` (WCAG). */
+function luminance(hex: string): number {
+  const channel = (i: number) => {
+    const c = parseInt(hex.slice(i, i + 2), 16) / 255
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4
+  }
+  return 0.2126 * channel(1) + 0.7152 * channel(3) + 0.0722 * channel(5)
+}
+
+/** WCAG contrast ratio of two `#rrggbb` colours (1 to 21). */
+export function contrastRatio(a: string, b: string): number {
+  const [x, y] = [luminance(a), luminance(b)].sort((p, q) => q - p) as [number, number]
+  return (x + 0.05) / (y + 0.05)
+}
+
+/** The ink a custom fill gets so its text reads: near-black on light fills, near-white on dark. */
+export function inkOn(fill: string): string {
+  return contrastRatio(fill, '#1f2328') >= contrastRatio(fill, '#ffffff') ? '#1f2328' : '#ffffff'
+}
+
+/** The light and dark canvas backgrounds a line colour must show on. */
+export const CANVAS_BACKGROUNDS = ['#ffffff', '#1c1c1e'] as const
+const LINE_CONTRAST_MIN = 1.5
+
+/** Text fit: does `text` fit `box` at some step, and at which size. */
+function fit(text: string, box: Rect, measure: Measure, steps: readonly number[], fixed?: number) {
+  const plain = plainRichText(text)
+  if (fixed) {
+    const lines = plain.split('\n').flatMap((line) => wrapText(line, fixed, box.w, measure)).length
+    return { fits: lines * fixed * 1.3 <= box.h + 0.5, size: fixed }
+  }
+  const block = fitTextInBox(plain, box.w, box.h, measure, steps)
+  return { fits: block.lines.length * block.lineHeight <= box.h + 0.5, size: block.fontSize }
+}
+
+/** The checks for one board. */
+export function lintBoard(board: WhiteboardBoard, measure: Measure = estimateMeasure): { issues: BoardIssue[]; total: number } {
+  const ctx: GeometryContext = geometryContext(board.elements, measure)
+  const issues: BoardIssue[] = []
+  const add = (issue: BoardIssue) => issues.push(issue)
+  // As a reader sees it: hidden elements, and arrows bound to them, are not checked.
+  const shown = visibleBoard(board).elements
+  const bounds = new Map(shown.map((element) => [element.id, elementBounds(element, ctx)]))
+  const sections = shown.filter((element) => element.type === 'section')
+
+  // ---- text that does not fit
+  for (const element of shown) {
+    if (element.type === 'note' && element.text.trim()) {
+      const box = { x: 0, y: 0, w: element.w - 2 * NOTE_PADDING, h: element.h - 2 * NOTE_PADDING }
+      const result = fit(element.text, box, measure, NOTE_STEPS, element.fontSize ? TEXT_SIZE_PX[element.fontSize] : undefined)
+      if (!result.fits) add({ rule: 'text-overflow', ids: [element.id], message: `The text of ${name(element)} does not fit; it is cut off.`, fix: 'Make the note bigger, turn on auto-size, or shorten the text.' })
+      else if (!element.fontSize && result.size < TINY_PX) add({ rule: 'tiny-text', ids: [element.id], message: `${name(element)} only fits its text at ${result.size}px.`, fix: 'Make the note bigger or shorten the text.' })
+    } else if (element.type === 'shape' && element.text?.trim() && !element.timer) {
+      const box = shapeTextBox(element.kind, element)
+      const result = fit(element.text, box, measure, SHAPE_STEPS, element.fontSize ? TEXT_SIZE_PX[element.fontSize] : undefined)
+      if (!result.fits) add({ rule: 'text-overflow', ids: [element.id], message: `The label of ${name(element)} does not fit; it is cut off.`, fix: 'Make the shape bigger or shorten the label.' })
+      else if (!element.fontSize && result.size < TINY_PX) add({ rule: 'tiny-text', ids: [element.id], message: `${name(element)} only fits its label at ${result.size}px.`, fix: 'Make the shape bigger or shorten the label.' })
+    } else if (element.type === 'table') {
+      const { rows, cols } = tableSize(element)
+      const covered = new Set<string>()
+      for (const merge of tableMerges(element)) {
+        for (let r = merge.row; r < merge.row + merge.rows; r++) for (let c = merge.col; c < merge.col + merge.cols; c++) if (r !== merge.row || c !== merge.col) covered.add(`${r}:${c}`)
+      }
+      let worst: string | null = null
+      for (let r = 0; r < rows && !worst; r++) {
+        for (let c = 0; c < cols; c++) {
+          const cell = element.rows[r]![c]!
+          if (!cell.trim() || covered.has(`${r}:${c}`)) continue
+          const rect = tableCellRect(element, r, c)
+          const result = fit(cell, { x: 0, y: 0, w: rect.w - 16, h: rect.h - 4 }, measure, CELL_STEPS)
+          if (!result.fits) {
+            worst = `row ${r + 1}, column ${c + 1}`
+            break
+          }
+        }
+      }
+      if (worst) add({ rule: 'text-overflow', ids: [element.id], message: `A cell of table ${element.id} (${worst}) is cut off.`, fix: 'Widen that column, add height to the row, or shorten the text.' })
+    }
+  }
+
+  // ---- overlaps (a sweep over x)
+  const boxes = shown.filter(
+    (element) => element.type === 'note' || element.type === 'shape' || element.type === 'image' || element.type === 'table' || element.type === 'link' || element.type === 'text',
+  )
+  const sorted = boxes.map((element) => ({ element, r: bounds.get(element.id)! })).sort((a, b) => a.r.x - b.r.x)
+  const sameGroup = (a: WhiteboardElement, b: WhiteboardElement) => !!a.groups?.some((group) => b.groups?.includes(group))
+  let overlaps = 0
+  for (let i = 0; i < sorted.length; i++) {
+    const a = sorted[i]!
+    for (let j = i + 1; j < sorted.length; j++) {
+      const b = sorted[j]!
+      if (b.r.x >= a.r.x + a.r.w) break
+      const shared = overlapArea(a.r, b.r)
+      if (!shared) continue
+      if (sameGroup(a.element, b.element)) continue
+      // Text laid over a box is a label, not a clash.
+      if ((a.element.type === 'text' && rectContains(b.r, a.r)) || (b.element.type === 'text' && rectContains(a.r, b.r))) continue
+      if (shared < 0.15 * Math.min(area(a.r), area(b.r))) continue
+      const [top, under] = board.elements.indexOf(a.element) > board.elements.indexOf(b.element) ? [a.element, b.element] : [b.element, a.element]
+      overlaps++
+      if (overlaps <= 30) add({ rule: 'overlap', ids: [top.id, under.id], message: `${name(top)} covers ${name(under)}.`, fix: 'Move one of them apart (40 units between neighbours), or use Tidy up.' })
+    }
+  }
+
+  // ---- half in a section
+  for (const element of shown) {
+    if (element.type === 'section' || element.type === 'arrow' || element.type === 'sticker' || element.type === 'stroke') continue
+    const r = bounds.get(element.id)!
+    const c = center(r)
+    for (const section of sections) {
+      const s = bounds.get(section.id)!
+      if (rectContains(s, r) || rectContains(r, s)) continue
+      const shared = overlapArea(r, s)
+      if (!shared) continue
+      const inside = pointInRect(c, s)
+      if (inside && shared > 0.5 * area(r)) {
+        add({ rule: 'section-edge', ids: [element.id, section.id], message: `${name(element)} sticks out of ${name(section)}.`, fix: 'Move it fully inside, or make the section bigger.' })
+      } else if (!inside && shared > 0.25 * area(r)) {
+        add({ rule: 'section-edge', ids: [element.id, section.id], message: `${name(element)} sits half in ${name(section)} but is not part of it (it will not move with it).`, fix: 'Move it fully into the section, or out of it.' })
+      }
+    }
+  }
+
+  // ---- arrows
+  const seen = new Map<string, string>()
+  for (const element of shown) {
+    if (element.type !== 'arrow') continue
+    const free = [element.from, element.to].filter((end) => !isBoundEnd(end)).length
+    if (free > 0) add({ rule: 'dangling-arrow', ids: [element.id], message: `Arrow ${element.label ? `"${element.label}" ` : ''}${element.id} has ${free === 2 ? 'both ends' : 'an end'} pointing at nothing.`, fix: 'Attach its ends to elements, or remove it.' })
+    else if (isBoundEnd(element.from) && isBoundEnd(element.to)) {
+      const key = `${element.from.elementId}>${element.to.elementId}`
+      const earlier = seen.get(key)
+      if (earlier) add({ rule: 'duplicate-arrow', ids: [element.id, earlier], message: `Arrows ${earlier} and ${element.id} join the same two elements.`, fix: 'Remove one of them.' })
+      else seen.set(key, element.id)
+    }
+    if (element.stroke && isHexColor(element.stroke)) {
+      const worst = Math.min(...CANVAS_BACKGROUNDS.map((bg) => contrastRatio(element.stroke!, bg)))
+      if (worst < LINE_CONTRAST_MIN) add({ rule: 'low-contrast', ids: [element.id], message: `Arrow ${element.id}'s colour ${element.stroke} almost vanishes on the ${contrastRatio(element.stroke, '#ffffff') < LINE_CONTRAST_MIN ? 'light' : 'dark'} canvas.`, fix: 'Use a colour name (it adapts to the theme) or a mid-tone hex.' })
+    }
+  }
+  for (const element of shown) {
+    const stroke = 'stroke' in element && element.type !== 'arrow' ? element.stroke : undefined
+    if (!stroke || !isHexColor(stroke)) continue
+    const fill = 'fill' in element ? element.fill : undefined
+    if (fill) continue // a filled body shows either way
+    const worst = Math.min(...CANVAS_BACKGROUNDS.map((bg) => contrastRatio(stroke, bg)))
+    if (worst < LINE_CONTRAST_MIN && element.type === 'section') add({ rule: 'low-contrast', ids: [element.id], message: `${name(element)}'s outline ${stroke} almost vanishes on one theme.`, fix: 'Use a colour name or a mid-tone hex.' })
+  }
+
+  const order = new Map(LINT_RULES.map((rule, i) => [rule, i]))
+  issues.sort((a, b) => order.get(a.rule)! - order.get(b.rule)!)
+  // Overlaps past the 30 listed still count towards the total.
+  return { issues: issues.slice(0, MAX_BOARD_ISSUES), total: issues.length + Math.max(0, overlaps - 30) }
+}
+
+/** The issues as plain lines (the agent's read, an Ask Buffy request). */
+export function formatBoardIssues(result: { issues: BoardIssue[]; total: number }): string[] {
+  const lines = result.issues.map((issue) => `- [${issue.rule}] ${issue.message} Fix: ${issue.fix} (ids: ${issue.ids.join(', ')})`)
+  if (result.total > result.issues.length) lines.push(`- … ${result.total - result.issues.length} more`)
+  return lines
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/whiteboard-ops.ts b/common/src/desktop-cloud/artifact-kinds/whiteboard-ops.ts
new file mode 100644
index 000000000..038916076
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/whiteboard-ops.ts
@@ -0,0 +1,403 @@
+/**
+ * Board edits. Every function takes a valid board and returns a valid one (new ids are unique,
+ * no arrow is left pointing at a deleted element), so the editor never emits a board the schema
+ * would refuse. Pure: no DOM.
+ */
+
+import {
+  arrowGeometry,
+  geometryContext,
+  withSectionMembers,
+  type GeometryContext,
+  type Measure,
+} from './whiteboard-geometry'
+import {
+  isBoundEnd,
+  isBoxElement,
+  MAX_ELEMENTS,
+  type ArrowElement,
+  type ArrowEnd,
+  type Point,
+  type WhiteboardBoard,
+  type WhiteboardElement,
+} from './whiteboard'
+
+const round1 = (v: number) => Math.round(v * 10) / 10
+
+/** A fresh id with `prefix`, unique in `taken` (which it then joins). */
+export function mintId(prefix: string, taken: Set<string>): string {
+  for (;;) {
+    const id = `${prefix}-${Math.random().toString(36).slice(2, 8)}`
+    if (!taken.has(id)) {
+      taken.add(id)
+      return id
+    }
+  }
+}
+
+export function boardIds(board: WhiteboardBoard): Set<string> {
+  return new Set(board.elements.map((element) => element.id))
+}
+
+export function addElements(board: WhiteboardBoard, elements: readonly WhiteboardElement[]): WhiteboardBoard {
+  if (elements.length === 0) return board
+  const room = Math.max(0, MAX_ELEMENTS - board.elements.length)
+  return { ...board, elements: [...board.elements, ...elements.slice(0, room)] }
+}
+
+/**
+ * Sections go to the back when added, so a new frame drawn around notes sits under them. It is
+ * inserted just before the lowest element it covers.
+ */
+export function addSection(board: WhiteboardBoard, section: WhiteboardElement, ctx: GeometryContext): WhiteboardBoard {
+  if (board.elements.length >= MAX_ELEMENTS) return board
+  const members = new Set(
+    withSectionMembers([...board.elements, section], [section.id], geometryContext([...board.elements, section], ctx.measure)),
+  )
+  members.delete(section.id)
+  const index = board.elements.findIndex((element) => members.has(element.id))
+  const elements = [...board.elements]
+  elements.splice(index === -1 ? elements.length : index, 0, section)
+  return { ...board, elements }
+}
+
+/** Merges `patches[id]` into each named element (fields the element type does not have are ignored). */
+export function updateElements(
+  board: WhiteboardBoard,
+  patches: ReadonlyMap<string, Partial<WhiteboardElement>>,
+): WhiteboardBoard {
+  if (patches.size === 0) return board
+  let changed = false
+  const elements = board.elements.map((element) => {
+    const patch = patches.get(element.id)
+    if (!patch) return element
+    const next = { ...element } as Record<string, unknown>
+    for (const [key, value] of Object.entries(patch)) {
+      if (key === 'id' || key === 'type') continue
+      if (!(key in element) && !OPTIONAL_KEYS[element.type].includes(key)) continue
+      if (value === undefined) delete next[key]
+      else next[key] = value
+    }
+    changed = true
+    return next as WhiteboardElement
+  })
+  return changed ? { ...board, elements } : board
+}
+
+const SHARED_OPTIONAL = ['groups', 'locked', 'hidden']
+
+const PAINTS = ['fill', 'stroke']
+
+const OPTIONAL_KEYS: Record<WhiteboardElement['type'], string[]> = {
+  note: [...SHARED_OPTIONAL, 'fontSize', ...PAINTS, 'votes', 'autoSize'],
+  shape: [...SHARED_OPTIONAL, 'text', 'fontSize', ...PAINTS, 'timer'],
+  text: [...SHARED_OPTIONAL, 'w'],
+  section: [...SHARED_OPTIONAL, 'color', ...PAINTS, 'noteColor', 'stack'],
+  arrow: [...SHARED_OPTIONAL, 'label', 'head', 'color', 'stroke', 'routing', 'bend', 'labelAt', 'startHead', 'endHead'],
+  stroke: [...SHARED_OPTIONAL],
+  image: [...SHARED_OPTIONAL, 'crop'],
+  sticker: [...SHARED_OPTIONAL, 'attachedTo'],
+  table: [...SHARED_OPTIONAL, 'header', 'color', ...PAINTS, 'colWidths', 'rowHeights', 'merges'],
+  link: [...SHARED_OPTIONAL, 'color', ...PAINTS, 'artifact'],
+}
+
+/** Whether an element takes separate fill and outline overrides (`fill`/`stroke`). */
+export function supportsPaint(element: WhiteboardElement): 'both' | 'stroke' | null {
+  if (element.type === 'arrow') return 'stroke'
+  return OPTIONAL_KEYS[element.type].includes('fill') ? 'both' : null
+}
+
+/** Whether an element takes a board colour (for the colour picker to know what applies). */
+export function supportsColor(element: WhiteboardElement): boolean {
+  return element.type !== 'text' && element.type !== 'image' && element.type !== 'sticker'
+}
+
+function translate(element: WhiteboardElement, dx: number, dy: number): WhiteboardElement {
+  if (isBoxElement(element) || element.type === 'text') {
+    return { ...element, x: round1(element.x + dx), y: round1(element.y + dy) }
+  }
+  if (element.type === 'stroke') {
+    return { ...element, points: element.points.map(([x, y]) => [round1(x + dx), round1(y + dy)] as [number, number]) }
+  }
+  const move = (end: ArrowEnd): ArrowEnd => (isBoundEnd(end) ? end : { x: round1(end.x + dx), y: round1(end.y + dy) })
+  return { ...element, from: move(element.from), to: move(element.to) }
+}
+
+/**
+ * Moves `ids` (and the members of any section among them) by (dx, dy). Bound arrow ends follow
+ * their elements without being written; a free arrow end moves only when its arrow is moved.
+ */
+export function moveElements(
+  board: WhiteboardBoard,
+  ids: readonly string[],
+  dx: number,
+  dy: number,
+  ctx: GeometryContext = geometryContext(board.elements),
+): WhiteboardBoard {
+  if (ids.length === 0 || (dx === 0 && dy === 0)) return board
+  const moving = new Set(withSectionMembers(board.elements, ids, ctx))
+  return {
+    ...board,
+    elements: board.elements.map((element) => (moving.has(element.id) ? translate(element, dx, dy) : element)),
+  }
+}
+
+/** Moves exactly `ids` (the caller already expanded sections), for a drag in progress. */
+export function translateElements(
+  board: WhiteboardBoard,
+  ids: ReadonlySet<string>,
+  dx: number,
+  dy: number,
+): WhiteboardBoard {
+  if (ids.size === 0 || (dx === 0 && dy === 0)) return board
+  return {
+    ...board,
+    elements: board.elements.map((element) => (ids.has(element.id) ? translate(element, dx, dy) : element)),
+  }
+}
+
+/** Arrow ends bound to an element outside `keep` become free points where they are drawn now. */
+function freeEndsOutside(
+  arrow: ArrowElement,
+  keep: (id: string) => boolean,
+  ctx: GeometryContext,
+): ArrowElement {
+  const fromGone = isBoundEnd(arrow.from) && !keep(arrow.from.elementId)
+  const toGone = isBoundEnd(arrow.to) && !keep(arrow.to.elementId)
+  if (!fromGone && !toGone) return arrow
+  const geometry = arrowGeometry(arrow, ctx)
+  return {
+    ...arrow,
+    from: fromGone ? { x: round1(geometry.start.x), y: round1(geometry.start.y) } : arrow.from,
+    to: toGone ? { x: round1(geometry.end.x), y: round1(geometry.end.y) } : arrow.to,
+  }
+}
+
+/**
+ * Deletes `ids`. Arrows bound to a deleted element go with it (round 4: the same as the agent's
+ * `removeElements`, so the editor and the agent agree; undo brings both back). Stickers attached
+ * to a deleted element stay where they are, unattached.
+ */
+export function deleteElements(
+  board: WhiteboardBoard,
+  ids: readonly string[],
+  _measure?: Measure,
+): WhiteboardBoard {
+  if (ids.length === 0) return board
+  const gone = new Set(ids)
+  const bound = (end: ArrowEnd) => isBoundEnd(end) && gone.has(end.elementId)
+  const elements = board.elements
+    .filter((element) => !gone.has(element.id) && !(element.type === 'arrow' && (bound(element.from) || bound(element.to))))
+    .map((element) => (element.type === 'sticker' && element.attachedTo && gone.has(element.attachedTo) ? detach(element) : element))
+  return { ...board, elements }
+}
+
+/** A sticker without its `attachedTo`. */
+function detach<T extends WhiteboardElement>(element: T): T {
+  if (element.type !== 'sticker' || element.attachedTo === undefined) return element
+  const next = { ...element }
+  delete (next as { attachedTo?: string }).attachedTo
+  return next
+}
+
+/**
+ * The elements to copy for `ids` (sections bring their members), in board order, with arrow ends
+ * bound outside the copy freed. Self-contained: it can be pasted into any board.
+ */
+export function copyFragment(
+  board: WhiteboardBoard,
+  ids: readonly string[],
+  ctx: GeometryContext = geometryContext(board.elements),
+): WhiteboardElement[] {
+  const chosen = new Set(withSectionMembers(board.elements, ids, ctx))
+  return board.elements
+    .filter((element) => chosen.has(element.id))
+    .map((element) =>
+      element.type === 'arrow'
+        ? freeEndsOutside(element, (id) => chosen.has(id), ctx)
+        : element.type === 'sticker' && element.attachedTo && !chosen.has(element.attachedTo)
+          ? detach(element)
+          : element,
+    )
+}
+
+/**
+ * Pastes a fragment offset by (dx, dy) with fresh ids (arrows re-pointed at the copies). Returns
+ * the board and the new ids, which become the selection.
+ */
+export function pasteFragment(
+  board: WhiteboardBoard,
+  fragment: readonly WhiteboardElement[],
+  dx: number,
+  dy: number,
+): { board: WhiteboardBoard; ids: string[] } {
+  const existing = boardIds(board)
+  const taken = new Set(existing)
+  const idMap = new Map<string, string>()
+  for (const element of fragment) idMap.set(element.id, mintId(element.type, taken))
+  // Copies form their own groups: a pasted group is a new group, never a member of the original.
+  const groupMap = new Map<string, string>()
+  const regroup = (groups: string[] | undefined) => {
+    if (!groups) return undefined
+    return groups.map((group) => {
+      let next = groupMap.get(group)
+      if (!next) {
+        next = mintId('group', taken)
+        groupMap.set(group, next)
+      }
+      return next
+    })
+  }
+  const copies = fragment.map((element) => {
+    const renamed = { ...element, id: idMap.get(element.id)! } as WhiteboardElement
+    if (element.groups) renamed.groups = regroup(element.groups)
+    const moved = translate(renamed, dx, dy)
+    if (moved.type === 'sticker' && moved.attachedTo !== undefined) {
+      const target = idMap.get(moved.attachedTo)
+      return target ? { ...moved, attachedTo: target } : detach(moved)
+    }
+    if (moved.type !== 'arrow') return moved
+    const remap = (end: ArrowEnd): ArrowEnd => {
+      if (!isBoundEnd(end)) return end
+      const target = idMap.get(end.elementId)
+      return target ? { ...end, elementId: target } : end
+    }
+    return { ...moved, from: remap(moved.from), to: remap(moved.to) }
+  })
+  const room = Math.max(0, MAX_ELEMENTS - board.elements.length)
+  const kept = copies.slice(0, room)
+  const keptIds = new Set(kept.map((element) => element.id))
+  // An arrow whose bound copy did not fit is dropped rather than left dangling.
+  const valid = kept.filter(
+    (element) =>
+      element.type !== 'arrow' ||
+      [element.from, element.to].every((end) => !isBoundEnd(end) || keptIds.has(end.elementId) || existing.has(end.elementId)),
+  )
+  return { board: { ...board, elements: [...board.elements, ...valid] }, ids: valid.map((element) => element.id) }
+}
+
+export type ReorderDirection = 'forward' | 'backward' | 'front' | 'back'
+
+/** Moves `ids` one step (or all the way) up or down the drawing order, keeping their relative order. */
+export function reorder(board: WhiteboardBoard, ids: readonly string[], direction: ReorderDirection): WhiteboardBoard {
+  const chosen = new Set(ids)
+  if (chosen.size === 0) return board
+  const elements = [...board.elements]
+  if (direction === 'front' || direction === 'back') {
+    const picked = elements.filter((element) => chosen.has(element.id))
+    const rest = elements.filter((element) => !chosen.has(element.id))
+    return { ...board, elements: direction === 'front' ? [...rest, ...picked] : [...picked, ...rest] }
+  }
+  if (direction === 'forward') {
+    for (let i = elements.length - 2; i >= 0; i--) {
+      if (chosen.has(elements[i].id) && !chosen.has(elements[i + 1].id)) {
+        ;[elements[i], elements[i + 1]] = [elements[i + 1], elements[i]]
+      }
+    }
+  } else {
+    for (let i = 1; i < elements.length; i++) {
+      if (chosen.has(elements[i].id) && !chosen.has(elements[i - 1].id)) {
+        ;[elements[i], elements[i - 1]] = [elements[i - 1], elements[i]]
+      }
+    }
+  }
+  return { ...board, elements }
+}
+
+// ---- describing a selection for the chat
+
+const quote = (text: string) => {
+  const flat = text.replace(/\s+/g, ' ').trim()
+  return flat.length > 80 ? `“${flat.slice(0, 79)}…”` : `“${flat}”`
+}
+
+function labelOf(element: WhiteboardElement | undefined): string {
+  if (!element) return 'a point'
+  switch (element.type) {
+    case 'note':
+    case 'text':
+      return element.text.trim() ? quote(element.text) : `an empty ${element.type}`
+    case 'shape':
+      return element.text?.trim() ? quote(element.text) : `a ${element.kind}`
+    case 'section':
+      return `section ${quote(element.title || 'Untitled')}`
+    case 'image':
+      return `image ${quote(element.alt || 'untitled')}`
+    case 'link':
+      return `link ${quote(element.title || element.url)}`
+    case 'sticker':
+      return `a ${element.sticker} sticker`
+    case 'table':
+      return `a ${element.rows.length}×${element.rows[0]?.length ?? 0} table`
+    default:
+      return `a ${element.type}`
+  }
+}
+
+const NOUN: Record<WhiteboardElement['type'], [string, string]> = {
+  note: ['note', 'notes'],
+  shape: ['shape', 'shapes'],
+  text: ['text', 'texts'],
+  section: ['section', 'sections'],
+  arrow: ['arrow', 'arrows'],
+  stroke: ['sketch', 'sketches'],
+  image: ['image', 'images'],
+  sticker: ['sticker', 'stickers'],
+  table: ['table', 'tables'],
+  link: ['link card', 'link cards'],
+}
+
+/**
+ * A plain-text account of the selection for the agent: a count line, then one line per element
+ * (at most 40). It is data the agent reads, never instructions. `withIds` (Ask Buffy) ends each
+ * line with the element's id, so the agent can edit exactly those; a comment's quote leaves them out.
+ */
+export function describeSelection(board: WhiteboardBoard, ids: readonly string[], options: { withIds?: boolean } = {}): string {
+  const byId = new Map(board.elements.map((element) => [element.id, element]))
+  const picked = ids.map((id) => byId.get(id)).filter((element): element is WhiteboardElement => !!element)
+  if (picked.length === 0) return ''
+  const counts = new Map<WhiteboardElement['type'], number>()
+  for (const element of picked) counts.set(element.type, (counts.get(element.type) ?? 0) + 1)
+  const head = [...counts]
+    .map(([type, count]) => `${count} ${NOUN[type][count === 1 ? 0 : 1]}`)
+    .join(', ')
+  const lines = picked.slice(0, 40).map((element) => (options.withIds ? `${describeLine(element)} [id ${element.id}]` : describeLine(element)))
+  const more = picked.length > 40 ? [`- …and ${picked.length - 40} more`] : []
+  return [`${head} on “${board.title}”:`, ...lines, ...more].join('\n')
+
+  function describeLine(element: WhiteboardElement): string {
+    switch (element.type) {
+      case 'note':
+        return `- note ${labelOf(element)} (${element.color}${element.votes ? `, ${element.votes} vote${element.votes === 1 ? '' : 's'}` : ''})`
+      case 'shape':
+        return `- ${element.kind} ${labelOf(element)}${element.timer ? ` (a ${Math.round(element.timer.duration / 60) || 1} min timer)` : ''}`
+      case 'text':
+        return `- text ${labelOf(element)}`
+      case 'section':
+        return `- ${labelOf(element)}`
+      case 'image':
+      case 'sticker':
+        return `- ${labelOf(element)}`
+      case 'link':
+        return `- ${labelOf(element)} (${element.url})`
+      case 'table': {
+        const head = element.rows[0].map((cell) => cell.trim()).filter(Boolean).join(' | ')
+        return `- ${labelOf(element)}${head ? `: ${quote(head)}` : ''}`
+      }
+      case 'stroke':
+        return `- a ${element.color} marker sketch`
+      case 'arrow': {
+        const end = (e: ArrowEnd) => (isBoundEnd(e) ? labelOf(byId.get(e.elementId)) : 'a point')
+        const label = element.label ? ` labelled ${quote(element.label)}` : ''
+        return `- arrow from ${end(element.from)} to ${end(element.to)}${label}`
+      }
+    }
+  }
+}
+
+/** The world point at the centre of a list of points (the paste target when nothing better is known). */
+export function centroid(points: readonly Point[]): Point {
+  if (points.length === 0) return { x: 0, y: 0 }
+  const sum = points.reduce((acc, p) => ({ x: acc.x + p.x, y: acc.y + p.y }), { x: 0, y: 0 })
+  return { x: sum.x / points.length, y: sum.y / points.length }
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/whiteboard-r2.test.ts b/common/src/desktop-cloud/artifact-kinds/whiteboard-r2.test.ts
