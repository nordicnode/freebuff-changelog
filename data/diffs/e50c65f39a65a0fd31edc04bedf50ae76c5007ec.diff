+  switch (name) {
+    case 'SUM': {
+      const nums = collectNumbers(args, host)
+      return isError(nums) ? nums : finite(nums.reduce((s, n) => s + n, 0))
+    }
+    case 'AVERAGE': {
+      const nums = collectNumbers(args, host)
+      if (isError(nums)) return nums
+      if (nums.length === 0) return errors['#DIV/0!']
+      return finite(nums.reduce((s, n) => s + n, 0) / nums.length)
