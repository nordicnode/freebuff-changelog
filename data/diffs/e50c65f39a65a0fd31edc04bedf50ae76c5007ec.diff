+    const mine = insertLines(base, 't', 'row', 5, 1)
+    const theirs = book(
+      sparse({ rowMeta: { '2': { height: 60 }, '4': { height: 40 } }, merges: ['A1:B1'], rules: [{ id: 'r1', range: 'A2:A3', type: 'empty', style: { bg: 'red' } }] }),
+    )
