+/**
+ * The full authoring reference `artifact_guide {kind: "whiteboard"}` returns: the doc comment at
+ * the top of this file, for the agent, plus how to edit a stored board.
+ */
+export const WHITEBOARD_GUIDE = `Whiteboard (kind "whiteboard"): ONE JSON object, declarative data, never HTML. Every object is strict (an unknown key is refused).
+
+{ "version": 1, "title": "..." (<= 200 chars), "elements": [Element, ...] (<= ${MAX_ELEMENTS}, back to front: later entries draw on top), "noteTheme"?: ${NOTE_THEMES.join(' | ')} }
+"noteTheme" re-themes every sticky note at once (the colour names stay; absent is classic).
+
+Coordinates are world units (1 unit = 1 px at 100% zoom), x right, y down; x, y is an element's top-left. The canvas is infinite; start near (0, 0).
+Every element has a unique "id" (1-64 letters, digits, _ or -, e.g. "note-risk-1"). Keep the ids you read when editing.
+
+Elements, by "type":
+- note: { id, x, y, w, h, text, color }. Usually 200x200 for a short phrase, 240x160 for a sentence; keep it under ~25 words.
+- shape: { id, kind, x, y, w, h, text?, color }. kind: ${SHAPE_KINDS.join(', ')}. Flowcharts: rect a step, pill start/end, diamond a decision, parallelogram input/output, document a document, subroutine a predefined step, cylinder a database, queue a queue. System maps: cloud a cloud/external service, person a user or actor (its label sits under the figure). Usually 160x80 (diamond 160x120, cylinder 120x120, document 160x96, triangle 140x120, cloud 176x112, person 96x136). Text is centred.
+- text: { id, x, y, text, size, w? }. size: xs 12px, s 14, m 18, l 28, xl 44 (line height 1.3x). Without w a line never wraps. A board title is "xl" at the top-left.
+- section: { id, x, y, w, h, title, color? }. A titled frame: an element belongs to it when the element's centre is inside it, and moves with it. Put a section BEFORE its members in elements so it draws underneath. Pad 40 inside each edge and 48 at the top for the title.
+- arrow: { id, from, to, label?, style: "solid" | "dashed", head?: "end" (default) | "start" | "both" | "none", color?, stroke? }. Each end is { "elementId": "...", "side"?: top|right|bottom|left } (bound: it follows the element; leave side out for the nearest) or { "x", "y" } (a free point). Never bound to an arrow, a stroke or itself. Labels are 1-4 words.
+- stroke: { id, points: [[x, y], ...] (1-${MAX_STROKE_POINTS}), color, width (1-48, usually 4) }. A marker sketch; rarely needed.
+- image: { id, x, y, w, h, src, alt, crop? }. src is an uploaded "/_asset/<id>" ref: for any picture from the web, call import_artifact_image first and use the ref it returns (read_artifact lists the board's assets). Never hotlink an https:// URL (readers see a placeholder instead of it), and never data: or javascript:. "crop": { "x", "y", "w", "h" } is the part shown, in fractions 0-1 of the whole picture (absent shows it all); keep w/h of the element in the crop's proportions.
+- sticker: { id, x, y, w, h, sticker, attachedTo? }. sticker: ${STICKERS.join(', ')}. Usually 56x56; stick a few on a note's corner to vote. "attachedTo": an element id: the sticker moves and copies with that element (an id the board lacks is ignored).
+- table: { id, x, y, w, h, rows: [["Name", "Owner"], ["Auth", "Ana"]], header?: true, color? }. Every row has the same number of cells (<= ${MAX_TABLE_COLS} columns, <= ${MAX_TABLE_ROWS} rows, <= ${MAX_CELL_TEXT} chars a cell); columns and rows are equal unless weighted. Size it 140 per column and 40 per row. "colWidths": [1, 2, 1] and "rowHeights" are relative weights, one per column or row (a list of the wrong length is ignored and draws evenly); "merges": [{ "row", "col", "rows", "cols" }] (at most ${MAX_TABLE_MERGES}, counted from 0) draws that block of cells as one, holding the top-left cell's text. Prefer the tableEdit op to keep these in step.
+- link: { id, x, y, w, h, url, title, color?, artifact? }. A card for a web page: url is https:// only; usually 280x96. The card shows the title and host only. "artifact": { "id": "<artifact uuid>", "kind": ${ARTIFACT_KINDS.map((k) => `"${k}"`).join(' | ')} } makes it a card for another Freebuff artifact (a click opens it; url is then ${artifactCardUrl('<id>')}): add one with the linkArtifact op.
+Optional on every element: "groups": ["group-id", ...] (innermost first; a click selects the whole outermost group, so give elements that belong together one shared id) and "locked": true (the reader's editor will not move, resize, edit or delete it: use it for a template's frame or legend) and "hidden": true (invisible to readers: not drawn, exported or shown on a shared link, and arrows bound to it hide too; the layers panel can show it again. Use it for speaker notes or a draft, never to keep a secret).
+Notes and shapes: "fontSize": xs|s|m|l|xl (absent fits the text to the box), and their text may use **bold**, *italic* and lines starting with "- " as bullets.
+Arrows: "startHead" / "endHead": ${ARROWHEAD_SHAPES.join(' | ')} is the shape at that end (absent: a triangle where "head" puts one, none elsewhere). "routing": "elbow" draws right angles (good for flowcharts and org charts; absent or "curved" is a curve, "straight" one straight segment) and, without a "bend", routes itself round any box in its way; "bend": a number moves an elbow's middle segment that far (and turns that routing off); "labelAt": 0-1 is where the label sits (absent 0.5).
+Notes: "votes": 0-${MAX_VOTES} is a dot-vote tally drawn as a badge; "autoSize": true makes the note's height follow its text in the editor. Sections: "stack": true makes a kanban column (notes dropped in stack top to bottom, one column wide; set it with the stackSection op, which also lays the column out). "noteColor": a colour name that notes the reader adds or drags into the section take in the editor (your addElements and moveElements do not recolour: give such notes that "color" yourself). Shapes: "timer": { "duration": seconds 1-${MAX_TIMER_SECONDS}, "startedAt"?: epoch ms while running, "elapsed"?: seconds used before } turns the shape into a countdown (use the "timer" op to start, pause or reset it).
+Colours are names: ${COLORS.join(', ')}. The app maps each to the reader's theme. "fill" and "stroke" (notes, shapes, sections, tables, link cards; "stroke" on arrows) override the fill and the outline separately, each a colour name or a "#rrggbb" hex drawn as is: use names unless asked for an exact colour.
+Text fields are at most ${MAX_TEXT} chars; coordinates stay within +-1,000,000 and sizes 1-20,000.
+
+Layout, so nothing overlaps and the board reads well:
+- Work on an 8-unit grid. 40 units between neighbouring notes or shapes, 80 between groups or sections.
+- A row of 200-wide notes sits at x, x+240, x+480...; a column at y, y+240...
+- A section around a grid of C x R notes of 200x200 is 40 + C*200 + (C-1)*40 + 40 wide and 48 + R*200 + (R-1)*40 + 40 tall (3x2: 760 x 528).
+- Flows read left to right: shapes 240 apart (160 wide + 80 for the arrow and its label), rows 160 apart. Bind arrows to elements, not points. A decision is a diamond with labelled "yes"/"no" arrows.
+- A brainstorm is sections by theme with notes inside; a system map is shapes (cylinders for stores, clouds for outside services, persons for users) joined by labelled arrows, with sections for boundaries (a cloud account, a service).
+- Swimlanes: one section per team or actor, stacked edge to edge (each 200 tall, all the same width, no gap), steps inside the lane that does them, elbow arrows between steps across lanes. The "swimlanes" template is a ready start.
+- Use at most four colours, each with one meaning (e.g. yellow ideas, green decided, red risks, gray context), and say so in a small text legend when it is not obvious.
+- Title the board with an xl text above the content, plus a one-line takeaway under it (an "m" text: what the reader should come away with), and keep the whole board compact: the reader zooms to fit.
+
+Example: ${JSON.stringify(WHITEBOARD_EXAMPLE)}
+
+Editing a stored board: edit_artifact with patch, a list of ops applied in order and then validated as a whole (any failure changes nothing):
+- {"op":"addElements","elements":[{...}, ...],"place"?:{"near":"<element id>"} | {"section":"<section id>"}}. A missing id is minted (like "note-3"). With place, leave x and y out: each element is put in the nearest free spot beside that element, or in reading order inside that section (refused when the section is full: grow it first). Without place, x and y are required. Missing sizes default (note 200x200, shape 160x80, diamond 160x120, cylinder 120x120); a missing note colour is yellow, shape colour blue, arrow style solid. Sections are inserted beneath the elements they cover.
+- {"op":"updateElement","id":"...","props":{"text":"...","color":"green"}} (merges; null removes an optional field; id and type never change)
+- {"op":"removeElements","ids":[...]} (arrows bound to a removed element are removed too, as when the reader deletes it in the editor; a removed section's members stay)
+- {"op":"connect","from":"<element id>","to":"<element id>","label"?:"...","style"?:"solid"|"dashed","id"?:"...","fromSide"?:"top"|"right"|"bottom"|"left","toSide"?:...,"routing"?:"curved"|"elbow"|"straight","head"?:"end"|"start"|"both"|"none","color"?:"<colour name>"} (a bound arrow; sides absent are chosen nearest)
+- {"op":"tableEdit","id":"<table id>","action":"insertRow"|"deleteRow"|"insertCol"|"deleteCol","at"?:n} (insert before row/column n, or delete row/column n; at absent = the end/last. The table grows or shrinks by one row or column; at least 1 row and 1 column stay; weights and merges shift with it). More actions, each with only its own fields (rows and columns count from 0): "action":"merge","row":r,"col":c,"rows":2,"cols":1 (one cell from there; every merged cell's text is kept, joined into the top-left); "action":"unmerge","row":r,"col":c (splits the merge covering that cell); "action":"resizeCol"|"resizeRow","at":n,"weight":2 (that column's or row's relative weight; the others keep theirs, 1 when none were set); "action":"header","on":true|false (the first row as a header)
+- {"op":"vote","id":"<note id>","by"?:1 | "count"?:3} (add to a note's votes, negative to remove, or set them; 0 clears)
+- {"op":"tally","ids"?:[...]} (sets each note's votes to the stickers attached to it or sitting on it; ids absent = every note with a sticker)
+- {"op":"sortByVotes","ids":[note ids]} (most votes first: the notes swap places so reading order follows the votes; stickers on them come along)
+- {"op":"clusterNotes","ids"?:[note ids],"gap"?:80} (groups notes that sit within gap of each other, or share a section, so each cluster selects and moves as one; ids absent = every note)
+- {"op":"timer","id":"<shape id>","action":"start"|"pause"|"reset","duration"?:seconds} (adds the countdown to a shape when it has none; duration sets or changes it)
+- {"op":"crop","id":"<image id>","crop":{"x":0.1,"y":0,"w":0.8,"h":1}} | "trims":{"left":0.1,"top":0,"right":0.1,"bottom":0} | "reset":true (exactly one: the part shown, in fractions of the whole picture, or trims off each edge (each pair at most 0.95). The box shrinks with the crop so the picture keeps its scale; reset shows the whole picture again at that scale)
+- {"op":"setHidden","ids":[...],"hidden":true|false} (hides elements from readers, or shows them again)
+- {"op":"setLocked","ids":[...],"locked":true|false} (locks elements against the reader's editor, or unlocks them)
+- {"op":"arrowHeads","ids":[arrow ids],"start"?:"${ARROWHEAD_SHAPES.join('"|"')}","end"?:...} (the shape at each end; an end left out keeps its shape; "none" draws nothing)
+- {"op":"linkArtifact","artifactId":"<artifact uuid>","kind":"doc"|"slides"|"sheet"|"data"|"whiteboard"|"design","title":"...","x"?:0,"y"?:0,"place"?:{"near":"<element id>"}} (adds a 280x96 card for another Freebuff artifact: x, y is its top-left, or with place it sits 40 to the right of that element, centred on it. artifactId is the artifact's UUID as create_artifact or list_artifacts gave it)
+- {"op":"layoutSubtree","root":"<element id>","direction"?:"right"|"down"} (a tidy mind-map tree: everything the root's bound arrows reach, one rank per level, siblings stacked, each parent centred on its children; the root stays put, locked nodes stay)
+- {"op":"addChild","parent":"<element id>","text"?:"...","direction"?:"right"|"down"} (mind map: a new node like the parent (a note or shape keeps its type, size and colour) joined to it by an arrow, then the parent's whole tree is laid out again from its root; read the board to find the new id)
+- {"op":"attachSticker","ids":[sticker ids]} (attaches each sticker to the element under its centre, so it moves and copies with it, or frees it when it sits on nothing)
+- {"op":"stackSection","id":"<section id>","stack":true|false} (makes a section a kanban column and lays its notes out top to bottom in reading order, growing it to fit; false only clears the flag)
+- {"op":"noteTheme","theme":"${NOTE_THEMES.join('"|"')}" | null} (re-themes every sticky note; null or "classic" clears it)
+- {"op":"moveElements","ids":[...],"dx":240,"dy":0} (a section brings its members; bound arrows follow)
+- {"op":"arrange","ids":[...],"mode":"left"|"center"|"right"|"top"|"middle"|"bottom"|"distribute-horizontal"|"distribute-vertical"} (align to the selection's own edge or centre, or even out the gaps of 3+; a group moves as one; locked elements and arrows stay)
+- {"op":"tidy","ids":[...],"layout":"grid"|"tree"|"flow"} (lays 2+ elements out afresh from the selection's top-left: grid = a near-square grid in reading order; tree = top-down from the elements nothing points at, following the bound arrows between them; flow = left-to-right ranks by the longest chain of arrows. 40 between neighbours, 80 between ranks, on the 8-unit grid; a group moves as one, a section brings its members, locked elements and arrows stay. Use it after adding many elements instead of computing coordinates)
+- {"op":"group","ids":[...]} / {"op":"ungroup","ids":[...]} (group wraps 2+ elements in a new outer group; ungroup removes the outermost group of each)
+- {"op":"reorder","ids":[...],"to":"front"|"back"|"forward"|"backward"} or {"op":"reorder","ids":["<one id>"],"index":0} (the drawing order, as the editor's Bring to front / Send to back: front and back move them to the top or bottom, forward and backward one step past their neighbour, keeping their order among themselves; index puts one element at an exact place in elements, 0 = bottom)
+- {"op":"applyTemplate","template":"brainstorm"|"flowchart"|"kanban"|"retro"|"user-journey"|"matrix"|"swimlanes"|"swot"|"mind-map"|"roadmap"|"dot-voting","at"?:{"x":0,"y":0}} (adds a ready-made layout: on an empty board with readable ids and the template's title, else below the content, or with its top-left at "at", with fresh ids; then fill it in with updateElement)
+- generic {"op":"set"|"insert"|"remove","path":"/elements/3/text","value":...} on a JSON pointer.
+read_artifact's summary lists every element by id, each section with its members and each arrow as "A → B (label)". Hidden elements stay in the body, but are invisible to readers.
+It ends with a "Checks:" list, the same checks the reader's Checks panel shows: overlaps (two boxes covering each other), cut-off text (a note, shape or table cell whose text does not fit), tiny text (it fits only below 12px), half-in-section (an element straddling a section's edge), dangling arrows (an end on a free point) and duplicate arrows (two joining the same two elements), and low contrast (a #rrggbb line that vanishes on one theme). Each names the ids and a fix: fix every one before you finish (move, resize, shorten, tidy), then read again.`
diff --git a/common/src/desktop-cloud/artifact-merge.property.test.ts b/common/src/desktop-cloud/artifact-merge.property.test.ts
new file mode 100644
index 000000000..cac233163
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-merge.property.test.ts
@@ -0,0 +1,250 @@
+import { describe, expect, test } from 'bun:test'
+
+import {
+  applyDoc,
+  applyKeyed,
+  applySheet,
+  DESIGN,
+  DESIGN_FRAMES,
+  docBase,
+  docScript,
+  docTouches,
+  expectDoc,
+  expectKeyed,
+  expectSheet,
+  frameKids,
+  KEYED_SPECS,
+  keyedScript,
+  relativeOrder,
+  rng,
+  sheetBase,
+  sheetScript,
+  survivingValues,
+  type KeyedModel,
+  type KeyedSpec,
+  type Side,
+} from './__tests__/merge-generators'
+import { mergeArtifactBodies, type ArtifactMergeResult } from './artifact-merge'
+import { parseBoard } from './artifact-kinds/whiteboard'
+import { parseDashboard } from './artifact-kinds/data'
+import { validateDesign } from './artifact-kinds/design'
+import { parseDeck } from './artifact-kinds/slides'
+import { parseWorkbook } from './artifact-kinds/sheet'
+
+import type { ArtifactKind } from './artifacts'
+
+// Random bases and random edit scripts for both sides, per kind, checked against what the scripts
+// say a merge must give. Deterministic: a failure names its seed and case.
+
+const CASES = 250
+const SEED = 0x5eed
+
+const VALID: Record<Exclude<ArtifactKind, 'doc'>, (value: unknown) => boolean> = {
+  slides: (v) => parseDeck(v).ok,
+  whiteboard: (v) => parseBoard(v).ok,
+  data: (v) => parseDashboard(v).ok,
+  design: (v) => validateDesign(v).ok,
+  sheet: (v) => parseWorkbook(v).ok,
+}
+
+const json = (value: unknown) => JSON.stringify(value)
+const body = (result: ArtifactMergeResult, what: string): string => {
+  if (!result.ok) throw new Error(`${what}: expected a merge, got conflicts ${result.conflicts.join(', ')}`)
+  return result.body
+}
+
+function checkUnits(result: ArtifactMergeResult, what: string) {
+  if (result.ok) return
+  expect(result.units.length, what).toBeGreaterThan(0)
+  expect(new Set(result.units.map((u) => u.key)).size, `${what}: unit keys are unique`).toBe(result.units.length)
+  expect(result.conflicts, what).toEqual(result.units.map((u) => u.label))
+}
+
+/** merge(base, x, x) = x, merge(base, base, t) = t, merge(base, m, base) = m, and the result re-merged against theirs is stable. */
+function checkIdempotence(kind: ArtifactKind, base: string, mine: string, theirs: string, merged: string | null, what: string) {
+  expect(mergeArtifactBodies(kind, base, mine, mine), what).toEqual({ ok: true, body: mine })
+  expect(mergeArtifactBodies(kind, base, base, theirs), what).toEqual({ ok: true, body: theirs })
+  expect(mergeArtifactBodies(kind, base, mine, base), what).toEqual({ ok: true, body: mine })
+  if (merged === null) return
+  const again = mergeArtifactBodies(kind, base, merged, theirs)
+  const parse = (text: string) => (kind === 'doc' ? text : JSON.parse(text))
+  expect(again.ok ? parse(again.body) : again.conflicts, `${what}: re-merge`).toEqual(parse(merged))
+}
+
+describe('keyed kinds: entities edited, added, deleted and reordered on both sides', () => {
+  for (const spec of KEYED_SPECS) {
+    const name = spec.name ?? spec.kind
+    test(`${name}: ${CASES} random cases`, () => {
+      const r = rng(SEED + name.length)
+      let merged = 0
+      let clashed = 0
+      for (let c = 0; c < CASES; c += 1) {
+        const outcome = runKeyedCase(spec, r, `${name} seed ${SEED} case ${c}`)
+        if (outcome === true) merged += 1
+        else if (outcome === false) clashed += 1
+      }
+      // Both outcomes are exercised: clean merges and conflicts.
+      expect(merged).toBeGreaterThan(CASES / 10)
+      expect(clashed).toBeGreaterThan(CASES / 10)
+    })
+  }
+})
+
+/** Whether the case merged cleanly; null when it was skipped (over the kind's list cap). */
+function runKeyedCase(spec: KeyedSpec, r: ReturnType<typeof rng>, what: string): boolean | null {
+  const base = spec.base(r)
+  const reorderer: Side | null = r.chance(0.3) ? r.pick(['mine', 'theirs'] as const) : null
+  const mineModel = applyKeyed(base, keyedScript(r, spec, base, reorderer === 'mine'))
+  const theirModel = applyKeyed(base, keyedScript(r, spec, base, reorderer === 'theirs'))
+  const [b, m, t] = [base, mineModel, theirModel].map((model) => json(spec.render(model)))
+  expect(VALID[spec.kind](JSON.parse(b!)), `${what}: base valid`).toBe(true)
+
+  const expected = expectKeyed(base, mineModel, theirModel)
+  const over = (count: number) => spec.max !== undefined && count > spec.max
+  if ([mineModel, theirModel].some((model) => over(model.order.length)) || over(Object.keys(expected.ents).length)) return null
+  for (const side of ['mine', 'theirs'] as const) if (over(Object.keys(expectKeyed(base, mineModel, theirModel, side).ents).length)) return null
+  const orderClash = spec === DESIGN && designOrderClash(base, mineModel, theirModel)
+  const result = mergeArtifactBodies(spec.kind, b!, m!, t!)
+  checkUnits(result, what)
+  // (ii) a unit changed differently on both sides is reported, never silently dropped.
+  expect(result.ok, `${what}: conflicts ${expected.conflicts.join(', ')} ${result.ok ? '' : result.conflicts.join(', ')}`).toBe(
+    expected.conflicts.length === 0 && !orderClash,
+  )
+  if (result.ok) {
+    const out = JSON.parse(result.body)
+    // (iii) the merge is a body of this kind.
+    expect(VALID[spec.kind](out), `${what}: merged valid`).toBe(true)
+    // (i) every unit changed on one side has that side's value; untouched units stay.
+    const got = spec.extract(out)
+    expect(got.ents, what).toEqual(expected.ents)
+    expect(new Set(got.order), what).toEqual(new Set(Object.keys(expected.ents)))
+    if (spec !== DESIGN) {
+      // One side's reorder of the entities both kept is the merged order of them.
+      const both = new Set(base.order.filter((id) => id in expected.ents && id in mineModel.ents && id in theirModel.ents))
+      const reference = reorderer === 'mine' ? mineModel.order : theirModel.order
+      expect(relativeOrder(got.order, both), `${what}: order`).toEqual(relativeOrder(reference, both))
+    }
+  }
+  // (iv) idempotence.
+  checkIdempotence(spec.kind, b!, m!, t!, result.ok ? result.body : null, what)
+
+  // (v) Keep mine / Keep theirs: always a valid body, nothing changed on one side only is lost,
+  // and each clashing unit takes the chosen side.
+  for (const side of ['mine', 'theirs'] as const) {
+    const settled = mergeArtifactBodies(spec.kind, b!, m!, t!, { resolve: side })
+    const out = JSON.parse(body(settled, `${what} resolve ${side}`))
+    expect(VALID[spec.kind](out), `${what} resolve ${side}: valid`).toBe(true)
+    expect(spec.extract(out).ents, `${what} resolve ${side}`).toEqual(expectKeyed(base, mineModel, theirModel, side).ents)
+  }
+  return result.ok
+}
+
+/** A design frame whose child list both sides changed differently (its order is one unit). */
+function designOrderClash(b: KeyedModel, m: KeyedModel, t: KeyedModel): boolean {
+  return DESIGN_FRAMES.some((frame) => {
+    const [bk, mk, tk] = [b, m, t].map((model) => json(frameKids(model, frame)))
+    return bk !== mk && bk !== tk && mk !== tk
+  })
+}
+
+describe('doc: blocks edited, deleted and inserted on both sides', () => {
+  test(`${CASES} random cases`, () => {
+    const r = rng(SEED)
+    for (let c = 0; c < CASES; c += 1) {
+      const what = `doc seed ${SEED} case ${c}`
+      const base = docBase(r)
+      const mine = docScript(r, base)
+      const theirs = docScript(r, base)
+      const join = (blocks: string[]) => `${blocks.join('\n\n')}\n`
+      const [b, m, t] = [base, applyDoc(base, mine), applyDoc(base, theirs)].map(join)
+      const result = mergeArtifactBodies('doc', b!, m!, t!)
+      checkUnits(result, what)
+      const [mt, tt] = [docTouches(mine), docTouches(theirs)]
+      const near = mt.some((x) => tt.some((y) => Math.abs(x - y) < 3))
+      const sameBlock = [...mine.edits.keys(), ...mine.deletes].some(
+        (i) => (theirs.edits.has(i) && theirs.edits.get(i) !== mine.edits.get(i)) || (theirs.deletes.has(i) && mine.edits.has(i)),
+      )
+      // (ii) the same block changed differently is reported; (i) changes apart always merge.
+      if (sameBlock) expect(result.ok, what).toBe(false)
+      if (!near) expect(result.ok, `${what}: ${result.ok ? '' : result.conflicts.join(', ')}`).toBe(true)
+      // When it merges, it is exactly both scripts applied.
+      if (result.ok) {
+        // Exactly both scripts applied; two insertions at one gap that each joined a neighbouring
+        // hunk of their own side do not clash, and either may come first.
+        const shared = [...mine.inserts.keys()].some((p) => theirs.inserts.has(p))
+        const sorted = (blocks: string[]) => (shared ? [...blocks].sort() : blocks)
+        expect(sorted(result.body.trim().split('\n\n')), what).toEqual(sorted(expectDoc(base, mine, theirs)))
+      }
+      // Re-merging under the OLD base is only stable when the two sides' changes sit apart: a
+      // block hunk of the result that spans both sides' adjacent changes overlaps theirs (diff3).
+      checkIdempotence('doc', b!, m!, t!, result.ok && !near ? result.body : null, what)
+      // (v) settled either way: every change of one side away from the other side's survives.
+      for (const side of ['mine', 'theirs'] as const) {
+        const settled = body(mergeArtifactBodies('doc', b!, m!, t!, { resolve: side }), `${what} resolve ${side}`)
+        const blocks = settled.trim().split('\n\n')
+        for (const [script, touches, others] of [[mine, mt, tt], [theirs, tt, mt]] as const) {
+          // A side's changes that touch (adjacent blocks, a block and the gap beside it) are one
+          // hunk, and a clashing hunk is settled whole; so "apart" is the change's whole run.
+          const run = (x: number) => {
+            const sorted = [...touches].sort((p, q) => p - q)
+            let [lo, hi] = [x, x]
+            for (const y of sorted) if (y > hi && y - hi <= 2) hi = y
+            for (const y of [...sorted].reverse()) if (y < lo && lo - y <= 2) lo = y
+            return [lo, hi] as const
+          }
+          const apart = (x: number) => {
+            const [lo, hi] = run(x)
+            return others.every((y) => y <= lo - 3 || y >= hi + 3)
+          }
+          for (const [i, text] of script.edits) if (apart(2 * i + 1)) expect(blocks, `${what} resolve ${side}: edit`).toContain(text)
+          for (const i of script.deletes) if (apart(2 * i + 1)) expect(blocks, `${what} resolve ${side}: delete`).not.toContain(base[i])
+          for (const [p, texts] of script.inserts) if (apart(2 * p)) for (const text of texts) expect(blocks, `${what} resolve ${side}: insert`).toContain(text)
+        }
+      }
+    }
+  })
+})
+
+describe('sheet: cell edits, row/column inserts and deletes, tab rename and delete on both sides', () => {
+  test(`${CASES} random cases`, () => {
+    const r = rng(SEED + 7)
+    let rebased = 0
+    for (let c = 0; c < CASES; c += 1) {
+      const what = `sheet seed ${SEED + 7} case ${c}`
+      const base = sheetBase(r)
+      const mine = sheetScript(r, base)
+      const theirs = sheetScript(r, base)
+      const [b, m, t] = [base.workbook, applySheet(base.workbook, mine), applySheet(base.workbook, theirs)].map(json)
+      expect(VALID.sheet(JSON.parse(b!)), `${what}: base valid`).toBe(true)
+      const expected = expectSheet(base.workbook, mine, theirs)
+      const result = mergeArtifactBodies('sheet', b!, m!, t!)
+      checkUnits(result, what)
+      expect(result.ok, `${what}: expected ${expected.conflicts.join(', ') || 'a merge'}, got ${result.ok ? 'a merge' : result.conflicts.join(', ')}`).toBe(
+        expected.conflicts.length === 0,
+      )
+      if (result.ok && expected.workbook) {
+        const out = JSON.parse(result.body)
+        expect(VALID.sheet(out), `${what}: merged valid`).toBe(true)
+        // Every cell where the scripts put it (shifted by the other side's line edit), formulas
+        // in every tab pointing at the shifted cells.
+        const cells = (book: any) => Object.fromEntries(book.tabs.map((tab: any) => [tab.id, { name: tab.name, rows: tab.rows, cols: tab.cols, cells: tab.cells }]))
+        expect(cells(out), what).toEqual(cells(expected.workbook))
+        if ((mine.line || theirs.line) && (mine.edits.length || theirs.edits.length)) rebased += 1
+      }
+      checkIdempotence('sheet', b!, m!, t!, result.ok ? result.body : null, what)
+      for (const side of ['mine', 'theirs'] as const) {
+        const settled = mergeArtifactBodies('sheet', b!, m!, t!, { resolve: side })
+        const out = JSON.parse(body(settled, `${what} resolve ${side}`))
+        expect(VALID.sheet(out), `${what} resolve ${side}: valid`).toBe(true)
+        if (expected.workbook) expect(out, `${what} resolve ${side}: no conflict, same merge`).toEqual(JSON.parse(body(result, what)))
+        // (v) nothing either side wrote is lost unless it clashed and the other side won.
+        const values = new Set(out.tabs.flatMap((tab: any) => Object.values(tab.cells).map((cell: any) => cell.v)))
+        for (const [script, other, is] of [[mine, theirs, 'mine'], [theirs, mine, 'theirs']] as const) {
+          for (const v of survivingValues(script, other, is, side)) expect(values.has(v), `${what} resolve ${side}: ${is}'s ${v}`).toBe(true)
+        }
+      }
+    }
+    // The generator really exercises the rebase.
+    expect(rebased).toBeGreaterThan(CASES / 5)
+  })
+})
diff --git a/common/src/desktop-cloud/artifact-merge.protection.test.ts b/common/src/desktop-cloud/artifact-merge.protection.test.ts
new file mode 100644
index 000000000..c033baef1
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-merge.protection.test.ts
@@ -0,0 +1,185 @@
+import { describe, expect, test } from 'bun:test'
+
+import { applySheet, rng, sheetBase, sheetScript } from './__tests__/merge-generators'
+import { mergeArtifactBodies } from './artifact-merge'
+import type { Workbook } from './artifact-kinds/sheet'
+import { protectionRefusal } from './artifact-kinds/sheet-guard'
+import { protectionInvariantViolation } from './artifact-kinds/sheet-protection-invariant'
+
+// A merge must never produce a body the protection check would have refused. The store checks a
+// non-owner's merged save against what it holds (theirs), so: when each side's own edit was a write
+// a non-owner could make (the guard accepts it against base), every merged result, clean or settled
+// toward either side, is accepted against theirs, and the protection invariant holds against both
+// base and theirs (sheet-protection.ts: protected cells, protection config and the names their
+// formulas read are unchanged).
+
+const CASES = 400
+const SEED = 0x9a7d
+
+/** The base with a protected block on Data and a protected formula on Sum. */
+function protect(base: Workbook, r: ReturnType<typeof rng>): Workbook {
+  const top = 1 + r.int(2)
+  return {
+    ...base,
+    tabs: base.tabs.map((tab) =>
+      tab.id === 'data'
+        ? { ...tab, protected: [{ id: 'p1', range: `A${top}:B${top + 1}`, note: 'locked' }] }
+        : tab.id === 'sum'
+          ? { ...tab, protected: [{ id: 'p1', range: 'A1:A2' }] }
+          : tab,
+    ),
+  }
+}
+
+const accepted = (before: Workbook, after: Workbook) => protectionRefusal(before, after, { owner: false }) === null
+
+/**
+ * Sometimes a conditional-format rule, a table or a validation on Data (over a protected range
+ * they are its cells' format), at a random place, so a merge meets them too.
+ */
+function withOverlay(r: ReturnType<typeof rng>, workbook: Workbook, rows: number): Workbook {
+  if (!r.chance(0.5)) return workbook
+  const top = 1 + r.int(rows)
+  const range = `${r.chance(0.5) ? 'A' : 'C'}${top}:${r.chance(0.5) ? 'B' : 'D'}${top + 1 + r.int(2)}`
+  const id = r.token('o')
+  return {
+    ...workbook,
+    tabs: workbook.tabs.map((tab) =>
+      tab.id !== 'data'
+        ? tab
+        : r.chance(0.5)
+          ? { ...tab, rules: [...(tab.rules ?? []), { id, range, type: 'gt' as const, value: r.int(9), style: { bg: 'red' as const } }] }
+          : r.chance(0.5)
+            ? { ...tab, tables: [...(tab.tables ?? []), { id, range }] }
+            : { ...tab, validations: [...(tab.validations ?? []), { kind: 'list' as const, range, options: [{ value: id }] }] },
+    ),
+  }
+}
+
+describe('sheet merge × protection: merging two accepted non-owner writes stays accepted', () => {
+  test(`${CASES} random cases`, () => {
+    const r = rng(SEED)
+    let checked = 0
+    for (let c = 0; c < CASES; c += 1) {
+      const what = `seed ${SEED} case ${c}`
+      const shape = sheetBase(r)
+      const base = protect(shape.workbook, r)
+      const mine = withOverlay(r, applySheet(base, sheetScript(r, shape)), shape.rows)
+      const theirs = withOverlay(r, applySheet(base, sheetScript(r, shape)), shape.rows)
+      if (!accepted(base, mine) || !accepted(base, theirs)) continue
+      checked += 1
+      const [b, m, t] = [base, mine, theirs].map((w) => JSON.stringify(w))
+      for (const resolve of [undefined, 'mine', 'theirs'] as const) {
+        const result = mergeArtifactBodies('sheet', b!, m!, t!, resolve ? { resolve } : {})
+        if (!result.ok) continue
+        const merged = JSON.parse(result.body) as Workbook
+        const label = `${what} resolve ${resolve ?? 'none'}`
+        expect(protectionRefusal(theirs, merged, { owner: false }), `${label}: the store would refuse the merge`).toBeNull()
+        expect(protectionInvariantViolation(base, merged), `${label}: invariant vs base`).toBeNull()
+        expect(protectionInvariantViolation(theirs, merged), `${label}: invariant vs theirs`).toBeNull()
+      }
+    }
+    // Enough accepted pairs to mean something.
+    expect(checked).toBeGreaterThan(CASES / 10)
+  })
+})
+
+describe('sheet merge × protection: the owner protected cells this editor changed meanwhile', () => {
+  test(`${CASES} random cases`, () => {
+    const r = rng(SEED + 1)
+    let merged = 0
+    let conflicts = 0
+    for (let c = 0; c < CASES; c += 1) {
+      const what = `seed ${SEED + 1} case ${c}`
+      const shape = sheetBase(r)
+      const base = shape.workbook
+      const mine = withOverlay(r, applySheet(base, sheetScript(r, shape)), shape.rows)
+      // Theirs: the owner adds (or, with a protection already there, resizes) one over Data.
+      const top = 1 + r.int(shape.rows)
+      const owner = applySheet(base, { edits: [] })
+      const theirs: Workbook = {
+        ...owner,
+        tabs: owner.tabs.map((tab) =>
+          tab.id === 'data' ? { ...tab, protected: [{ id: 'p1', range: `A${top}:${r.chance(0.5) ? 'C' : 'B'}${top + r.int(2)}` }] } : tab,
+        ),
+      }
+      const [b, m, t] = [base, mine, theirs].map((w) => JSON.stringify(w))
+      for (const resolve of [undefined, 'mine', 'theirs'] as const) {
+        const result = mergeArtifactBodies('sheet', b!, m!, t!, resolve ? { resolve } : {})
+        if (!result.ok) {
+          // Only an unsettled merge may stop on the owner's new protection.
+          expect(resolve, `${what}: a resolution always settles it`).toBeUndefined()
+          conflicts += 1
+          continue
+        }
+        merged += 1
+        const out = JSON.parse(result.body) as Workbook
+        // The editor's save of this merge goes to the store against theirs.
+        expect(protectionRefusal(theirs, out, { owner: false }), `${what} resolve ${resolve ?? 'none'}`).toBeNull()
+        // Every value is a unique token: one showing up twice is a row the overlay put on shifted lines.
+        const values = Object.values(out.tabs.find((tab) => tab.id === 'data')?.cells ?? {}).flatMap((cell) => (typeof cell.v === 'string' ? [cell.v] : []))
+        expect(new Set(values).size, `${what} resolve ${resolve ?? 'none'}: a value doubled`).toBe(values.length)
+      }
+    }
+    expect(merged).toBeGreaterThan(0)
+    // The generator really produces edits that reach the owner's new range.
+    expect(conflicts).toBeGreaterThan(0)
+  })
+})
+
+/** The owner's own change to the Data tab's protections: one added, p1 removed, or p1 resized. */
+function ownerProtects(r: ReturnType<typeof rng>, workbook: Workbook, rows: number): Workbook {
+  const roll = r.int(3)
+  const top = 1 + r.int(rows)
+  return {
+    ...workbook,
+    tabs: workbook.tabs.map((tab) => {
+      if (tab.id !== 'data') return tab
+      const list = tab.protected ?? []
+      const next =
+        roll === 0
+          ? [...list, { id: 'p2', range: `C${top}:C${top + r.int(2)}` }]
+          : roll === 1
+            ? list.filter((p) => p.id !== 'p1')
+            : list.map((p) => (p.id === 'p1' ? { ...p, range: p.range.replace(/:B(\d+)$/, (_, n: string) => `:C${Number(n) + 1}`) } : p))
+      const { protected: _old, ...rest } = tab
+      return next.length ? { ...rest, protected: next } : rest
+    }),
+  }
+}
+
+describe('sheet merge × protection: the owner is "mine" (their draft changed protections), an editor wrote meanwhile', () => {
+  test(`${CASES} random cases`, () => {
+    const r = rng(SEED + 2)
+    let checked = 0
+    let kept = 0
+    for (let c = 0; c < CASES; c += 1) {
+      const what = `seed ${SEED + 2} case ${c}`
+      const shape = sheetBase(r)
+      const base = protect(shape.workbook, r)
+      const mine = ownerProtects(r, applySheet(base, sheetScript(r, shape)), shape.rows)
+      const script = sheetScript(r, shape)
+      const theirs = applySheet(base, script)
+      // Each side's own write is one the store takes: the owner's as the owner's, theirs as an editor's.
+      if (protectionRefusal(base, mine, { owner: true }) !== null || !accepted(base, theirs)) continue
+      checked += 1
+      const [b, m, t] = [base, mine, theirs].map((w) => JSON.stringify(w))
+      for (const resolve of [undefined, 'mine', 'theirs'] as const) {
+        const result = mergeArtifactBodies('sheet', b!, m!, t!, { mineIsOwner: true, ...(resolve ? { resolve } : {}) })
+        if (!result.ok) continue
+        const out = JSON.parse(result.body) as Workbook
+        const label = `${what} resolve ${resolve ?? 'none'}`
+        // The owner's save of this merge goes to the store against theirs.
+        expect(protectionRefusal(theirs, out, { owner: true }), `${label}: the store would refuse the owner's merge`).toBeNull()
+        // The owner's protection change stands (theirs moved no line of Data, so no remap applies).
+        if (resolve !== 'theirs' && script.line?.tab !== 'data') {
+          const data = (w: Workbook) => w.tabs.find((tab) => tab.id === 'data')?.protected ?? []
+          expect(data(out), `${label}: the owner's protections`).toEqual(data(mine))
+          kept += 1
+        }
+      }
+    }
+    expect(checked).toBeGreaterThan(CASES / 10)
+    expect(kept).toBeGreaterThan(0)
+  })
+})
