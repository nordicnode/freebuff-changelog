+    expect(ok(applyDocOp(twice, { op: 'replaceText', find: 'cat', replace: 'dog', all: true }))).toBe('a dog\n\nthe dog\n')
+    expect(ok(applyDocOp(twice, { op: 'replaceText', find: 'cat', replace: 'dog', block: 1 }))).toBe('a cat\n\nthe dog\n')
