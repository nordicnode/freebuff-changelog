+const RADIUS: Record<string, string> = { '2px': 'rounded-sm', '4px': 'rounded', '6px': 'rounded-md', '8px': 'rounded-lg', '12px': 'rounded-xl', '16px': 'rounded-2xl', '24px': 'rounded-3xl', '999px': 'rounded-full', '50%': 'rounded-full' }
