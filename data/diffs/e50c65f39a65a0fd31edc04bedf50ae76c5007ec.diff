+import { DESIGN_LIMITS, type Design, type DesignBoard, type DesignNode, type DesignNote, type DesignTokens, type FrameNode } from './design'
+
+/**
+ * Pure operations on a design: find, update, insert, remove, duplicate and reorder nodes and
+ * boards. Every function returns a new design (structural sharing; the input is never mutated)
+ * and leaves it valid: ids stay unique, duplicates get fresh ids for their whole subtree.
+ */
+
+export type NodeHit = {
+  node: DesignNode
+  parent: FrameNode | null
+  index: number
+  depth: number
+}
+
+export function* walkNodes(
+  root: DesignNode,
+  parent: FrameNode | null = null,
+  depth = 1,
+): Generator<NodeHit> {
+  const stack: NodeHit[] = [{ node: root, parent, index: 0, depth }]
+  while (stack.length > 0) {
+    const hit = stack.pop()!
+    yield hit
+    if (hit.node.type === 'frame') {
+      const frame = hit.node
+      for (let i = frame.children.length - 1; i >= 0; i -= 1) {
+        stack.push({ node: frame.children[i], parent: frame, index: i, depth: hit.depth + 1 })
+      }
+    }
+  }
+}
+
+export function findNode(root: DesignNode, nodeId: string): NodeHit | null {
+  for (const hit of walkNodes(root)) if (hit.node.id === nodeId) return hit
+  return null
+}
+
+export function getBoard(design: Design, boardId: string): DesignBoard | undefined {
+  return design.boards.find((board) => board.id === boardId)
+}
+
+/** The board holding a node, by id. */
+export function boardOfNode(design: Design, nodeId: string): DesignBoard | undefined {
+  return design.boards.find((board) => findNode(board.root, nodeId) !== null)
+}
+
+/** Root-first chain of nodes ending at `nodeId`, or [] when it is not in the tree. */
+export function nodeChain(root: DesignNode, nodeId: string): DesignNode[] {
+  const chain: DesignNode[] = []
+  const visit = (node: DesignNode): boolean => {
+    chain.push(node)
+    if (node.id === nodeId) return true
+    if (node.type === 'frame') for (const child of node.children) if (visit(child)) return true
+    chain.pop()
+    return false
+  }
+  return visit(root) ? chain : []
+}
+
+export function countNodes(root: DesignNode): number {
+  let count = 0
+  for (const _ of walkNodes(root)) count += 1
+  return count
+}
+
+export function allIds(design: Design): Set<string> {
+  const ids = new Set<string>()
+  for (const board of design.boards) {
+    ids.add(board.id)
+    for (const hit of walkNodes(board.root)) ids.add(hit.node.id)
+  }
+  for (const note of design.notes ?? []) ids.add(note.id)
+  for (const page of design.pages ?? []) ids.add(page.id)
+  return ids
+}
+
+const slug = (value: string) =>
+  value
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, 40) || 'node'
+
+/** A fresh id from `base` not in `taken` (and added to it). */
+export function freshId(taken: Set<string>, base: string): string {
+  const stem = slug(base)
+  let candidate = stem
+  for (let n = 2; taken.has(candidate); n += 1) candidate = `${stem}-${n}`
+  taken.add(candidate)
+  return candidate
+}
+
+/** A deep copy of a subtree with every id replaced by a fresh one. */
+export function reidSubtree(node: DesignNode, taken: Set<string>): DesignNode {
+  const id = freshId(taken, node.id.replace(/-\d+$/, ''))
+  if (node.type !== 'frame') return { ...node, id }
+  return { ...node, id, children: node.children.map((child) => reidSubtree(child, taken)) }
+}
+
+/** Rebuilds the path to `nodeId`, replacing it with `fn(node)` (or removing it when fn returns null). */
+function mapNode(
+  root: FrameNode,
+  nodeId: string,
+  fn: (node: DesignNode, parent: FrameNode | null) => DesignNode | DesignNode[] | null,
+): FrameNode {
+  if (root.id === nodeId) {
+    const next = fn(root, null)
+    // The root itself can be replaced by a frame only; never removed.
+    return next && !Array.isArray(next) && next.type === 'frame' ? next : root
+  }
+  const visit = (frame: FrameNode): FrameNode | null => {
+    const index = frame.children.findIndex((child) => child.id === nodeId)
+    if (index !== -1) {
+      const result = fn(frame.children[index], frame)
+      const replacement = result === null ? [] : Array.isArray(result) ? result : [result]
+      const children = [...frame.children]
+      children.splice(index, 1, ...replacement)
+      return { ...frame, children }
+    }
+    for (let i = 0; i < frame.children.length; i += 1) {
+      const child = frame.children[i]
+      if (child.type !== 'frame') continue
+      const next = visit(child)
+      if (next) {
+        const children = [...frame.children]
+        children[i] = next
+        return { ...frame, children }
+      }
+    }
+    return null
+  }
+  return visit(root) ?? root
+}
+
+export function updateBoard(
+  design: Design,
+  boardId: string,
+  fn: (board: DesignBoard) => DesignBoard,
+): Design {
+  let changed = false
+  const boards = design.boards.map((board) => {
+    if (board.id !== boardId) return board
+    const next = fn(board)
+    if (next !== board) changed = true
+    return next
+  })
+  return changed ? { ...design, boards } : design
+}
+
+/** Replace one board wholesale (the agent's one-board-per-write edit). Appends when new. */
+export function replaceBoard(design: Design, board: DesignBoard): Design {
+  return design.boards.some((existing) => existing.id === board.id)
+    ? updateBoard(design, board.id, () => board)
+    : { ...design, boards: [...design.boards, board] }
+}
+
+/**
+ * Patch a node's fields. Keys set to `undefined` in the patch are removed, so the stored JSON
+ * never carries explicit undefined. The node's id and type never change.
+ */
+export function updateNode(
+  design: Design,
+  boardId: string,
+  nodeId: string,
+  patch: Partial<Record<string, unknown>>,
+): Design {
+  return updateBoard(design, boardId, (board) => ({
+    ...board,
+    root: mapNode(board.root, nodeId, (node) => {
+      const next: Record<string, unknown> = { ...node }
+      for (const [key, value] of Object.entries(patch)) {
+        if (key === 'id' || key === 'type') continue
+        if (value === undefined) delete next[key]
+        else next[key] = value
+      }
+      return next as DesignNode
+    }),
+  }))
+}
+
+export function removeNode(design: Design, boardId: string, nodeId: string): Design {
+  return updateBoard(design, boardId, (board) => ({
+    ...board,
+    root: mapNode(board.root, nodeId, () => null),
+  }))
+}
+
+/** Duplicates a node next to itself; returns the new design and the copy's id. */
+export function duplicateNode(
+  design: Design,
+  boardId: string,
+  nodeId: string,
+): { design: Design; nodeId: string | null } {
+  const board = getBoard(design, boardId)
+  if (!board || board.root.id === nodeId) return { design, nodeId: null }
+  const taken = allIds(design)
+  let copyId: string | null = null
+  const next = updateBoard(design, boardId, (current) => ({
+    ...current,
+    root: mapNode(current.root, nodeId, (node, parent) => {
+      const copy = reidSubtree(node, taken)
+      if (parent?.layout === 'absolute') {
+        copy.x = (node.x ?? 0) + 16
+        copy.y = (node.y ?? 0) + 16
+      }
+      copyId = copy.id
+      return [node, copy]
+    }),
+  }))
+  return { design: next, nodeId: copyId }
+}
+
+/** Moves a node among its siblings by `delta` places (clamped). */
+export function moveNode(design: Design, boardId: string, nodeId: string, delta: number): Design {
+  return updateBoard(design, boardId, (board) => {
+    const hit = findNode(board.root, nodeId)
+    if (!hit?.parent) return board
+    const parentId = hit.parent.id
+    const target = Math.max(0, Math.min(hit.parent.children.length - 1, hit.index + delta))
+    if (target === hit.index) return board
+    const reorder = (frame: FrameNode): FrameNode => {
+      const children = [...frame.children]
+      const [moved] = children.splice(hit.index, 1)
+      children.splice(target, 0, moved)
+      return { ...frame, children }
+    }
+    if (parentId === board.root.id) return { ...board, root: reorder(board.root) }
+    return {
+      ...board,
+      root: mapNode(board.root, parentId, (parent) => reorder(parent as FrameNode)),
+    }
+  })
+}
+
+/** Inserts `node` into frame `parentId` at `index` (default: the end). */
+export function insertNode(
+  design: Design,
+  boardId: string,
+  parentId: string,
+  node: DesignNode,
+  index?: number,
+): Design {
+  const insert = (frame: FrameNode): FrameNode => {
+    const children = [...frame.children]
+    children.splice(index ?? children.length, 0, node)
+    return { ...frame, children }
+  }
+  return updateBoard(design, boardId, (board) =>
+    board.root.id === parentId
+      ? { ...board, root: insert(board.root) }
+      : {
+          ...board,
+          root: mapNode(board.root, parentId, (parent) =>
+            parent.type === 'frame' ? insert(parent) : parent,
+          ),
+        },
+  )
+}
+
+export type MoveTarget = { boardId: string; parentId: string; index: number; x?: number; y?: number }
+
+/**
+ * Moves node `nodeId` (on `fromBoardId`) into frame `to.parentId` at `to.index` (an index into
+ * the target's children as they are BEFORE the move), on the same or another board. With
+ * `copy`, a fresh-id duplicate goes there instead and the original stays. Entering an absolute
+ * frame sets x/y (to.x/y, default 0); leaving one drops them. Returns the design unchanged (and
+ * null) when the move cannot apply: the root, a frame into its own subtree, a non-frame or an
+ * instance target, a full frame, or a move that changes nothing.
+ */
+export function moveNodeTo(
+  design: Design,
+  fromBoardId: string,
+  nodeId: string,
+  to: MoveTarget,
+  options: { copy?: boolean } = {},
+): { design: Design; nodeId: string | null } {
+  const unchanged = { design, nodeId: null }
+  const from = getBoard(design, fromBoardId)
+  const target = getBoard(design, to.boardId)
+  if (!from || !target) return unchanged
+  const hit = findNode(from.root, nodeId)
+  if (!hit?.parent) return unchanged
+  const parentHit = findNode(target.root, to.parentId)
+  const parent = parentHit?.node
+  if (!parent || parent.type !== 'frame' || parent.instanceOf !== undefined) return unchanged
+  if (to.boardId === fromBoardId && findNode(hit.node, to.parentId)) return unchanged
+  const sameParent = to.boardId === fromBoardId && hit.parent.id === to.parentId
+  if (!sameParent && parent.children.length >= DESIGN_LIMITS.maxChildren) return unchanged
+  let index = Math.max(0, Math.min(parent.children.length, Math.round(to.index)))
+  if (sameParent && !options.copy) {
+    // Removing the node first shifts every later index down by one.
+    if (index > hit.index) index -= 1
+    if (index === hit.index && parent.layout !== 'absolute') return unchanged
+  }
+  let moved: DesignNode = options.copy ? reidSubtree(hit.node, allIds(design)) : hit.node
+  if (parent.layout === 'absolute') {
+    moved = { ...moved, x: Math.round(to.x ?? moved.x ?? 0), y: Math.round(to.y ?? moved.y ?? 0) }
+  } else if (moved.x !== undefined || moved.y !== undefined) {
+    const { x: _x, y: _y, ...rest } = moved
+    moved = rest as DesignNode
+  }
+  const without = options.copy ? design : removeNode(design, fromBoardId, nodeId)
+  return { design: insertNode(without, to.boardId, to.parentId, moved, index), nodeId: moved.id }
+}
+
+/** Removes a board and every `linkTo` that pointed at it, so no link dangles. */
+export function removeBoard(design: Design, boardId: string): Design {
+  const unlink = (node: DesignNode): DesignNode => {
+    let next = node
+    if ((node.type === 'frame' || node.type === 'button') && node.linkTo === boardId) {
+      const { linkTo: _gone, transition: _with, ...rest } = node
+      next = rest as DesignNode
+    }
+    if (next.type === 'frame') next = { ...next, children: next.children.map(unlink) }
+    return next
+  }
+  const next: Design = {
+    ...design,
+    boards: design.boards.filter((board) => board.id !== boardId).map((board) => ({ ...board, root: unlink(board.root) as FrameNode })),
+  }
+  // The prototype's start board goes with it (the next board in order starts instead).
+  if (next.startBoard === boardId) delete next.startBoard
+  return next
+}
+
+/** Duplicates a board to its right with fresh ids throughout; returns the copy's id. */
+export function duplicateBoard(
+  design: Design,
+  boardId: string,
+): { design: Design; boardId: string | null } {
+  const index = design.boards.findIndex((board) => board.id === boardId)
+  if (index === -1) return { design, boardId: null }
+  const source = design.boards[index]
+  const taken = allIds(design)
+  const copy: DesignBoard = {
+    ...source,
+    id: freshId(taken, source.id.replace(/-\d+$/, '')),
+    title: `${source.title} copy`.slice(0, 120),
+    x: source.x + source.w + BOARD_GAP,
+    root: reidSubtree(source.root, taken) as FrameNode,
+  }
+  const boards = [...design.boards]
+  boards.splice(index + 1, 0, copy)
+  return { design: { ...design, boards }, boardId: copy.id }
+}
+
+export const BOARD_GAP = 120
+
+export function updateNote(
+  design: Design,
+  noteId: string,
+  fn: (note: DesignNote) => DesignNote | null,
+): Design {
+  const notes = (design.notes ?? []).flatMap((note) => {
+    if (note.id !== noteId) return [note]
+    const next = fn(note)
+    return next ? [next] : []
+  })
+  return { ...design, notes }
+}
+
+// ---- tokens
+
+/** How many colour fields name a token. */
+export function tokenUsage(design: Design, name: string): number {
+  let count = 0
+  const keys = ['fill', 'stroke', 'color', 'background'] as const
+  for (const board of design.boards) {
+    if (board.background === name) count += 1
+    for (const { node } of walkNodes(board.root)) {
+      const record = node as Record<string, unknown>
+      for (const key of keys) if (record[key] === name) count += 1
+      const gradient = record.gradient as { from?: string; to?: string } | undefined
+      if (gradient?.from === name) count += 1
+      if (gradient?.to === name) count += 1
+    }
+  }
+  return count
+}
+
+export function setTokens(design: Design, tokens: DesignTokens): Design {
+  return { ...design, tokens }
+}
+
+export function setColorToken(design: Design, name: string, hex: string): Design {
+  const tokens: DesignTokens = design.tokens ?? { colors: {} }
+  return { ...design, tokens: { ...tokens, colors: { ...tokens.colors, [name]: hex } } }
+}
+
+/** Removes a colour token, replacing every reference with its hex so nothing dangles. */
+export function removeColorToken(design: Design, name: string): Design {
+  const hex = design.tokens?.colors[name]
+  if (!design.tokens || hex === undefined) return design
+  const { [name]: _removed, ...colors } = design.tokens.colors
+  const keys = ['fill', 'stroke', 'color', 'background'] as const
+  const swap = (node: DesignNode): DesignNode => {
+    const record: Record<string, unknown> = { ...node }
+    for (const key of keys) if (record[key] === name) record[key] = hex
+    const gradient = record.gradient as { from: string; to: string } | undefined
+    if (gradient && (gradient.from === name || gradient.to === name)) {
+      record.gradient = { ...gradient, from: gradient.from === name ? hex : gradient.from, to: gradient.to === name ? hex : gradient.to }
+    }
+    if (node.type === 'frame') record.children = node.children.map(swap)
+    return record as DesignNode
+  }
+  const swapColor = (value: string) => (value === name ? hex : value)
+  const styles = design.styles
+    ? {
+        ...design.styles,
+        ...(design.styles.text ? { text: design.styles.text.map((style) => (style.color === name ? { ...style, color: hex } : style)) } : {}),
+        ...(design.styles.fills
+          ? {
+              fills: design.styles.fills.map((style) => ({
+                ...style,
+                fill: swapColor(style.fill),
+                ...(style.gradient ? { gradient: { ...style.gradient, from: swapColor(style.gradient.from), to: swapColor(style.gradient.to) } } : {}),
+              })),
+            }
+          : {}),
+      }
+    : undefined
+  // Round 5: its dark value goes with it; a colour lever holding it keeps the hex.
+  const tokens: DesignTokens = { ...design.tokens, colors }
+  if (design.tokens.themes?.dark && name in design.tokens.themes.dark) {
+    const { [name]: _dark, ...dark } = design.tokens.themes.dark
+    tokens.themes = Object.keys(dark).length ? { dark } : undefined
+    if (!tokens.themes) delete tokens.themes
+  }
+  const variables = design.variables?.map((variable) => (variable.type === 'color' && variable.value === name ? { ...variable, value: hex } : variable))
+  return {
+    ...design,
+    ...(styles ? { styles } : {}),
+    ...(variables ? { variables } : {}),
+    tokens,
+    boards: design.boards.map((board) => ({
+      ...board,
+      background: board.background === name ? hex : board.background,
+      root: swap(board.root) as FrameNode,
+    })),
+  }
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/design-variants.ts b/common/src/desktop-cloud/artifact-kinds/design-variants.ts
new file mode 100644
index 000000000..a2bca1690
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/design-variants.ts
@@ -0,0 +1,166 @@
+import { collectMains, type Design, type DesignNode, type FrameNode, type InstanceOverride } from './design'
+import { isInstance, overrideTargets } from './design-components'
+import { findNode, getBoard, updateBoard } from './design-tree'
+
+/**
+ * Variants and instance swap. A VARIANT is a main component named "<Group> / <Variant>"
+ * ("Button / Primary", "Button / Secondary"): mains that share a group are one component's
+ * variants. Swapping an instance points it at another main (a variant, or any main) and carries
+ * its content overrides across by the target's matching node: the same id, else the same layer
+ * name and type, else the same type at the same position among that type. No new fields: a
+ * variant is a naming convention on mains, so every stored body is already valid.
+ */
+
+export const VARIANT_SEP = '/'
+
+/** "Button / Primary" → { group: "Button", variant: "Primary" }; a plain name has no variant. */
+export function variantName(name: string | undefined): { group: string; variant: string | null } {
+  const raw = (name ?? '').trim()
+  const at = raw.indexOf(VARIANT_SEP)
+  if (at === -1) return { group: raw, variant: null }
+  const group = raw.slice(0, at).trim()
+  const variant = raw.slice(at + 1).trim()
+  return group && variant ? { group, variant } : { group: raw, variant: null }
+}
+
+/** The mains in `mainId`'s variant group (itself included), by variant name; just it when ungrouped. */
+export function variantsOf(mains: ReadonlyMap<string, FrameNode>, mainId: string): FrameNode[] {
+  const main = mains.get(mainId)
+  if (!main) return []
+  const { group, variant } = variantName(main.name)
+  if (variant === null) return [main]
+  return [...mains.values()]
+    .filter((other) => {
+      const named = variantName(other.name)
+      return named.variant !== null && named.group.toLowerCase() === group.toLowerCase()
+    })
+    .sort((a, b) => (variantName(a.name).variant ?? '').localeCompare(variantName(b.name).variant ?? ''))
+}
+
+/** Whether `mainId`'s subtree holds (through instances) an instance of `targetId`, or is it. */
+function reaches(mains: ReadonlyMap<string, FrameNode>, mainId: string, targetId: string, seen = new Set<string>()): boolean {
+  if (mainId === targetId) return true
+  if (seen.has(mainId)) return false
+  seen.add(mainId)
+  const main = mains.get(mainId)
+  if (!main) return false
+  const stack: DesignNode[] = [...main.children]
+  while (stack.length > 0) {
+    const node = stack.pop()!
+    if (node.type !== 'frame') continue
+    if (node.instanceOf !== undefined && reaches(mains, node.instanceOf, targetId, seen)) return true
+    stack.push(...node.children)
+  }
+  return false
+}
+
+/** Overrides re-keyed from one main's nodes to another's (unmatched ones are dropped). */
+export function carryOverrides(
+  overrides: Record<string, InstanceOverride> | undefined,
+  from: FrameNode | undefined,
+  to: FrameNode,
+): Record<string, InstanceOverride> | undefined {
+  if (!overrides || Object.keys(overrides).length === 0) return undefined
+  const targets = overrideTargets(to)
+  const sources = from ? overrideTargets(from) : []
+  const ordinal = (list: Array<{ id: string; node: DesignNode }>, id: string) => {
+    const item = list.find((entry) => entry.id === id)
+    if (!item) return -1
+    return list.filter((entry) => entry.node.type === item.node.type).findIndex((entry) => entry.id === id)
+  }
+  const out: Record<string, InstanceOverride> = {}
+  const used = new Set<string>()
+  const entries = Object.entries(overrides)
+  const matched = new Map<string, { id: string; node: DesignNode }>()
+  // Pass 1: the same id, else the same layer name and type.
+  for (const [key] of entries) {
+    const source = sources.find((entry) => entry.id === key)
+    let match = targets.find((entry) => entry.id === key && !used.has(entry.id))
+    if (!match && source?.node.name) match = targets.find((entry) => !used.has(entry.id) && entry.node.type === source.node.type && entry.node.name === source.node.name)
+    if (match) {
+      used.add(match.id)
+      matched.set(key, match)
+    }
+  }
+  // Pass 2: the same position among that type, else the first free node of that type.
+  for (const [key] of entries) {
+    if (matched.has(key)) continue
+    const source = sources.find((entry) => entry.id === key)
+    if (!source) continue
+    const sameType = targets.filter((entry) => entry.node.type === source.node.type)
+    let match: { id: string; node: DesignNode } | undefined = sameType[ordinal(sources, key)]
+    if (!match || used.has(match.id)) match = sameType.find((entry) => !used.has(entry.id))
+    if (match) {
+      used.add(match.id)
+      matched.set(key, match)
+    }
+  }
+  for (const [key, value] of entries) {
+    const match = matched.get(key)
+    if (!match) continue
+    // Only the fields that kind of node takes.
+    const kept: InstanceOverride = {}
+    if (match.node.type === 'text' && value.text !== undefined) kept.text = value.text
+    if (match.node.type === 'button' && value.label !== undefined) kept.label = value.label
+    if (match.node.type === 'image') {
+      if (value.src !== undefined) kept.src = value.src
+      else if (value.placeholder !== undefined) kept.placeholder = value.placeholder
+      if (value.alt !== undefined) kept.alt = value.alt
+    }
+    if (Object.keys(kept).length > 0) out[match.id] = kept
+  }
+  return Object.keys(out).length ? out : undefined
+}
+
+export type SwapResult = { ok: true; design: Design } | { ok: false; reason: string }
+
+/**
+ * Points instance `instanceId` at main `mainId`, carrying its overrides across. Refused (with a
+ * reason) when the node is not an instance, the target is not a main, or the swap would put a
+ * main inside itself.
+ */
+export function swapInstance(design: Design, boardId: string, instanceId: string, mainId: string): SwapResult {
+  const board = getBoard(design, boardId)
+  const hit = board ? findNode(board.root, instanceId) : null
+  if (!board || !hit) return { ok: false, reason: `board "${boardId}" has no node "${instanceId}"` }
+  if (!isInstance(hit.node)) return { ok: false, reason: `"${instanceId}" is not an instance` }
+  const mains = collectMains(design.boards)
+  const target = mains.get(mainId)
+  if (!target) return { ok: false, reason: `"${mainId}" is not a main component` }
+  if (hit.node.instanceOf === mainId) return { ok: true, design }
+  // Every main that holds this instance (an ancestor marked component) must not be reachable from the target.
+  const chain: FrameNode[] = []
+  const visit = (node: DesignNode): boolean => {
+    if (node.id === instanceId) return true
+    if (node.type !== 'frame') return false
+    chain.push(node)
+    for (const child of node.children) if (visit(child)) return true
+    chain.pop()
+    return false
+  }
+  visit(board.root)
+  for (const ancestor of chain) {
+    if (ancestor.component && reaches(mains, mainId, ancestor.id)) {
+      return { ok: false, reason: `an instance of "${target.name ?? mainId}" cannot go inside the main "${ancestor.name ?? ancestor.id}" it contains` }
+    }
+  }
+  const overrides = carryOverrides(hit.node.overrides, mains.get(hit.node.instanceOf), target)
+  const next: FrameNode = { ...hit.node, instanceOf: mainId, layout: target.layout }
+  if (overrides) next.overrides = overrides
+  else delete next.overrides
+  // An instance named after its old main follows the new one's name.
+  const oldMain = mains.get(hit.node.instanceOf)
+  if (hit.node.name !== undefined && oldMain && hit.node.name === oldMain.name) {
+    if (target.name) next.name = target.name
+    else delete next.name
+  }
+  const swapped = updateBoard(design, boardId, (current) => {
+    const replace = (node: DesignNode): DesignNode => {
+      if (node.id === instanceId) return next
+      if (node.type !== 'frame') return node
+      return { ...node, children: node.children.map(replace) }
+    }
+    return { ...current, root: replace(current.root) as FrameNode }
+  })
+  return { ok: true, design: swapped }
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/design-vector.ts b/common/src/desktop-cloud/artifact-kinds/design-vector.ts
new file mode 100644
index 000000000..d5b2897ca
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/design-vector.ts
@@ -0,0 +1,130 @@
+import type { ShapeNode } from './design'
+
+/**
+ * Vector shape geometry: an SVG path (`d`) for a shape's kind inside its w×h box. The renderer,
+ * the code export and the board export all draw vectors from this, so they match. Pure.
+ */
+
+const r = (value: number) => Math.round(value * 100) / 100
+
+/** The shape kinds drawn as an SVG path rather than a CSS box. */
+export const VECTOR_KINDS = ['arrow', 'polygon', 'star', 'path'] as const
+export function isVectorShape(node: ShapeNode): boolean {
+  return (VECTOR_KINDS as readonly string[]).includes(node.kind)
+}
+
+/** Regular polygon points inscribed in the box (first vertex at the top). */
+export function polygonPoints(sides: number, w: number, h: number): Array<[number, number]> {
+  const n = Math.max(3, Math.min(24, Math.round(sides)))
+  const out: Array<[number, number]> = []
+  for (let i = 0; i < n; i += 1) {
+    const angle = -Math.PI / 2 + (i * 2 * Math.PI) / n
+    out.push([r(w / 2 + (w / 2) * Math.cos(angle)), r(h / 2 + (h / 2) * Math.sin(angle))])
+  }
+  return out
+}
+
+/** Star points (outer and inner alternating, first point at the top). */
+export function starPoints(points: number, innerRatio: number, w: number, h: number): Array<[number, number]> {
+  const n = Math.max(3, Math.min(24, Math.round(points)))
+  const inner = Math.max(0.1, Math.min(0.95, innerRatio))
+  const out: Array<[number, number]> = []
+  for (let i = 0; i < n * 2; i += 1) {
+    const angle = -Math.PI / 2 + (i * Math.PI) / n
+    const k = i % 2 === 0 ? 1 : inner
+    out.push([r(w / 2 + (w / 2) * k * Math.cos(angle)), r(h / 2 + (h / 2) * k * Math.sin(angle))])
+  }
+  return out
+}
+
+const pathOf = (points: Array<[number, number]>, closed: boolean) =>
+  points.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${r(x)} ${r(y)}`).join(' ') + (closed ? ' Z' : '')
+
+/**
+ * A path whose segment i (point i to i + 1; with `closed`, the last back to the first) is a cubic
+ * curve when `curves[i]` gives its two control points (shares of the box), else a line.
+ */
+export function curvedPathOf(
+  points: Array<[number, number]>,
+  curves: ReadonlyArray<readonly [number, number, number, number] | null>,
+  closed: boolean,
+  w: number,
+  h: number,
+): string {
+  if (points.length === 0) return ''
+  const parts = [`M${r(points[0][0])} ${r(points[0][1])}`]
+  const segments = closed ? points.length : points.length - 1
+  for (let i = 0; i < segments; i += 1) {
+    const [x, y] = points[(i + 1) % points.length]
+    const curve = curves[i]
+    parts.push(curve ? `C${r(curve[0] * w)} ${r(curve[1] * h)} ${r(curve[2] * w)} ${r(curve[3] * h)} ${r(x)} ${r(y)}` : `L${r(x)} ${r(y)}`)
+  }
+  return parts.join(' ') + (closed ? ' Z' : '')
+}
+
+/**
+ * The SVG path of a vector shape in its w×h box, plus whether it is filled (closed) or only
+ * stroked. An arrow runs left to right through the box's middle with its head at the end.
+ */
+export function shapeGeometry(node: ShapeNode, w: number, h: number): { d: string; closed: boolean } {
+  switch (node.kind) {
+    case 'polygon':
+      return { d: pathOf(polygonPoints(node.sides ?? 6, w, h), true), closed: true }
+    case 'star':
+      return { d: pathOf(starPoints(node.sides ?? 5, node.innerRatio ?? 0.5, w, h), true), closed: true }
+    case 'path': {
+      const points = (node.vertices ?? [[0, 0], [1, 1]]).map(([x, y]) => [x * w, y * h] as [number, number])
+      if (!node.curves?.some(Boolean)) return { d: pathOf(points, node.closed === true), closed: node.closed === true }
+      return { d: curvedPathOf(points, node.curves, node.closed === true, w, h), closed: node.closed === true }
+    }
+    case 'arrow': {
+      const stroke = node.strokeWidth ?? 2
+      const head = Math.min(w / 2, Math.max(8, stroke * 4))
+      const mid = h / 2
+      return {
+        d: `M0 ${r(mid)} L${r(w)} ${r(mid)} M${r(w - head)} ${r(mid - head / 2)} L${r(w)} ${r(mid)} L${r(w - head)} ${r(mid + head / 2)}`,
+        closed: false,
+      }
+    }
+    default:
+      return { d: `M0 0 L${r(w)} 0 L${r(w)} ${r(h)} L0 ${r(h)} Z`, closed: true }
+  }
+}
+
+/**
+ * A pen path from board px points (and per-segment cubic control points, also board px): its box
+ * at (x, y), and the points and controls as shares of that box, which is how a path shape stores
+ * them. The editor's pen and the agent's addPath both build paths with this.
+ */
+export function pathShapeFromPoints(
+  points: Array<[number, number]>,
+  curves: Array<[number, number, number, number] | null> | undefined,
+  taken: ReadonlySet<string>,
+  id: string,
+): ShapeNode {
+  const minX = Math.min(...points.map(([x]) => x))
+  const minY = Math.min(...points.map(([, y]) => y))
+  const w = Math.max(1, Math.max(...points.map(([x]) => x)) - minX)
+  const h = Math.max(1, Math.max(...points.map(([, y]) => y)) - minY)
+  const share = (value: number, from: number, size: number) => Math.round(((value - from) / size) * 1000) / 1000
+  const clampShare = (value: number) => Math.min(2, Math.max(-1, value))
+  let nodeId = id
+  for (let n = 2; taken.has(nodeId); n += 1) nodeId = `${id}-${n}`
+  return {
+    type: 'shape',
+    id: nodeId,
+    kind: 'path',
+    x: Math.round(minX),
+    y: Math.round(minY),
+    w: Math.round(w),
+    h: Math.round(h),
+    vertices: points.map(([x, y]) => [share(x, minX, w), share(y, minY, h)] as [number, number]),
+    ...(curves?.some(Boolean)
+      ? {
+          curves: curves.map((curve) =>
+            curve ? ([clampShare(share(curve[0], minX, w)), clampShare(share(curve[1], minY, h)), clampShare(share(curve[2], minX, w)), clampShare(share(curve[3], minY, h))] as [number, number, number, number]) : null,
+          ),
+        }
+      : {}),
+  }
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/design.ts b/common/src/desktop-cloud/artifact-kinds/design.ts
new file mode 100644
index 000000000..e624aafee
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/design.ts
@@ -0,0 +1,1783 @@
+import { z } from 'zod/v4'
+import { isSameOriginImagePath } from '../artifact-image-src'
+
+/**
+ * FREEBUFF DESIGN — the body of a `design` artifact (version 1), written for the agent that
+ * authors it.
+ *
+ * A design is a canvas of ARTBOARDS ("boards"): website and landing-page mockups, app screens,
+ * wireframes, posters, social posts. Each board is a fixed-size frame placed on an infinite
+ * canvas at (x, y), and its content is a TREE OF NODES that Freebuff draws with its own
+ * renderer. There is no HTML, CSS or script anywhere in the body: only the node kinds below, so
+ * a shared design is always safe to show. Unknown keys are refused (every object is strict).
+ *
+ * TOP LEVEL
+ *   { version: 1, title, tokens?, styles?, pages?: Page[], boards: Board[], notes?: Note[], startBoard? }
+ *   Round 4 (all optional): shared text/fill `styles` applied by `textStyle`/`fillStyle`; board
+ *   `breakpoints` with node `responsive` overrides (design-resolve.ts); `constraints` on absolute
+ *   children; vector shapes (arrow, polygon, star, path; design-vector.ts); board `guides` and
+ *   `layoutGrid`; frame `rowGap`; text `fontSize`; the prototype's `startBoard`.
+ *   tokens.colors   { name: "#rrggbb" }. Names are lowercase-kebab ("primary", "on-primary").
+ *                   Any colour field elsewhere takes a token name or a hex ("#0f172a", "#fff",
+ *                   "#0f172a80") or "transparent". Prefer tokens: editing a token restyles every
+ *                   board at once. The renderer's defaults read these names when present:
+ *                   background, surface, text, muted, border, primary, on-primary.
+ *   tokens.fonts    { heading, body }, each one of FONT_IDS (system, humanist, geometric,
+ *                   rounded, serif, didone, mono). Headings (display, h1-h3) use `heading`.
+ *   tokens.radius   default corner radius for buttons and inputs (px, default 8).
+ *   tokens.spacingUnit  the design's spacing grid (px, default 8). Use multiples of it.
+ *   Board  { id, title, x, y, w, h, background?, root }   root is a frame that fills the board.
+ *          Lay boards out left to right with ~120px between them; a row per flow or page.
+ *          Common sizes: desktop 1440 wide, tablet 768x1024, phone 390x844, poster 1080x1350,
+ *          social square 1080x1080. A long web page is one tall board (1440 x 3200 is fine).
+ *   Note   { id, x, y, w?, text, kind: "title" | "note" }   canvas labels: a "title" above a
+ *          row of boards, a "note" for a sticky comment. Notes are never part of a board.
+ *   Page   { id, title }   each page is its own canvas. A board or note names its page with
+ *          `page`; without one it sits on the first page, and a design without `pages` (every
+ *          version-1 body written before pages existed) is one implicit page. design-pages.ts.
+ *   Components: a frame with `component: true` is a MAIN; a frame with `instanceOf: <main id>`
+ *          and no children is an INSTANCE that draws the main, with `overrides` for content
+ *          (text, label, image) keyed by the main's node ids. design-components.ts.
+ *
+ * NODES (every node has a unique `id`; ids are unique across the whole design, boards and notes
+ * included; optional `name` labels it in the layers panel; `hidden: true` skips it)
+ *   frame   { layout: "stack-v" | "stack-h" | "grid" | "absolute", children: Node[],
+ *             gap?, padding?, align?, justify?, wrap?, rowGap?, columns?, w?, h?, minW?, maxW?,
+ *             minH?, maxH? (px bounds on a fill/hug size), grow?, fill?, gradient?, fillImage?,
+ *             stroke?, strokeWidth?, strokeSides?, radius?, shadow?: none|sm|md|lg|xl|inner,
+ *             blur?, aspect?, clip?, linkTo? }   (DESIGN_GUIDE has every field)
+ *             stack-v / stack-h are flex columns / rows. grid has `columns` equal tracks.
+ *             absolute places each child at its own x, y (px from the frame's top-left).
+ *             align is the cross axis (start|center|end|stretch); justify the main axis
+ *             (start|center|end|between|around|evenly). padding is a number, [vertical, horizontal] or
+ *             [top, right, bottom, left].
+ *   text    { text, style: display|h1|h2|h3|body|small|caption|mono, color?, weight?
+ *             (400|500|600|700|800), align?: start|center|end, maxLines?, w? }
+ *   image   { src | placeholder: photo|avatar|logo|chart|map, alt, w?, h?, radius?,
+ *             fit?: cover|contain, aspect?, focus?, zoom? }  src is an uploaded "/_asset/<id>"
+ *             (import_artifact_image for a web picture, or the editor's upload). Never hotlink:
+ *             an https src still validates (stored bodies) but views draw it as a placeholder and
+ *             Checks flags it. Prefer placeholders in mockups: they always render and export.
+ *   icon    { icon (one of ICON_NAMES), size?, color? }
+ *   button  { label, variant: primary|secondary|ghost, size?: sm|md|lg, icon?, w?, linkTo? }
+ *             (an arrow-* or chevron-* icon sits after the label, any other before it)
+ *   input   { kind: text|search|select|checkbox|toggle, label?, placeholder?, value?,
+ *             checked?, w? }   drawn in the editor; a working control in Present (round 5).
+ *   divider { color? }   a 1px rule across its parent.
+ *   shape   { kind: rect|ellipse|line|arrow|polygon|star|path, w, h, fill?, stroke?,
+ *             strokeWidth?, radius?, ... }   vectors (sides, innerRatio, vertices) in design-vector.ts.
+ *   Sizes (w, h) are px numbers, "fill" (take the parent's remaining space on that axis) or
+ *   "hug" (fit the content; the default). `grow: true` is "fill" along the parent's main axis.
+ *   linkTo is a board id: in Present and shared views a click on that node opens the board,
+ *   so an app flow is a click-through prototype. `transition` (with linkTo, on a frame or a
+ *   button): instant (default) | dissolve | slide-left | slide-right | slide-up | slide-down.
+ *
+ * LAYOUT GUIDANCE
+ *   - Build pages as a stack-v root of full-width sections (w: "fill"), each section a frame
+ *     with generous padding (desktop [96, 120], phone [48, 24]) and a centred inner column.
+ *   - Rows of cards: a grid with `columns` 3 on desktop, 1 on phone; never absolute for that.
+ *   - Use absolute only for free compositions (posters, hero art, overlapping badges).
+ *   - Keep text readable: body 16, small 14; cap long copy with `w` (e.g. 560) not line breaks.
+ *   - Limits: depth 16, 600 nodes per board, 4000 nodes and 40 boards in all, 1 MB of JSON.
+ *   - Edit one board at a time: replace that board's object, keep every other board as is.
+ *
+ * WORKED EXAMPLE (a phone sign-in screen)
+ *   {
+ *     "version": 1,
+ *     "title": "Sign in",
+ *     "tokens": {
+ *       "colors": { "background": "#ffffff", "text": "#0f172a", "muted": "#64748b",
+ *                   "border": "#e2e8f0", "primary": "#4f46e5", "on-primary": "#ffffff" },
+ *       "fonts": { "heading": "geometric", "body": "system" }, "radius": 12
+ *     },
+ *     "boards": [{
+ *       "id": "signin", "title": "Sign in", "x": 0, "y": 0, "w": 390, "h": 844,
+ *       "background": "background",
+ *       "root": { "type": "frame", "id": "signin-root", "layout": "stack-v",
+ *         "padding": [72, 24], "gap": 24, "children": [
+ *           { "type": "image", "id": "signin-logo", "placeholder": "logo", "alt": "Logo",
+ *             "w": 48, "h": 48 },
+ *           { "type": "text", "id": "signin-title", "text": "Welcome back", "style": "h1" },
