+function findNode(node: Json, id: string): Json | undefined {
+  if (node.id === id) return node
+  for (const kid of (node.children as Json[] | undefined) ?? []) {
+    const found = findNode(kid, id)
+    if (found) return found
+  }
+  return undefined
