+import { describe, expect, test } from 'bun:test'
+
+import { isRemoteImageUrl, isSameOriginImagePath } from './artifact-image-src'
+import { isSafeImageSrc } from './artifact-kinds/design'
+import { setSlideImage } from './artifact-kinds/slides-ops'
+import { deckSchema } from './artifact-kinds/slides'
+import { isAllowedImageSrc } from './artifact-kinds/whiteboard'
+
+const ASSET = '/_asset/0193a8f0-0000-7000-a000-000000000001'
+/** Forms a browser resolves to another origin, or that could break out of an export. */
+const OFF_ORIGIN = [
+  '//evil.example/p.png',
+  '/\\evil.example/p.png',
+  '/%5Cevil.example/p.png',
+  '/%5cevil.example/p.png',
+  '/%2F/evil.example/p.png',
+  '/ /evil.example',
+  '/\tevil',
+  '/x</style><img/src/onerror=alert(1)>',
+  '/x"onerror="alert(1)',
+]
+/** What stored bodies hold today: they must stay valid (save and restore re-validate them). */
+const KEPT = [ASSET, '/_blob/abc123', '/Placeholder.svg', 'https://images.example.com/a.png', 'https://example.com/a(1).png']
+
+describe('artifact image sources (M2)', () => {
+  test('a same-origin path never resolves off the origin', () => {
+    for (const src of OFF_ORIGIN) expect(isSameOriginImagePath(src)).toBe(false)
+    for (const src of [ASSET, '/_blob/abc123', '/Placeholder.svg']) expect(isSameOriginImagePath(src)).toBe(true)
+  })
+
+  test('a remote image is a well-formed https URL with a host and no credentials', () => {
+    expect(isRemoteImageUrl('https://images.example.com/a.png')).toBe(true)
+    for (const src of ['http://x.example/a.png', 'https://u:p@x.example/a', 'https:\\\\x.example', '//x.example', 'https:// x.example'])
+      expect(isRemoteImageUrl(src)).toBe(false)
+  })
+
+  test('every kind validator refuses the off-origin forms and keeps what stored bodies hold', () => {
+    const slide = (src: string) =>
+      deckSchema.safeParse({
+        version: 1,
+        title: 'D',
+        aspect: '16:9',
+        slides: [{ id: 's', layout: 'image', title: 'T', image: { src, alt: '' } }],
+      }).success
+    for (const src of OFF_ORIGIN) {
+      expect(isSafeImageSrc(src)).toBe(false)
+      expect(isAllowedImageSrc(src)).toBe(false)
+      expect(slide(src)).toBe(false)
+    }
+    for (const src of KEPT) {
+      expect(isSafeImageSrc(src)).toBe(true)
+      expect(isAllowedImageSrc(src)).toBe(true)
+      expect(slide(src)).toBe(true)
+    }
+    const deck = deckSchema.parse({ version: 1, title: 'D', aspect: '16:9', slides: [{ id: 's', layout: 'title', title: 'T' }] })
+    expect(setSlideImage(deck, 's', { src: '/\\evil.example/p.png', alt: '' })).toBe(deck)
+  })
+})
+
+describe('images an agent write may introduce (only stored assets)', () => {
+  const OTHER = '/_asset/0193a8f0-0000-7000-a000-000000000002'
+  test('every image src in a body, by format: Markdown and HTML images in a doc, every src in a JSON kind', async () => {
+    const { bodyImageSrcs } = await import('./artifact-image-src')
+    expect(bodyImageSrcs('markdown', `![a](https://x.example/a.png)\n![b](${ASSET})\n<img src="/_blob/z">`)).toEqual(['https://x.example/a.png', ASSET, '/_blob/z'])
+    const design = { boards: [{ root: { children: [{ type: 'image', src: 'https://x.example/h.jpg' }], fillImage: { src: ASSET } } }] }
+    expect(bodyImageSrcs('json', JSON.stringify(design))).toEqual(['https://x.example/h.jpg', ASSET])
+    expect(bodyImageSrcs('json', 'not json')).toEqual([])
+    // A chart's data rows and a design data list's rows are the author's columns, not images.
+    const chart = { slides: [{ id: 's', chart: { type: 'bar', x: 'src', series: [{ key: 'n' }], data: [{ src: 'https://x.example/a', n: 1 }] } }] }
+    expect(bodyImageSrcs('json', JSON.stringify(chart))).toEqual([])
+    expect(bodyImageSrcs('json', JSON.stringify({ data: [{ id: 'l', rows: [{ src: '/x' }] }] }))).toEqual([])
+  })
+
+  test('a new src must be a stored asset (or the built-in placeholder); one already stored stays, whatever it is', async () => {
+    const { unstoredImageSrcsAdded } = await import('./artifact-image-src')
+    const deck = (...srcs: string[]) => JSON.stringify({ slides: srcs.map((src, i) => ({ id: `s${i}`, image: { src, alt: '' } })) })
+    // https, a same-origin path and the blob path are not stored assets of this artifact.
+    expect(unstoredImageSrcsAdded('json', deck(), deck('https://x.example/a.png', '/_blob/abc', '/Placeholder.svg', ASSET))).toEqual(['https://x.example/a.png', '/_blob/abc'])
+    // An https src the stored body already holds (a person put it there) is kept, not refused.
+    expect(unstoredImageSrcsAdded('json', deck('https://x.example/a.png'), deck('https://x.example/a.png', OTHER))).toEqual([])
+    // A create has no stored body: every unstored src is new.
+    expect(unstoredImageSrcsAdded('markdown', null, '![x](https://x.example/a.png)')).toEqual(['https://x.example/a.png'])
+  })
+})
diff --git a/common/src/desktop-cloud/artifact-image-src.ts b/common/src/desktop-cloud/artifact-image-src.ts
new file mode 100644
index 000000000..de793bd79
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-image-src.ts
@@ -0,0 +1,106 @@
+/**
+ * Which image addresses an artifact may hold, shared by the kinds' validators
+ * (artifact-kinds/slides.ts, whiteboard.ts, design.ts) and the renderers'
+ * load decision (freebuff/web …/artifacts/remote-images.ts).
+ *
+ * Validation stays permissive on purpose (save and restore re-validate whole
+ * stored bodies, so tightening would strand existing artifacts): an https URL,
+ * or a same-origin path. Only the forms a browser would resolve OFF this
+ * origin are refused: `//host`, `/\host`, a backslash anywhere, and an encoded
+ * slash or backslash (`/%2F…`, `/%5C…`), plus markup characters in a path. Loading is the renderers' stricter
+ * call: an uploaded asset (`/_asset/<uuid>`) always, a third-party https image
+ * only after the reader opts in, anything else never.
+ *
+ * What an AGENT may add is stricter still (`unstoredImageSrcsAdded`, enforced by the store's write
+ * pipeline for agent writes): only this artifact's stored assets, or the built-in placeholder. A
+ * src the stored body already holds is kept, so existing bodies and people's own https images
+ * still save; the agent imports a picture (import_artifact_image) instead of hotlinking it.
+ */
+
+import { ARTIFACT_ASSET_REF_PATTERN } from './artifacts'
+
+const CONTROL_OR_SPACE = /[\u0000- \u007f-\u009f]/
+const ENCODED_SEPARATOR = /%(?:2f|5c)/i
+/** Never part of a real path (a browser percent-encodes them); refused so no export can be broken out of. */
+const MARKUP = /[<>"'`]/
+
+/** A path on this origin: one leading `/`, then a letter, digit, `_` or `.`; nothing that leaves the origin. */
+export function isSameOriginImagePath(src: string): boolean {
+  return (
+    /^\/[A-Za-z0-9_.]/.test(src) &&
+    !src.includes('\\') &&
+    !CONTROL_OR_SPACE.test(src) &&
+    !ENCODED_SEPARATOR.test(src) &&
+    !MARKUP.test(src)
+  )
+}
+
+/** An absolute `https:` URL with a host and no credentials, as the browser will read it. */
+export function isRemoteImageUrl(src: string): boolean {
+  if (!/^https:\/\//i.test(src) || src.includes('\\') || CONTROL_OR_SPACE.test(src)) return false
+  try {
+    const url = new URL(src)
+    return url.protocol === 'https:' && url.hostname !== '' && url.username === '' && url.password === ''
+  } catch {
+    return false
+  }
+}
+
+/** Image srcs that are ours to serve without a remote fetch: the placeholder new slides use. */
+export const BUILT_IN_IMAGE_SRCS: ReadonlySet<string> = new Set(['/Placeholder.svg'])
+
+/** An uploaded asset ref (`/_asset/<uuid>`) or a built-in image: what an agent write may add. */
+export function isStoredImageSrc(src: string): boolean {
+  return ARTIFACT_ASSET_REF_PATTERN.test(src) || BUILT_IN_IMAGE_SRCS.has(src)
+}
+
+const MARKDOWN_IMAGE = /!\[[^\]]*\]\(\s*<?([^\s)>]+)/g
+const HTML_IMAGE = /<img\b[^>]*?\bsrc\s*=\s*["']([^"']+)["']/gi
+
+/**
+ * Every image src in a body, in order, distinct: a Markdown body's Markdown and HTML images, and
+ * every `src` in a JSON kind (slide images and elements, design nodes and fills, whiteboard
+ * images), except inside free-form records (`FREE_FORM_KEYS`: a chart's `data`, a design data
+ * list's `rows`), whose columns are named by the author and may well be called "src". Empty for
+ * an unreadable JSON body.
+ */
+export function bodyImageSrcs(format: 'markdown' | 'json', body: string): string[] {
+  const found = new Set<string>()
+  const note = (src: unknown) => {
+    if (typeof src === 'string' && src) found.add(src)
+  }
+  if (format !== 'json') {
+    for (const match of body.matchAll(MARKDOWN_IMAGE)) note(match[1])
+    for (const match of body.matchAll(HTML_IMAGE)) note(match[1])
+    return [...found]
+  }
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(body)
+  } catch {
+    return []
+  }
+  const walk = (value: unknown, depth: number) => {
+    if (depth > 64 || !value || typeof value !== 'object') return
+    if (Array.isArray(value)) for (const item of value) walk(item, depth + 1)
+    else
+      for (const [key, field] of Object.entries(value)) {
+        if (key === 'src') note(field)
+        else if (!FREE_FORM_KEYS.has(key)) walk(field, depth + 1)
+      }
+  }
+  walk(parsed, 0)
+  return [...found]
+}
+
+/** Keys whose value is author-named data rows (chart.ts `data`, design.ts data lists' `rows`), never image holders. */
+const FREE_FORM_KEYS: ReadonlySet<string> = new Set(['data', 'rows'])
+
+/**
+ * The image srcs `next` adds that are not stored images (`isStoredImageSrc`) and that `stored`
+ * did not already hold: what an agent write may not introduce. `stored` is null for a new body.
+ */
+export function unstoredImageSrcsAdded(format: 'markdown' | 'json', stored: string | null, next: string): string[] {
+  const had = new Set(stored === null ? [] : bodyImageSrcs(format, stored))
+  return bodyImageSrcs(format, next).filter((src) => !isStoredImageSrc(src) && !had.has(src))
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/chart.ts b/common/src/desktop-cloud/artifact-kinds/chart.ts
new file mode 100644
index 000000000..34f272a96
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/chart.ts
@@ -0,0 +1,84 @@
+/**
+ * The chart spec shared by artifact kinds: the JSON a Docs ```chart block holds,
+ * and the `chart` of a slide. Pure (zod only), so the server validates a body
+ * with exactly the rules the app draws by.
+ *
+ *   { "type": "bar" | "line" | "area", "title"?: string, "x": "<row key for the x axis>",
+ *     "series": [{ "key": "<row key>", "label": "<legend label>" }],   // 1-8, unique, not x
+ *     "data": [{ "<x>": "Week 1", "<series key>": 40 }, ...] }           // 1-500 rows
+ *
+ * Every row has the x key; every value is a string or a finite number, and
+ * series values are numbers. It mirrors `parseChartSpec` (freebuff/web doc/
+ * DocChart.tsx) rule for rule and is never looser: it also rejects unknown keys
+ * on a series entry. `slides-model.test.ts` checks both agree.
+ *
+ * Sheet charts (a range of cells) and data charts (a dataset's columns) are not
+ * this spec: sheet.ts shares `CHART_TYPES`, data.ts the series limit.
+ */
+
+import { z } from 'zod/v4'
+
+export const CHART_TYPES = ['bar', 'line', 'area'] as const
+export type ChartSpecType = (typeof CHART_TYPES)[number]
+
+export const CHART_LIMITS = { series: 8, rows: 500 } as const
+
+export type ChartSpec = {
+  type: ChartSpecType
+  title?: string
+  /** The key in each row that labels the x axis. */
+  x: string
+  series: Array<{ key: string; label: string }>
+  data: Array<Record<string, string | number>>
+}
+
+const chartCell = z.union([z.string(), z.number().finite()])
+
+export const chartSpecSchema = z
+  .strictObject({
+    type: z.enum(CHART_TYPES),
+    title: z.string().optional(),
+    x: z.string().refine((v) => v.trim() !== '', 'x must name a row key'),
+    series: z
+      .array(
+        z.strictObject({
+          key: z.string().refine((v) => v.trim() !== '', 'series key is empty'),
+          label: z.string(),
+        }),
+      )
+      .min(1)
+      .max(CHART_LIMITS.series),
+    data: z.array(z.record(z.string(), chartCell)).min(1).max(CHART_LIMITS.rows),
+  })
+  .superRefine((spec, ctx) => {
+    const keys = new Set<string>()
+    spec.series.forEach((s, i) => {
+      if (s.key === spec.x || keys.has(s.key)) {
+        ctx.addIssue({
+          code: 'custom',
+          path: ['series', i, 'key'],
+          message: 'series keys must be unique and differ from x',
+        })
+      }
+      keys.add(s.key)
+    })
+    spec.data.forEach((row, i) => {
+      if (!(spec.x in row)) {
+        ctx.addIssue({ code: 'custom', path: ['data', i], message: `row lacks "${spec.x}"` })
+      }
+      for (const key of keys) {
+        if (key in row && typeof row[key] !== 'number') {
+          ctx.addIssue({
+            code: 'custom',
+            path: ['data', i, key],
+            message: 'series values must be numbers',
+          })
+        }
+      }
+    })
+  })
+
+// The schema's output is exactly the spec type.
+type _SpecFits = z.infer<typeof chartSpecSchema> extends ChartSpec ? true : never
+const _specFits: _SpecFits = true
+void _specFits
diff --git a/common/src/desktop-cloud/artifact-kinds/data-calc.test.ts b/common/src/desktop-cloud/artifact-kinds/data-calc.test.ts
new file mode 100644
index 000000000..d3c008d23
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/data-calc.test.ts
@@ -0,0 +1,202 @@
+import { describe, expect, test } from 'bun:test'
+
+import { parseDashboard, type Dashboard } from './data'
+import {
+  calcReferences,
+  evaluateCalc,
+  materializeDashboard,
+  paramValues,
+  parseCalc,
+  stripCalculated,
+  type CalcNode,
+} from './data-calc'
+
+/**
+ * A body as stored before round 3 (round-2 fields included: combo, span, references,
+ * annotations, heatmap, display "trend"), frozen as JSON text. It must parse, and parse to
+ * exactly itself: round 3 adds only optional keys and no defaults.
+ */
+const PRE_R3_BODY = `{"version":1,"title":"Ops","layout":"grid","sources":[{"id":"wh","label":"Warehouse"}],
+"datasets":[{"id":"d","sourceId":"wh","columns":[{"key":"week","label":"Week","type":"date"},{"key":"users","label":"Users","type":"number"},{"key":"rev","label":"Revenue","type":"currency"},{"key":"plat","label":"Platform","type":"string"}],
+"rows":[{"week":"2026-11-02","users":100,"rev":500,"plat":"Web"},{"week":"2026-11-09","users":120,"rev":660,"plat":"CLI"}]}],
+"blocks":[{"kind":"kpi","id":"k","label":"Users","datasetId":"d","value":{"column":"users","agg":"sum"},"sparkline":"week","display":"trend","delta":{"vs":"previous","format":"percent"},"format":"integer","sourceId":"wh","span":2},
+{"kind":"chart","id":"c","title":"Mix","type":"combo","datasetId":"d","x":"week","series":[{"key":"users","label":"Users","as":"bar"},{"key":"rev","label":"Revenue","as":"line"}],"sourceId":"wh","span":3,"references":[{"value":110,"label":"Goal"}],"annotations":[{"x":"2026-11-09","label":"Launch"}]},
+{"kind":"table","id":"t","title":"Rows","datasetId":"d","heatmap":["users"],"span":4}],
+"filters":[{"id":"range","label":"Weeks","datasetIds":["d"],"column":"week","type":"date-range"}]}`
+
+const evaluate = (source: string, row: Record<string, string | number | null> = {}, params: Record<string, number> = {}) => {
+  const parsed = parseCalc(source)
+  if (!parsed.ok) throw new Error(parsed.error)
+  return evaluateCalc(parsed.node, row, params)
+}
+
+const parseError = (source: string) => {
+  const parsed = parseCalc(source)
+  return parsed.ok ? null : parsed.error
+}
+
+describe('calculated columns: the expression language', () => {
+  test('arithmetic follows precedence; ^ is right-associative; unary minus', () => {
+    expect(evaluate('1 + 2 * 3')).toBe(7)
+    expect(evaluate('(1 + 2) * 3')).toBe(9)
+    expect(evaluate('2 ^ 3 ^ 2')).toBe(512)
+    expect(evaluate('-2 + 5')).toBe(3)
+    expect(evaluate('7 % 3')).toBe(1)
+    expect(evaluate('1.5e2 / 3')).toBe(50)
+  })
+
+  test('columns in brackets (ids may hold "-"), parameters in braces', () => {
+    expect(evaluate('[rev] / [users-total]', { rev: 600, 'users-total': 120 })).toBe(5)
