index 000000000..9772bca46
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/design-lint.ts
@@ -0,0 +1,293 @@
+import { HEX, emptyDesign, type Design, type DesignBoard, type DesignNode, type DesignTokens, type TextStyle } from './design'
+import { collectMains } from './design'
+import { hasLogic, logicScope, materializeBoardLogic, themedTokens } from './design-logic'
+import { materializeBoard } from './design-resolve'
+
+/**
+ * Design lint: checks a design the way a reviewer would, from the model alone (no DOM), so the
+ * editor's Checks tab and the agent's read_artifact (packages/internal kind-checks.ts
+ * `designLintIssues`) return the same list. Each board is checked at its base size and at every
+ * breakpoint it declares (shared styles and overrides resolved), once per finding.
+ *   - contrast   text (and button labels) against the solid colour behind it, by WCAG 2.x: 4.5:1
+ *                for body text, 3:1 for large text (24 px, or 18.66 px at weight 700+).
+ *   - tap-target a control on a touch board (under 600 wide, or drawn in a device frame) smaller
+ *                than 40 px: a small button, a small linked frame.
+ *   - alt-text   an uploaded or remote image with no alt text.
+ * Only what the model can know for sure is flagged: contrast is skipped (never guessed) when a
+ * gradient, a background image, a translucent colour or a layer opacity sits between the text
+ * and the colour behind it, or when the text may overlap a sibling (a child of an absolute frame,
+ * a pinned node). A main component is checked where it lives, not once per instance.
+ * Pure and deterministic.
+ */
+
+/**
+ * Round 5 adds, for a design that publishes or installs a design system (system adherence):
+ *   - off-token  a colour written as a hex where the system has tokens (fill, stroke, text colour).
+ *   - off-scale  a gap or padding off the spacing scale (tokens.spacingScale, else multiples of
+ *                the spacing unit).
+ *   - off-type   text that sets its own size instead of using one of the system's text styles.
+ * and for every design:
+ *   - external-image  an image hotlinked from another site (import it as an upload instead).
+ */
+export type LintRule = 'contrast' | 'tap-target' | 'alt-text' | 'off-token' | 'off-scale' | 'off-type' | 'external-image'
+
+export type LintIssue = {
+  /** Stable per finding: `${rule}:${nodeId}`. */
+  id: string
+  rule: LintRule
+  boardId: string
+  nodeId: string
+  /** One sentence for the Checks list. */
+  message: string
+  /** What to change, worded as a request (what "Ask Buffy to fix" sends). */
+  fix: string
+  /** Contrast only: the measured ratio, rounded to two places. */
+  ratio?: number
+}
+
+export const LINT_LIMITS = { maxIssues: 200, minTap: 40, touchBoardWidth: 600 } as const
+
+const DEFAULT_COLORS = emptyDesign().tokens!.colors
+
+/** The renderer's type scale: size and default weight per style (DesignRenderer TEXT_SCALE). */
+const TEXT_SIZE: Record<TextStyle, { size: number; weight: number }> = {
+  display: { size: 64, weight: 700 },
+  h1: { size: 44, weight: 700 },
+  h2: { size: 32, weight: 700 },
+  h3: { size: 20, weight: 600 },
+  body: { size: 16, weight: 400 },
+  small: { size: 14, weight: 400 },
+  caption: { size: 12, weight: 600 },
+  mono: { size: 14, weight: 400 },
+}
+const BUTTON = { sm: { height: 32, font: 13 }, md: { height: 40, font: 14 }, lg: { height: 48, font: 16 } } as const
+
+type Rgb = [number, number, number]
+
+/** An opaque colour's channels; null for transparent, a translucent hex, or an unknown name. */
+export function opaqueRgb(value: string | undefined, tokens: DesignTokens | undefined): Rgb | null {
+  if (value === undefined || value === 'transparent') return null
+  const hex = HEX.test(value) ? value : tokens?.colors[value] ?? DEFAULT_COLORS[value]
+  if (!hex || !HEX.test(hex)) return null
+  let h = hex.slice(1).toLowerCase()
+  if (h.length === 3) h = [...h].map((c) => c + c).join('')
+  if (h.length === 8) {
+    if (h.slice(6) !== 'ff') return null
+    h = h.slice(0, 6)
+  }
+  return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as Rgb
+}
+
+function luminance([r, g, b]: Rgb): number {
+  const lin = (c: number) => {
+    const s = c / 255
+    return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4
+  }
+  return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
+}
+
+/** The WCAG contrast ratio of two opaque colours (1 to 21). */
+export function contrastRatio(a: Rgb, b: Rgb): number {
+  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x)
+  return (hi + 0.05) / (lo + 0.05)
+}
+
+/** The ratio text of this size and weight needs (AA). */
+export function requiredRatio(size: number, weight: number): number {
+  return size >= 24 || (size >= 18.66 && weight >= 700) ? 3 : 4.5
+}
+
+const round2 = (value: number) => Math.round(value * 100) / 100
+const isTouchBoard = (board: DesignBoard) => board.w < LINT_LIMITS.touchBoardWidth || board.device !== undefined
+
+/** What sits behind a node: a solid colour, or unknown (a gradient, an image, a translucent layer). */
+type Backdrop = Rgb | 'unknown'
+
+function label(node: DesignNode): string {
+  if (node.name) return `“${node.name}”`
+  if (node.type === 'text') return `“${node.text.length > 32 ? `${node.text.slice(0, 31)}…` : node.text}”`
+  if (node.type === 'button') return `button “${node.label}”`
+  return node.type
+}
+
+/** Every finding on the design, boards in order, at most `LINT_LIMITS.maxIssues`. */
+export function lintDesign(design: Design): LintIssue[] {
+  const issues: LintIssue[] = []
+  /** The board being checked draws with these (its theme's colours). */
+  let tokens = design.tokens
+  const systemic = Boolean(design.system || design.installedSystems?.length)
+  const scale = design.tokens?.spacingScale
+  const unit = design.tokens?.spacingUnit ?? 8
+  const onScale = (value: number) => value === 0 || (scale ? scale.includes(value) : value % (unit / 2) === 0)
+  const tokenNames = new Set(Object.keys(design.tokens?.colors ?? {}))
+  const push = (issue: LintIssue) => {
+    if (seen.has(issue.id)) return
+    seen.add(issue.id)
+    if (issues.length < LINT_LIMITS.maxIssues) issues.push(issue)
+  }
+
+  const checkContrast = (board: DesignBoard, node: DesignNode, fg: string | undefined, bg: Backdrop, size: number, weight: number, what: string) => {
+    if (bg === 'unknown') return
+    const color = opaqueRgb(fg, tokens)
+    if (!color) return
+    const ratio = contrastRatio(color, bg)
+    const need = requiredRatio(size, weight)
+    if (ratio >= need) return
+    push({
+      id: `contrast:${node.id}`,
+      rule: 'contrast',
+      boardId: board.id,
+      nodeId: node.id,
+      ratio: round2(ratio),
+      message: `${what} has contrast ${round2(ratio)}:1; it needs ${need}:1.`,
+      fix: `Raise the contrast of ${what} (now ${round2(ratio)}:1, needs ${need}:1): darken or lighten its colour or its background, preferably by editing the colour tokens.`,
+    })
+  }
+
+  const seen = new Set<string>()
+  const scope = hasLogic(design) ? logicScope(design, undefined, collectMains(design.boards)) : null
+  const drawn = design.boards.flatMap((board) =>
+    [null, ...(board.breakpoints ?? []).map((entry) => entry.id)].map((breakpoint) => {
+      const at = materializeBoard(board, design.styles, breakpoint)
+      return scope ? materializeBoardLogic(at, scope) : at
+    }),
+  )
+  const raw = new Map<string, DesignNode>()
+  for (const board of design.boards) {
+    const stack: DesignNode[] = [board.root]
+    while (stack.length) {
+      const node = stack.pop()!
+      raw.set(node.id, node)
+      if (node.type === 'frame') stack.push(...node.children)
+    }
+  }
+  /** System adherence, once per stored node (not per breakpoint or repeat copy). */
+  const adherence = (board: DesignBoard, node: DesignNode) => {
+    const stored = raw.get(node.id)
+    if (!stored) return
+    if (systemic && tokenNames.size > 0) {
+      for (const key of ['fill', 'stroke', 'color'] as const) {
+        const value = (stored as Record<string, unknown>)[key]
+        if (typeof value === 'string' && HEX.test(value) && !(stored.type === 'frame' && stored.fillStyle)) {
+          push({
+            id: `off-token:${stored.id}:${key}`,
+            rule: 'off-token',
+            boardId: board.id,
+            nodeId: stored.id,
+            message: `${label(stored)} uses ${value} for its ${key === 'color' ? 'colour' : key}, not a colour token.`,
+            fix: `Set the ${key} of ${label(stored)} to one of the system's colour tokens (${[...tokenNames].slice(0, 6).join(', ')}) instead of ${value}.`,
+          })
+        }
+      }
+      if (stored.type === 'frame') {
+        const pads = stored.padding === undefined ? [] : typeof stored.padding === 'number' ? [stored.padding] : stored.padding
+        const off = [stored.gap, stored.rowGap, ...pads].filter((value): value is number => value !== undefined && !onScale(value))
+        if (off.length) {
+          push({
+            id: `off-scale:${stored.id}`,
+            rule: 'off-scale',
+            boardId: board.id,
+            nodeId: stored.id,
+            message: `${label(stored)} has spacing ${[...new Set(off)].join(', ')} px, off the system's spacing scale.`,
+            fix: `Change the gap and padding of ${label(stored)} to steps of the spacing scale (${scale ? scale.join(', ') : `multiples of ${unit}`} px).`,
+          })
+        }
+      }
+      if (stored.type === 'text' && (design.styles?.text?.length ?? 0) > 0 && !stored.textStyle && stored.fontSize !== undefined) {
+        push({
+          id: `off-type:${stored.id}`,
+          rule: 'off-type',
+          boardId: board.id,
+          nodeId: stored.id,
+          message: `${label(stored)} sets its own size (${stored.fontSize} px) instead of a text style.`,
+          fix: `Apply one of the system's text styles to ${label(stored)} (textStyle) instead of a custom font size.`,
+        })
+      }
+    }
+    if (stored.type === 'image' && stored.src && /^https:/i.test(stored.src)) {
+      push({
+        id: `external-image:${stored.id}`,
+        rule: 'external-image',
+        boardId: board.id,
+        nodeId: stored.id,
+        message: `${label(stored)} is hotlinked from another site; it will not show on shared links and may change or vanish.`,
+        fix: `Import the picture of ${label(stored)} with import_artifact_image and use its /_asset/ ref as the src.`,
+      })
+    }
+  }
+  for (const board of drawn) {
+    tokens = themedTokens(design.tokens, board.theme)
+    const touch = isTouchBoard(board)
+    const boardBg = opaqueRgb(board.background ?? 'background', tokens) ?? 'unknown'
+    const visit = (node: DesignNode, behind: Backdrop) => {
+      if (node.hidden) return
+      adherence(board, node)
+      // A layer opacity blends with whatever is under it: no reliable colour from here down.
+      const translucent = node.opacity !== undefined && node.opacity < 1
+      if (node.type === 'frame') {
+        // An opaque fill decides what is behind the children, whatever was under the frame.
+        let here: Backdrop = behind
+        if (translucent || node.fillImage || node.gradient) here = 'unknown'
+        else if (node.fill !== undefined && node.fill !== 'transparent') here = opaqueRgb(node.fill, tokens) ?? 'unknown'
+        if (node.linkTo !== undefined && touch) {
+          const w = typeof node.w === 'number' ? node.w : null
+          const h = typeof node.h === 'number' ? node.h : null
+          const small = (w !== null && w < LINT_LIMITS.minTap) || (h !== null && h < LINT_LIMITS.minTap)
+          if (small) {
+            push({
+              id: `tap-target:${node.id}`,
+              rule: 'tap-target',
+              boardId: board.id,
+              nodeId: node.id,
+              message: `${label(node)} is a link only ${Math.min(w ?? Infinity, h ?? Infinity)} px across; touch targets need ${LINT_LIMITS.minTap} px.`,
+              fix: `Make the tap area of ${label(node)} at least ${LINT_LIMITS.minTap}×${LINT_LIMITS.minTap} px (padding or a larger w/h), keeping the visible size if it should look small.`,
+            })
+          }
+        }
+        // An instance's content is the main's: checked where the main lives.
+        if (node.instanceOf !== undefined) return
+        // In an absolute frame, or pinned over a stack, a child may sit on a sibling (a shape,
+        // an image): what is behind it is unknown unless it brings its own fill.
+        for (const child of node.children) visit(child, node.layout === 'absolute' || child.absolute ? 'unknown' : here)
+        return
+      }
+      const bg: Backdrop = translucent ? 'unknown' : behind
+      if (node.type === 'text') {
+        const scale = TEXT_SIZE[node.style]
+        checkContrast(board, node, node.color ?? 'text', bg, node.fontSize ?? scale.size, node.weight ?? scale.weight, `Text ${label(node)}`)
+      } else if (node.type === 'button') {
+        const size = BUTTON[node.size ?? 'md']
+        if (node.variant === 'primary') {
+          const own = opaqueRgb('primary', tokens)
+          checkContrast(board, node, 'on-primary', translucent || !own ? 'unknown' : own, size.font, 600, `The label of ${label(node)}`)
+        } else if (node.variant === 'secondary') {
+          const own = opaqueRgb('background', tokens)
+          checkContrast(board, node, 'text', translucent || !own ? 'unknown' : own, size.font, 600, `The label of ${label(node)}`)
+        } else {
+          checkContrast(board, node, 'text', bg, size.font, 600, `The label of ${label(node)}`)
+        }
+        if (touch && size.height < LINT_LIMITS.minTap) {
+          push({
+            id: `tap-target:${node.id}`,
+            rule: 'tap-target',
+            boardId: board.id,
+            nodeId: node.id,
+            message: `${label(node)} is ${size.height} px tall; touch targets need ${LINT_LIMITS.minTap} px.`,
+            fix: `Give ${label(node)} size "md" or "lg" so it is at least ${LINT_LIMITS.minTap} px tall on this touch screen.`,
+          })
+        }
+      } else if (node.type === 'image' && node.src !== undefined && node.alt.trim() === '') {
+        push({
+          id: `alt-text:${node.id}`,
+          rule: 'alt-text',
+          boardId: board.id,
+          nodeId: node.id,
+          message: `${label(node)} has no alt text.`,
+          fix: `Write alt text for the image ${node.name ? `“${node.name}”` : node.id} that says what it shows (or what it is for, if it is a link).`,
+        })
+      }
+    }
+    visit(board.root, boardBg)
+  }
+  return issues
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/design-logic-edit.ts b/common/src/desktop-cloud/artifact-kinds/design-logic-edit.ts
new file mode 100644
index 000000000..62259d6c9
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/design-logic-edit.ts
@@ -0,0 +1,190 @@
+import {
+  DESIGN_LIMITS,
+  type Design,
+  type DesignBoard,
+  type DesignDataList,
+  type DesignNode,
+  type DesignVariable,
+  type FrameNode,
+  type Interaction,
+} from './design'
+
+/**
+ * Edits for round 5's logic and prototype fields, shared by the editor and the agent's ops:
+ * variables (levers), data lists, and the clean-up that keeps references valid when what they
+ * name goes away (a removed variable, list, node or board drops the `showIf`, binding,
+ * interaction, repeat or focus entry that named it, never leaving the design invalid). Pure.
+ */
+
+function mapAllNodes(design: Design, fn: (node: DesignNode, inRepeat: boolean) => DesignNode): Design {
+  let changed = false
+  const visit = (node: DesignNode, inRepeat: boolean): DesignNode => {
+    let next = fn(node, inRepeat)
+    if (next.type === 'frame') {
+      const nested = inRepeat || next.repeat !== undefined
+      let kidsChanged = false
+      const children = next.children.map((child) => {
+        const out = visit(child, nested)
+        if (out !== child) kidsChanged = true
+        return out
+      })
+      if (kidsChanged) next = { ...next, children }
+    }
+    if (next !== node) changed = true
+    return next
+  }
+  const boards = design.boards.map((board) => {
+    const root = visit(board.root, false) as FrameNode
+    return root === board.root ? board : { ...board, root }
+  })
+  return changed ? { ...design, boards } : design
+}
+
+function without<T extends object>(value: T, key: keyof T): T {
+  const copy = { ...value }
+  delete copy[key]
+  return copy
+}
+
+/** Adds the variable, or replaces the one with its id. Null when the design is at the cap. */
+export function setVariable(design: Design, variable: DesignVariable): Design | null {
+  const list = design.variables ?? []
+  const at = list.findIndex((entry) => entry.id === variable.id)
+  if (at === -1 && list.length >= DESIGN_LIMITS.maxVariables) return null
+  const next = at === -1 ? [...list, variable] : list.map((entry, index) => (index === at ? variable : entry))
+  return { ...design, variables: next }
+}
+
+/** A variable's new value (the Props panel's lever moving). */
+export function setVariableValue(design: Design, id: string, value: DesignVariable['value']): Design {
+  const variables = (design.variables ?? []).map((entry) => (entry.id === id ? { ...entry, value } : entry))
+  return { ...design, variables }
+}
+
+/** Adds the data list, or replaces the one with its id. Null when the design is at the cap. */
+export function setDataList(design: Design, list: DesignDataList): Design | null {
+  const lists = design.data ?? []
+  const at = lists.findIndex((entry) => entry.id === list.id)
+  if (at === -1 && lists.length >= DESIGN_LIMITS.maxDataLists) return null
+  const next = at === -1 ? [...lists, list] : lists.map((entry, index) => (index === at ? list : entry))
+  return pruneDangling({ ...design, data: next })
+}
+
+export function removeVariable(design: Design, id: string): Design {
+  const variables = (design.variables ?? []).filter((entry) => entry.id !== id)
+  const next: Design = { ...design, variables: variables.length ? variables : undefined }
+  if (!next.variables) delete next.variables
+  return pruneDangling(next)
+}
+
+export function removeDataList(design: Design, id: string): Design {
+  const data = (design.data ?? []).filter((entry) => entry.id !== id)
+  const next: Design = { ...design, data: data.length ? data : undefined }
+  if (!next.data) delete next.data
+  return pruneDangling(next)
+}
+
+/**
+ * Drops every round-5 reference to something that is gone: a `showIf` or binding naming a
+ * missing variable (or a row field outside any repeat), a repeat naming a missing list, an
+ * interaction naming a missing board, node or variable, a focus entry naming a node no longer on
+ * its board. Identity when nothing dangles.
+ */
+export function pruneDangling(design: Design): Design {
+  const variables = new Set((design.variables ?? []).map((entry) => entry.id))
+  const lists = new Map((design.data ?? []).map((entry) => [entry.id, entry]))
+  const boards = new Set(design.boards.map((board) => board.id))
+  const nodes = new Set<string>()
+  const instances = new Set<string>()
+  const mains = new Set<string>()
+  for (const board of design.boards) {
+    const stack: DesignNode[] = [board.root]
+    while (stack.length) {
+      const node = stack.pop()!
+      nodes.add(node.id)
+      if (node.type === 'frame') {
+        if (node.instanceOf !== undefined) instances.add(node.id)
+        if (node.component) mains.add(node.id)
+        stack.push(...node.children)
+      }
+    }
+  }
+  const keep = (interaction: Interaction): boolean => {
+    const { action, target } = interaction
+    if (action === 'back' || action === 'closeOverlay') return true
+    if (target === undefined) return false
+    if (action === 'navigate' || action === 'overlay') return boards.has(target)
+    if (action === 'setVariable') return variables.has(target)
+    if (action === 'setVariant') return instances.has(target) && typeof interaction.value === 'string' && mains.has(interaction.value)
+    return nodes.has(target)
+  }
+  let next = mapAllNodes(design, (node, inRepeat) => {
+    let out = node
+    if (out.showIf && !variables.has(out.showIf.variable)) out = without(out, 'showIf')
+    if (out.bind) {
+      const entries = Object.entries(out.bind).filter(([, ref]) => ref !== undefined && (ref.startsWith('item.') ? inRepeat || insideMain(design, node.id) : variables.has(ref)))
+      if (entries.length !== Object.keys(out.bind).length) out = entries.length ? { ...out, bind: Object.fromEntries(entries) } : without(out, 'bind')
+    }
+    if (out.interactions) {
+      const kept = out.interactions.filter(keep)
+      if (kept.length !== out.interactions.length) out = kept.length ? { ...out, interactions: kept } : without(out, 'interactions')
+    }
+    if (out.type === 'frame' && out.repeat && !lists.has(out.repeat.data)) out = without(out as FrameNode, 'repeat')
+    return out
+  })
+  // A repeat that went away leaves "item." bindings outside any repeat: a second pass drops them.
+  if (next !== design) next = pruneDangling(next)
+  const boardsNext = next.boards.map((board): DesignBoard => {
+    if (!board.focusOrder) return board
+    const onBoard = new Set<string>()
+    const stack: DesignNode[] = [board.root]
+    while (stack.length) {
+      const node = stack.pop()!
+      onBoard.add(node.id)
+      if (node.type === 'frame') stack.push(...node.children)
+    }
+    const order = board.focusOrder.filter((id) => onBoard.has(id))
+    if (order.length === board.focusOrder.length) return board
+    return order.length ? { ...board, focusOrder: order } : without(board, 'focusOrder')
+  })
+  const changedBoards = boardsNext.some((board, index) => board !== next.boards[index])
+  return changedBoards ? { ...next, boards: boardsNext } : next
+}
+
+function insideMain(design: Design, nodeId: string): boolean {
+  for (const board of design.boards) {
+    const walk = (node: DesignNode, inMain: boolean): boolean | null => {
+      if (node.id === nodeId) return inMain
+      if (node.type !== 'frame') return null
+      for (const child of node.children) {
+        const found = walk(child, inMain || Boolean(node.component))
+        if (found !== null) return found
+      }
+      return null
+    }
+    const found = walk(board.root, false)
+    if (found !== null) return found
+  }
+  return false
+}
+
+/** The nodes on a board a prototype viewer can reach with the keyboard, in layer order. */
+export function interactiveNodes(board: DesignBoard): DesignNode[] {
+  const out: DesignNode[] = []
+  const visit = (node: DesignNode) => {
+    const live = Boolean(node.interactions?.length) || node.type === 'input' || ((node.type === 'button' || node.type === 'frame') && node.linkTo !== undefined)
+    if (live) out.push(node)
+    if (node.type === 'frame') node.children.forEach(visit)
+  }
+  visit(board.root)
+  return out
+}
+
+/** The board's keyboard order: its `focusOrder` first, then any other interactive node in layer order. */
+export function focusSequence(board: DesignBoard): DesignNode[] {
+  const live = interactiveNodes(board)
+  const byId = new Map(live.map((node) => [node.id, node]))
+  const ordered = (board.focusOrder ?? []).flatMap((id) => (byId.has(id) ? [byId.get(id)!] : []))
+  const seen = new Set(ordered.map((node) => node.id))
+  return [...ordered, ...live.filter((node) => !seen.has(node.id))]
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/design-logic.ts b/common/src/desktop-cloud/artifact-kinds/design-logic.ts
new file mode 100644
index 000000000..86b742763
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-kinds/design-logic.ts
@@ -0,0 +1,230 @@
+import {
+  DESIGN_LIMITS,
+  HEX,
+  isSafeImageSrc,
+  type BindableKey,
+  type Design,
+  type DesignBoard,
+  type DesignDataList,
+  type DesignNode,
+  type DesignTokens,
+  type FrameNode,
+  type VariableValue,
+} from './design'
+import { INSTANCE_SEP, resolveInstance } from './design-components'
+
+/**
+ * Round 5's declarative logic, resolved before anything draws: design variables (the Props
+ * panel's levers), `showIf`, `bind`, `{{holes}}` in copy, and `repeat` frames over inline data
+ * lists. No code anywhere: every rule is data the schema validates and caps. A design without
+ * variables or data lists, and a node without these fields, comes out exactly as it went in.
+ *
+ *   {{id}}            a variable's value          {{item.field}}  the current repeat row's field
+ *   showIf            { variable, equals?, not? }  drawn only while it matches
+ *   bind              { text|label|src|alt|fill|color|checked|value|placeholder: "<var id>" | "item.<field>" }
+ *   repeat (frame)    { data, limit? }             the children once per row; row 0 keeps the
+ *                     template's ids, row i suffixes every id in its copy with `~r<i>`, so a click
+ *                     on any copy selects the template (the editor's `~` id convention).
+ *
+ * Pure: no React, no DOM.
+ */
+
+export type LogicScope = {
+  vars: Readonly<Record<string, VariableValue>>
+  data: ReadonlyMap<string, DesignDataList>
+  tokens?: DesignTokens
+  /** The repeat row being drawn. */
+  item?: Readonly<Record<string, VariableValue>>
+  /** Main components, to draw instances inside a repeat with that row. */
+  mains?: ReadonlyMap<string, FrameNode>
+}
+
+export const REPEAT_SEP = `${INSTANCE_SEP}r`
+
+/** The design's variables at their stored values, with `overrides` (a prototype's state) winning. */
+export function logicScope(design: Design, overrides?: Readonly<Record<string, VariableValue>>, mains?: ReadonlyMap<string, FrameNode>): LogicScope {
+  const vars: Record<string, VariableValue> = {}
+  for (const variable of design.variables ?? []) vars[variable.id] = variable.value
+  if (overrides) for (const [key, value] of Object.entries(overrides)) if (Object.hasOwn(vars, key)) vars[key] = value
+  return { vars, data: new Map((design.data ?? []).map((list) => [list.id, list])), tokens: design.tokens, mains }
+}
+
+/** Whether the design uses any round-5 logic (a fast path: nothing to resolve otherwise). */
+export function hasLogic(design: Design): boolean {
+  return (design.variables?.length ?? 0) > 0 || (design.data?.length ?? 0) > 0
+}
+
+function lookup(ref: string, scope: LogicScope): VariableValue | undefined {
+  if (ref.startsWith('item.')) return scope.item?.[ref.slice(5)]
+  return Object.hasOwn(scope.vars, ref) ? scope.vars[ref] : undefined
+}
+
+const HOLE = /\{\{\s*((?:item\.)?[A-Za-z0-9][A-Za-z0-9_-]{0,63})\s*\}\}/g
+
+/** `{{name}}` holes filled from the scope; a name it does not know stays as written. */
+export function fillHoles(text: string, scope: LogicScope): string {
+  if (!text.includes('{{')) return text
+  return text.replace(HOLE, (whole, name: string) => {
+    const value = lookup(name, scope)
+    return value === undefined ? whole : String(value)
+  })
+}
+
+export function hasHoles(text: string | undefined): boolean {
+  if (!text) return false
+  HOLE.lastIndex = 0
+  return HOLE.test(text)
+}
+
+/** Whether a `showIf` lets the node draw. */
+export function showIfPasses(showIf: DesignNode['showIf'], scope: LogicScope): boolean {
+  if (!showIf) return true
+  const value = lookup(showIf.variable, scope)
+  const match = showIf.equals === undefined ? Boolean(value) : value === showIf.equals
+  return showIf.not ? !match : match
+}
+
+const TEXT_MAX: Partial<Record<BindableKey, number>> = { text: 2000, label: 80, alt: 300, value: 200, placeholder: 120 }
+
+function colorOk(value: string, tokens: DesignTokens | undefined) {
+  return HEX.test(value) || value === 'transparent' || Object.hasOwn(tokens?.colors ?? {}, value)
+}
+
+/** One node's showIf, bindings and holes resolved (its children untouched). */
+export function applyNodeLogic<T extends DesignNode>(node: T, scope: LogicScope): T {
+  let out: Record<string, unknown> | null = null
+  const set = (key: string, value: unknown) => {
+    out ??= { ...node }
+    out[key] = value
+  }
+  if (node.showIf && !showIfPasses(node.showIf, scope)) set('hidden', true)
+  for (const key of ['text', 'label', 'alt', 'value', 'placeholder'] as const) {
+    const current = (node as Record<string, unknown>)[key]
+    if (typeof current === 'string' && current.includes('{{')) set(key, fillHoles(current, scope).slice(0, TEXT_MAX[key]))
+  }
+  if (node.type === 'frame' && node.overrides) {
+    let changed = false
+    const overrides: NonNullable<FrameNode['overrides']> = {}
+    for (const [id, override] of Object.entries(node.overrides)) {
+      const next = { ...override }
+      for (const key of ['text', 'label', 'alt'] as const) {
+        const value = next[key]
+        if (typeof value === 'string' && value.includes('{{')) {
+          next[key] = fillHoles(value, scope).slice(0, TEXT_MAX[key])
+          changed = true
+        }
+      }
+      overrides[id] = next
+    }
+    if (changed) set('overrides', overrides)
+  }
+  for (const [key, ref] of Object.entries(node.bind ?? {}) as Array<[BindableKey, string | undefined]>) {
+    if (ref === undefined) continue
+    const value = lookup(ref, scope)
+    if (value === undefined) continue
+    if (key === 'checked') {
+      if (node.type === 'input') set('checked', Boolean(value))
+    } else if (key === 'src') {
+      if (node.type === 'image' && typeof value === 'string' && isSafeImageSrc(value)) {
+        set('src', value)
+        set('placeholder', undefined)
+      }
+    } else if (key === 'fill' || key === 'color') {
+      if (typeof value === 'string' && colorOk(value, scope.tokens) && key in fieldOwners && fieldOwners[key].includes(node.type)) set(key, value)
+    } else if (fieldOwners[key].includes(node.type)) {
+      set(key, String(value).slice(0, TEXT_MAX[key]))
+    }
+  }
+  if (!out) return node
+  const result = out as Record<string, unknown>
+  for (const key of Object.keys(result)) if (result[key] === undefined) delete result[key]
+  return result as T
+}
+
+/** Which node types carry each bindable field. */
+const fieldOwners: Record<BindableKey, ReadonlyArray<DesignNode['type']>> = {
+  text: ['text'],
+  label: ['button', 'input'],
+  src: ['image'],
+  alt: ['image'],
+  fill: ['frame', 'shape'],
+  color: ['text', 'icon', 'divider'],
+  checked: ['input'],
+  value: ['input'],
+  placeholder: ['input'],
+}
+
+function suffixIds(node: DesignNode, suffix: string): DesignNode {
+  if (!suffix) return node
+  const id = `${node.id}${suffix}`
+  if (node.type !== 'frame') return { ...node, id }
+  return { ...node, id, children: node.children.map((child) => suffixIds(child, suffix)) }
+}
+
+/**
+ * A subtree with its logic resolved: each node's showIf, bindings and holes, and every repeat
+ * expanded into one copy of its children per row (at most the list's rows and `limit`).
+ */
+export function expandLogicTree(node: DesignNode, scope: LogicScope, depth = 0): DesignNode {
+  const resolved = applyNodeLogic(node, scope)
+  if (resolved.type !== 'frame' || depth > DESIGN_LIMITS.maxDepth * 2) return resolved
+  // Inside a repeat, an instance draws now, with this row (holes in its main see `item`).
+  if (resolved.instanceOf !== undefined && scope.item && scope.mains) {
+    const drawn = resolveInstance(resolved, scope.mains)
+    return { ...drawn, instanceOf: undefined, children: drawn.children.map((child) => expandLogicTree(child, scope, depth + 1)) }
+  }
+  if (resolved.repeat && resolved.instanceOf === undefined) {
+    const list = scope.data.get(resolved.repeat.data)
+    const { repeat, ...frame } = resolved
+    if (!list) return { ...frame, children: resolved.children.map((child) => expandLogicTree(child, scope, depth + 1)) }
+    const rows = list.rows.slice(0, Math.min(repeat.limit ?? DESIGN_LIMITS.maxDataRows, DESIGN_LIMITS.maxDataRows))
+    const children: DesignNode[] = []
+    rows.forEach((row, index) => {
+      const inner: LogicScope = { ...scope, item: row }
+      for (const child of resolved.children) {
+        const copy = expandLogicTree(child, inner, depth + 1)
+        children.push(index === 0 ? copy : suffixIds(copy, `${REPEAT_SEP}${index}`))
+      }
+    })
+    return { ...frame, children }
+  }
+  if (resolved.children.length === 0) return resolved
+  let changed = resolved !== node
+  const children = resolved.children.map((child) => {
+    const next = expandLogicTree(child, scope, depth + 1)
+    if (next !== child) changed = true
+    return next
+  })
+  return changed ? { ...resolved, children } : node
+}
+
+/** A board with its logic resolved (for drawing, checking and code only: never stored). */
+export function materializeBoardLogic(board: DesignBoard, scope: LogicScope): DesignBoard {
+  const root = expandLogicTree(board.root, scope) as FrameNode
+  return root === board.root ? board : { ...board, root }
+}
+
+/** Every board's logic resolved; the identity when the design declares no variables or data. */
+export function materializeLogic(design: Design, overrides?: Readonly<Record<string, VariableValue>>): Design {
+  if (!hasLogic(design)) return design
+  const scope = logicScope(design, overrides)
+  return { ...design, boards: design.boards.map((board) => materializeBoardLogic(board, scope)) }
+}
+
+/** The template id a drawn node came from: a repeat copy's `~r<i>` suffixes dropped. */
+export function templateId(drawnId: string): string {
+  return drawnId.replace(/~r\d+(?=~|$)/g, '')
+}
+
+// ---- themes
+
+/** The tokens a board draws with: its theme's colour values over the base ones. */
+export function themedTokens(tokens: DesignTokens | undefined, theme: 'light' | 'dark' | undefined): DesignTokens | undefined {
+  if (!tokens || theme !== 'dark' || !tokens.themes?.dark) return tokens
+  return { ...tokens, colors: { ...tokens.colors, ...tokens.themes.dark } }
+}
+
+/** The variables a board's Props panel lists: design-wide ones and that board's own. */
+export function boardVariables(design: Design, boardId: string | null) {
+  return (design.variables ?? []).filter((variable) => variable.board === undefined || variable.board === boardId)
+}
diff --git a/common/src/desktop-cloud/artifact-kinds/design-model.test.ts b/common/src/desktop-cloud/artifact-kinds/design-model.test.ts
