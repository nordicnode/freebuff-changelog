+      frame('settings-actions', 'stack-h', [button('settings-cancel', 'Cancel', 'ghost'), button('settings-save', 'Save changes', 'primary')], { gap: 12, w: 'fill', justify: 'end' }),
+    ], { name: 'Settings', w: 'fill', padding: compact ? [32, 20] : [64, 120], gap: 32 })
+  },
+}
