+    ['max-width', pxv(board.w)],
+    ['margin', '0 auto'],
+    ['min-height', pxv(board.h)],
+    ['background-color', color(board.background ?? 'background', ctx) ?? '#ffffff'],
+    ['color', color('text', ctx) ?? '#0f172a'],
