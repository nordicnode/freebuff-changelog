+ */
+
+/** Where a slide's text does not fit: the layout's body or a column, a free text element, or the slide. */
+export type OverflowRegion =
+  | { kind: 'body' }
+  | { kind: 'column'; index: number }
+  | { kind: 'element'; id: string }
+  | { kind: 'slide' }
