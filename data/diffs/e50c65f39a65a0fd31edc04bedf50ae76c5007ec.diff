+}
+
+function scanDeck(deck: Deck): { issues: SlideOverflowIssue[]; regions: SlideTextRegion[] } {
+  const canvas = DESIGN_SIZE[deck.aspect]
+  // The deck's spacing token scales the canvas padding (slides-canvas.css `--fb-slide-pad-*`).
