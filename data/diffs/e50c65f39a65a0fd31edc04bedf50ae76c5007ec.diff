@@ -0,0 +1,593 @@
+/**
+ * What "Read aloud" says for a Freebuff artifact: a reading outline per kind, as plain
+ * speakable sentences (no Markdown, no ids, no JSON). Pure and DOM-free; it never throws, and a
+ * body it cannot read gives no sentences.
+ *
+ *   doc         the selected tab's Markdown (else every tab): headings, paragraphs, list items,
+ *               quotes and table rows. Code fences, charts, images, tab markers, pending blocks
+ *               and the suggestions sidecar are skipped.
+ *   slides      per slide "Slide N. <title>.", then its subtitle, body, columns, the text of its
+ *               free elements, and its speaker notes. `slideId` reads one slide.
+ *   sheet       `range` (with `tabId`, or a `Tab!A1:C5` range) row by row; else the first tab's
+ *               header row and the first five rows under it, each value paired with its header.
+ *   data        the title, subtitle, then each block: KPIs as "<label>: <value>", sections,
+ *               text, and chart and table titles. `blockId` reads one block.
+ *   whiteboard  sections and loose notes/shapes/text/link titles in rows top-to-bottom, each row
+ *               left-to-right; each section followed by the elements whose centre lies inside it.
+ *   design      per board its title and then its text (and button labels) in tree order;
+ *               component instances read as the main they draw. `boardId` reads one board.
+ *
+ * Every sentence is short enough for the browser's speech engines, which cut off or stall on
+ * very long utterances: a long sentence is broken at a comma or a space.
+ */
+
+import type { ArtifactKind } from './artifacts'
+import { isInstance, resolveInstance } from './artifact-kinds/design-components'
+import { collectMains, validateDesign, type DesignNode, type FrameNode } from './artifact-kinds/design'
+import { docBlockKind } from './artifact-kinds/doc-blocks'
+import { splitDocSuggestions } from './artifact-kinds/doc-suggestions'
+import { docTabs, splitBlocks } from './artifact-kinds/doc-tabs'
+import { materializeDashboard } from './artifact-kinds/data-calc'
+import { defaultFilterState, formatValue as formatDataValue, kpiResult } from './artifact-kinds/data-compute'
+import { parseDashboard } from './artifact-kinds/data'
+import { colName, parseAddress, parseSheetRange, type CellRect } from './artifact-kinds/sheet-address'
+import { formatValue as formatSheetValue } from './artifact-kinds/sheet-format'
+import { SheetEngine, literalValue, type CellValue } from './artifact-kinds/sheet-formula'
+import { parseWorkbook, tabCols, tabRows, type SheetTab, type Workbook } from './artifact-kinds/sheet'
+import { elementHasText } from './artifact-kinds/slides-elements'
+import { parseDeck } from './artifact-kinds/slides'
+import { LINE_HEIGHT, TEXT_SIZE_PX, parseBoard, type WhiteboardElement } from './artifact-kinds/whiteboard'
+
+/** What part of the artifact to read; every field is optional and kind-specific. */
+export type ArtifactSpeechSelection = {
+  /** doc: the tab id (`docTabs`); sheet: the tab id (or name). */
+  tabId?: string
+  /** sheet: `A1:C5` or `B2` (on `tabId` or the first tab), or `Tab!A1:C5`. */
+  range?: string
+  /** slides: read only this slide. */
+  slideId?: string
+  /** data: read only this block. */
+  blockId?: string
+  /** design: read only this board. */
+  boardId?: string
+}
+
+export type ArtifactSpeech = {
+  title?: string
+  /** One utterance each, in reading order. */
+  sentences: string[]
+  /** The sentences joined by a space. */
+  text: string
+}
+
+/** Longest sentence handed to a speech engine before it is broken up. */
+export const MAX_SPEECH_SENTENCE = 240
+/** At most this many sentences are produced for one artifact. */
+export const MAX_SPEECH_SENTENCES = 2000
+
+const SHEET_DEFAULT_ROWS = 5
+const SHEET_MAX_ROWS = 200
+const SHEET_MAX_COLS = 40
+
+const empty = (): ArtifactSpeech => ({ sentences: [], text: '' })
+
+export function artifactSpeechText(kind: ArtifactKind, body: string, selection?: ArtifactSpeechSelection): ArtifactSpeech {
+  try {
+    if (typeof body !== 'string' || !body.trim()) return empty()
+    const outline = outlineFor(kind, body, selection ?? {})
+    if (!outline) return empty()
+    const sentences = outline.segments
+      .flatMap(splitSpeechSentences)
+      .map(endSentence)
+      .filter((sentence) => /[\p{L}\p{N}]/u.test(sentence))
+      .slice(0, MAX_SPEECH_SENTENCES)
+    const title = outline.title?.trim() ? clean(outline.title) : undefined
+    return { ...(title ? { title } : {}), sentences, text: sentences.join(' ') }
+  } catch {
+    return empty()
+  }
+}
+
+type Outline = { title?: string; segments: string[] }
+
+function outlineFor(kind: ArtifactKind, body: string, selection: ArtifactSpeechSelection): Outline | null {
+  switch (kind) {
+    case 'doc':
+      return docOutline(body, selection)
+    case 'slides':
+      return slidesOutline(body, selection)
+    case 'sheet':
+      return sheetOutline(body, selection)
+    case 'data':
+      return dataOutline(body, selection)
+    case 'whiteboard':
+      return whiteboardOutline(body)
+    case 'design':
+      return designOutline(body, selection)
+    default:
+      return null
+  }
+}
+
+function parseJson(body: string): unknown {
+  try {
+    return JSON.parse(body)
+  } catch {
+    return undefined
+  }
+}
+
+// ---- Sentences
+
+const ABBREVIATIONS = new Set(['e.g', 'i.e', 'etc', 'vs', 'mr', 'mrs', 'ms', 'dr', 'st', 'fig', 'approx', 'inc', 'ltd', 'jr', 'sr', 'cf'])
+
+/**
+ * Text split into sentences for one utterance each: at a sentence end (. ! ? …) followed by a
+ * space, and at line breaks. Abbreviations (e.g., vs.), initials (U.S.) and decimals (3.5) do
+ * not end a sentence. A sentence longer than `MAX_SPEECH_SENTENCE` is broken at a comma, a
+ * semicolon or a space. Whitespace is collapsed; empty pieces are dropped.
+ */
+export function splitSpeechSentences(text: string): string[] {
+  const out: string[] = []
+  if (typeof text !== 'string') return out
+  for (const line of text.split(/\n+/)) {
+    const flat = line.replace(/\s+/g, ' ').trim()
+    if (!flat) continue
+    const end = /[.!?…]+["'”’)\]]*(?=\s|$)/g
+    let start = 0
+    let match: RegExpExecArray | null
+    while ((match = end.exec(flat))) {
+      const stop = match.index + match[0].length
+      if (match[0].startsWith('.') && match[0].length === 1) {
+        const word = /([\p{L}.]+)$/u.exec(flat.slice(start, match.index))?.[1]?.toLowerCase() ?? ''
+        if (ABBREVIATIONS.has(word) || /^\p{L}(\.\p{L})+$/u.test(word)) continue
+      }
+      pushChunked(out, flat.slice(start, stop))
+      start = stop
+    }
+    pushChunked(out, flat.slice(start))
+  }
+  return out
+}
+
+function pushChunked(out: string[], piece: string): void {
+  let rest = piece.trim()
+  while (rest.length > MAX_SPEECH_SENTENCE) {
+    const window = rest.slice(0, MAX_SPEECH_SENTENCE)
+    const soft = Math.max(window.lastIndexOf(', '), window.lastIndexOf('; '), window.lastIndexOf(': '))
+    const cut = soft > MAX_SPEECH_SENTENCE / 3 ? soft + 1 : window.lastIndexOf(' ') > 0 ? window.lastIndexOf(' ') : MAX_SPEECH_SENTENCE
+    out.push(rest.slice(0, cut).trim())
+    rest = rest.slice(cut).trim()
+  }
+  if (rest) out.push(rest)
+}
+
+/** A sentence with closing punctuation, so the engine pauses after it. */
+function endSentence(sentence: string): string {
+  return /[.!?…:;]["'”’)\]]*$/.test(sentence) ? sentence : `${sentence}.`
+}
+
+const clean = (text: string) => text.replace(/\s+/g, ' ').trim()
+
+// ---- Markdown to speakable text
+
+/** Inline Markdown reduced to the words a reader sees. */
+export function speakableInline(text: string): string {
+  return clean(
+    text
+      .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
+      .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
+      .replace(/\[([^\]]+)\]\[[^\]]*\]/g, '$1')
+      .replace(/\[\^[^\]]+\]/g, '')
+      .replace(/<\/?[A-Za-z][^>]*>/g, ' ')
+      .replace(/`+([^`]*)`+/g, '$1')
+      .replace(/(\*\*|__)(?=\S)([\s\S]*?\S)\1/g, '$2')
+      .replace(/(^|[^\p{L}\p{N}*])\*(?=\S)([^*]*?\S)\*(?![\p{L}\p{N}])/gu, '$1$2')
+      .replace(/(^|[^\p{L}\p{N}_])_(?=\S)([^_]*?\S)_(?![\p{L}\p{N}])/gu, '$1$2')
+      .replace(/~~(?=\S)([\s\S]*?\S)~~/g, '$1')
+      .replace(/==(?=\S)([\s\S]*?\S)==/g, '$1')
+      .replace(/\\([\\`*_{}[\]()#+\-.!>~|])/g, '$1'),
+  )
+}
+
+const LIST_ITEM = /^\s*(?:[-*+]|\d+[.)])\s+(?:\[[ xX]\]\s+)?/
+
+/** One top-level Markdown block as speakable segments; nothing for blocks a listener skips. */
+function blockSegments(block: string): string[] {
+  const kind = docBlockKind(block)
+  switch (kind) {
+    case 'code':
+    case 'chart':
+    case 'image':
+    case 'divider':
+    case 'toc':
+    case 'tab':
+    case 'pending':
+    case 'meta':
+      return []
+    case 'heading':
+      return [speakableInline(block.replace(/^#{1,6}\s+/, '').replace(/\s+#+\s*$/, ''))]
+    case 'list':
+    case 'tasks': {
+      const items: string[] = []
+      for (const line of block.split('\n')) {
+        if (LIST_ITEM.test(line)) items.push(line.replace(LIST_ITEM, ''))
+        else if (items.length) items[items.length - 1] += ` ${line.trim()}`
+        else items.push(line)
+      }
+      return items.map(speakableInline)
+    }
+    case 'quote':
+    case 'callout': {
+      const lines = block.split('\n').map((line) => line.replace(/^\s*>\s?/, ''))
+      const text = lines
+        .join('\n')
+        .replace(/^\s*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]/i, (_m, word: string) => `${word[0]}${word.slice(1).toLowerCase()}:`)
+      return paragraphSegments(text)
+    }
+    case 'table': {
+      const rows = block
+        .split('\n')
+        .filter((line) => !/^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$/.test(line))
+        .map((line) =>
+          line
+            .replace(/^\s*\|/, '')
+            .replace(/\|\s*$/, '')
+            .split('|')
+            .map((cell) => speakableInline(cell))
+            .filter(Boolean)
+            .join(', '),
+        )
+      return rows.filter(Boolean)
+    }
+    case 'footnote':
+      return paragraphSegments(block.replace(/^\[\^[^\]]+\]:\s*/, ''))
+    default:
+      return paragraphSegments(block)
+  }
+}
+
+/** A paragraph: soft line breaks join, so a wrapped sentence stays one sentence. */
+function paragraphSegments(text: string): string[] {
+  const joined = speakableInline(text.split('\n').map((line) => line.trim()).join(' '))
+  return joined ? [joined] : []
+}
+
+/** Markdown (a doc tab, a slide body, a text block) as speakable segments. */
+export function markdownSpeechSegments(markdown: string): string[] {
+  return splitBlocks(markdown).flatMap(blockSegments)
+}
+
+// ---- doc
+
+function docOutline(body: string, selection: ArtifactSpeechSelection): Outline {
+  const { content } = splitDocSuggestions(body)
+  const blocks = splitBlocks(content)
+  const tabs = docTabs(blocks)
+  const tab = selection.tabId ? tabs.find((t) => t.id === selection.tabId) : undefined
+  const chosen = tab ? blocks.slice(tab.start, tab.end) : blocks
+  const heading = chosen.find((block) => /^#\s/.test(block))
+  return {
+    title: heading ? speakableInline(heading.replace(/^#\s+/, '')) : undefined,
+    segments: chosen.flatMap(blockSegments),
+  }
+}
+
+// ---- slides
+
+function slidesOutline(body: string, selection: ArtifactSpeechSelection): Outline | null {
+  const parsed = parseDeck(parseJson(body))
+  if (!parsed.ok) return null
+  const deck = parsed.deck
+  const segments: string[] = []
+  deck.slides.forEach((slide, index) => {
+    if (selection.slideId && slide.id !== selection.slideId) return
+    const title = slide.title ? clean(slide.title) : ''
+    segments.push(title ? `Slide ${index + 1}. ${endSentence(title)}` : `Slide ${index + 1}.`)
+    if (slide.subtitle) segments.push(clean(slide.subtitle))
+    if (slide.body) segments.push(...markdownSpeechSegments(slide.body))
+    for (const column of slide.columns ?? []) segments.push(...markdownSpeechSegments(column))
+    if (slide.chart?.title) segments.push(`Chart: ${clean(slide.chart.title)}`)
+    for (const element of slide.elements ?? []) {
+      if (elementHasText(element) && element.text?.trim()) segments.push(element.text)
+    }
+    if (slide.notes?.trim()) segments.push('Speaker notes.', slide.notes)
+  })
+  return { title: deck.title, segments }
+}
+
+// ---- sheet
+
+function sheetOutline(body: string, selection: ArtifactSpeechSelection): Outline | null {
+  const parsed = parseWorkbook(parseJson(body))
+  if (!parsed.ok) return null
+  const workbook = parsed.workbook
+  let tab: SheetTab | undefined = selection.tabId
+    ? workbook.tabs.find((t) => t.id === selection.tabId || t.name.toLowerCase() === selection.tabId?.toLowerCase())
+    : undefined
+  let rect: CellRect | null = null
+  if (selection.range) {
+    const bang = selection.range.lastIndexOf('!')
+    const source = bang === -1 ? selection.range.toUpperCase() : `${selection.range.slice(0, bang + 1)}${selection.range.slice(bang + 1).toUpperCase()}`
+    const range = parseSheetRange(source.replace(/\$/g, '').trim())
+    if (range) {
+      rect = range.rect
+      if (range.tab) tab = workbook.tabs.find((t) => t.name.toLowerCase() === range.tab?.toLowerCase()) ?? tab
+    }
+  }
+  tab ??= workbook.tabs[0]
+  if (!tab) return null
+  const read = cellReader(workbook, tab)
+  const segments: string[] = []
+  if (workbook.tabs.length > 1) segments.push(`${tab.name}.`)
+
+  if (rect) {
+    const bottom = Math.min(rect.bottom, tabRows(tab) - 1, rect.top + SHEET_MAX_ROWS - 1)
+    const right = Math.min(rect.right, tabCols(tab) - 1, rect.left + SHEET_MAX_COLS - 1)
+    if (rect.top === rect.bottom && rect.left === rect.right) {
+      const text = read(rect.top, rect.left)
+      segments.push(`${colName(rect.left)}${rect.top + 1}: ${text || 'empty'}`)
+    } else {
+      for (let row = rect.top; row <= bottom; row += 1) {
+        const values: string[] = []
+        for (let col = rect.left; col <= right; col += 1) {
+          const text = read(row, col)
+          if (text) values.push(text)
+        }
+        if (values.length) segments.push(`Row ${row + 1}: ${values.join(', ')}`)
+      }
+    }
+    return { title: workbook.title, segments }
+  }
+
+  // No range: the header row (the first row holding anything) and the five rows under it.
+  const used = usedBounds(tab)
+  if (!used) return { title: workbook.title, segments }
+  const right = Math.min(used.right, used.left + SHEET_MAX_COLS - 1)
+  const headers: string[] = []
+  for (let col = used.left; col <= right; col += 1) headers.push(read(used.top, col))
+  const named = headers.filter(Boolean)
+  if (named.length) segments.push(`Columns: ${named.join(', ')}`)
+  let taken = 0
+  for (let row = used.top + 1; row <= used.bottom && taken < SHEET_DEFAULT_ROWS; row += 1) {
+    const pairs: string[] = []
+    for (let col = used.left; col <= right; col += 1) {
+      const text = read(row, col)
+      if (!text) continue
+      const header = headers[col - used.left]
+      pairs.push(header ? `${header}: ${text}` : text)
+    }
+    if (!pairs.length) continue
+    taken += 1
+    segments.push(`Row ${row + 1}. ${pairs.join(', ')}`)
+  }
+  return { title: workbook.title, segments }
+}
+
+/** The cells' text as the page shows it: formulas computed, values formatted. */
+function cellReader(workbook: Workbook, tab: SheetTab): (row: number, col: number) => string {
+  let engine: SheetEngine | null = null
+  try {
+    engine = SheetEngine.build(workbook)
+  } catch {
+    engine = null
+  }
+  return (row, col) => {
+    const cell = tab.cells[`${colName(col)}${row + 1}`]
+    let value: CellValue
+    try {
+      value = engine ? engine.value(tab.id, row, col) : literalValue(cell)
+    } catch {
+      value = literalValue(cell)
+    }
+    try {
+      return clean(
+        formatSheetValue(value, cell?.fmt, {
+          decimals: cell?.decimals,
+          dateStyle: cell?.dateStyle,
+          currency: cell?.currency,
+          locale: workbook.locale,
+        }),
+      )
+    } catch {
+      return typeof value === 'string' || typeof value === 'number' ? clean(String(value)) : ''
+    }
+  }
+}
+
+function usedBounds(tab: SheetTab): CellRect | null {
+  let rect: CellRect | null = null
+  for (const [address, cell] of Object.entries(tab.cells)) {
+    if (cell.v === undefined && cell.f === undefined) continue
+    const pos = parseAddress(address)
+    if (!pos) continue
+    rect = rect
+      ? {
+          top: Math.min(rect.top, pos.row),
+          left: Math.min(rect.left, pos.col),
+          bottom: Math.max(rect.bottom, pos.row),
+          right: Math.max(rect.right, pos.col),
+        }
+      : { top: pos.row, left: pos.col, bottom: pos.row, right: pos.col }
+  }
+  return rect
+}
+
+// ---- data
+
+function dataOutline(body: string, selection: ArtifactSpeechSelection): Outline | null {
+  const parsed = parseDashboard(parseJson(body))
+  if (!parsed.ok) return null
+  const dashboard = materializeDashboard(parsed.dashboard)
+  const state = defaultFilterState(dashboard)
+  const segments: string[] = []
+  if (!selection.blockId) {
+    segments.push(dashboard.title)
+    if (dashboard.subtitle) segments.push(dashboard.subtitle)
+  }
+  for (const block of dashboard.blocks) {
+    if (selection.blockId && block.id !== selection.blockId) continue
+    switch (block.kind) {
+      case 'kpi': {
+        let spoken = 'no data'
+        let delta = ''
+        try {
+          const result = kpiResult(dashboard, block, state)
+          if (result.value !== null) spoken = formatDataValue(result.value, block.format, dashboard.currency)
+          if (result.delta) delta = ` (${[result.delta.text, result.delta.label].filter(Boolean).join(' ')})`
+        } catch {
+          spoken = 'no data'
+        }
+        segments.push(`${clean(block.label)}: ${spoken}${delta}`)
+        if (block.note) segments.push(block.note)
+        break
+      }
+      case 'section':
+        segments.push(block.title)
+        if (block.description) segments.push(block.description)
+        break
+      case 'text':
+        segments.push(...markdownSpeechSegments(block.markdown))
+        break
+      case 'chart':
+        segments.push(`Chart: ${clean(block.title)}`)
+        if (block.note) segments.push(block.note)
+        break
+      case 'table':
+        segments.push(`Table: ${clean(block.title)}`)
+        break
+    }
+  }
+  return { title: dashboard.title, segments }
+}
+
+// ---- whiteboard
+
+type Placed = { element: WhiteboardElement; x: number; y: number; h: number; cx: number; cy: number; text: string[] }
+
+/**
+ * Reading order on a board: rows top to bottom, each left to right. An element joins the current
+ * row while its top is above that row's first element's vertical middle, so a taller shape a
+ * little higher than its neighbours still reads in its place along the row.
+ */
+function readingOrder<T extends Placed>(items: readonly T[]): T[] {
+  const sorted = [...items].sort((a, b) => a.y - b.y || a.x - b.x)
+  const rows: T[][] = []
+  let middle = Number.NEGATIVE_INFINITY
+  for (const item of sorted) {
+    const row = rows[rows.length - 1]
+    if (row && item.y < middle) row.push(item)
+    else {
+      rows.push([item])
+      middle = item.y + item.h / 2
+    }
+  }
+  return rows.flatMap((row) => row.sort((a, b) => a.x - b.x))
+}
+
+/** A note's or shape's text without its marks: **bold**, *italic*, and "- " bullets as lines. */
+function boardText(text: string): string[] {
+  return text
+    .split('\n')
+    .map((line) => speakableInline(line.replace(/^\s*[-•]\s+/, '')))
+    .filter(Boolean)
+}
+
+function whiteboardOutline(body: string): Outline | null {
+  const parsed = parseBoard(body)
+  if (!parsed.ok) return null
+  const board = parsed.board
+  const sections: Array<Placed & { w: number; h: number; members: Placed[] }> = []
+  const readable: Placed[] = []
+  for (const element of board.elements) {
+    switch (element.type) {
+      case 'section':
+        sections.push({
+          element,
+          x: element.x,
+          y: element.y,
+          cx: element.x + element.w / 2,
+          cy: element.y + element.h / 2,
+          w: element.w,
+          h: element.h,
+          text: element.title.trim() ? [clean(element.title)] : [],
+          members: [],
+        })
+        break
+      case 'note':
+      case 'shape': {
+        const text = boardText(element.text ?? '')
+        if (text.length)
+          readable.push({ element, x: element.x, y: element.y, h: element.h, cx: element.x + element.w / 2, cy: element.y + element.h / 2, text })
+        break
+      }
+      case 'text': {
+        const text = boardText(element.text)
+        const w = element.w ?? 0
+        const h = TEXT_SIZE_PX[element.size] * LINE_HEIGHT * text.length
+        if (text.length) readable.push({ element, x: element.x, y: element.y, h, cx: element.x + w / 2, cy: element.y + h / 2, text })
+        break
+      }
+      case 'link':
+        if (element.title.trim())
+          readable.push({ element, x: element.x, y: element.y, h: element.h, cx: element.x + element.w / 2, cy: element.y + element.h / 2, text: [clean(element.title)] })
+        break
+      default:
+        break
+    }
+  }
+  const loose: Placed[] = []
+  for (const item of readable) {
+    // The innermost (smallest) section whose box holds the element's centre owns it.
+    let owner: (typeof sections)[number] | undefined
+    for (const section of sections) {
+      const inside =
+        item.cx >= section.x && item.cx <= section.x + section.w && item.cy >= section.y && item.cy <= section.y + section.h
+      if (inside && (!owner || section.w * section.h < owner.w * owner.h)) owner = section
+    }
+    if (owner) owner.members.push(item)
+    else loose.push(item)
+  }
+  const top: Placed[] = readingOrder<Placed>([...sections, ...loose])
+  const segments: string[] = []
+  for (const item of top) {
+    segments.push(...item.text)
+    const section = sections.find((s) => s === item)
+    if (section) for (const member of readingOrder(section.members)) segments.push(...member.text)
+  }
+  return { title: board.title, segments }
+}
+
+// ---- design
+
+function designOutline(body: string, selection: ArtifactSpeechSelection): Outline | null {
+  const parsed = validateDesign(parseJson(body))
+  if (!parsed.ok) return null
+  const design = parsed.design
+  const mains = collectMains(design.boards)
+  const segments: string[] = []
+  const walk = (node: DesignNode, depth: number) => {
+    if (node.hidden || depth > 64) return
+    switch (node.type) {
+      case 'frame': {
+        const frame: FrameNode = isInstance(node) ? resolveInstance(node, mains) : node
+        for (const child of frame.children) walk(child, depth + 1)
+        break
+      }
+      case 'text':
+        if (node.text.trim()) segments.push(node.text)
+        break
+      case 'button':
+        if (node.label.trim()) segments.push(node.label)
+        break
+      default:
+        break
+    }
+  }
+  for (const board of design.boards) {
+    if (selection.boardId && board.id !== selection.boardId) continue
+    if (board.title.trim()) segments.push(board.title)
+    walk(board.root, 0)
+  }
+  return { title: design.title, segments }
+}
diff --git a/common/src/desktop-cloud/artifact-view-context.test.ts b/common/src/desktop-cloud/artifact-view-context.test.ts
new file mode 100644
index 000000000..5c25c2272
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-view-context.test.ts
@@ -0,0 +1,147 @@
+import { expect, test } from 'bun:test'
+
+import {
+  ARTIFACT_VIEW_SLIDE_IDS_MAX,
+  ARTIFACT_CONTEXT_BODY_MAX_CHARS,
+  ARTIFACT_CONTEXT_HEADER_MAX_CHARS,
+  artifactViewContextSchema,
+  decodeArtifactViewContext,
+  encodeArtifactViewContext,
+  normalizeArtifactViewContext,
+  resolveArtifactViewContext,
+  type ArtifactViewContext,
+} from './artifact-view-context'
+
+const ID = '0190a4f0-0000-7000-8000-000000000009'
+const TOKEN = 'a'.repeat(43)
+
+const base: ArtifactViewContext = { artifactId: ID, kind: 'data', title: 'Revenue', revision: 7, mode: 'viewing', dirty: false }
+
+/** Filters far past any request header: 40 keys of 50 long values each. */
+function hugeFilters(): Record<string, string[]> {
+  const filters: Record<string, string[]> = {}
+  for (let key = 0; key < 40; key++) filters[`region-${key}`] = Array.from({ length: 50 }, (_, value) => `${key}-${value}-${'x'.repeat(190)}`)
+  return filters
+}
+
+test('oversized Data filters keep the artifact id and revision and say they were cut', () => {
+  const context = { ...base, selection: { kind: 'data' as const, blockId: 'kpi-1', tabId: 'overview', filters: hugeFilters() } }
+  // The body copy: within its cap, ids kept, the cut named.
+  const body = normalizeArtifactViewContext(context)!
+  expect(JSON.stringify(body).length).toBeLessThanOrEqual(ARTIFACT_CONTEXT_BODY_MAX_CHARS)
+  expect(body.artifactId).toBe(ID)
+  expect(body.revision).toBe(7)
+  expect(body.selection).toMatchObject({ kind: 'data', blockId: 'kpi-1', tabId: 'overview' })
+  expect(body.truncated).toContain('selection.filters')
+  // The header copy (for an API that reads only the header): never dropped whole, still decodable.
+  const header = encodeArtifactViewContext(context)
+  expect(header).not.toBeNull()
+  expect(header!.length).toBeLessThanOrEqual(ARTIFACT_CONTEXT_HEADER_MAX_CHARS)
+  const decoded = decodeArtifactViewContext(header)!
+  expect(decoded.artifactId).toBe(ID)
+  expect(decoded.revision).toBe(7)
+  expect(decoded.selection).toMatchObject({ kind: 'data', blockId: 'kpi-1' })
+})
+
+test('truncation is deterministic', () => {
+  const context = { ...base, selection: { kind: 'data' as const, blockId: 'b', filters: hugeFilters() } }
+  expect(JSON.stringify(normalizeArtifactViewContext(context))).toBe(JSON.stringify(normalizeArtifactViewContext(structuredClone(context))))
+  expect(encodeArtifactViewContext(context)).toBe(encodeArtifactViewContext(structuredClone(context)))
+})
+
+test('per-field caps clip long values instead of dropping the context', () => {
+  const context = {
+    ...base,
+    kind: 'doc',
+    title: 'T'.repeat(5000),
+    selection: { kind: 'doc', tabId: 't1', blockIndex: 3, quote: 'q'.repeat(5000), unknownFutureField: 1 },
+    futureField: { nested: true },
+  }
+  const normalized = normalizeArtifactViewContext(context)!
+  expect(normalized.title.length).toBeLessThanOrEqual(200)
+  expect(normalized.selection).toMatchObject({ kind: 'doc', tabId: 't1', blockIndex: 3 })
+  expect((normalized.selection as { quote: string }).quote.length).toBeLessThanOrEqual(500)
+  expect(normalized.truncated).toEqual(expect.arrayContaining(['title', 'selection.quote']))
+  expect(artifactViewContextSchema.safeParse(normalized).success).toBe(true)
+  // No id, kind or revision: nothing to address, so no context.
+  expect(normalizeArtifactViewContext({ ...base, artifactId: '' })).toBeNull()
+  expect(normalizeArtifactViewContext({ ...base, kind: 'nope' })).toBeNull()
+  expect(normalizeArtifactViewContext('nope')).toBeNull()
+})
+
+test('the header copy is the shape an older API decodes: no link token, no truncation marker', () => {
+  const context = { ...base, linkToken: TOKEN, truncated: ['selection.filters' as const] }
+  const header = encodeArtifactViewContext(context)!
+  const json = JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(header), (c) => c.charCodeAt(0))))
+  expect(json).not.toHaveProperty('linkToken')
+  expect(json).not.toHaveProperty('truncated')
+  expect(json.artifactId).toBe(ID)
+})
+
+test('the body is preferred over the header; the header is the fallback; neither is never a failure', () => {
+  const fromBody = { ...base, title: 'body' }
+  const header = encodeArtifactViewContext({ ...base, title: 'header' })
+  expect(resolveArtifactViewContext({ body: fromBody, header })).toMatchObject({ source: 'body', context: { title: 'body' } })
+  expect(resolveArtifactViewContext({ body: undefined, header })).toMatchObject({ source: 'header', context: { title: 'header' } })
+  // A body copy that does not read falls back to the header, never a failed run.
+  expect(resolveArtifactViewContext({ body: { nonsense: true }, header })).toMatchObject({ source: 'header' })
+  expect(resolveArtifactViewContext({ body: undefined, header: 'not base64!' })).toBeNull()
+  // A client never supplies a sealed token: the API seals one itself.
+  expect(resolveArtifactViewContext({ body: { ...base, sealedLinkToken: 'x' }, header: null })!.context).not.toHaveProperty('sealedLinkToken')
+  // A link token of the right shape is kept (the API seals it); any other is dropped.
+  expect(resolveArtifactViewContext({ body: { ...base, linkToken: TOKEN }, header: null })!.context.linkToken).toBe(TOKEN)
+  expect(resolveArtifactViewContext({ body: { ...base, linkToken: 'short' }, header: null })!.context).not.toHaveProperty('linkToken')
+})
+
+test('ours’ full doc and data selections survive the body and the header copies whole, ids uncut', () => {
+  const longId = `d${'x'.repeat(199)}`
+  const doc: ArtifactViewContext = {
+    artifactId: 'a-doc',
+    kind: 'doc',
+    title: 'Plan',
+    revision: 4,
+    mode: 'editing',
+    dirty: false,
+    lastEditedByUserAt: null,
+    selection: { kind: 'doc', tabId: 't-launch', blockIndex: 3, blockHash: 'abc1234', blockId: 'b-abc1234.2', quote: 'the launch' },
+  }
+  const data: ArtifactViewContext = {
+    artifactId: 'a-data',
+    kind: 'data',
+    title: 'Weekly',
+    revision: 2,
+    mode: 'viewing',
+    dirty: true,
+    lastEditedByUserAt: '2026-11-16T15:00:00.000Z',
+    selection: { kind: 'data', blockId: longId, tabId: longId, filters: { region: ['EU', 'US'], compareToPrevious: true, clicked: 'week = 2026-11-09' } },
+  }
+  for (const context of [doc, data]) {
+    expect(normalizeArtifactViewContext(context)).toEqual(context)
+    expect(decodeArtifactViewContext(encodeArtifactViewContext(context))).toEqual(context)
+  }
+  // A block id that is not one is dropped, never the selection.
+  const odd = normalizeArtifactViewContext({ ...doc, selection: { ...doc.selection, blockId: 'not an id' } })
+  expect(odd?.selection).toEqual({ kind: 'doc', tabId: 't-launch', blockIndex: 3, blockHash: 'abc1234', quote: 'the launch' })
+})
+
+test('round 5: a slides multi-selection and a whiteboard viewport ride the body; over a cap they are cut, never refused', () => {
+  const ids = Array.from({ length: ARTIFACT_VIEW_SLIDE_IDS_MAX }, (_, i) => `slide-${i}`)
+  const slides = { ...base, lastEditedByUserAt: null, kind: 'slides' as const, selection: { kind: 'slides' as const, slideId: 'slide-0', slideIds: ids } }
+  expect(normalizeArtifactViewContext(slides)).toEqual(slides)
+  const over = normalizeArtifactViewContext({ ...slides, selection: { ...slides.selection, slideIds: [...ids, 'one-more'] } })!
+  expect(over.selection).toEqual(slides.selection)
+  expect(over.truncated).toEqual(['selection.lists'])
+
+  const viewport = { x: -120, y: 40, w: 1600, h: 900, zoom: 0.75 }
+  const board = { ...base, lastEditedByUserAt: null, kind: 'whiteboard' as const, selection: { kind: 'whiteboard' as const, elementIds: ['a'], viewport } }
+  expect(normalizeArtifactViewContext(board)).toEqual(board)
+  expect(artifactViewContextSchema.safeParse(board).success).toBe(true)
+  // A malformed viewport is dropped; the selection and the context stay.
+  expect(normalizeArtifactViewContext({ ...board, selection: { ...board.selection, viewport: { ...viewport, zoom: 0, extra: 1 } } })!.selection).toEqual({ kind: 'whiteboard', elementIds: ['a'] })
+  // The round-4 header copy carries neither field.
+  for (const context of [slides, board]) {
+    const header = decodeArtifactViewContext(encodeArtifactViewContext(context))!
+    expect(JSON.stringify(header)).not.toContain('slideIds')
+    expect(JSON.stringify(header)).not.toContain('viewport')
+  }
+})
diff --git a/common/src/desktop-cloud/artifact-view-context.ts b/common/src/desktop-cloud/artifact-view-context.ts
new file mode 100644
index 000000000..790b98828
--- /dev/null
+++ b/common/src/desktop-cloud/artifact-view-context.ts
@@ -0,0 +1,508 @@
+import { z } from 'zod/v4'
+
+import { ARTIFACT_DOC_BLOCK_ID_PATTERN, ARTIFACT_KINDS, ARTIFACT_TITLE_MAX_CHARS } from './artifacts'
+
+/**
+ * What the user is looking at when they send a chat message: the artifact tab
+ * open and focused in that chat's panel, and what is selected in it. The
+ * workspace sends it on the run request (`artifactContext`, web's
+ * contracts.ts); the agent gets it as a data block ahead of the prompt
+ * (web/src/server/desktop-cloud/artifact-view-context.ts), so "this slide",
+ * "these cells" or "the selected box" resolve to ids.
+ *
+ * It is a HINT from the client: the server re-reads the artifact as the run's
+ * user (kind, title, revision, access) and never trusts these fields for
+ * access. Every string here is user content, framed as data.
+ */
+
+export const ARTIFACT_VIEW_MODES = ['editing', 'viewing', 'presenting'] as const
+export type ArtifactViewMode = (typeof ARTIFACT_VIEW_MODES)[number]
+
+const id = z.string().min(1).max(200)
+/** A quote of selected text: short, the ids are what address it. */
+export const ARTIFACT_VIEW_QUOTE_MAX_CHARS = 500
+const quote = z.string().max(ARTIFACT_VIEW_QUOTE_MAX_CHARS)
+const filterValue = z.union([
+  z.string().max(200),
+  z.number().finite(),
+  z.boolean(),
+  z.null(),
+  z.array(z.string().max(200)).max(50),
+])
+
+/** Free-position slide elements reported at most (a multi-select lists the first ones). */
+export const ARTIFACT_VIEW_SLIDE_ELEMENTS_MAX = 12
+/** A free element's text excerpt, in characters: enough to recognise it, the id addresses it. */
+export const ARTIFACT_VIEW_ELEMENT_TEXT_MAX_CHARS = 120
+/** Row/column groups the selection touches, reported at most. */
+export const ARTIFACT_VIEW_SHEET_GROUPS_MAX = 8
+/** Whiteboard element ids listed at most; `selectedCount` says how many were selected in all. */
+export const ARTIFACT_VIEW_WHITEBOARD_IDS_MAX = 50
+/** Slides selected together (the grid or the filmstrip) listed at most. */
+export const ARTIFACT_VIEW_SLIDE_IDS_MAX = 50
+/** A board coordinate or extent the whiteboard viewport reports (board units). */
+const VIEWPORT_COORD_MAX = 10_000_000
+const viewportNumber = z.number().finite().min(-VIEWPORT_COORD_MAX).max(VIEWPORT_COORD_MAX)
+/** The part of the board on screen: its top-left, size (board units) and zoom. */
+const whiteboardViewport = z.strictObject({
+  x: viewportNumber,
+  y: viewportNumber,
+  w: viewportNumber.min(0),
+  h: viewportNumber.min(0),
+  zoom: z.number().finite().min(0.01).max(100),
+})
+
+/** Each kind's selection, by id. Every field optional: a pane reports what it has. */
+export const artifactSelectionSchema = z.discriminatedUnion('kind', [
+  z.strictObject({
+    kind: z.literal('doc'),
+    tabId: id.optional(),
+    blockIndex: z.number().int().min(0).max(100_000).optional(),
+    /** The block's hash as read_artifact's outline shows it (doc-blocks.ts `docBlockHash`), for a block op's guard. */
+    blockHash: z.string().regex(/^[0-9a-z]{7}$/).optional(),
+    /** The block's stable id (doc-block-ids.ts), which the doc's block ops and comment anchors take. */
+    blockId: z.string().regex(ARTIFACT_DOC_BLOCK_ID_PATTERN).optional(),
+    quote: quote.optional(),
+  }),
+  z.strictObject({
+    kind: z.literal('slides'),
+    slideId: id.optional(),
+    /** 1-based, as the user sees it. */
+    slideNumber: z.number().int().min(1).max(10_000).optional(),
+    /** The element on the slide: title, subtitle, body, notes, image, chart… */
+    element: z.string().min(1).max(40).optional(),
+    quote: quote.optional(),
+    /**
+     * Free-position elements selected on the slide (text boxes, shapes, lines, arrows, images:
+     * the slide's `elements`), by id, with their type and a text excerpt (an image's alt).
+     */
+    freeElements: z
+      .array(
+        z.strictObject({
+          id: z.string().min(1).max(64),
+          /** slides.ts `ELEMENT_TYPES`; a bounded string so a newer type never drops the context. */
+          type: z.string().min(1).max(20),
+          text: z.string().max(ARTIFACT_VIEW_ELEMENT_TEXT_MAX_CHARS).optional(),
+        }),
+      )
+      .max(ARTIFACT_VIEW_SLIDE_ELEMENTS_MAX)
+      .optional(),
+    /** Every slide selected (a multi-selection in the grid or filmstrip), by id, in deck order. */
+    slideIds: z.array(id).max(ARTIFACT_VIEW_SLIDE_IDS_MAX).optional(),
+  }),
+  z.strictObject({
+    kind: z.literal('sheet'),
+    tabId: id.optional(),
+    tabName: z.string().max(100).optional(),
+    /** A1 notation without the tab: "B2:D9" or "C4". */
+    range: z.string().max(40).optional(),
+    /**
+     * The row/column groups the selected range overlaps, as the tab stores them: rows "3:8"
+     * (1-based), columns "C:E"; a collapsed group's lines are hidden in the grid.
+     */
+    groups: z
+      .array(
+        z.strictObject({
+          axis: z.enum(['row', 'col']),
+          range: z.string().min(1).max(20),
+          collapsed: z.boolean(),
+        }),
+      )
+      .max(ARTIFACT_VIEW_SHEET_GROUPS_MAX)
+      .optional(),
+  }),
+  z.strictObject({
+    kind: z.literal('data'),
+    blockId: id.optional(),
+    /** The section shown as a tab on a read page. */
+    tabId: id.optional(),
+    filters: z.record(z.string().max(100), filterValue).optional(),
+  }),
+  z.strictObject({
+    kind: z.literal('whiteboard'),
+    elementIds: z.array(id).max(ARTIFACT_VIEW_WHITEBOARD_IDS_MAX).optional(),
+    /** How many elements are selected in all (box or lasso), when more than `elementIds` lists. */
+    selectedCount: z.number().int().min(0).max(1_000_000).optional(),
+    /** The part of the board on screen. */
+    viewport: whiteboardViewport.optional(),
+  }),
+  z.strictObject({
+    kind: z.literal('design'),
+    pageId: id.optional(),
+    boardId: id.optional(),
+    /** From the board's root down to the selected node. */
+    nodePath: z.array(id).max(40).optional(),
+    /** The breakpoint the editor draws and edits at (absent: each board's base width). */
+    breakpoint: z
+      .strictObject({
+        id: z.string().min(1).max(64),
+        title: z.string().max(40).optional(),
+        width: z.number().finite().min(1).max(100_000).optional(),
+      })
+      .optional(),
+    /** The named style (design.styles) the selected node uses. */
+    namedStyle: z
+      .strictObject({
+        kind: z.enum(['text', 'fill']),
+        id: z.string().min(1).max(64),
+        name: z.string().max(60).optional(),
+      })
+      .optional(),
+  }),
+])
+export type ArtifactSelection = z.infer<typeof artifactSelectionSchema>
+
+/**
+ * What was cut to fit a cap, in fixed words (never client text): the agent is told so, and the
+ * API logs it (`artifact_view_context_truncated`). Ids, the kind and the revision are never cut.
+ */
+export const ARTIFACT_VIEW_TRUNCATIONS = [
+  'title',
+  'lastEditedByUserAt',
+  'selection',
+  'selection.quote',
+  'selection.names',
+  'selection.lists',
+  'selection.filters',
+] as const
+export type ArtifactViewTruncation = (typeof ARTIFACT_VIEW_TRUNCATIONS)[number]
+
+/** A share link's token (artifacts.ts `ARTIFACT_LINK_TOKEN_PATTERN`). */
+const LINK_TOKEN = /^[A-Za-z0-9_-]{43}$/
+
+export const artifactViewContextSchema = z.strictObject({
+  artifactId: id,
+  kind: z.enum(ARTIFACT_KINDS),
+  title: z.string().max(ARTIFACT_TITLE_MAX_CHARS),
+  revision: z.number().int().min(1),
+  mode: z.enum(ARTIFACT_VIEW_MODES),
+  selection: artifactSelectionSchema.nullable().optional(),
+  /** Edits in the tab not yet saved: the stored revision lacks them. */
+  dirty: z.boolean(),
+  /** When this user last edited it in this tab (ISO), null when they have not. */
+  lastEditedByUserAt: z.string().max(40).nullable().optional(),
+  /**
+   * The share link's token the tab was opened with (a link-only artifact): the API seals it
+   * (`sealedLinkToken`) before the run is stored, reads the artifact as the user WITH it, and lets
+   * this run's read tools use it for this artifact only. Never shown to the model. Body only.
+   */
+  linkToken: z.string().regex(LINK_TOKEN).optional(),
+  /** Set by the API alone (a client's is dropped): `linkToken`, sealed to the run. */
+  sealedLinkToken: z.string().min(1).max(400).optional(),
+  /** What was cut to fit a cap. Body only. */
+  truncated: z.array(z.enum(ARTIFACT_VIEW_TRUNCATIONS)).max(ARTIFACT_VIEW_TRUNCATIONS.length).optional(),
+})
+export type ArtifactViewContext = z.infer<typeof artifactViewContextSchema>
+
+/**
+ * Transport. The context rides the run BODY (`artifactContext`, web's contracts.ts) and, for an
+ * API that reads only the header (round 4), a HEADER copy in the round-4 shape, cut to fit. The
+ * API takes the body's first and the header's when the body has none that reads
+ * (`resolveArtifactViewContext`). An API without the field at all refuses the body with
+ * "Invalid cloud run request"; the send then goes again without it (send-commit.ts).
+ *
+ * Neither copy is ever dropped whole for its size: each field has a cap, and over the copy's cap
+ * the lowest-priority parts go first (filters, excerpts, names, lists, then the selection, then
+ * the title), each named in `truncated`.
+ */
+export const ARTIFACT_CONTEXT_HEADER = 'x-freebuff-artifact-context'
+/** Encoded header characters accepted (base64 of the JSON, so titles in any script survive). */
+export const ARTIFACT_CONTEXT_HEADER_MAX_CHARS = 8000
+/** The body copy's JSON characters at most: a view is ids and short excerpts, never a body. */
+export const ARTIFACT_CONTEXT_BODY_MAX_CHARS = 16_000
+/** Filters a data view carries at most, and the values of one multi-select. */
+const FILTER_KEYS_MAX = 40
+const FILTER_VALUES_MAX = 50
+
+type Marks = Set<ArtifactViewTruncation>
+type Raw = Record<string, unknown>
+const isRecord = (value: unknown): value is Raw => !!value && typeof value === 'object' && !Array.isArray(value)
+const idOf = (value: unknown, max = 200) => (typeof value === 'string' && value.length >= 1 && value.length <= max ? value : undefined)
+/** A string cut to `max` (marked), or undefined for a non-string. */
+function clipped(value: unknown, max: number, marks: Marks, mark: ArtifactViewTruncation): string | undefined {
+  if (typeof value !== 'string') return undefined
+  if (value.length <= max) return value
+  marks.add(mark)
+  return value.slice(0, max)
+}
+const intIn = (value: unknown, min: number, max: number) =>
+  typeof value === 'number' && Number.isInteger(value) && value >= min && value <= max ? value : undefined
+/** Drops undefined fields, so the strict schema reads the object as written. */
+function defined<T extends Raw>(value: T): T {
+  return Object.fromEntries(Object.entries(value).filter(([, field]) => field !== undefined)) as T
+}
+/** At most `max` items (marked when cut). */
+function capped<T>(items: T[], max: number, marks: Marks, mark: ArtifactViewTruncation): T[] {
+  if (items.length <= max) return items
+  marks.add(mark)
+  return items.slice(0, max)
+}
+
+/** One kind's selection, field by field: unknown fields dropped, each value capped. Null when it does not read. */
+function normalizeSelection(raw: unknown, marks: Marks): ArtifactSelection | null {
+  if (!isRecord(raw)) return null
+  let selection: Raw | null = null
+  switch (raw.kind) {
+    case 'doc':
+      selection = {
+        kind: 'doc',
+        tabId: idOf(raw.tabId),
+        blockIndex: intIn(raw.blockIndex, 0, 100_000),
+        blockHash: typeof raw.blockHash === 'string' && /^[0-9a-z]{7}$/.test(raw.blockHash) ? raw.blockHash : undefined,
+        blockId: typeof raw.blockId === 'string' && ARTIFACT_DOC_BLOCK_ID_PATTERN.test(raw.blockId) ? raw.blockId : undefined,
+        quote: clipped(raw.quote, ARTIFACT_VIEW_QUOTE_MAX_CHARS, marks, 'selection.quote'),
+      }
+      break
+    case 'slides':
+      selection = {
+        kind: 'slides',
+        slideId: idOf(raw.slideId),
+        slideNumber: intIn(raw.slideNumber, 1, 10_000),
+        element: idOf(raw.element, 40),
+        quote: clipped(raw.quote, ARTIFACT_VIEW_QUOTE_MAX_CHARS, marks, 'selection.quote'),
+        freeElements: Array.isArray(raw.freeElements)
+          ? capped(
+              raw.freeElements.flatMap((element) => {
+                if (!isRecord(element) || !idOf(element.id, 64) || !idOf(element.type, 20)) return []
+                return [defined({ id: element.id as string, type: element.type as string, text: clipped(element.text, ARTIFACT_VIEW_ELEMENT_TEXT_MAX_CHARS, marks, 'selection.quote') })]
+              }),
+              ARTIFACT_VIEW_SLIDE_ELEMENTS_MAX,
+              marks,
+              'selection.lists',
+            )
+          : undefined,
+        slideIds: Array.isArray(raw.slideIds)
+          ? capped(raw.slideIds.filter((value): value is string => !!idOf(value)), ARTIFACT_VIEW_SLIDE_IDS_MAX, marks, 'selection.lists')
+          : undefined,
+      }
+      break
+    case 'sheet':
+      selection = {
+        kind: 'sheet',
+        tabId: idOf(raw.tabId),
+        tabName: clipped(raw.tabName, 100, marks, 'selection.names'),
+        range: idOf(raw.range, 40),
+        groups: Array.isArray(raw.groups)
+          ? capped(
+              raw.groups.flatMap((group) =>
+                isRecord(group) && (group.axis === 'row' || group.axis === 'col') && idOf(group.range, 20) && typeof group.collapsed === 'boolean'
+                  ? [{ axis: group.axis, range: group.range as string, collapsed: group.collapsed }]
+                  : [],
+              ),
+              ARTIFACT_VIEW_SHEET_GROUPS_MAX,
+              marks,
+              'selection.lists',
+            )
+          : undefined,
+      }
+      break
+    case 'data': {
+      let filters: Record<string, string | number | boolean | null | string[]> | undefined
+      if (isRecord(raw.filters)) {
+        filters = {}
+        for (const [key, value] of capped(Object.entries(raw.filters), FILTER_KEYS_MAX, marks, 'selection.filters')) {
+          const name = clipped(key, 100, marks, 'selection.filters')!
+          if (typeof value === 'string') filters[name] = clipped(value, 200, marks, 'selection.filters')!
+          else if ((typeof value === 'number' && Number.isFinite(value)) || typeof value === 'boolean' || value === null) filters[name] = value
+          else if (Array.isArray(value))
+            filters[name] = capped(value.filter((item): item is string => typeof item === 'string'), FILTER_VALUES_MAX, marks, 'selection.filters').map(
+              (item) => clipped(item, 200, marks, 'selection.filters')!,
+            )
+        }
+      }
+      selection = { kind: 'data', blockId: idOf(raw.blockId), tabId: idOf(raw.tabId), filters }
+      break
+    }
+    case 'whiteboard': {
+      const ids = Array.isArray(raw.elementIds) ? raw.elementIds.filter((value): value is string => !!idOf(value)) : undefined
+      const elementIds = ids && capped(ids, ARTIFACT_VIEW_WHITEBOARD_IDS_MAX, marks, 'selection.lists')
+      const selectedCount = intIn(raw.selectedCount, 0, 1_000_000) ?? (ids && elementIds && ids.length > elementIds.length ? Math.min(ids.length, 1_000_000) : undefined)
+      const viewport = whiteboardViewport.safeParse(isRecord(raw.viewport) ? defined({ x: raw.viewport.x, y: raw.viewport.y, w: raw.viewport.w, h: raw.viewport.h, zoom: raw.viewport.zoom }) : undefined)
+      selection = { kind: 'whiteboard', elementIds, selectedCount, viewport: viewport.success ? viewport.data : undefined }
+      break
+    }
+    case 'design': {
+      const path = Array.isArray(raw.nodePath) ? raw.nodePath.filter((value): value is string => !!idOf(value)) : undefined
+      const breakpoint = isRecord(raw.breakpoint) && idOf(raw.breakpoint.id, 64)
+        ? defined({
+            id: raw.breakpoint.id as string,
+            title: clipped(raw.breakpoint.title, 40, marks, 'selection.names'),
+            width: typeof raw.breakpoint.width === 'number' && Number.isFinite(raw.breakpoint.width) && raw.breakpoint.width >= 1 && raw.breakpoint.width <= 100_000 ? raw.breakpoint.width : undefined,
+          })
+        : undefined
+      const namedStyle = isRecord(raw.namedStyle) && (raw.namedStyle.kind === 'text' || raw.namedStyle.kind === 'fill') && idOf(raw.namedStyle.id, 64)
+        ? defined({ kind: raw.namedStyle.kind, id: raw.namedStyle.id as string, name: clipped(raw.namedStyle.name, 60, marks, 'selection.names') })
+        : undefined
+      // Root down to the selected node: a cut keeps the selected end.
+      if (path && path.length > 40) marks.add('selection.lists')
+      selection = { kind: 'design', pageId: idOf(raw.pageId), boardId: idOf(raw.boardId), nodePath: path?.slice(-40), breakpoint, namedStyle }
+      break
+    }
+  }
+  if (!selection) return null
+  const parsed = artifactSelectionSchema.safeParse(defined(selection))
+  return parsed.success ? parsed.data : null
+}
+
+/** The lowest-priority parts of a selection first; each step returns null when it has nothing to cut. */
+const SELECTION_CUTS: Array<[ArtifactViewTruncation, (selection: ArtifactSelection) => ArtifactSelection | null]> = [
+  ['selection.filters', (s) => (s.kind === 'data' && s.filters && Object.values(s.filters).some((v) => Array.isArray(v) && v.length > 5)
+    ? { ...s, filters: Object.fromEntries(Object.entries(s.filters).map(([k, v]) => [k, Array.isArray(v) ? v.slice(0, 5) : v])) }
+    : null)],
+  ['selection.filters', (s) => {
+    if (s.kind !== 'data' || !s.filters) return null
+    const keys = Object.keys(s.filters)
+    if (!keys.length) return null
+    // One filter fewer, from the end: the caller repeats until the copy fits.
+    const filters = Object.fromEntries(Object.entries(s.filters).slice(0, keys.length - 1))
+    return defined({ ...s, filters: keys.length > 1 ? filters : undefined })
+  }],
+  ['selection.quote', (s) => (s.kind === 'doc' && s.quote !== undefined ? defined({ ...s, quote: undefined })
+    : s.kind === 'slides' && (s.quote !== undefined || s.freeElements?.some((e) => e.text !== undefined))
+      ? defined({ ...s, quote: undefined, freeElements: s.freeElements?.map(({ id, type }) => ({ id, type })) })
+      : null)],
+  ['selection.names', (s) => (s.kind === 'sheet' && s.tabName !== undefined ? defined({ ...s, tabName: undefined })
+    : s.kind === 'design' && (s.breakpoint?.title !== undefined || s.namedStyle?.name !== undefined)
+      ? defined({ ...s, breakpoint: s.breakpoint && defined({ ...s.breakpoint, title: undefined }), namedStyle: s.namedStyle && defined({ ...s.namedStyle, name: undefined }) })
+      : null)],
+  ['selection.lists', (s) => {
+    if (s.kind === 'whiteboard' && (s.elementIds?.length ?? 0) > 10)
+      return { ...s, elementIds: s.elementIds!.slice(0, 10), selectedCount: s.selectedCount ?? s.elementIds!.length }
+    if (s.kind === 'design' && (s.nodePath?.length ?? 0) > 8) return { ...s, nodePath: s.nodePath!.slice(-8) }
+    if (s.kind === 'sheet' && s.groups?.length) return defined({ ...s, groups: undefined })
+    if (s.kind === 'slides' && (s.freeElements?.length ?? 0) > 3) return { ...s, freeElements: s.freeElements!.slice(0, 3) }
+    if (s.kind === 'slides' && (s.slideIds?.length ?? 0) > 10) return { ...s, slideIds: s.slideIds!.slice(0, 10) }
+    return null
+  }],
+]
+
+/**
+ * The context cut to `fits`, lowest priority first, each cut named in `truncated` (unless
+ * `markTruncated` is false: the header's round-4 shape has no such field). Deterministic.
+ */
+function fitArtifactViewContext(
+  context: ArtifactViewContext,
+  fits: (context: ArtifactViewContext) => boolean,
+  marks: Marks,
+): ArtifactViewContext {
+  const withMarks = (next: ArtifactViewContext) =>
+    marks.size ? { ...next, truncated: ARTIFACT_VIEW_TRUNCATIONS.filter((mark) => marks.has(mark)) } : next
+  let current = withMarks(context)
+  if (fits(current)) return current
+  for (const [mark, cut] of SELECTION_CUTS) {
+    for (let next = current.selection ? cut(current.selection) : null; next; next = current.selection ? cut(current.selection) : null) {
+      marks.add(mark)
+      current = withMarks({ ...current, selection: next })
+      if (fits(current)) return current
+    }
+  }
+  if (current.selection) {
+    marks.add('selection')
+    current = withMarks({ ...current, selection: { kind: current.selection.kind } as ArtifactSelection })
+    if (fits(current)) return current
+  }
+  if (current.lastEditedByUserAt) {
+    marks.add('lastEditedByUserAt')
+    current = withMarks({ ...current, lastEditedByUserAt: null })
+    if (fits(current)) return current
+  }
+  // The server re-reads the title as the run user: the client's copy is the last to go.
+  marks.add('title')
+  return withMarks({ ...current, title: '' })
+}
+
+/**
+ * Any value as a view context, tolerantly: unknown fields dropped, each field capped (cut, never
+ * a failure), the whole within `maxChars` of JSON. Null only without an id, kind and revision to
+ * address. A client's `sealedLinkToken` is never kept.
+ */
+export function normalizeArtifactViewContext(value: unknown, maxChars = ARTIFACT_CONTEXT_BODY_MAX_CHARS): ArtifactViewContext | null {
+  if (!isRecord(value)) return null
+  const artifactId = idOf(value.artifactId)
+  const kind = ARTIFACT_KINDS.find((known) => known === value.kind)
+  const revision = intIn(value.revision, 1, Number.MAX_SAFE_INTEGER)
+  if (!artifactId || !kind || !revision) return null
+  const marks: Marks = new Set(
+    Array.isArray(value.truncated) ? ARTIFACT_VIEW_TRUNCATIONS.filter((mark) => (value.truncated as unknown[]).includes(mark)) : [],
+  )
+  let selection: ArtifactSelection | null = null
+  if (value.selection !== undefined && value.selection !== null) {
+    selection = normalizeSelection(value.selection, marks)
+    if (!selection) marks.add('selection')
+  }
+  const context: ArtifactViewContext = defined({
+    artifactId,
+    kind,
+    title: typeof value.title === 'string' ? clipped(value.title, ARTIFACT_TITLE_MAX_CHARS, marks, 'title')! : '',
+    revision,
+    mode: ARTIFACT_VIEW_MODES.find((mode) => mode === value.mode) ?? 'viewing',
+    selection,
+    dirty: value.dirty === true,
+    lastEditedByUserAt: typeof value.lastEditedByUserAt === 'string' && value.lastEditedByUserAt.length <= 40 ? value.lastEditedByUserAt : null,
+    linkToken: typeof value.linkToken === 'string' && LINK_TOKEN.test(value.linkToken) ? value.linkToken : undefined,
+  })
+  const fitted = fitArtifactViewContext(context, (next) => JSON.stringify(next).length <= maxChars, marks)
+  // The run body's schema is strict: whatever this returns must read there, or a run would fail on it.
+  const checked = artifactViewContextSchema.safeParse(fitted)
+  return checked.success ? checked.data : null
+}
+
+/**
+ * The context as a stored copy keeps it (a saved draft, a queued message): never a link token,
+ * which lives in memory only (artifact-handoff.ts). A send from a stored copy reads as the user.
+ */
+export function withoutLinkToken<T extends ArtifactViewContext | null | undefined>(context: T): T {
+  if (!context || (context.linkToken === undefined && context.sealedLinkToken === undefined)) return context
+  const { linkToken: _token, sealedLinkToken: _sealed, ...rest } = context
+  return rest as T
+}
+
+const base64 = (text: string) => {
+  const bytes = new TextEncoder().encode(text)
+  let binary = ''
+  for (const byte of bytes) binary += String.fromCharCode(byte)
+  return btoa(binary)
+}
+
+/**
+ * The header copy: the round-4 shape (no link token, no `truncated`, no sealed token), cut to the
+ * header's cap. Null only for a context with nothing to address.
+ */
+export function encodeArtifactViewContext(context: unknown): string | null {
+  const normalized = normalizeArtifactViewContext(context)
+  if (!normalized) return null
+  const { linkToken: _token, sealedLinkToken: _sealed, truncated: _marks, ...legacy } = normalized
+  // Round-5 selection fields stay out of the round-4 header: only the body carries them.
+  if (legacy.selection?.kind === 'slides' && legacy.selection.slideIds) legacy.selection = defined({ ...legacy.selection, slideIds: undefined })
+  if (legacy.selection?.kind === 'whiteboard' && legacy.selection.viewport) legacy.selection = defined({ ...legacy.selection, viewport: undefined })
+  const fitted = fitArtifactViewContext(legacy, (next) => base64(JSON.stringify(next)).length <= ARTIFACT_CONTEXT_HEADER_MAX_CHARS, new Set())
+  const { truncated: _cut, ...shape } = fitted
+  const encoded = base64(JSON.stringify(shape))
+  return encoded.length <= ARTIFACT_CONTEXT_HEADER_MAX_CHARS ? encoded : null
+}
+
+/** The header's context, or null for an absent, oversized or malformed one (a send never fails on it). */
+export function decodeArtifactViewContext(header: string | null | undefined): ArtifactViewContext | null {
+  if (!header || header.length > ARTIFACT_CONTEXT_HEADER_MAX_CHARS || !/^[A-Za-z0-9+/]*={0,2}$/.test(header)) return null
+  try {
+    const binary = atob(header)
+    const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0))
+    return normalizeArtifactViewContext(JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes)))
+  } catch {
+    return null
+  }
+}
+
+/**
+ * The run's context as the API reads it: the body's when it reads, else the header's; null when
+ * neither does (never a failed run). The caller seals any `linkToken` before storing the run.
+ */
+export function resolveArtifactViewContext(input: {
+  body: unknown
+  header: string | null | undefined
+}): { context: ArtifactViewContext; source: 'body' | 'header' } | null {
+  const fromBody = input.body === undefined ? null : normalizeArtifactViewContext(input.body)
+  if (fromBody) return { context: fromBody, source: 'body' }
+  const fromHeader = decodeArtifactViewContext(input.header)
+  return fromHeader ? { context: fromHeader, source: 'header' } : null
+}
