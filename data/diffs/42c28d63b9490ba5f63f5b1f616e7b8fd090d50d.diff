+        //     userId: value.userId,
+        //   },
+        //   `${pluralize(creditsUsed, 'credit')} reported to Stripe`
+        // )
+      } catch (error) {
+        logger.error({ error, creditsUsed }, 'Failed to report usage to Stripe')
+      }
+    }
+  )
+
+  return savedMessage
 }
