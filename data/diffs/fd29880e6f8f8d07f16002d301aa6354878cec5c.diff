+        subagentList.length - 1,
+        persistentSelectedIndex + 5
+      ) // Jump 5 items down
+      if (newIndex !== persistentSelectedIndex) {
+        persistentSelectedIndex = newIndex
+        centerSelectedItem()
+        renderSubagentList()
+      }
+      return
+    }
+
+    if (key && key.name === 'home') {
