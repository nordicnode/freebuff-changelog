+        )
+        const boxWidth = Math.min(terminalWidth - 6, maxContentWidth)
+
+        // Add top border
+        lines.push(`  ${cyan('┌' + '─'.repeat(boxWidth + 2) + '┐')}`)
+
+        // Add content lines with proper padding
+        contentForBox.forEach((line) => {
+          const cleanLine = line.replace(/\u001b\[[0-9;]*m/g, '')
