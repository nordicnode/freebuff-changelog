diff --git a/backend/project.json b/backend/project.json
new file mode 100644
index 000000000..789c94ad0
--- /dev/null
+++ b/backend/project.json
@@ -0,0 +1,23 @@
+{
+  "name": "backend",
+  "$schema": "../node_modules/nx/schemas/project-schema.json",
+  "sourceRoot": "src",
+  "projectType": "application",
+  "targets": {
+    "build": {
+      "executor": "nx:run-commands",
+      "options": {
+        "command": "tsc --build",
+        "cwd": "backend"
+      }
+    },
+    "test": {
+      "executor": "nx:run-commands",
+      "options": {
+        "command": "bun test $(find src -name *.test.ts)",
+        "cwd": "backend"
+      }
+    }
+  },
+  "implicitDependencies": ["common"]
+}
