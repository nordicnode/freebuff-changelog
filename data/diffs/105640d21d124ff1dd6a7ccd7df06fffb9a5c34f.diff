+    .min(1, 'search_id cannot be empty')
+    .describe('search_id from the earlier search result.'),
+  user_consent: z
+    .literal(true)
+    .describe(
+      'Must be true, and only after the user has explicitly approved creating an account on this service.',
+    ),
+})
