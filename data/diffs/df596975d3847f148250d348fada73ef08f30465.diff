+                flexShrink: 0,
+              }}
+            >
+              <TerminalLink
+                text={loginUrl}
+                maxWidth={maxUrlWidth}
+                formatLines={(text, width) =>
+                  formatUrl(text, width ?? maxUrlWidth)
