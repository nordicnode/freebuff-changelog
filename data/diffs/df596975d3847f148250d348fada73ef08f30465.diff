+                width: '100%',
+                flexShrink: 0,
+              }}
+            >
+              <text wrap={false}>
+                <span fg={copyMessage.startsWith('✓') ? COPY_SUCCESS_COLOR : COPY_ERROR_COLOR}>
+                  {copyMessage}
+                </span>
+              </text>
+            </box>
+          )}
+        </box>
+      )}
+    </box>
+  )
+}
diff --git a/cli/src/components/terminal-link.tsx b/cli/src/components/terminal-link.tsx
