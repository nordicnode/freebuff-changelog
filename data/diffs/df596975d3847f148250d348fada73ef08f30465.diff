+                color={hasClickedLink ? LINK_COLOR_CLICKED : LINK_COLOR_DEFAULT}
+                activeColor={LINK_COLOR_CLICKED}
+                underlineOnHover={true}
+                isActive={justCopied}
+                onActivate={async () => {
