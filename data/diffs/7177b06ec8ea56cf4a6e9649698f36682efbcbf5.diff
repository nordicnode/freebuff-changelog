+        createGrantData({
+          operation_id: operationId,
+          user_id: userId,
+          balance: amount,
+          principal: amount,
+        }),
+      )
+    },
+    lockKey: `user:${userId}`,
+    context: { userId, amount, operationId },
+    logger,
+  })
+
+  return {
+    granted: amount,
+    startTime,
+    endTime: Date.now(),
+  }
+}
