@@ -391,50 +391,59 @@ const HARNESS_LABEL: Record<DeviceHarness, string> = {
   'claude-code': 'Claude Code',
 }
 const HARNESS_ACCOUNT: Record<DeviceHarness, string> = {
   codex: 'ChatGPT',
   'claude-code': 'Claude',
 }
 const PICK_FREEBUFF = 'choose a Freebuff model from the model picker to keep going'
 
 /** Desktop's own copy for a turn it could not run, already worded for the
  *  user (harness/claude-code.ts, codex-errors.ts, codex.ts). */
 const DESKTOP_WORDED = [
   /^This agent runs your local (Claude Code|Codex CLI), which is signed out\./,
   /^Your organization’s Claude Code policy disables autonomous permission mode\b/,
   /^Freebuff stopped this turn after its Claude Code elevation guard failed\./,
   /\. Update it to keep using this agent, or switch to another from the selector\.$/,
 ]
 
 /** When the CLI says its plan's limit resets, as it printed it (the computer's own clock). */
 function limitReset(message: string): string | null {
   const at =
     /\btry again at ([^()\n]{1,60}?)\.?\s*$/i.exec(message) ??
     /\bresets (?:at )?([^()\n·∙|]{1,40}?(?: \([^)\n]{1,40}\))?)\.?\s*(?:$|[·∙|])/i.exec(message)
   return at?.[1]?.trim() || null
 }
 
+/**
+ * What to do when Desktop refuses a chat because its folder's identity no longer matches the chat's
+ * binding and no known input says why (Desktop's `bindingChangeAdvice` 'unknown'). The notice that
+ * shows it has Reconnect folder. Builds before this pointed at Settings > General > Diagnose, which
+ * the page no longer shows (#10015); the hosted page rewrites that sentence from them.
+ */
+export const CHECKOUT_RECONNECT_FIX =
+  'Choose Reconnect folder to connect it again, or start a new chat in this folder. This chat’s history is kept.'
+
 /** Added to a failed turn that started without its computer (web `cloudRunErrorMessage`): otherwise
  * the user saw only the generic failure and could not tell the turn never had their files or
  * terminal. The hosted Desktop page finds it in a failed turn's error to offer Reconnect and retry. */
 export const DEVICE_UNREACHABLE_RUN_NOTE =
   'Your computer did not respond when this message started, so Freebuff had no access to its files or terminal. Check that Freebuff Desktop is open, then send the message again.'
 
 /**
  * The user-facing message for a native turn's journal `error`, or null when it
  * is not one we can name. Desktop builds before these messages existed wrote the
  * SDK's own text for every abort ("Claude Code process aborted by user").
  *
  * The CLI runs on the user's computer with their own sign-in, so most failures
  * are theirs to fix there: signed out, plan limit used up, a model their plan
  * cannot use. Only fixed classes are named; the CLI's raw text never is (it can
  * quote the request).
  */
 export function deviceHarnessFailureMessage(
   message: string,
   harness?: DeviceHarness,
 ): string | null {
   if (
     message === DEVICE_HARNESS_TIME_LIMIT_MESSAGE ||
     message === LEGACY_DEVICE_HARNESS_TIME_LIMIT_MESSAGE ||
     message === DEVICE_HARNESS_STOPPED_MESSAGE
   )
diff --git a/common/src/desktop-cloud/handback.ts b/common/src/desktop-cloud/handback.ts
index 95345d472..c00d8bd1e 100644
--- a/common/src/desktop-cloud/handback.ts
+++ b/common/src/desktop-cloud/handback.ts
@@ -27,53 +27,54 @@ export const CLOUD_EXPORT_HEADERS = {
 } as const
 
 export const handbackRequestSchema = z
   .object({
     workspaceId: z.string().min(1).max(120),
     /** The export's run receipt; a newer run means the export is stale. */
     exportRunId: z.string().max(120),
     exportSha256: z.string().regex(/^[0-9a-f]{64}$/),
   })
   .strict()
 export type HandbackRequest = z.infer<typeof handbackRequestSchema>
 
 /** Sent only after Desktop has committed the local landing. The timestamp identifies this move,
  * so a delayed acknowledgement cannot reclaim a later Cloud workspace. */
 export const handbackCompleteSchema = handbackRequestSchema.extend({
   handedBackAt: z.iso.datetime({ offset: true }),
 })
 export type HandbackCompleteRequest = z.infer<typeof handbackCompleteSchema>
 
 export interface HandbackResponse {
   workspaceId: string
   /** ISO time the chat left Cloud. Repeating the same handback returns the original time. */
   handedBackAt: string
 }
 
-/** The 409 a run request gets for a chat that continues on a computer. */
+/** The 409 a run request gets for a chat that continues on a computer. No control is called
+ *  "Continue in Cloud" any more: Desktop and the hosted page move a chat with its run location. */
 export const HANDED_BACK_RUN_ERROR =
-  'This chat continues on a computer. Open it there, or choose Continue in Cloud on that computer to bring it back.'
+  'This chat continues on a computer. Open it there, or choose Cloud as its run location on that computer to bring it back.'
 
 /** The 409 a handback gets when Cloud moved on after the export; export again. */
 export const STALE_EXPORT_ERROR =
   'This chat changed in Cloud after its files were copied. Retry Continue locally.'
 
 /**
  * Export v2 (`GET …/export?v=2`). The tar is the same working-tree copy, plus two entries under
  * this directory, which a worktree never exports itself:
  *
  * - `meta.json` (`CloudExportMeta`): the commit the chat's worktree started from, its HEAD, and the
  *   files tracked at HEAD that the working tree no longer has.
  * - `commits.bundle`: `git bundle` of HEAD excluding `base` (absent when HEAD is the base; with
  *   `history=full`, HEAD's whole history, for a Cloud project's first landing on a computer), under
  *   the ref `CLOUD_EXPORT_BUNDLE_REF`. Its prerequisites are reachable from `base`, which the
  *   computer that uploaded the chat has. Without a known base it holds HEAD's whole history.
  *
  * With them, Continue locally lands Cloud's commits as commits and merges Cloud's work with the
  * computer's own, instead of flattening it over the current branch tip. An older server ignores
  * `v` and sends v1 (no `meta.json`); Desktop then lands the files as before.
  */
 export const CLOUD_EXPORT_V2_DIR = '.freebuff-export'
 /** The ref name inside `commits.bundle`. */
 export const CLOUD_EXPORT_BUNDLE_REF = 'HEAD'
 
 const commitSchema = z.string().regex(/^[0-9a-f]{40}(?:[0-9a-f]{24})?$/)
