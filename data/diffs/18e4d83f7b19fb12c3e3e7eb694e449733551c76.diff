diff --git a/common/src/util/freebuff-hours.ts b/common/src/util/freebuff-hours.ts
index 85b57a101..e5f576025 100644
--- a/common/src/util/freebuff-hours.ts
+++ b/common/src/util/freebuff-hours.ts
@@ -200,25 +200,36 @@ export function freebucksShortfallLine(params: {
 }): { line: string; cheaperModelFits: boolean } {
   const model = params.modelName ?? 'this model'
   const cheaperModelFits = params.balance >= FREEBUCKS_PER_HOUR
   if (params.sharedDevice) {
     return {
       line:
         `The accounts on this device share one daily allowance, and what's left today doesn't cover an hour of ${model}.` +
         (cheaperModelFits
           ? ' Pick a model with a lower multiplier to keep going.'
           : ''),
       cheaperModelFits,
     }
   }
   const left = cheaperModelFits
     ? `${formatHoursWithUnit(params.balance)} left`
     : 'less than an hour left'
   return {
     line:
       `An hour of ${model} uses ${formatHoursWithUnit(params.price)}, and you have ${left}.` +
       (cheaperModelFits
         ? ' Pick a model with a lower multiplier to keep going.'
         : ''),
     cheaperModelFits,
   }
 }
+
+/**
+ * How a turn that ended for want of hours opens its message: the day's
+ * allowance cannot start another hour, and no cheaper model would either. The
+ * Cloud worker words it (`allowanceRefusalMessage`); the hosted page finds it
+ * to offer plans beside Retry, which meets the same refusal until the reset.
+ */
+export const FREEBUFF_HOURS_USED_UP = 'Today’s hours are used up'
+
+export const isFreebuffHoursUsedUp = (message: string | null | undefined) =>
+  !!message?.startsWith(FREEBUFF_HOURS_USED_UP)
