+  /^export\s+(const|let|var)\b/,
+  // Python
+  /^(async\s+)?def\s+\w/,
+  /^class\s+\w/,
+  // Go
+  /^func\s/,
+  /^type\s+\w+\s+(struct|interface)\b/,
+  // Rust
+  /^(pub(\([^)]*\))?\s+)?(async\s+)?(fn|struct|enum|trait|impl|mod)\b/,
+  // Markdown
+  /^#{1,3}\s+\S/,
