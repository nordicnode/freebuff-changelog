+      !edited &&
+      !read.content.startsWith(COMPACTED_READ_MARKER) &&
+      used + cost(file) <= params.tokenBudget
+    ) {
+      carried.push(file)
+      used += cost(file)
+    } else {
+      left.push({ read, reason: edited ? 'edited' : 'budget' })
+    }
+  }
