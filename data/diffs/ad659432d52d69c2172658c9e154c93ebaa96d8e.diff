+function getZodIssueCount(error: unknown): number {
+  if (
+    error != null &&
+    typeof error === 'object' &&
+    'issues' in error &&
+    Array.isArray((error as { issues: unknown }).issues)
+  ) {
+    return (error as { issues: unknown[] }).issues.length
+  }
+  return Infinity
