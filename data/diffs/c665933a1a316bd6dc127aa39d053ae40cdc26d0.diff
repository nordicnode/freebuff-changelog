  *  absent from SUPPORTED_FREEBUFF_MODELS by design. */
 function findFreebuffModelOption(
   id: string | null | undefined,
 ): FreebuffModelOption | undefined {
   return (
     SUPPORTED_FREEBUFF_MODELS.find((m) => freebuffModelIdMatches(id, m.id)) ??
