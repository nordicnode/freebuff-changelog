 export function hasIncompleteCodeFence(content: string): boolean {
   let fenceCount = 0
   const fenceRegex = /```/g
   while (fenceRegex.exec(content)) {
     fenceCount += 1
   }
   return fenceCount % 2 === 1
 }
 
