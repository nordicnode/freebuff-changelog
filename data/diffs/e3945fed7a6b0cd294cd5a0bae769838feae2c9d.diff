+/**
+ * Node-compatible file existence check.
+ * Uses fs.stat instead of Bun-specific fs.exists.
+ */
+export async function fileExists(params: {
+  filePath: string
+  fs: CodebuffFileSystem
+}): Promise<boolean> {
+  const { filePath, fs } = params
+
+  try {
+    await fs.stat(filePath)
+    return true
+  } catch {
+    return false
+  }
+}
