@@ -0,0 +1,60 @@
+import { expect, test } from 'bun:test'
+import {
+  DESKTOP_RECEIPT_PLATFORMS,
+  extractDesktopAcquisitionReceipt,
+  parseDesktopAcquisitionReceipt,
+} from './desktop-acquisition-receipt'
+
+const ID = '9ba081d8-8090-489e-a445-5a604cd144af'
+const ISSUED = Math.floor(Date.parse('2026-10-18T20:00:00Z') / 1_000)
+const token = (platform = 'windows') =>
+  `v1.${ID}.${ISSUED.toString(36)}.${platform}.${'a'.repeat(43)}`
+
+test('the public syntax parser accepts each release key without pretending to verify its HMAC', () => {
+  for (const platform of DESKTOP_RECEIPT_PLATFORMS) {
+    expect(parseDesktopAcquisitionReceipt(token(platform))).toEqual({
+      acquisition_id: ID,
+      issued_at: ISSUED,
+      platform,
+      token: token(platform),
+    })
+  }
+})
+
+test('receipt syntax rejects identity strings, noncanonical timestamps and trailing data', () => {
+  for (const malformed of [
+    undefined,
+    {},
+    'person@example.com',
+    token('unsupported'),
+    `${token()}\n`,
+    `${token()} `,
+    token().replace(ID, '00000000-0000-0000-0000-000000000000'),
+    token().replace(ISSUED.toString(36), `0${ISSUED.toString(36)}`),
+    token().slice(0, -1),
+    `${token()}=`,
+    token().replace('v1.', 'v0.'),
+  ]) {
+    expect(parseDesktopAcquisitionReceipt(malformed)).toBeNull()
+  }
+})
+
+test('filename receipts survive browser collision suffixes across installer formats', () => {
+  for (const extension of ['exe', 'app', 'zip', 'AppImage', 'deb']) {
+    for (const collision of ['', ' (1)', ' (42)']) {
+      const basename = `Freebuff Installer--fb_${token()}${collision}.${extension}`
+      expect(
+        extractDesktopAcquisitionReceipt(`/downloads/${basename}`),
+      ).toEqual(parseDesktopAcquisitionReceipt(token()))
+      expect(
+        extractDesktopAcquisitionReceipt(
+          `C:\\Users\\Person\\Downloads\\${basename}`,
+        ),
+      ).toEqual(parseDesktopAcquisitionReceipt(token()))
+    }
+  }
+  expect(extractDesktopAcquisitionReceipt('Freebuff Installer.exe')).toBeNull()
+  expect(
+    extractDesktopAcquisitionReceipt(`Freebuff--fb_${token()}.exe.untrusted`),
+  ).toBeNull()
+})
diff --git a/common/src/util/desktop-acquisition-receipt.ts b/common/src/util/desktop-acquisition-receipt.ts
new file mode 100644
index 000000000..4773a65f5
--- /dev/null
+++ b/common/src/util/desktop-acquisition-receipt.ts
@@ -0,0 +1,49 @@
+/** Public, noncredential receipt syntax shared by delivery and Desktop. HMAC verification is server-only. */
+export const DESKTOP_RECEIPT_PLATFORMS = [
+  'mac-arm64',
+  'mac-intel',
+  'windows',
+  'windows-arm64',
+  'windows-baseline',
+  'linux',
+  'linux-arm64',
+  'linux-appimage',
+  'linux-arm64-appimage',
+] as const
+export type DesktopReceiptPlatform = (typeof DESKTOP_RECEIPT_PLATFORMS)[number]
+export const DESKTOP_RECEIPT_MAX_AGE_SECONDS = 30 * 24 * 60 * 60
+const UUID =
+  '[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}'
+const TOKEN = new RegExp(
+  `^v1\\.(${UUID})\\.([0-9a-z]{6,10})\\.(${DESKTOP_RECEIPT_PLATFORMS.join('|')})\\.([A-Za-z0-9_-]{43})$`,
+)
+
+export function parseDesktopAcquisitionReceipt(value: unknown) {
+  if (typeof value !== 'string' || value.length > 180) return null
+  const match = TOKEN.exec(value)
+  if (!match || match[0] !== value) return null
+  const issued_at = Number.parseInt(match[2]!, 36)
+  if (
+    !Number.isSafeInteger(issued_at) ||
+    issued_at <= 0 ||
+    issued_at.toString(36) !== match[2]
+  )
+    return null
+  return {
+    acquisition_id: match[1]!,
+    issued_at,
+    platform: match[3]! as DesktopReceiptPlatform,
+    token: value,
+  }
+}
+
+export function extractDesktopAcquisitionReceipt(filename: unknown) {
+  if (typeof filename !== 'string') return null
+  const name = filename.split(/[\\/]/).pop() ?? ''
+  const marker = name.lastIndexOf('--fb_')
+  if (marker < 0) return null
+  const token = name
+    .slice(marker + 5)
+    .replace(/(?: \([0-9]+\))?\.(?:exe|app|zip|AppImage|deb)$/, '')
+  return parseDesktopAcquisitionReceipt(token)
+}
diff --git a/common/src/util/desktop-installer-archive.test.ts b/common/src/util/desktop-installer-archive.test.ts
new file mode 100644
index 000000000..ef26d42b4
--- /dev/null
+++ b/common/src/util/desktop-installer-archive.test.ts
@@ -0,0 +1,292 @@
+import { describe, expect, test } from 'bun:test'
+import { gzipSync, gunzipSync } from 'node:zlib'
+
+import {
+  DESKTOP_DEB_RECEIPT_MARKER,
+  prepareDesktopDebReceipt,
+} from './desktop-installer-archive'
+
+const token = (platform = 'linux') =>
+  `v1.12345678-1234-4234-8234-123456789abc.${Math.floor(Date.now() / 1000).toString(36)}.${platform}.${'a'.repeat(43)}`
+const script = `#!/bin/sh\nset -e\n${DESKTOP_DEB_RECEIPT_MARKER}\necho configured\n`
+
+function tarEntry(name: string, text: string, type = '0'): Buffer {
+  const data = Buffer.from(text)
+  const header = Buffer.alloc(512)
+  header.write(name, 0, 100)
+  header.write('0000755\0', 100, 8)
+  header.write('0000000\0', 108, 8)
+  header.write('0000000\0', 116, 8)
+  header.write(`${data.length.toString(8).padStart(11, '0')}\0`, 124, 12)
+  header.write('00000000000\0', 136, 12)
+  header.fill(32, 148, 156)
+  header.write(type, 156)
+  header.write('ustar\0', 257, 6)
+  header.write('00', 263, 2)
+  header.write(
+    `${header
+      .reduce((sum, byte) => sum + byte, 0)
+      .toString(8)
+      .padStart(6, '0')}\0 `,
+    148,
+    8,
+  )
+  return Buffer.concat([
+    header,
+    data,
+    Buffer.alloc((512 - (data.length % 512)) % 512),
+  ])
+}
+
+function arHeader(name: string, size: number): Buffer {
+  return Buffer.from(
+    `${`${name}/`.padEnd(16)}${'1234567'.padEnd(12)}${'0'.padEnd(6)}${'0'.padEnd(6)}${'100644'.padEnd(8)}${String(size).padEnd(10)}\x60\n`,
+  )
+}
+
+function arEntry(name: string, body: Buffer): Buffer {
+  return Buffer.concat([
+    arHeader(name, body.length),
+    body,
+    ...(body.length % 2 ? [Buffer.from('\n')] : []),
+  ])
+}
+
+function fixture(
+  options: {
+    postinst?: string
+    compression?: string
+    type?: string
+    duplicate?: boolean
+  } = {},
+) {
+  const controlEntry = tarEntry(
+    './control',
+    'Package: freebuff\nVersion: 0.0.180\nArchitecture: amd64\n',
+  )
+  const postinstEntry = tarEntry(
+    './postinst',
+    options.postinst ?? script,
+    options.type,
+  )
+  const control = gzipSync(
+    Buffer.concat([
+      controlEntry,
+      postinstEntry,
+      ...(options.duplicate ? [postinstEntry] : []),
+      Buffer.alloc(1024),
+    ]),
+  )
+  const prefix = Buffer.concat([
+    Buffer.from('!<arch>\n'),
+    arEntry('debian-binary', Buffer.from('2.0\n')),
+    arEntry(options.compression ?? 'control.tar.gz', control),
+  ])
+  // Arbitrary opaque compressed application data: the personalizer must never inspect or alter it.
+  const suffix = arEntry('data.tar.xz', Buffer.from([0, 128, 42, 255, 1, 2, 3]))
+  return {
+    prefix,
+    suffix,
+    archive: Buffer.concat([prefix, suffix]),
+    controlEntry,
+  }
+}
+
+async function* chunks(
+  buffer: Buffer,
+  chunkSize = 17,
+): AsyncGenerator<Uint8Array> {
+  yield new Uint8Array(0)
+  for (let i = 0; i < buffer.length; i += chunkSize)
+    yield buffer.subarray(i, i + chunkSize)
+}
+
+async function collect(source: AsyncIterable<Uint8Array>): Promise<Buffer> {
+  const chunks: Uint8Array[] = []
+  for await (const chunk of source) chunks.push(chunk)
+  return Buffer.concat(chunks)
+}
+
+function rewrittenControl(archive: Buffer): {
+  header: Buffer
+  control: Buffer
+  tail: Buffer
+} {
+  const offset = 8 + 60 + 4
+  const header = archive.subarray(offset, offset + 60)
+  const size = Number(header.toString('ascii', 48, 58).trim())
+  return {
+    header,
+    control: gunzipSync(archive.subarray(offset + 60, offset + 60 + size)),
+    tail: archive.subarray(offset + 60 + size + (size % 2)),
+  }
+}
+
+describe('Debian acquisition receipt delivery', () => {
+  test.each([1, 17, 65536])(
+    'personalizes only the install hook with %p-byte input chunks',
+    async (chunkSize) => {
+      const original = fixture()
+      const receipt = token()
+      const result = await collect(
+        await prepareDesktopDebReceipt(
+          chunks(original.archive, chunkSize),
+          receipt,
+        ),
+      )
+      const { header, control, tail } = rewrittenControl(result)
+      expect(result.subarray(0, 8 + 60 + 4)).toEqual(
+        original.archive.subarray(0, 8 + 60 + 4),
+      )
+      expect(header.subarray(0, 48)).toEqual(original.prefix.subarray(72, 120))
+      expect(control.subarray(0, original.controlEntry.length)).toEqual(
+        original.controlEntry,
+      )
+      expect(tail).toEqual(original.suffix)
+      const postinstHeader = control.subarray(
+        original.controlEntry.length,
+        original.controlEntry.length + 512,
+      )
+      const postinstSize = Number.parseInt(
+        postinstHeader.toString('ascii', 124, 136),
+        8,
+      )
+      const updated = control
+        .subarray(
+          original.controlEntry.length + 512,
+          original.controlEntry.length + 512 + postinstSize,
+        )
+        .toString()
+      expect(updated).toContain(`printf '%s\\n' '${receipt}'`)
+      expect(updated).toContain(
+        '[ ! -e /var/lib/freebuff/install-receipt.txt ] && install -d',
+      )
+      expect(updated).toContain('( set -C;')
+      expect(updated).toEndWith('echo configured\n')
+      expect(updated).not.toContain(DESKTOP_DEB_RECEIPT_MARKER)
+      const checksumHeader = Buffer.from(postinstHeader)
+      const storedChecksum = Number.parseInt(
+        checksumHeader.toString('ascii', 148, 156),
+        8,
+      )
+      checksumHeader.fill(32, 148, 156)
+      expect(storedChecksum).toBe(
+        checksumHeader.reduce((sum, byte) => sum + byte, 0),
+      )
+    },
+  )
+
+  test('does not pull the application payload while preparing the HTTP response', async () => {
+    const { prefix, suffix } = fixture()
+    let pulledPayload = false
+    let closed = false
+    async function* source() {
+      try {
+        yield prefix
+        pulledPayload = true
+        yield suffix
+      } finally {
+        closed = true
+      }
+    }
+    const prepared = await prepareDesktopDebReceipt(
+      source(),
+      token('linux-arm64'),
+    )
+    expect(pulledPayload).toBe(false)
+    const result = await collect(prepared)
+    expect(rewrittenControl(result).tail).toEqual(suffix)
+    expect(closed).toBe(true)
+  })
+
+  test('consumer cancellation closes the upstream download', async () => {
+    let closed = false
+    const { prefix, suffix } = fixture()
+    async function* source() {
+      try {
+        yield prefix
+        yield suffix
+      } finally {
+        closed = true
+      }
+    }
+    for await (const _chunk of await prepareDesktopDebReceipt(
+      source(),
+      token(),
+    ))
+      break
+    expect(closed).toBe(true)
+  })
+
+  test.each([
+    { postinst: '#!/bin/sh\necho old release\n' },
+    { postinst: `${script}\n${DESKTOP_DEB_RECEIPT_MARKER}` },
+    { type: '2' },
+    { duplicate: true },
+    { compression: 'control.tar.xz' },
+  ])(
+    'rejects unsupported or ambiguous control hooks before returning a stream: %p',
+    async (options) => {
+      await expect(
+        prepareDesktopDebReceipt(chunks(fixture(options).archive), token()),
+      ).rejects.toThrow()
+    },
+  )
+
+  test('bounds compressed and decompressed control archives', async () => {
+    const binary = arEntry('debian-binary', Buffer.from('2.0\n'))
+    const oversizedHeader = Buffer.concat([
+      Buffer.from('!<arch>\n'),
+      binary,
+      arHeader('control.tar.gz', 2 * 1024 * 1024 + 1),
+    ])
+    await expect(
+      prepareDesktopDebReceipt(chunks(oversizedHeader), token()),
+    ).rejects.toThrow('Unsupported Debian control archive')
+    const compressedBomb = arEntry(
+      'control.tar.gz',
+      gzipSync(Buffer.alloc(8 * 1024 * 1024 + 1)),
+    )
+    await expect(
+      prepareDesktopDebReceipt(
+        chunks(
+          Buffer.concat([Buffer.from('!<arch>\n'), binary, compressedBomb]),
+        ),
+        token(),
+      ),
+    ).rejects.toThrow()
+  })
+
+  test('malformed or truncated release downloads close the upstream', async () => {
+    let closed = false
+    async function* source() {
+      try {
+        yield fixture().prefix.subarray(0, 90)
+      } finally {
+        closed = true
+      }
+    }
+    await expect(prepareDesktopDebReceipt(source(), token())).rejects.toThrow(
+      'Truncated Debian installer',
+    )
+    expect(closed).toBe(true)
+    await expect(
+      prepareDesktopDebReceipt(chunks(Buffer.from('not ar!!')), token()),
+    ).rejects.toThrow('Invalid Debian installer')
+  })
+
+  test.each([`${token()}' ; touch /tmp/untrusted`, token('windows'), ''])(
+    'rejects unsafe/wrong-platform receipts before reading a release',
+    async (receipt) => {
+      let read = false
+      async function* source() {
+        read = true
+        yield fixture().archive
+      }
+      await expect(prepareDesktopDebReceipt(source(), receipt)).rejects.toThrow(
+        'Invalid Debian acquisition receipt',
+      )
+      expect(read).toBe(false)
+    },
+  )
+})
diff --git a/common/src/util/desktop-installer-archive.ts b/common/src/util/desktop-installer-archive.ts
new file mode 100644
index 000000000..68c564c80
--- /dev/null
+++ b/common/src/util/desktop-installer-archive.ts
@@ -0,0 +1,197 @@
+import { gzipSync, gunzipSync } from 'node:zlib'
+
+import { parseDesktopAcquisitionReceipt } from './desktop-acquisition-receipt'
+
+const AR_MAGIC = Buffer.from('!<arch>\n')
+const CONTROL_LIMIT = 2 * 1024 * 1024
+const CONTROL_TAR_LIMIT = 8 * 1024 * 1024
+export const DESKTOP_DEB_RECEIPT_MARKER =
+  '# FREEBUFF_INSTALL_RECEIPT_PLACEHOLDER'
+
+/** Reads only as much of a release stream as the current archive member needs. */
+class ArchiveReader {
+  private readonly iterator: AsyncIterator<Uint8Array>
+  private chunk: Uint8Array = new Uint8Array(0)
+  private offset = 0
+
+  constructor(source: AsyncIterable<Uint8Array>) {
+    this.iterator = source[Symbol.asyncIterator]()
+  }
+
+  async read(size: number): Promise<Buffer> {
+    const output = Buffer.alloc(size)
+    let written = 0
+    while (written < size) {
+      if (this.offset === this.chunk.length) {
+        const next = await this.iterator.next()
+        if (next.done) throw new Error('Truncated Debian installer')
+        this.chunk = next.value
+        this.offset = 0
+        if (!this.chunk.length) continue
+      }
+      const count = Math.min(size - written, this.chunk.length - this.offset)
+      output.set(this.chunk.subarray(this.offset, this.offset + count), written)
+      this.offset += count
+      written += count
+    }
+    return output
+  }
+
+  async *rest(): AsyncGenerator<Uint8Array> {
+    if (this.offset < this.chunk.length) yield this.chunk.subarray(this.offset)
+    for (;;) {
+      const next = await this.iterator.next()
+      if (next.done) return
+      if (next.value.length) yield next.value
+    }
+  }
+
+  async cancel(): Promise<void> {
+    await this.iterator.return?.()
+  }
+}
+
+function arMember(header: Buffer): { name: string; size: number } {
+  if (header.length !== 60 || header.toString('ascii', 58) !== '`\n')
+    throw new Error('Invalid Debian archive member')
+  const name = header.toString('ascii', 0, 16).trim().replace(/\/$/, '')
+  const sizeText = header.toString('ascii', 48, 58).trim()
+  if (!/^\d+$/.test(sizeText)) throw new Error('Invalid Debian archive size')
+  const size = Number(sizeText)
+  if (!Number.isSafeInteger(size))
+    throw new Error('Invalid Debian archive size')
+  return { name, size }
+}
+
+function tarName(header: Buffer): string {
+  const name = header.toString('utf8', 0, 100).replace(/\0.*$/s, '')
+  const prefix = header.toString('utf8', 345, 500).replace(/\0.*$/s, '')
+  return (prefix ? `${prefix}/${name}` : name).replace(/^\.\//, '')
+}
+
+function tarSize(header: Buffer): number {
+  const sizeText = header.toString('ascii', 124, 136).replace(/\0/g, '').trim()
+  if (!/^[0-7]+$/.test(sizeText))
+    throw new Error('Unsupported Debian control tar size')
+  const size = Number.parseInt(sizeText, 8)
+  if (!Number.isSafeInteger(size) || size > CONTROL_TAR_LIMIT)
+    throw new Error('Debian control tar member is too large')
+  return size
+}
+
+function resizedTarHeader(original: Buffer, size: number): Buffer {
+  const header = Buffer.from(original)
+  header.fill(0, 124, 136)
+  header.write(size.toString(8).padStart(11, '0'), 124, 11, 'ascii')
+  header.fill(32, 148, 156)
+  const checksum = header.reduce((total, byte) => total + byte, 0)
+  header.write(`${checksum.toString(8).padStart(6, '0')}\0 `, 148, 8, 'ascii')
+  return header
+}
+
+function receiptInstallScript(receipt: string): string {
+  // The caller verified the signature; the shared parser also limits this literal to shell-safe
+  // ASCII. This file is outside the application and is not replaced by ordinary auto-updates.
+  return `# Persist only the original acquisition, never replace it during an upgrade.\nif [ ! -e /var/lib/freebuff/install-receipt.txt ] && install -d -m 0755 /var/lib/freebuff; then\n    ( set -C; printf '%s\\n' '${receipt}' > /var/lib/freebuff/install-receipt.txt ) 2>/dev/null || true\n    chmod 0644 /var/lib/freebuff/install-receipt.txt 2>/dev/null || true\nfi`
+}
+
+function personalizeControl(control: Buffer, receipt: string): Buffer {
+  const archive = gunzipSync(control, { maxOutputLength: CONTROL_TAR_LIMIT })
+  if (archive.length > CONTROL_TAR_LIMIT)
+    throw new Error('Debian control tar is too large')
+  const parts: Buffer[] = []
+  let offset = 0
+  let rewritten = false
+  while (offset + 512 <= archive.length) {
+    const header = archive.subarray(offset, offset + 512)
+    if (header.every((byte) => byte === 0)) {
+      parts.push(archive.subarray(offset))
+      offset = archive.length
+      break
+    }
+    const size = tarSize(header)
+    const end = offset + 512 + Math.ceil(size / 512) * 512
+    if (end > archive.length) throw new Error('Truncated Debian control tar')
+    if (tarName(header) === 'postinst') {
+      if (rewritten || (header[156] !== 0 && header[156] !== 48))
+        throw new Error('Invalid Debian post-install hook')
+      const original = archive
+        .subarray(offset + 512, offset + 512 + size)
+        .toString('utf8')
+      if (original.split(DESKTOP_DEB_RECEIPT_MARKER).length !== 2)
+        throw new Error(
+          'Debian installer does not support acquisition receipts',
+        )
+      const updated = Buffer.from(
+        original.replace(
+          DESKTOP_DEB_RECEIPT_MARKER,
+          receiptInstallScript(receipt),
+        ),
+      )
+      parts.push(resizedTarHeader(header, updated.length), updated)
+      if (updated.length % 512)
+        parts.push(Buffer.alloc(512 - (updated.length % 512)))
+      rewritten = true
+    } else {
+      parts.push(archive.subarray(offset, end))
+    }
+    offset = end
+  }
+  if (!rewritten || offset !== archive.length)
+    throw new Error('Invalid Debian control tar')
+  return gzipSync(Buffer.concat(parts))
+}
+
+/**
+ * Personalize a website download without buffering its application payload. Only the small
+ * control.tar.gz install hook changes; the data archive and every byte after it pass through.
+ * The returned stream is ready only after the receipt hook has been checked, so unsupported
+ * releases can fail before the HTTP response starts. The caller must verify the receipt HMAC.
+ */
+export async function prepareDesktopDebReceipt(
+  source: AsyncIterable<Uint8Array>,
+  receipt: string,
+): Promise<AsyncIterable<Uint8Array>> {
+  const parsed = parseDesktopAcquisitionReceipt(receipt)
+  if (
+    !parsed ||
+    (parsed.platform !== 'linux' && parsed.platform !== 'linux-arm64')
+  )
+    throw new Error('Invalid Debian acquisition receipt')
+  const reader = new ArchiveReader(source)
+  try {
+    if (!(await reader.read(8)).equals(AR_MAGIC))
+      throw new Error('Invalid Debian installer')
+    const binaryHeader = await reader.read(60)
+    const binary = arMember(binaryHeader)
+    if (binary.name !== 'debian-binary' || binary.size !== 4)
+      throw new Error('Unsupported Debian installer')
+    const binaryBody = await reader.read(4)
+    if (binaryBody.toString('ascii') !== '2.0\n')
+      throw new Error('Unsupported Debian version')
+    const controlHeader = await reader.read(60)
+    const control = arMember(controlHeader)
+    if (control.name !== 'control.tar.gz' || control.size > CONTROL_LIMIT)
+      throw new Error('Unsupported Debian control archive')
+    const updated = personalizeControl(await reader.read(control.size), receipt)
+    if (control.size % 2) await reader.read(1)
+    const header = Buffer.from(controlHeader)
+    header.write(String(updated.length).padEnd(10, ' '), 48, 10, 'ascii')
+    return (async function* () {
+      try {
+        yield AR_MAGIC
+        yield binaryHeader
+        yield binaryBody
+        yield header
+        yield updated
+        if (updated.length % 2) yield Buffer.from('\n')
+        yield* reader.rest()
+      } finally {
+        await reader.cancel()
+      }
+    })()
+  } catch (error) {
+    await reader.cancel()
+    throw error
+  }
+}
diff --git a/common/src/util/desktop-installer-zip.ts b/common/src/util/desktop-installer-zip.ts
new file mode 100644
index 000000000..4bca04956
--- /dev/null
+++ b/common/src/util/desktop-installer-zip.ts
@@ -0,0 +1,200 @@
+/** Rename only ZIP entry paths around a signed .app; signed bundle bytes are unchanged. Small bootstrap archives only. */
+export function personalizeDesktopInstallerZip(
+  input: Uint8Array,
+  receipt: string,
+): Uint8Array {
+  const data = Buffer.from(input)
+  if (
+    data.length < 22 ||
+    data.length > 16 * 1024 * 1024 ||
+    !/^[A-Za-z0-9_.-]{50,180}$/.test(receipt) ||
+    receipt.trim() !== receipt
+  )
+    throw Error('Invalid installer archive')
+  let end = data.length - 22
+  while (
+    end >= Math.max(0, data.length - 65557) &&
+    data.readUInt32LE(end) !== 0x06054b50
+  )
+    end--
+  if (
+    end < 0 ||
+    data.readUInt32LE(end) !== 0x06054b50 ||
+    end + 22 + data.readUInt16LE(end + 20) !== data.length
+  )
+    throw Error('Invalid ZIP directory')
+  const count = data.readUInt16LE(end + 10),
+    directory = data.readUInt32LE(end + 16)
+  if (
+    !count ||
+    count > 2048 ||
+    data.readUInt16LE(end + 4) ||
+    data.readUInt16LE(end + 6) ||
+    data.readUInt16LE(end + 8) !== count ||
+    directory + data.readUInt32LE(end + 12) !== end
+  )
+    throw Error('Unsupported ZIP')
+  const extraFields = (bytes: Buffer) => {
+    for (let at = 0; at < bytes.length; ) {
+      if (at + 4 > bytes.length) throw Error('Invalid ZIP extra field')
+      const id = bytes.readUInt16LE(at),
+        size = bytes.readUInt16LE(at + 2)
+      if (id === 1 || at + 4 + size > bytes.length)
+        throw Error('Unsupported ZIP extra field')
+      at += 4 + size
+    }
+  }
+  const entries: {
+    central: Buffer
+    oldName: Buffer
+    name: Buffer
+    offset: number
+    flags: number
+    method: number
+    crc: number
+    compressed: number
+    uncompressed: number
+  }[] = []
+  let position = directory
+  let root = ''
+  const paths = new Set<string>()
+  for (let i = 0; i < count; i++) {
+    if (position + 46 > end || data.readUInt32LE(position) !== 0x02014b50)
+      throw Error('Invalid ZIP entry')
+    const n = data.readUInt16LE(position + 28),
+      x = data.readUInt16LE(position + 30),
+      c = data.readUInt16LE(position + 32)
+    const length = 46 + n + x + c
+    const flags = data.readUInt16LE(position + 8),
+      method = data.readUInt16LE(position + 10)
+    const crc = data.readUInt32LE(position + 16),
+      compressed = data.readUInt32LE(position + 20),
+      uncompressed = data.readUInt32LE(position + 24)
+    if (
+      position + length > end ||
+      data.readUInt16LE(position + 6) >= 45 ||
+      data.readUInt16LE(position + 34) ||
+      data.readUInt32LE(position + 42) === 0xffffffff ||
+      compressed === 0xffffffff ||
+      uncompressed === 0xffffffff ||
+      flags & 0x2041 ||
+      ![0, 8].includes(method) ||
+      (method === 0 && compressed !== uncompressed)
+    )
+      throw Error('Unsupported ZIP entry')
+    extraFields(data.subarray(position + 46 + n, position + 46 + n + x))
+    const oldName = data.subarray(position + 46, position + 46 + n),
+      path = oldName.toString('utf8')
+    root ||= path.split('/')[0] ?? ''
+    const components = path.replace(/\/$/, '').split('/')
+    if (
+      !root.endsWith('.app') ||
+      root.length <= 4 ||
+      root.includes('..') ||
+      /[\\:\x00-\x1f\x7f]/.test(path) ||
+      components.some((part) => !part || part === '.' || part === '..') ||
+      !Buffer.from(path).equals(oldName) ||
+      paths.has(path) ||
+      !(path === root || path.startsWith(root + '/'))
+    )
+      throw Error('Invalid app path')
+    paths.add(path)
+    const name = Buffer.from(
+      root.slice(0, -4) + '--fb_' + receipt + '.app' + path.slice(root.length),
+    )
+    if (name.length > 0xffff) throw Error('ZIP entry path too long')
+    entries.push({
+      central: Buffer.from(data.subarray(position, position + length)),
+      oldName,
+      name,
+      offset: data.readUInt32LE(position + 42),
+      flags,
+      method,
+      crc,
+      compressed,
+      uncompressed,
+    })
+    position += length
+  }
+  if (position !== end) throw Error('Invalid ZIP directory size')
+  const chunks: Buffer[] = [],
+    offsets = new Map<number, number>()
+  let outputSize = 0
+  const sorted = [...entries].sort((a, b) => a.offset - b.offset)
+  if (sorted[0]?.offset !== 0) throw Error('Unsupported ZIP prefix')
+  for (let i = 0; i < sorted.length; i++) {
+    const entry = sorted[i]!,
+      next = sorted[i + 1]?.offset ?? directory
+    if (
+      entry.offset + 30 > next ||
+      data.readUInt32LE(entry.offset) !== 0x04034b50 ||
+      data.readUInt16LE(entry.offset + 4) >= 45 ||
+      data.readUInt16LE(entry.offset + 6) !== entry.flags ||
+      data.readUInt16LE(entry.offset + 8) !== entry.method
+    )
+      throw Error('Invalid local ZIP entry')
+    const n = data.readUInt16LE(entry.offset + 26),
+      x = data.readUInt16LE(entry.offset + 28)
+    if (
+      entry.offset + 30 + n + x > next ||
+      !data
+        .subarray(entry.offset + 30, entry.offset + 30 + n)
+        .equals(entry.oldName)
+    )
+      throw Error('Inconsistent ZIP entry')
+    extraFields(data.subarray(entry.offset + 30 + n, entry.offset + 30 + n + x))
+    const localCrc = data.readUInt32LE(entry.offset + 14),
+      localCompressed = data.readUInt32LE(entry.offset + 18),
+      localUncompressed = data.readUInt32LE(entry.offset + 22)
+    const descriptor = Boolean(entry.flags & 8)
+    if (
+      (localCrc !== entry.crc && !(descriptor && localCrc === 0)) ||
+      (localCompressed !== entry.compressed &&
+        !(descriptor && localCompressed === 0)) ||
+      (localUncompressed !== entry.uncompressed &&
+        !(descriptor && localUncompressed === 0))
+    )
+      throw Error('Inconsistent ZIP sizes')
+    const payloadEnd = entry.offset + 30 + n + x + entry.compressed
+    const descriptorSize = next - payloadEnd
+    if (!descriptor && descriptorSize !== 0)
+      throw Error('Inconsistent ZIP payload')
+    if (descriptor) {
+      if (
+        ![12, 16].includes(descriptorSize) ||
+        payloadEnd < entry.offset ||
+        payloadEnd + descriptorSize > next
+      )
+        throw Error('Invalid ZIP descriptor')
+      const at = descriptorSize === 16 ? payloadEnd + 4 : payloadEnd
+      if (
+        (descriptorSize === 16 &&
+          data.readUInt32LE(payloadEnd) !== 0x08074b50) ||
+        data.readUInt32LE(at) !== entry.crc ||
+        data.readUInt32LE(at + 4) !== entry.compressed ||
+        data.readUInt32LE(at + 8) !== entry.uncompressed
+      )
+        throw Error('Inconsistent ZIP descriptor')
+    }
+    const header = Buffer.from(data.subarray(entry.offset, entry.offset + 30))
+    header.writeUInt16LE(entry.name.length, 26)
+    offsets.set(entry.offset, outputSize)
+    const rest = data.subarray(entry.offset + 30 + n, next)
+    chunks.push(header, entry.name, rest)
+    outputSize += header.length + entry.name.length + rest.length
+  }
+  const directoryOffset = outputSize
+  for (const entry of entries) {
+    const n = entry.central.readUInt16LE(28),
+      header = Buffer.from(entry.central.subarray(0, 46)),
+      rest = entry.central.subarray(46 + n)
+    header.writeUInt16LE(entry.name.length, 28)
+    header.writeUInt32LE(offsets.get(entry.offset)!, 42)
+    chunks.push(header, entry.name, rest)
+    outputSize += header.length + entry.name.length + rest.length
+  }
+  const footer = Buffer.from(data.subarray(end))
+  footer.writeUInt32LE(outputSize - directoryOffset, 12)
+  footer.writeUInt32LE(directoryOffset, 16)
+  return Buffer.concat([...chunks, footer])
+}
