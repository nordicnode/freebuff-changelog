   section: FreebuffPickerSectionId
   /** Position within the section; lower first. */
   order: number
   /** Listed under the section's collapsed "More" until expanded, or until it
    *  is the selected row. */
   more?: boolean
   /** The section's own pick, badged Recommended. */
   recommended?: boolean
 }
 
