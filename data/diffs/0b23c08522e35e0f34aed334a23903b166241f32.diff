diff --git a/.github/workflows/sdk-release-build.yml b/.github/workflows/sdk-release-build.yml
index d050ca1a4..3c1df7f5a 100644
--- a/.github/workflows/sdk-release-build.yml
+++ b/.github/workflows/sdk-release-build.yml
@@ -36,6 +36,19 @@ jobs:
           name: ${{ inputs.artifact-name }}
           path: sdk/
 
+      - name: Set environment variables
+        env:
+          SECRETS_CONTEXT: ${{ toJSON(secrets) }}
+        shell: bash
+        run: |
+          VAR_NAMES=$(bun scripts/generate-ci-env.js)
+          echo "$SECRETS_CONTEXT" | jq -r --argjson vars "$VAR_NAMES" '
+            to_entries | .[] | select(.key as $k | $vars | index($k)) | .key + "=" + .value
+          ' >> $GITHUB_ENV
+
+          echo "CODEBUFF_GITHUB_ACTIONS=true" >> $GITHUB_ENV
+          echo "CODEBUFF_GITHUB_TOKEN=${{ secrets.CODEBUFF_GITHUB_TOKEN }}" >> $GITHUB_ENV
+
       - name: Build SDK
         run: |
           cd sdk
