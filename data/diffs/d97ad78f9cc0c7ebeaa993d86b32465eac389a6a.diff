ies(\"down\", this.name),\n+        ArrowUp: insertEmptyParagraphAtNodeBoundaries(\"up\", this.name),\n+      };\n+    },\n+\n+    addNodeView() {\n+      return ReactNodeViewRenderer(CustomImageNodeView);\n+    },\n+  });\n+};\n"
