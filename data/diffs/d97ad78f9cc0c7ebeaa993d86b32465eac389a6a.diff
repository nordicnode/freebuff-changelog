mplete implementation now, formatting all changes as tool calls as shown above.`,\n+\n+    handleSteps: function* () {\n+      yield 'STEP'\n+    },\n+  }\n+}\n+const definition = {\n+  ...createBestOfNImplementor({ model: 'sonnet' }),\n+  id: 'editor-implementor',\n+}\n+export default definition\n"
