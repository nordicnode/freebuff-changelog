+
+  test('a run waiting on the user says Needs you and points below', async () => {
+    const frame = await draw({
+      phase: 'running',
+      changedFiles: [],
+      undone: false,
+      runningSince: Date.now(),
+      needsYou: true,
+    })
+    expect(frame).toContain('Needs you')
+    expect(frame).toContain('Waiting for you below')
