+    expect(anchors(additions)).toEqual(['a'])
+    expect(additions[0]!.ad.impUrl).toBe('imp-1')
+  })
+
+  test('spaces ads every 2 answers across a longer transcript', () => {
+    const additions = computeInlineAdAdditions({
