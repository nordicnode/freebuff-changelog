+    maxOutputTokens: PROJECT_UNDERSTANDING_MAX_OUTPUT_TOKENS,
+    outputMode: 'structured_output',
+    outputSchema: buildProjectUnderstandingOutputSchema(template),
+    includeMessageHistory: false,
