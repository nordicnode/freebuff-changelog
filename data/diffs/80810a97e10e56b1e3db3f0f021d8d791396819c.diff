 /** Exact reviewed pairs: a staging session must never cross into another environment. */
 export const HOSTED_WORKSPACE_ENVIRONMENTS = [
   { apiOrigin: HOSTED_WORKSPACE_API_ORIGIN, authOrigin: HOSTED_WORKSPACE_ORIGIN },
