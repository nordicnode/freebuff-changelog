   cleanupRenderer = undefined
   const setup = await createTestRenderer({ width, height: Math.max(40, maxHeight), kittyKeyboard: true })
   const root = createRoot(setup.renderer)
   cleanupRenderer = () => {
     flushSync(() => root.unmount())
     setup.renderer.destroy()
   }
   flushSync(() =>
     root.render(
