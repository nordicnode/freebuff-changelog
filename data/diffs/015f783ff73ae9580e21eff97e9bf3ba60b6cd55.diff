--- /dev/null
+++ b/common/src/desktop-cloud/file-download.test.ts
@@ -0,0 +1,41 @@
+import { expect, test } from 'bun:test'
+import { FILE_DOWNLOAD_CHUNK_BYTES as CHUNK, fileDownloadResponse } from './file-download'
+
+test('download response preserves binary bytes, filename and size beyond preview limits', async () => {
+  const data = new Uint8Array(CHUNK * 5 + 7).map((_, i) => i % 256)
+  const offsets: number[] = []
+  let closed = 0
+  const response = await fileDownloadResponse('dir/résumé "x".bin', async offset => {
+    offsets.push(offset)
+    return { data: data.slice(offset, offset + CHUNK), size: data.length, revision: 'stable' }
+  }, { close: async () => { closed++ } })
+  expect(response.headers.get('content-type')).toBe('application/octet-stream')
+  expect(response.headers.get('content-disposition')).toContain('r%C3%A9sum%C3%A9%20%22x%22.bin')
+  expect(new Uint8Array(await response.arrayBuffer())).toEqual(data)
+  expect(offsets).toEqual([0, CHUNK, CHUNK * 2, CHUNK * 3, CHUNK * 4, CHUNK * 5])
+  expect(closed).toBe(1)
+})
+test('file replacement and truncated chunks abort the response instead of completing a partial download', async () => {
+  for (const changed of ['revision', 'size', 'short']) {
+    let closed = 0
+    const response = await fileDownloadResponse('file', async offset => ({
+      data: new Uint8Array(offset && changed === 'short' ? 1 : CHUNK),
+      size: offset && changed === 'size' ? CHUNK * 3 : CHUNK * 2,
+      revision: offset && changed === 'revision' ? 'changed' : 'first',
+    }), { close: async () => { closed++ } })
+    await expect(response.arrayBuffer()).rejects.toThrow('changed')
+    expect(closed).toBe(1)
+  }
+})
+test('cancellation closes idle reads and initial failures close before returning headers', async () => {
+  let closed = 0
+  const abort = new AbortController()
+  const response = await fileDownloadResponse('file', async () => ({ data: new Uint8Array(CHUNK), size: CHUNK * 2, revision: 'a' }),
+    { signal: abort.signal, close: async () => { closed++ } })
+  abort.abort(new Error('cancelled'))
+  // Bun 1.3 throws synchronously for an already-errored Response body.
+  await expect((async () => response.arrayBuffer())()).rejects.toThrow('cancelled')
+  expect(closed).toBe(1)
+  await expect(fileDownloadResponse('file', async () => { throw new Error('missing') }, { close: async () => { closed++ } })).rejects.toThrow('missing')
+  expect(closed).toBe(2)
+})
diff --git a/common/src/desktop-cloud/file-download.ts b/common/src/desktop-cloud/file-download.ts
new file mode 100644
index 000000000..a6f240853
--- /dev/null
+++ b/common/src/desktop-cloud/file-download.ts
@@ -0,0 +1,75 @@
+/** Bounded binary reads shared by Desktop and Cloud; previews have separate limits. */
+export const FILE_DOWNLOAD_CHUNK_BYTES = 256 * 1024
+export interface FileDownloadChunk {
+  data: Uint8Array
+  size: number
+  revision: string
+}
+
+/** Fetch the first chunk before sending headers so missing files remain HTTP errors.
+ * Later failures abort the body: a partial download must never look successful. */
+export async function fileDownloadResponse(
+  path: string,
+  read: (offset: number) => Promise<FileDownloadChunk>,
+  options: { signal?: AbortSignal; close?: () => Promise<void> } = {},
+): Promise<Response> {
+  let closed = false
+  let onAbort: (() => void) | undefined
+  const close = async () => {
+    if (closed) return
+    closed = true
+    if (onAbort) options.signal?.removeEventListener('abort', onAbort)
+    await options.close?.()
+  }
+  let first: FileDownloadChunk
+  try {
+    options.signal?.throwIfAborted()
+    first = await read(0)
+    options.signal?.throwIfAborted()
+    if (!Number.isSafeInteger(first.size) || first.size < 0) throw new Error('Invalid download size')
+  } catch (error) {
+    await close()
+    throw error
+  }
+  let offset = 0
+  let initial: FileDownloadChunk | undefined = first
+  const body = new ReadableStream<Uint8Array>({
+    start(controller) {
+      onAbort = () => {
+        controller.error(options.signal?.reason ?? new Error('Download cancelled'))
+        void close().catch(() => {})
+      }
+      options.signal?.addEventListener('abort', onAbort, { once: true })
+    },
+    async pull(controller) {
+      try {
+        options.signal?.throwIfAborted()
+        const chunk = initial ?? await read(offset)
+        initial = undefined
+        if (closed) return
+        options.signal?.throwIfAborted()
+        if (chunk.size !== first.size || chunk.revision !== first.revision ||
+            chunk.data.length !== Math.min(FILE_DOWNLOAD_CHUNK_BYTES, first.size - offset))
+          throw new Error('The file changed during download. Please try again.')
+        offset += chunk.data.length
+        if (chunk.data.length) controller.enqueue(chunk.data)
+        if (offset === first.size) {
+          await close()
+          controller.close()
+        }
+      } catch (error) {
+        await close()
+        controller.error(error)
+      }
+    },
+    cancel: close,
+  })
+  const filename = path.split(/[\\/]/).pop() || 'download'
+  return new Response(body, { headers: {
+    'Content-Type': 'application/octet-stream',
+    'Content-Length': String(first.size),
+    'Content-Disposition': `attachment; filename*=UTF-8''${encodeURIComponent(filename).replace(/['()*]/g, char => '%' + char.charCodeAt(0).toString(16))}`,
+    'Cache-Control': 'private, no-store, no-transform',
+    'X-Content-Type-Options': 'nosniff',
+  } })
+}
