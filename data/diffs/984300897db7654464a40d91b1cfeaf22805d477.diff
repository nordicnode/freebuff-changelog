+    const b = scratch()
+    for (const dir of [a, b]) { fs.writeFileSync(path.join(dir, 'freebuff'), '#!/bin/sh'); fs.chmodSync(path.join(dir, 'freebuff'), 0o755) }
+    const onPath = commandsOnPath('freebuff', { PATH: [a, b, a].join(':') }, 'linux')
