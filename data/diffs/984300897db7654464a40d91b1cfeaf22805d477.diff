+    fs.writeFileSync(path.join(dir, 'last-fatal-crash.json'), JSON.stringify({ errorName: 'RangeError', crashedAt: new Date().toISOString(), crashedVersion: '0.2.30' }))
+    const history = historyFindings({ configDir: dir, now: Date.now() })
