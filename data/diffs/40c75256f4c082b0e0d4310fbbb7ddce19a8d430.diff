 export const SUPABASE_FOUNDATION_MODES = [
   'foundation-mac',
   'foundation-desktop',
   'foundation-backend-desktop',
   'foundation-local',
   'foundation-all',
 ] as const
 export type SupabaseFoundationMode = (typeof SUPABASE_FOUNDATION_MODES)[number]
 export function supabaseFoundationMode(
