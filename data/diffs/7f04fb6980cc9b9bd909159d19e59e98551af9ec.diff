 /** "BR" → "Brazil". Falls back to the raw code when the runtime can't
  *  resolve it (malformed code, missing ICU data). */
 export function formatFreebuffCountryName(countryCode: string): string {
   try {
     return (
       new Intl.DisplayNames(['en'], { type: 'region' }).of(countryCode) ??
       countryCode
     )
   } catch {
     return countryCode
   }
 }
 
 /**
  * The one line to render next to the model list. Callers gate on the access
- * tier: a full-access account has the whole catalog and needs no explanation.
+ * tier and the plan (`getFreebuffSessionModelAvailabilityNotice` for one
+ * session response; Desktop's snapshot keeps both until contradicted): a
+ * full-access account has the whole catalog and needs no explanation, and a
+ * paying account is never called limited nor sent to verify (operator,
+ * 2026-10-01).
  *
  * A missing/unknown reason still returns a line — the reduced catalog is
  * visible either way, so saying nothing is the one option that leaves the
- * question unanswered.
+ * question unanswered. That line names no cause: it was "…on this
+ * connection" until 2026-11-21, and the CLI header drew it for every
+ * response without a reason, full access and paid plans included, which sent
+ * a paying user looking for a network problem.
  */
 const COUNTRY_PAGE = 'freebuff.com/account?tab=country'
 
 export function getFreebuffModelAvailabilityNotice(
   reason: FreebuffLimitedModeReason | null | undefined,
 ): string {
-  const generic = "Some models aren't available on this connection"
+  const generic = "Some models aren't available yet"
   if (!reason) return generic
 
   const countryCode =
     reason.countryCode && reason.countryCode !== 'UNKNOWN'
       ? reason.countryCode
       : null
 
   switch (reason.countryBlockReason) {
     // Says why, not only what: since 2026-09-28 a VPN also gets a smaller
     // free Freebucks pool than the rest of limited access, and the honest
     // reason for both is the one the user can weigh.
     case 'anonymous_network':
       // A household line listed as a residential proxy is usually the user's
       // own connection, enrolled by a bandwidth-sharing app, not a VPN they
       // chose — so "try a direct connection" would be advice they cannot
       // take. Name the likely cause instead.
       // In a full-access country, someone who is not on a VPN (or cannot
       // turn off what flags the line) can confirm the country on Account →
       // Country (docs/freebuff-access-floor.md § Phone and ID attestation);
       // turning the VPN off comes first, because only that path asks for an
       // ID. Elsewhere there is nothing to confirm.
       const confirm =
         countryCode && FREE_MODE_ALLOWED_COUNTRIES.has(countryCode)
           ? `. Turn it off first. Can't, or not on one? Confirm your country at ${COUNTRY_PAGE}`
           : ''
       if (isResidentialProxyOnly(reason.ipPrivacySignals)) {
         return `This network is listed as a residential proxy, often because of a bandwidth-sharing app on a device here, so some models aren't available on it${
           confirm ? `. Confirm your country at ${COUNTRY_PAGE}` : ''
         }`
       }
       return `Using a ${formatFreebuffPrivacySignalList(
         reason.ipPrivacySignals,
       )}? We lose money on every VPN user, so more models and hours are available on a direct connection${confirm}`
     case 'country_not_allowed':
       return `Some models aren't available in ${
         countryCode ? formatFreebuffCountryName(countryCode) : 'your region'
       } yet`
     case 'recent_limited_country':
       return "This account was recently used from a region where some models aren't available yet, so those limits still apply for a while. Moved? Verify your country at freebuff.com/account?tab=country"
     case 'anonymized_or_unknown_country':
     case 'missing_client_ip':
     case 'unresolved_client_ip':
       return "We couldn't confirm your region, so we're showing models available everywhere"
     case 'ip_privacy_lookup_failed':
       return "We couldn't finish a network check, so we're showing models available everywhere"
     default:
       return generic
   }
 }
+
+/**
+ * The notice for one session response, or null when it has nothing to
+ * explain. Only a response that itself puts the account at limited access,
+ * without a plan, and carries the reason fields raises it.
+ *
+ * - No session yet (launch, a failed or shed GET) and the refusals
+ *   (`model_locked`, `ip_capped`, `superseded`, …) carry no reason and no
+ *   plan, so they cannot say whether there is anything to explain. The CLI
+ *   header drew the fallback for all of them, and for full access.
+ * - The pre-join GET sends the reason with every limited verdict
+ *   (`toLimitedModeReason` in the session route), and an active or ended view
+ *   sends it from the session row, so a limited account keeps its line there.
+ * - Never on a paid plan: `subscription.tierId`, or the plan the Freebucks
+ *   pool was sized from.
+ */
+export function getFreebuffSessionModelAvailabilityNotice(
+  session: { status: string } | null | undefined,
+): string | null {
+  if (!session || getFreebuffServerAccessTier(session) !== 'limited') {
+    return null
+  }
+  if (
+    getSubscriptionInfo(session)?.tierId != null ||
+    getFreebucksInfo(session)?.planId
+  ) {
+    return null
+  }
+  if (!('countryBlockReason' in session)) return null
+  return getFreebuffModelAvailabilityNotice(
+    session as FreebuffLimitedModeReason,
+  )
+}
