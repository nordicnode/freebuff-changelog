-/** The signals that change what is served. The other two are measurements. */
-export const ENFORCED_SIGNALS: ReadonlySet<ForeignClientSignal> =
-  new Set<ForeignClientSignal>([
-    'foreign_toolset',
-    'foreign_tool_names',
-    'foreign_system_prompt',
-  ])
