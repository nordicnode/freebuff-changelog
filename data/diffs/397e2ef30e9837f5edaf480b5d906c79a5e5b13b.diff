@@ -0,0 +1,96 @@
+/**
+ * THE ONE SERVING GATE for the display-ad placements.
+ *
+ * The placement ids in `DISPLAY_AD_PLACEMENT_IDS` are registered inventory
+ * (`PLACEMENT_SLOTS`, format `branded`; the Desktop three are mirrored to
+ * `:web` through `WEB_DESKTOP_SOURCE_PLACEMENTS`), so the billed impression
+ * and click endpoints, the delivery rows and the reporting grain all know
+ * them. What keeps them DARK is this set, and nothing else:
+ *
+ * - The serve path withholds an id not in it before any provider is asked
+ *   (both rails: `withholdDarkDisplayPlacements`), so no campaign can be
+ *   delivered to it, and the request reports `no_fill_reason: display_dark`.
+ * - `GET /api/v1/ads/policy` and `GET /api/ads/policy` announce only live ids
+ *   (`displayPlacementIds`), so a client knows not to ask.
+ * - Campaign targeting refuses an id not in it (`isTargetablePlacement`), for
+ *   advertisers and operators alike, and the self-serve picker never offers
+ *   it (`available` on its slot is derived from this set).
+ *
+ * TO GO LIVE for one placement, add its exact id here, for example
+ * `'Desktop-Top-Banner'`. Each surface is its own id: the `:web` mirror is
+ * NOT implied by its Desktop source, so add `'Desktop-Top-Banner:web'` too
+ * when the Cloud/web workspace should serve it. A deploy of `web` (CLI and
+ * Desktop rail) and `freebuff-web` (browser rail) is what turns it on. No env
+ * var, by design: going live is a reviewed code change.
+ */
+import { DISPLAY_AD_PLACEMENT_IDS } from './placements'
+
+import type { DisplayAdPlacementId } from './placements'
+
+/** Live display-ad placement ids. EMPTY: nothing is served yet. */
+export const DISPLAY_AD_SERVING_LIVE: ReadonlySet<DisplayAdPlacementId> =
+  new Set<DisplayAdPlacementId>([])
+
+/** Every display-ad placement id, on every surface, in slot order. */
+export const DISPLAY_AD_SERVED_PLACEMENT_IDS: readonly DisplayAdPlacementId[] =
+  Object.values(DISPLAY_AD_PLACEMENT_IDS).flatMap(
+    (ids) => Object.values(ids) as DisplayAdPlacementId[],
+  )
+
+const DISPLAY_IDS: ReadonlySet<string> = new Set(DISPLAY_AD_SERVED_PLACEMENT_IDS)
+
+export function isDisplayAdPlacementId(id: string): id is DisplayAdPlacementId {
+  return DISPLAY_IDS.has(id)
+}
+
+/**
+ * Whether a display-ad placement may serve. `live` is a test seam; production
+ * callers always use the checked-in set.
+ */
+export function isDisplayAdServingLive(
+  id: string,
+  live: ReadonlySet<string> = DISPLAY_AD_SERVING_LIVE,
+): boolean {
+  return isDisplayAdPlacementId(id) && live.has(id)
+}
+
+/** A display-ad placement that is registered but not yet live. */
+export function isDarkDisplayAdPlacement(
+  id: string,
+  live: ReadonlySet<string> = DISPLAY_AD_SERVING_LIVE,
+): boolean {
+  return isDisplayAdPlacementId(id) && !live.has(id)
+}
+
+/**
+ * Split a resolved placement list into what may be served and the dark
+ * display-ad ids withheld from it. Order is preserved.
+ */
+export function withholdDarkDisplayPlacements(
+  placementIds: readonly string[],
+  live: ReadonlySet<string> = DISPLAY_AD_SERVING_LIVE,
+): { placementIds: string[]; withheld: string[] } {
+  const withheld = placementIds.filter((id) =>
+    isDarkDisplayAdPlacement(id, live),
+  )
+  return {
+    placementIds: withheld.length
+      ? placementIds.filter((id) => !withheld.includes(id))
+      : [...placementIds],
+    withheld,
+  }
+}
+
+/**
+ * The live display-ad ids a policy response announces for one surface: the
+ * Desktop and CLI ids on `/api/v1/ads/policy`, the `:web` ids on the browser
+ * policy.
+ */
+export function liveDisplayPlacementIds(
+  surface: 'app' | 'web',
+  live: ReadonlySet<string> = DISPLAY_AD_SERVING_LIVE,
+): DisplayAdPlacementId[] {
+  return DISPLAY_AD_SERVED_PLACEMENT_IDS.filter(
+    (id) => live.has(id) && id.endsWith(':web') === (surface === 'web'),
+  )
+}
diff --git a/common/src/ads/display-ads/sponsor-theme.ts b/common/src/ads/display-ads/sponsor-theme.ts
new file mode 100644
index 000000000..494364a8b
--- /dev/null
+++ b/common/src/ads/display-ads/sponsor-theme.ts
@@ -0,0 +1,116 @@
+/**
+ * One sponsor colour pair → everything a display-ad placement paints with.
+ *
+ * A sponsor states a `fill` (its brand colour) and optionally an `ink` (text
+ * and icons drawn ON the fill). Every placement, on Desktop, Cloud and the
+ * CLI, derives its surfaces from these two values through this module, so a
+ * sponsor's colours are set in exactly one place (`sponsors.ts`).
+ *
+ * When `ink` is omitted it is derived: near-black or white, whichever reads
+ * better on the fill, tested against WCAG's 4.5:1 for normal text (every
+ * sRGB fill gets an ink that clears it; the test walks the cube).
+ *
+ * Pure functions over `#rrggbb` strings, no DOM, no terminal: the Desktop
+ * stylesheet does its own tints with `color-mix()` against the app's tokens,
+ * and the CLI blends with `tint()` against its theme surface.
+ */
+import { isValidBrandHex } from '../inline-ad-layout'
+
+export interface SponsorColors {
+  /** The sponsor's brand colour, `#rrggbb`. */
+  fill: string
+  /** Text/icon colour on `fill`, `#rrggbb`. Derived from `fill` when omitted. */
+  ink?: string
+}
+
+export interface SponsorTheme {
+  fill: string
+  ink: string
+  /** WCAG contrast ratio of `ink` on `fill` (1–21). */
+  contrast: number
+  /** Whether `fill` is a light colour (so dark ink sits on it). */
+  fillIsLight: boolean
+  /** `pct`% of `fill` blended over `over` (`#rrggbb`), as `#rrggbb`. */
+  tint(pct: number, over: string): string
+}
+
+/** WCAG AA for normal-size text. */
+export const MIN_INK_CONTRAST = 4.5
+
+/** The two derived inks. Near-black, not pure black, matching the sponsor fixtures. */
+export const DARK_INK = '#0a0a0a'
+export const LIGHT_INK = '#ffffff'
+
+type Rgb = readonly [number, number, number]
+
+function parseHex(hex: string): Rgb {
+  if (!isValidBrandHex(hex)) {
+    throw new Error(`sponsor colour must be #rrggbb, got ${JSON.stringify(hex)}`)
+  }
+  return [
+    parseInt(hex.slice(1, 3), 16),
+    parseInt(hex.slice(3, 5), 16),
+    parseInt(hex.slice(5, 7), 16),
+  ]
+}
+
+const toHex = (rgb: Rgb): string =>
+  `#${rgb.map((c) => Math.round(c).toString(16).padStart(2, '0')).join('')}`
+
+/** WCAG 2.x relative luminance of a `#rrggbb` colour. */
+export function relativeLuminance(hex: string): number {
+  const [r, g, b] = parseHex(hex).map((c) => {
+    const s = c / 255
+    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4
+  })
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b
+}
+
+/** WCAG contrast ratio between two `#rrggbb` colours (1–21). */
+export function contrastRatio(a: string, b: string): number {
+  const la = relativeLuminance(a)
+  const lb = relativeLuminance(b)
+  return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05)
+}
+
+/**
+ * The derived ink for a fill: whichever of DARK_INK / LIGHT_INK contrasts
+ * more. Near-black gives up a little range, so for the narrow band of
+ * mid-luminance fills where neither reaches 4.5:1 it falls back to pure
+ * black, which does.
+ */
+export function deriveInk(fill: string): string {
+  const dark = contrastRatio(DARK_INK, fill)
+  const light = contrastRatio(LIGHT_INK, fill)
+  if (Math.max(dark, light) < MIN_INK_CONTRAST) return '#000000'
+  return dark >= light ? DARK_INK : LIGHT_INK
+}
+
+/** `pct`% (0–100, clamped) of `fg` blended over `bg` in sRGB, as `#rrggbb`. */
+export function mixHex(fg: string, bg: string, pct: number): string {
+  const t = Math.min(100, Math.max(0, pct)) / 100
+  const f = parseHex(fg)
+  const b = parseHex(bg)
+  const at = (i: 0 | 1 | 2) => f[i] * t + b[i] * (1 - t)
+  return toHex([at(0), at(1), at(2)])
+}
+
+/**
+ * Resolve a sponsor's colours. Throws on a malformed hex: the only input is
+ * checked-in fixture data, so a typo should fail its test, not render grey.
+ * A stated `ink` is kept as the sponsor's choice even below 4.5:1; check
+ * `contrast` (the fixture test does) rather than overriding a brand.
+ */
+export function resolveSponsorTheme(colors: SponsorColors): SponsorTheme {
+  const fill = colors.fill.toLowerCase()
+  parseHex(fill)
+  const ink = (colors.ink ?? deriveInk(fill)).toLowerCase()
+  parseHex(ink)
+  return {
+    fill,
+    ink,
+    contrast: contrastRatio(fill, ink),
+    fillIsLight: deriveInk(fill) !== LIGHT_INK,
+    tint: (pct, over) => mixHex(fill, over, pct),
+  }
+}
diff --git a/common/src/ads/display-ads/sponsors.ts b/common/src/ads/display-ads/sponsors.ts
new file mode 100644
index 000000000..5215ffde5
--- /dev/null
+++ b/common/src/ads/display-ads/sponsors.ts
@@ -0,0 +1,226 @@
+/**
+ * MOCK sponsors for the display-ad placements: the single source of truth for
+ * each sponsor's name, link, logo, copy and COLOURS, on every surface.
+ *
+ * Colour lives here and nowhere else: `colors: { fill, ink? }`. Placements
+ * never write a hex; they read `sponsorFor(placement).theme` (see
+ * `sponsor-theme.ts`), and Desktop/Cloud turn that into `--ad-fill` /
+ * `--ad-ink` on the unit's wrapper. Omit `ink` to derive a 4.5:1 one.
+ *
+ * Which sponsor fills which placement is `DISPLAY_AD_LINEUP`, below.
+ *
+ * Nothing here is served: no campaign, auction or impression stands behind
+ * these. Copy and MCP endpoints are illustrative and must be re-checked with
+ * the advertiser before any of this is wired to real serving. Logos are the
+ * brands' Simple Icons marks (CC0), the same ones as
+ * `freebuff/web/public/logos/services/*.svg`, kept inline as path data so Desktop
+ * and Cloud draw them in the sponsor's ink with no asset pipeline. The CLI
+ * draws `lettermark`.
+ */
+import { resolveSponsorTheme } from './sponsor-theme'
+
+export type { DisplayAdSlot } from './placements'
+
+import type { DisplayAdSlot } from './placements'
+import type { SponsorColors, SponsorTheme } from './sponsor-theme'
+
+export type SponsorId = 'neon' | 'sentry' | 'deepgram' | 'clerk' | 'upstash'
+
+/** A single-path mark drawn with `fill="currentColor"` (the sponsor's ink). */
+export interface SponsorLogo {
+  viewBox: string
+  path: string
+}
+
+export interface SponsorCopy {
+  /** Bold line. */
+  headline: string
+  /** One supporting sentence. */
+  body: string
+  /** CTA label. Placements that show the domain as the CTA ignore it. */
+  cta: string
+  /** Short one-liner for single-row units (statusline, one-line splash). */
+  tagline: string
+}
+
+/** What the MCP featured card adds when the user clicks "Add server". */
+export interface SponsorMcpServer {
+  /** The entry's name in the user's MCP config. */
+  configKey: string
+  description: string
+  connection:
+    | { transport: 'http'; url: string }
+    | { transport: 'stdio'; command: string; args: string[] }
+}
+
+export interface DisplayAdSponsor {
+  id: SponsorId
+  name: string
+  /** Shown as the link text, e.g. on a "neon.com ↗" CTA chip. */
+  domain: string
