diff --git a/cli/src/components/display-ad-deals.tsx b/cli/src/components/display-ad-deals.tsx
new file mode 100644
index 000000000..07096bc4c
--- /dev/null
+++ b/cli/src/components/display-ad-deals.tsx
@@ -0,0 +1,166 @@
+/**
+ * The offer cards `/deals` prints into the transcript (slot `deals`, flagged
+ * with `cliStatusline`).
+ *
+ * Each card is a sponsor-colour header band (number, lettermark, bold name,
+ * "Sponsored") over a tinted body line with a filled "Open ↗" chip, one blank
+ * row between cards and around the list, then the usage hint.
+ *
+ * MOCK (`sponsorsFor('deals')` from common's fixture): each card's
+ * impression (on insertion, with its 1-based position) and clicks go to
+ * analytics only (`ads/display-ads-telemetry.ts`).
+ *
+ * SERVED (`/deals` passes the one served `CLI-Deals` ad, position 1, no mocks
+ * mixed in): billed impression on insertion, billed click before opening its
+ * clickUrl (`ads/served-display-ads.ts`).
+ */
+import { sponsorsFor } from '@codebuff/common/ads/display-ads/sponsors'
+
+import { Button } from './button'
+import {
+  CLI_DISPLAY_AD_PLACEMENT_IDS,
+  cliDisplayAdEnabled,
+  cliSponsorColors,
+} from '../ads/display-ads'
+import {
+  trackCliDisplayAd,
+  useCliDisplayAdImpression,
+} from '../ads/display-ads-telemetry'
+import {
+  isCliServedSponsor,
+  recordServedDisplayClick,
+  useServedDisplayImpression,
+  type CliDisplaySponsor,
+  type CliServedSponsor,
+} from '../ads/served-display-ads'
+import { useTerminalDimensions } from '../hooks/use-terminal-dimensions'
+import { useTheme } from '../hooks/use-theme'
+import { safeOpen } from '../utils/open-url'
+
+import type { PlacedSponsor } from '@codebuff/common/ads/display-ads/sponsors'
+
+export const DEALS_FOOTER_HINT = '/deals use 1   /deals off'
+
+const MAX_CARD_WIDTH = 72
+
+export function DisplayAdDeals({
+  sponsors = sponsorsFor('deals'),
+  placementId = CLI_DISPLAY_AD_PLACEMENT_IDS.deals,
+  open = safeOpen,
+  enabled = cliDisplayAdEnabled('cliStatusline'),
+}: {
+  sponsors?: CliDisplaySponsor[]
+  placementId?: string
+  open?: (url: string) => unknown
+  /** The flag `/deals` printed this under; false sends no analytics. */
+  enabled?: boolean
+}) {
+  const theme = useTheme()
+  const { terminalWidth } = useTerminalDimensions()
+  const width = Math.max(24, Math.min(MAX_CARD_WIDTH, terminalWidth - 6))
+  return (
+    <box
+      id={placementId}
+      style={{ flexDirection: 'column', marginTop: 1, marginBottom: 1, gap: 1 }}
+    >
+      {sponsors.map((sponsor, i) => {
+        const colors = cliSponsorColors(sponsor.theme, theme)
+        const onOpen = (action: 'header' | 'cta') => {
+          if (isCliServedSponsor(sponsor)) recordServedDisplayClick(sponsor)
+          else
+            trackCliDisplayAd(
+              { kind: 'click', slot: 'deals', sponsorId: sponsor.id, action, position: i + 1 },
+              enabled,
+            )
+          void open(sponsor.url)
+        }
+        return (
+          <box key={sponsor.id} style={{ width, flexDirection: 'column' }}>
+            {isCliServedSponsor(sponsor) ? (
+              <ServedDealImpression sponsor={sponsor} />
+            ) : (
+              <DealImpression sponsor={sponsor} position={i + 1} enabled={enabled} />
+            )}
+            <Button
+              onClick={() => onOpen('header')}
+              style={{
+                width: '100%',
+                height: 1,
+                paddingLeft: 1,
+                paddingRight: 1,
+                flexDirection: 'row',
+                justifyContent: 'space-between',
+                backgroundColor: colors.fill,
+              }}
+            >
+              <text style={{ fg: colors.ink, wrapMode: 'none', flexShrink: 1 }}>
+                {`${i + 1}  `}
+                <span bg={colors.ink} fg={colors.fill}>
+                  <b>{` ${sponsor.lettermark} `}</b>
+                </span>
+                <b>{` ${sponsor.name}`}</b>
+              </text>
+              <text style={{ fg: colors.ink, wrapMode: 'none', flexShrink: 0 }}>
+                Sponsored
+              </text>
+            </Button>
+            <box
+              style={{
+                width: '100%',
+                paddingLeft: 1,
+                paddingRight: 1,
+                flexDirection: 'row',
+                justifyContent: 'space-between',
+                backgroundColor: colors.tint,
+              }}
+            >
+              <text
+                style={{ fg: colors.tintText, wrapMode: 'word', flexShrink: 1 }}
+              >
+                <b>{sponsor.copy.headline}</b>
+                <span fg={colors.tintMuted}>{`  ${sponsor.domain}`}</span>
+              </text>
+              <Button
+                onClick={() => onOpen('cta')}
+                style={{ flexShrink: 0, paddingLeft: 1 }}
+              >
+                <text style={{ wrapMode: 'none' }}>
+                  <span bg={colors.fill} fg={colors.ink}>
+                    <b>{' Open ↗ '}</b>
+                  </span>
+                </text>
+              </Button>
+            </box>
+          </box>
+        )
+      })}
+      <text style={{ fg: theme.muted, wrapMode: 'none' }}>
+        {DEALS_FOOTER_HINT}
+      </text>
+    </box>
+  )
+}
+
+/** Renders nothing; the billed impression of a served card, on insertion. */
+function ServedDealImpression({
+  sponsor,
+}: {
+  sponsor: CliServedSponsor
+}) {
+  useServedDisplayImpression(sponsor)
+  return null
+}
+
+/** Renders nothing; reports one card's impression when the list is inserted. */
+function DealImpression({
+  sponsor,
+  position,
+  enabled,
+}: {
+  sponsor: PlacedSponsor
+  position: number
+  enabled: boolean
+}) {
+  useCliDisplayAdImpression('deals', sponsor.id, enabled, position)
+  return null
+}
diff --git a/cli/src/components/display-ad-splash.tsx b/cli/src/components/display-ad-splash.tsx
new file mode 100644
index 000000000..594b3e634
--- /dev/null
+++ b/cli/src/components/display-ad-splash.tsx
@@ -0,0 +1,270 @@
+/**
+ * `cliSplash`: the mock sponsor block under the launch header box.
+ *
+ * Boxed (the default): a 1px sponsor-colour border round an inverse band
+ * (lettermark, bold name, "Sponsored") over a tinted body with the headline,
+ * the body line, a filled "domain ↗" chip and "hide for today". The one-line
+ * variant is an inverse "Sponsored │ Name" chip, the tagline and the domain,
+ * for short terminals. Both carry the one disclosure and a hide control.
+ * The header's own bottom margin spaces the block from the transcript.
+ *
+ * MOCK (the local `cliSplash` flag): `sponsorFor('cliSplash')` from common's
+ * fixture, nothing fetched or billed; the impression (on insertion), the CTA
+ * and "hide for today" go to analytics only (`ads/display-ads-telemetry.ts`).
+ *
+ * SERVED (flag off, `CLI-Splash` in the policy's `displayPlacementIds`): one
+ * served ad (`ads/served-display-ads.ts`) drawn through the same views, with
+ * the billed impression on insertion and the billed click before opening its
+ * clickUrl. No fill draws nothing. "Hide for today" stays local.
+ */
+import { sponsorFor } from '@codebuff/common/ads/display-ads/sponsors'
+import { TextAttributes } from '@opentui/core'
+
+import { Button } from './button'
+import {
+  CLI_DISPLAY_AD_PLACEMENT_IDS,
+  cliDisplayAdEnabled,
+  cliSponsorColors,
+} from '../ads/display-ads'
+import {
+  useDisplayAdsStore,
+  useSplashHiddenToday,
+} from '../ads/display-ads-store'
+import {
+  trackCliDisplayAd,
+  useCliDisplayAdImpression,
+} from '../ads/display-ads-telemetry'
+import {
+  recordServedDisplayClick,
+  useServedDisplayAd,
+  useServedDisplayImpression,
+  type GetDisplayAd,
+} from '../ads/served-display-ads'
+import { useTheme } from '../hooks/use-theme'
+import { safeOpen } from '../utils/open-url'
+
+import type { CliSponsorColors } from '../ads/display-ads'
+import type { DisplaySponsor } from '@codebuff/common/ads/display-ads/served'
+
+export type DisplayAdSplashVariant = 'boxed' | 'line'
+
+/** Rows below which the launch header gets the one-line variant. */
+export const SPLASH_BOXED_MIN_ROWS = 28
+
+export function displayAdSplashVariant(
+  terminalHeight: number,
+): DisplayAdSplashVariant {
+  return terminalHeight < SPLASH_BOXED_MIN_ROWS ? 'line' : 'boxed'
+}
+
+/** The flagged or served, not-hidden-today block; renders nothing otherwise. */
+export function DisplayAdSplash({
+  width,
+  variant,
+  placementId = CLI_DISPLAY_AD_PLACEMENT_IDS.cliSplash,
+  enabled = cliDisplayAdEnabled('cliSplash'),
+  getServed,
+  open = safeOpen,
+}: {
+  width: number
+  variant: DisplayAdSplashVariant
+  placementId?: string
+  /** Test seam; production reads the settings flag. */
+  enabled?: boolean
+  /** Test seam for the served fetch. */
+  getServed?: GetDisplayAd
+  open?: (url: string) => unknown
+}) {
+  const theme = useTheme()
+  const hidden = useSplashHiddenToday()
+  const hide = useDisplayAdsStore((s) => s.hideSplashForToday)
+  const mock = enabled ? sponsorFor('cliSplash') : null
+  const served = useServedDisplayAd(placementId, !enabled && !hidden, getServed)
+  const shownMock = enabled && !hidden && Boolean(mock)
+  useCliDisplayAdImpression('cliSplash', mock?.id, shownMock)
+  // Inactive (flag on, or hidden today) the served hook holds and asks nothing.
+  useServedDisplayImpression(served)
+  const sponsor: DisplaySponsor | null = shownMock ? mock : served
+  if (!sponsor) return null
+  const colors = cliSponsorColors(sponsor.theme, theme)
+  const onOpen = () => {
+    if (served) recordServedDisplayClick(served)
+    else if (mock)
+      trackCliDisplayAd(
+        { slot: 'cliSplash', sponsorId: mock.id, kind: 'click', action: 'cta' },
+        enabled,
+      )
+    void open(sponsor.url)
+  }
+  const onHide = () => {
+    if (mock)
+      trackCliDisplayAd(
+        {
+          slot: 'cliSplash',
+          sponsorId: mock.id,
+          kind: 'dismiss',
+          action: 'hide_button',
+          scope: 'day',
+        },
+        enabled,
+      )
+    hide()
+  }
+  return variant === 'line' ? (
+    <DisplayAdSplashLine
+      sponsor={sponsor}
+      colors={colors}
+      width={width}
+      placementId={placementId}
+      muted={theme.muted}
+      onOpen={onOpen}
+      onHide={onHide}
+    />
+  ) : (
+    <DisplayAdSplashBoxed
+      sponsor={sponsor}
+      colors={colors}
+      width={width}
+      placementId={placementId}
+      onOpen={onOpen}
+      onHide={onHide}
+    />
+  )
+}
+
+interface ViewProps {
+  sponsor: DisplaySponsor
+  colors: CliSponsorColors
+  width: number
+  placementId: string
+  onOpen: () => void
+  onHide: () => void
+}
+
+export function DisplayAdSplashBoxed({
+  sponsor,
+  colors,
+  width,
+  placementId,
+  onOpen,
+  onHide,
+}: ViewProps) {
+  return (
+    <box
+      id={placementId}
+      style={{
+        width,
+        marginTop: 1,
+        border: true,
+        borderColor: colors.border,
+        flexDirection: 'column',
+        backgroundColor: colors.tint,
+      }}
+    >
+      <Button
+        onClick={onOpen}
+        style={{
+          width: '100%',
+          height: 1,
+          paddingLeft: 1,
+          paddingRight: 1,
+          flexDirection: 'row',
+          justifyContent: 'space-between',
+          backgroundColor: colors.fill,
+        }}
+      >
+        <text style={{ fg: colors.ink, wrapMode: 'none', flexShrink: 1 }}>
+          <span bg={colors.ink} fg={colors.fill}>
+            <b>{` ${sponsor.lettermark} `}</b>
+          </span>
+          <b>{` ${sponsor.name}`}</b>
+        </text>
+        <text style={{ fg: colors.ink, wrapMode: 'none', flexShrink: 0 }}>
+          Sponsored
+        </text>
+      </Button>
+      <box
+        style={{
+          flexDirection: 'column',
+          paddingLeft: 1,
+          paddingRight: 1,
+          paddingTop: 1,
+        }}
+      >
+        <text
+          style={{ fg: colors.tintText, wrapMode: 'word' }}
+          attributes={TextAttributes.BOLD}
+        >
+          {sponsor.copy.headline}
+        </text>
+        <text style={{ fg: colors.tintMuted, wrapMode: 'word' }}>
+          {sponsor.copy.body}
+        </text>
+        <box
+          style={{
+            flexDirection: 'row',
+            justifyContent: 'space-between',
+            marginTop: 1,
+          }}
+        >
+          <Button onClick={onOpen} style={{ flexShrink: 0 }}>
+            <text style={{ wrapMode: 'none' }}>
+              <span bg={colors.fill} fg={colors.ink}>
+                <b>{` ${sponsor.domain} ↗ `}</b>
+              </span>
+            </text>
+          </Button>
+          <Button onClick={onHide} style={{ flexShrink: 0 }}>
+            <text style={{ fg: colors.tintMuted, wrapMode: 'none' }}>
+              hide for today
+            </text>
+          </Button>
+        </box>
+      </box>
+    </box>
+  )
+}
+
+export function DisplayAdSplashLine({
+  sponsor,
+  colors,
+  width,
+  placementId,
+  muted,
+  onOpen,
+  onHide,
+}: ViewProps & { muted: CliSponsorColors['tintMuted'] }) {
+  return (
+    <box
+      id={placementId}
+      style={{
+        width,
+        height: 1,
+        marginTop: 1,
+        flexDirection: 'row',
+        justifyContent: 'space-between',
+        overflow: 'hidden',
+      }}
+    >
+      <Button
+        onClick={onOpen}
+        style={{ flexDirection: 'row', flexShrink: 1, overflow: 'hidden' }}
+      >
+        <text style={{ wrapMode: 'none', flexShrink: 0 }}>
+          <span bg={colors.fill} fg={colors.ink}>
+            <b>{` Sponsored │ ${sponsor.name} `}</b>
+          </span>
+        </text>
+        <text style={{ fg: colors.tintText, wrapMode: 'none', flexShrink: 1 }}>
+          {` ${sponsor.copy.tagline}`}
+        </text>
+        <text style={{ fg: colors.fill, wrapMode: 'none', flexShrink: 0 }}>
+          {` ${sponsor.domain} ↗`}
+        </text>
+      </Button>
+      <Button onClick={onHide} style={{ flexShrink: 0, paddingLeft: 1 }}>
+        <text style={{ fg: muted, wrapMode: 'none' }}>hide for today</text>
+      </Button>
+    </box>
+  )
+}
diff --git a/cli/src/components/display-ad-statusline.tsx b/cli/src/components/display-ad-statusline.tsx
new file mode 100644
index 000000000..4687b8209
--- /dev/null
+++ b/cli/src/components/display-ad-statusline.tsx
@@ -0,0 +1,171 @@
+/**
+ * `cliStatusline`: the mock sponsor row at the bottom of the Freebuff footer.
+ *
+ * One full-width row in the sponsor's fill with its ink: an inverse
+ * "Ad │ Name" chip (ink background, fill text), the tagline, a "/deals" hint
+ * and × to hide it for this session (`/deals off` does the same). As the row
+ * narrows it gives up the tagline, then the hint; the chip and × always draw.
+ *
+ * MOCK (the local `cliStatusline` flag): `sponsorFor('cliStatusline')` from
+ * common's fixture; the impression (on insertion), the row click and × go to
+ * analytics only (`ads/display-ads-telemetry.ts`).
+ *
+ * SERVED (flag off, `CLI-Statusline` in the policy's `displayPlacementIds`):
+ * one served ad (`ads/served-display-ads.ts`) in the same row, billed
+ * impression on insertion, billed click before opening its clickUrl. No fill
+ * draws nothing. × stays local (this session only).
+ */
+import { sponsorFor } from '@codebuff/common/ads/display-ads/sponsors'
+
+import { Button } from './button'
+import {
+  CLI_DISPLAY_AD_PLACEMENT_IDS,
+  cliDisplayAdEnabled,
+  cliSponsorColors,
+} from '../ads/display-ads'
+import { useDisplayAdsStore } from '../ads/display-ads-store'
+import {
+  trackCliDisplayAd,
+  useCliDisplayAdImpression,
+} from '../ads/display-ads-telemetry'
+import {
+  recordServedDisplayClick,
+  useServedDisplayAd,
+  useServedDisplayImpression,
+  type GetDisplayAd,
+} from '../ads/served-display-ads'
+import { getSessionDisplayPlacementIds } from '../hooks/use-dock-panel'
+import { useTheme } from '../hooks/use-theme'
+import { safeOpen } from '../utils/open-url'
+
+import type { CliSponsorColors } from '../ads/display-ads'
+import type { DisplaySponsor } from '@codebuff/common/ads/display-ads/served'
+
+export const DEALS_HINT = '/deals'
+
+export function DisplayAdStatusline({
+  placementId = CLI_DISPLAY_AD_PLACEMENT_IDS.cliStatusline,
+  enabled = cliDisplayAdEnabled('cliStatusline'),
+  getServed,
+  open = safeOpen,
+  dealsLive,
+}: {
+  /** Test seam: whether CLI-Deals is announced (else read off the policy). */
+  dealsLive?: boolean
+  placementId?: string
+  /** Test seam; production reads the settings flag. */
+  enabled?: boolean
+  /** Test seam for the served fetch. */
+  getServed?: GetDisplayAd
+  open?: (url: string) => unknown
+}) {
+  const theme = useTheme()
+  const hidden = useDisplayAdsStore((s) => s.statuslineHidden)
+  const setHidden = useDisplayAdsStore((s) => s.setStatuslineHidden)
+  const mock = enabled ? sponsorFor('cliStatusline') : null
+  // Inactive (flag on, or hidden) the served hook holds and asks nothing.
+  const served = useServedDisplayAd(placementId, !enabled && !hidden, getServed)
+  const shownMock = enabled && !hidden && Boolean(mock)
+  useCliDisplayAdImpression('cliStatusline', mock?.id, shownMock)
+  useServedDisplayImpression(served)
+  const sponsor: DisplaySponsor | null = shownMock ? mock : served
+  if (!sponsor) return null
+  return (
+    <DisplayAdStatuslineView
+      sponsor={sponsor}
+      colors={cliSponsorColors(sponsor.theme, theme)}
+      placementId={placementId}
+      // The hint points at /deals: a served row shows it only when CLI-Deals
+      // is served too, else /deals would answer "No deals are available."
+      showDealsHint={
+        shownMock ||
+        (dealsLive ??
+          (getSessionDisplayPlacementIds() ?? []).includes(
+            CLI_DISPLAY_AD_PLACEMENT_IDS.deals,
+          ))
+      }
+      onOpen={() => {
+        if (served) recordServedDisplayClick(served)
+        else if (mock)
+          trackCliDisplayAd(
+            {
+              slot: 'cliStatusline',
+              sponsorId: mock.id,
+              kind: 'click',
+              action: 'row',
+            },
+            enabled,
+          )
+        void open(sponsor.url)
+      }}
+      onHide={() => {
+        if (mock)
+          trackCliDisplayAd(
+            {
+              slot: 'cliStatusline',
+              sponsorId: mock.id,
+              kind: 'dismiss',
+              action: 'hide_button',
+              scope: 'session',
+            },
+            enabled,
+          )
+        setHidden(true)
+      }}
+    />
+  )
+}
+
+export function DisplayAdStatuslineView({
+  sponsor,
+  colors,
+  placementId,
+  showDealsHint = true,
+  onOpen,
+  onHide,
+}: {
+  showDealsHint?: boolean
+  sponsor: DisplaySponsor
+  colors: CliSponsorColors
+  placementId: string
+  onOpen: () => void
+  onHide: () => void
+}) {
+  return (
+    <box
+      id={placementId}
+      style={{
+        width: '100%',
+        height: 1,
+        flexDirection: 'row',
