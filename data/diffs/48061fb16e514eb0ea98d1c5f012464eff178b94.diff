diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 19cc6fce7..2deaaf770 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -53,6 +53,53 @@ jobs:
           bun run build
           bun run typecheck-only
 
+  # Test that the start-js script starts without crashing
+  startup-test:
+    needs: build
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v3
+
+      - name: Set up Bun
+        uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: '1.2.12'
+
+      - name: Cache dependencies
+        uses: actions/cache@v3
+        with:
+          path: |
+            node_modules
+            */node_modules
+            packages/*/node_modules
+          key: ${{ runner.os }}-deps-${{ hashFiles('**/bun.lockb') }}
+          restore-keys: |
+            ${{ runner.os }}-deps-
+
+      - name: Install dependencies
+        run: bun install --frozen-lockfile
+
+      - name: Set Environment Variables
+        run: |
+          echo "${{ secrets.ENV_LOCAL }}" > .env.local
+
+      - name: Test start-js script startup
+        run: |
+          cd npm-app
+          # Start the process in background and capture its PID
+          timeout 1s bun run start-js || exit_code=$?
+          
+          # timeout command returns 124 when it times out (which is what we want)
+          # Any other exit code means the process crashed before timeout
+          if [ "${exit_code:-0}" -eq 124 ]; then
+            echo "✅ Process ran for 1 second without crashing"
+            exit 0
+          else
+            echo "❌ Process crashed with exit code: ${exit_code:-0}"
+            exit 1
+          fi
+
   # Template for test jobs
   test:
     needs: build
