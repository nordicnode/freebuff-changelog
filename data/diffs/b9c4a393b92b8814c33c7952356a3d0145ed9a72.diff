+        default: {
+          query: {
+            user: {
+              findFirst: dbMock,
+            },
+          },
+          update: mock(() => ({
+            set: () => ({
+              where: () => Promise.resolve(),
+            }),
+          })),
+        },
+      }))
+
+      mock.module('common/src/billing/balance-calculator', () => ({
+        calculateUsageAndBalance: balanceMock,
