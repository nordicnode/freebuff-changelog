+        auto_topup_threshold: 100,
+        auto_topup_amount: 500,
+        next_quota_reset: new Date(),
+      }))
+
+      balanceMock = mock(() =>
+        Promise.resolve({
+          usageThisCycle: 0,
+          balance: {
+            totalRemaining: 50, // Below threshold by default
+            totalDebt: 0,
+            netBalance: 50,
+            breakdown: {},
