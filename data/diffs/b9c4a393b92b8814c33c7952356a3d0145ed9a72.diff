+
+      paymentIntentMock = mock(() =>
+        Promise.resolve({
+          status: 'succeeded',
+          id: 'pi_123',
+        })
+      )
+
+      grantCreditsMock = mock(() => Promise.resolve())
+
+      // Set up module mocks with fresh mocks
