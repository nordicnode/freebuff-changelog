-    clientRaw ?? '',
-  )
-    ? (clientRaw as (typeof SPONSORED_RUN_CLIENTS)[number])
-    : undefined
-  const os = surface.success ? OS_BY_SURFACE[surface.data] : undefined
-  const fromState = (SPONSORED_RUN_FROM_STATES as readonly string[]).includes(
-    args.fromState ?? '',
