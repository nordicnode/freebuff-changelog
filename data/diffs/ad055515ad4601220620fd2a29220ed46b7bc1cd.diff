+export function freebucksCannotAffordAnyModel(
+  freebucks: FreebuffFreebucksInfo | null | undefined,
+): boolean {
+  if (!freebucks || freebucks.quotaExempt) return false
+  const prices = Object.values(freebucks.prices)
