+      ],
+    })
+    expect(row).toMatchObject({
+      event: 'ordinary.event',
+      message: 'ordinary message',
+      user_id: 'authenticated-user',
+      client_session_id: 'session',
+      data: { private: 'ordinary records retain normal behavior' },
+    })
+  })
+})
