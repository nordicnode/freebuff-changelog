+        createMockGrant({
+          operation_id: 'grant-4',
+          balance: 100,
+          priority: 60, // Lowest priority (consumed last)
+          expires_at: null, // Never expires
+          created_at: new Date(now.getTime() - 5 * 24 * 60 * 60 * 1000),
