-  template: Pick<AgentTemplate, 'handleSteps'>
+  template: Pick<AgentTemplate, 'handleSteps'> &
+    Partial<Pick<AgentTemplate, 'mcpServers'>>
   publisherId: string
   agentId: string
   version: string
   trustedPublishers: ReadonlySet<string>
