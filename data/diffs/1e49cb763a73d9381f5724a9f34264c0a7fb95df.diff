 export function isUntrustedAgentPublisherError(
   error: unknown,
 ): error is UntrustedAgentPublisherError {
   return (
     error instanceof UntrustedAgentPublisherError ||
     (typeof error === 'object' &&
       error !== null &&
       (error as { name?: unknown }).name === 'UntrustedAgentPublisherError')
   )
 }
 
