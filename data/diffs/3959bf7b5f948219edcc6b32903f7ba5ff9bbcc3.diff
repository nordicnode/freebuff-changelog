+          authToken: `token-${i}`,
+          fingerprintId: `fingerprint-${i}`,
+          fingerprintHash: `hash-${i}`,
+        })
+      }
+
+      // Call saveUserCredentials 5 times rapidly
+      users.forEach(user => saveUserCredentials(user))
