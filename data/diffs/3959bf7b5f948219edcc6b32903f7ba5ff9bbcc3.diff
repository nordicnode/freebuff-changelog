+      expect(parsed.default.id).toBe(newUser.id)
+      expect(parsed.default.name).toBe(newUser.name)
+      expect(parsed.default.email).toBe(newUser.email)
+      expect(parsed.default.authToken).toBe(newUser.authToken)
