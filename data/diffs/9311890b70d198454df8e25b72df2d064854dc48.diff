+  const model =
+    SUPPORTED_FREEBUFF_MODELS.find((candidate) => candidate.id === id) ??
+    getFreebuffWebModel(id)
+  if (model.availability === 'off_peak_only') {
+    return `Back at ${formatLocalTime(
+      deepSeekExpensiveWindowEndsAt(now),
+      now,
+      options,
+    )}`
+  }
