+          ) : (
+            <AdBanner ad={ad} onDisableAds={() => {}} isFreeMode />
+          )}
+        </box>
+      )}
+
+      {/* Horizontal separator (mirrors chat input divider style) */}
+      {!ad && (
+        <text style={{ fg: theme.muted, flexShrink: 0 }}>
+          {'─'.repeat(terminalWidth)}
+        </text>
+      )}
+    </box>
+  )
+}
