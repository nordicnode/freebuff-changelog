 export function phoneUserAgent(userAgent: string | null | undefined): boolean {
   if (!userAgent) return false
   return (
     /\bCFNetwork\//.test(userAgent) ||
     /^okhttp\//i.test(userAgent) ||
     /\b(iPhone|iPod)\b/.test(userAgent) ||
