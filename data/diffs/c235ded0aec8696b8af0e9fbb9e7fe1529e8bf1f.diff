+        isNarrowWidth
+        feedbackMode={false}
+        handleExitFeedback={() => {}}
+        publishMode={false}
+        handleExitPublish={() => {}}
+        handlePublish={async () => {}}
+        handleSubmit={async () => {}}
+        onPaste={() => {}}
+        onInterruptStream={() => {}}
