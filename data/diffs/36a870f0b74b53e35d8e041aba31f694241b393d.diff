diff --git a/common/src/tools/params/tool/file-updates.ts b/common/src/tools/params/tool/file-updates.ts
new file mode 100644
index 000000000..f0aa8434c
--- /dev/null
+++ b/common/src/tools/params/tool/file-updates.ts
@@ -0,0 +1,23 @@
+import z from 'zod/v4'
+
+import type { $ToolResults } from '../../../tools/constants'
+
+const toolName = 'file_updates'
+export const fileUpdatesResultSchema = {
+  toolName: toolName,
+  outputs: z.tuple([
+    z.object({
+      type: z.literal('json'),
+      value: z.object({
+        message: z.string().optional(),
+        files: z.array(
+          z.object({
+            path: z.string(),
+            content: z.string(),
+            referencedBy: z.record(z.string(), z.array(z.string())),
+          }),
+        ),
+      }),
+    }),
+  ]),
+} as const satisfies $ToolResults
