       'str_replace',
       'write_file',
       'run_terminal_command',
       'code_search',
       'glob',
       'list_directory',
       'write_todos',
       'web_search',
       'read_url',
       'ask_user',
       'suggest_followups',
       'gravity_index',
       'render_ui',
       'skill',
     ],
     systemPrompt: `${base3.systemPrompt}
-${buildCliAppendix({
-  isFreebuff,
-  model: options.modelLabel ?? model,
-  noAskUser,
