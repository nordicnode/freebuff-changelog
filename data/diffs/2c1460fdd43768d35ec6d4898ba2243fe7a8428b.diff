+    def greet(self, name: str) -> str:
+        return f'{self.prefix}, {name}!'
+
+def print_greeting(greeter: Greeter, name: str):
+    print(greeter.greet(name))
+
+if __name__ == "__main__":
+    greeting = Greeting("Hello")
+    print_greeting(greeting, "World")
+`
