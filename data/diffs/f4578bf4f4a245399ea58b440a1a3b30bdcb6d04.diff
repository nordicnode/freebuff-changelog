+
+  describe('fallback should NOT occur on abort (user intent)', () => {
+    let fallbackCalled = false
+
+    async function primaryModel(signal: AbortSignal): Promise<PromptResult<string>> {
+      if (signal.aborted) {
+        return promptAborted('User cancelled')
+      }
