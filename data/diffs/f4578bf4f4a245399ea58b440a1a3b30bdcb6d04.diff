+      expect(error.name).toBe('AbortError')
+    })
+
+    it('creates error with empty string reason', () => {
+      const error = new AbortError('')
+      // Empty string is falsy, so no reason appended
+      expect(error.message).toBe(ABORT_ERROR_MESSAGE)
+    })
