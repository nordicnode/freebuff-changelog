+        'server_error',
+      ),
+      undefined,
+      PROVIDER_ERROR_DEFAULT_DELAY_MS,
+    ],
+    [
+      'Responses rate_limit_exceeded',
+      responsesError('Rate limit reached.', 'rate_limit_exceeded'),
+      undefined,
+      PROVIDER_RATE_LIMIT_DEFAULT_DELAY_MS,
+    ],
