+    const { consumeFromOrderedGrants } = await importModule()
+    const { tx, writes } = createWriteCaptureTx()
+
+    const grants = [
+      createMockGrant({
+        operation_id: 'debt-free',
+        balance: -50,
+        principal: 500,
+        priority: 20,
