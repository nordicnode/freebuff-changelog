+  private getAllFilePaths(nodes: any[], basePath: string = ''): string[] {
+    return nodes.flatMap((node) => {
+      if (node.type === 'file') {
+        return [path.join(basePath, node.name)]
+      }
+      return this.getAllFilePaths(node.children || [], path.join(basePath, node.name))
+    })
+  }
