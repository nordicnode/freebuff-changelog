+export function getFreebuffDesktopSessionBucket(
+  model: string,
+  accessTier: FreebuffAccessTier | null | undefined,
+): FreebuffDesktopSessionBucket {
+  return occupiesFreebuffDesktopSlot(model, accessTier)
+    ? 'premium'
+    : 'unlimited'
+}
