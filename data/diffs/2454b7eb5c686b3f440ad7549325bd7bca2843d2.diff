 export function suggestGitHubRepositoryName(projectName: string): string {
   const name = projectName
     .trim()
     .replace(/[^A-Za-z0-9_.-]+/g, '-')
     .replace(/-{2,}/g, '-')
     .replace(/^[-.]+|[-.]+$/g, '')
     .slice(0, 100)
     .replace(/[-.]+$/g, '')
   return validGitHubRepositoryName(name) ? name : 'my-project'
