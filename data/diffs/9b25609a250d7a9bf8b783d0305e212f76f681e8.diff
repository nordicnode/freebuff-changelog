+function stripFreebuffGeminiThinkerPrompt(prompt: string): string {
+  return prompt
+    .split('\n')
+    .filter((line) => !FREEBUFF_GEMINI_THINKER_PROMPT_LINE_SET.has(line.trim()))
+    .join('\n')
