+
+describe('a line the walk cannot finish is refused, not allowed', () => {
+  const nest = (inner: string, levels: number, wrap: (s: string) => string) => {
+    let command = inner
+    for (let level = 0; level < levels; level++) command = wrap(command)
+    return command
+  }
+  const evalWrap = (s: string) => `eval ${s}`
+
+  it('refuses wrappers nested deeper than the walk reads', () => {
+    // Within the limit the inner command is still judged for what it is.
+    expect(kindOf(nest('docker compose up', 6, evalWrap))).toBe('container')
+    // Past it the line is refused rather than waved through unread, whatever
+    // is buried there.
+    expect(kindOf(nest('docker compose up', 7, evalWrap))).toBe('unverifiable')
+    expect(kindOf(nest('ls', 12, evalWrap))).toBe('unverifiable')
+    expect(kindOf(nest('wsl ls', 9, (s) => `npx ${s}`))).toBe('unverifiable')
+    expect(kindOf(nest('ls', 8, (s) => `sh -c ${s}`))).toBe('unverifiable')
+  })
+
+  it('does not refuse ordinary nesting', () => {
+    expectAllowed([
+      'bash -c "npm test"',
+      'sudo -u app env FOO=1 timeout 30 npx tsc --noEmit',
+      'npx dotenv -- bun run test',
+      'cmd /c "npm run build"',
+      nest('ls', 6, evalWrap),
+    ])
+    expectAllowed(['powershell -Command "npm test"'], 'win32')
+  })
+
+  it('refuses a PowerShell script file, whose commands are not on the line', () => {
+    for (const command of [
+      'powershell -File setup.ps1',
+      'pwsh -f .\\scripts\\reset.ps1',
+      'powershell.exe -NoProfile -ExecutionPolicy Bypass -File x.ps1',
+    ]) {
+      const refused = sponsoredRefusedCommand(command, 'win32')
+      expect({ command, kind: refused?.kind }).toEqual({
+        command,
+        kind: 'unverifiable',
+      })
+      expect(refused!.invocation).toMatch(/^(powershell|pwsh) -File$/)
+    }
+  })
+
+  it('refuses an -EncodedCommand that does not decode', () => {
+    expect(kindOf('powershell -EncodedCommand !!not-base64!!', 'win32')).toBe(
+      'unverifiable',
+    )
+  })
+
+  it('tells the model to run the commands directly, or stop and report', () => {
+    for (const command of [
+      'powershell -File setup.ps1',
+      nest('ls', 7, evalWrap),
+    ]) {
+      const refused = sponsoredRefusedCommand(command, 'win32')
+      expect(refused?.kind).toBe('unverifiable')
+      const message = sponsoredCommandRefusal(refused!)
+      expect(message).toStartWith('Refusing ')
+      expect(message).toContain('Run the commands it contains directly')
+      expect(message).toContain('tell the user')
+    }
+  })
+})
