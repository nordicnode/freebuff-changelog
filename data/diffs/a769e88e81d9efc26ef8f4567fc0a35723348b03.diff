     check_env_setup
-    # Bun natively loads .env files and gives them precedence over inherited shell vars
-    exec "$REAL_BUN" "$@"
+    build_env_file_args
+    # Use --env-file to ensure env vars are passed to script subprocesses
+    exec "$REAL_BUN" $ENV_FILE_ARGS "$@"
 }
 
