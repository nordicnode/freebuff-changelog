+const fileDiff = (path: string, lines: number): FileDiff => ({
+  path,
+  status: 'modified',
+  diff: `--- a/${path}\n+++ b/${path}\n@@ -1 +1 @@\n${Array.from({ length: lines }, (_, i) => `+line ${i} of ${path}`).join('\n')}\n`,
+})
+
