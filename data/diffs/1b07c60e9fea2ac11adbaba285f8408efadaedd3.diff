+const small = {
+  prompt: 'Add the thing',
+  fileDiffs: [fileDiff('src/a.ts', 3), fileDiff('src/b.ts', 2)],
+  contextFiles: { 'src/a.ts': 'const a = 1\n', 'src/b.ts': 'const b = 2\n' },
+  agentDiff: agentSection('src/a.ts', 3) + agentSection('src/c.ts', 1),
+}
+
