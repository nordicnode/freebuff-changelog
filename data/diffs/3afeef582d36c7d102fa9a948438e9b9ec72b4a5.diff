+export function errorClassOf(text: string | undefined | null): (typeof ERROR_CLASSES)[number] {
+  if (!text) return 'none'
+  const scanned = text.length > ERROR_CLASS_SCAN_CHARS ? text.slice(0, ERROR_CLASS_SCAN_CHARS) : text
