+export function bucketInstallAge(ms: number): (typeof INSTALL_AGE_BUCKETS)[number] {
+  if (ms < DAY_MS) return '<1d'
+  if (ms < 7 * DAY_MS) return '1-7d'
+  if (ms < 30 * DAY_MS) return '7-30d'
+  if (ms < 90 * DAY_MS) return '30-90d'
+  return '90d+'
+}
