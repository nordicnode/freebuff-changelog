+export function bucketCount(n: number): (typeof COUNT_BUCKETS)[number] {
+  if (n <= 0) return '0'
+  if (n === 1) return '1'
+  if (n <= 5) return '2-5'
+  if (n <= 20) return '6-20'
+  return '21+'
