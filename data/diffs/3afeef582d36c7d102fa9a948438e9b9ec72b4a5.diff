+export function bucketTtft(ms: number): (typeof TTFT_BUCKETS)[number] {
+  if (ms < 1_000) return '<1s'
+  if (ms < 3_000) return '1-3s'
+  if (ms < 10_000) return '3-10s'
+  return '10s+'
