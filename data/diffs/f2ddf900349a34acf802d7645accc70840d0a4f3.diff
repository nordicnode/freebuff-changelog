+      if (remainingMs <= 0) break
+      await sleep(
+        Math.min(STATUS_RETRY_DELAY_MS * consecutiveFailures, remainingMs),
+      )
+      continue
+    }
+    consecutiveFailures = 0
+
+    const taskStatus = status.status
+    if (taskStatus === 'failed' || taskStatus === 'revoked') {
+      logger.error(
