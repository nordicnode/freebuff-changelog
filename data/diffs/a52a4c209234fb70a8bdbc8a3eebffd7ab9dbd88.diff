+/**
+ * Example: SDK Lint
+ *
+ * An AI-powered linter that finds issues in code.
+ * Run with: bun run sdk/e2e/examples/sdk-lint.example.ts
+ */
+
+import { CodebuffClient } from '../../src/client'
+
+const CODE_TO_LINT = `
+class Calculator {
+  result = 0;
+  
+  add(n) {
+    this.result += n;
+  }
+  
+  divide(n) {
+    this.result /= n; // Bug: division by zero not handled
+  }
+  
+  getResult() {
+    return this.result;
+  }
