+/**
+ * The `onResponseChunk` a spawned subagent streams through: its text and
+ * events reach the client attributed to it, nested under its parent.
+ */
+export function forwardSubagentChunk(params: {
+  userInputId: string
+  agentType: string
+  prompt: string | undefined
+  subAgentState: AgentState
+  parentAgentState: AgentState
+  sendSubagentChunk: (data: {
+    userInputId: string
+    agentId: string
+    agentType: string
+    chunk: string
+    prompt?: string
+  }) => void
+  writeToClient: (chunk: string | PrintModeEvent) => void
+}): (chunk: string | PrintModeEvent) => void {
+  const {
+    userInputId,
+    agentType,
+    prompt,
+    subAgentState,
+    parentAgentState,
+    sendSubagentChunk,
+    writeToClient,
+  } = params
+  return (chunk) => {
+    if (typeof chunk === 'string') {
+      sendSubagentChunk({
+        userInputId,
+        agentId: subAgentState.agentId,
+        agentType,
+        chunk,
+        prompt,
+      })
+      return
+    }
+
+    if (chunk.type === 'text') {
+      if (chunk.text) {
+        writeToClient({
+          type: 'text' as const,
+          agentId: subAgentState.agentId,
+          text: chunk.text,
+        })
+      }
+      return
+    }
+
+    // Add parentAgentId for proper nesting in UI
+    const ensureParentAgentId = () => {
+      if (chunk.type === 'subagent_start' || chunk.type === 'subagent_finish') {
+        return (
+          chunk.parentAgentId ??
+          subAgentState.parentId ??
+          parentAgentState?.agentId
+        )
+      }
+      if (chunk.type === 'tool_call' || chunk.type === 'tool_result') {
+        return (chunk as any).parentAgentId ?? subAgentState.agentId
+      }
+      return undefined
+    }
+
+    const parentAgentId = ensureParentAgentId()
+    if (
+      parentAgentId !== undefined &&
+      (chunk.type === 'subagent_start' ||
+        chunk.type === 'subagent_finish' ||
+        chunk.type === 'tool_call' ||
+        chunk.type === 'tool_result')
+    ) {
+      writeToClient({ ...chunk, parentAgentId })
+      return
+    }
+
+    const eventWithAgent = {
+      ...chunk,
+      agentId: subAgentState.agentId,
+    }
+    writeToClient(eventWithAgent)
+  }
+}
