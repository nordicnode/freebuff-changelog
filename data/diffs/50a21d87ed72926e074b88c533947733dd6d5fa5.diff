           value: outputForParent(output),
         }
       } else {
         const agentTypeStr = agents[index].agent_type
         return {
           agentType: agentTypeStr,
           agentName: agentTypeStr,
           value: { errorMessage: `Error spawning agent: ${result.reason}` },
         }
       }
     }),
   )
 
