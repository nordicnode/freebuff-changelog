+  if (raw === '[DONE]') return line
+  try {
+    const obj = JSON.parse(raw)
+    if (obj.usage) {
+      obj.usage.cost = creditsToFakeCost(billedCredits)
+      obj.usage.cost_details = { upstream_inference_cost: 0 }
+      return `data: ${JSON.stringify(obj)}\n`
+    }
+  } catch {
+    // pass through
+  }
