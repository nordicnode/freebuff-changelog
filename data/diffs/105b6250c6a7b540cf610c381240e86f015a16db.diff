+export function printFileTree(nodes: FileTreeNode[], depth: number = 0): string {
+  let result = '';
+  for (const node of nodes) {
+    const indent = '\t'.repeat(depth);
+    result += `${indent}${node.name}${node.type === 'directory' ? '/' : ''}\n`;
