+const getRandomColors = () => {
+  const allColors = ['red', 'green', 'yellow', 'blue', 'magenta', 'cyan']
+  const colors: string[] = []
+  while (colors.length < 3) {
+    const color = allColors[Math.floor(Math.random() * allColors.length)]
+    if (!colors.includes(color)) {
+      colors.push(color)
+    }
+  }
+  return colors
 }
 
