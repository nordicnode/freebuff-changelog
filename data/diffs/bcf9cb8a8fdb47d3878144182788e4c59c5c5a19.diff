-             .with(
-               {
-                 content: P.array({
-                   type: P.string,  // Match arrays where each element has a type field
-                 }),
-                 role: P.union('user', 'assistant'),
-               },
-               (msg) => {
-                 // msg.content is now typed as Array<{ type: string }>
