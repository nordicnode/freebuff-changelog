+    (surface !== null &&
+      (surfaces.includes(surface) ||
+        ((surface === 'web_desktop' || surface === 'web_mobile') &&
+          surfaces.includes('web'))))
+  )
+}
+
+/** A slot can be eligible in several clients. Used by validation and previews. */
