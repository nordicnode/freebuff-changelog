+ * suffix is refused outright rather than parsed.
+ */
+const PLAIN_FRONTMATTER_OPENER = /^\uFEFF?---[ \t]*\r?\n/
+
+const refuseEngine = (): never => {
+  throw new Error('SKILL.md frontmatter must be YAML')
