+// Helper to create ripgrep JSON context output (for -A, -B, -C flags)
+function createRgJsonContext(
+  filePath: string,
+  lineNumber: number,
+  lineText: string,
+): string {
+  return JSON.stringify({
+    type: 'context',
+    data: {
+      path: { text: filePath },
+      lines: { text: lineText },
+      line_number: lineNumber,
+    },
+  })
+}
