+test('a refusal names no value the client sent', () => {
+  const secret = 'TOP-SECRET-PROSE'
+  const poisoned = {
+    revision: 1,
+    settings: {
+      skills: [
+        {
+          // An illegal name is not echoed: only a name that still matches
+          // `SKILL_NAME_PATTERN` is safe to quote back.
+          name: `Review ${secret}`,
+          description: secret,
+          instructions: secret,
