+  sendMessageRef.current = sendMessage
+
+  const value: ChatRuntime = {
+    mainAgentTimer,
+    timerStartTime: mainAgentTimer.startTime,
+    streamStatus: queue.streamStatus,
+    isWaitingForResponse: queue.streamStatus === 'waiting',
