-        logger.error(
-          {
-            ...searchContext,
-            error:
-              error instanceof Error
-                ? {
-                    name: error.name,
-                    message: error.message,
-                    stack: error.stack,
-                  }
-                : error,
-            searchDuration,
-            success: false,
