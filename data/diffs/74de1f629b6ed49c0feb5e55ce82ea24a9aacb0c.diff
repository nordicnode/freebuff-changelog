+export const TASKS_PANEL_UNSUPPORTED = 'DEVICE_TASKS_UNSUPPORTED'
+
+export function isTasksPanelUnsupported(error: unknown): boolean {
+  return (
+    typeof error === 'object' &&
+    error !== null &&
+    'code' in error &&
+    error.code === TASKS_PANEL_UNSUPPORTED
+  )
+}
