+                </p>
+              </div>
+            )}
+
+            <p className="text-sm text-muted-foreground border-t pt-4 mt-6">
+              Questions? Contact us at{' '}
+              <Link
+                href={`mailto:${env.NEXT_PUBLIC_SUPPORT_EMAIL}`}
+                className="underline"
+              >
