diff --git a/evals/project.json b/evals/project.json
new file mode 100644
index 000000000..39c4cd7f0
--- /dev/null
+++ b/evals/project.json
@@ -0,0 +1,38 @@
+{
+  "name": "evals",
+  "$schema": "../node_modules/nx/schemas/project-schema.json",
+  "sourceRoot": ".",
+  "projectType": "application",
+  "targets": {
+    "build": {
+      "executor": "nx:run-commands",
+      "options": {
+        "command": "tsc --build",
+        "cwd": "evals"
+      },
+      "outputs": ["{projectRoot}/dist"],
+      "dependsOn": [
+        "^build"
+      ]
+    },
+    "run-eval-set": {
+      "executor": "nx:run-commands",
+      "options": {
+        "command": "bun run dist/run-eval-set.js",
+        "cwd": "evals"
+      },
+      "dependsOn": [
+        "build"
+      ]
+    },
+    "clean": {
+      "executor": "nx:run-commands",
+      "options": {
+        "command": "rm -rf dist",
+        "cwd": "evals"
+      }
+    }
+  },
+  "tags": [],
+  "implicitDependencies": ["@codebuff/integrations"]
+}
