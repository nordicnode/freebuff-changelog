+  describe('Text Node Handling', () => {
+    it('should preserve whitespace in text nodes', () => {
+      const parser = new Saxy()
+      const events: any[] = []
+      parser.on('text', (data) => events.push({ type: 'text', data }))
+
+      parser.write('  Text with leading and trailing spaces  ')
+      parser.end()
+
