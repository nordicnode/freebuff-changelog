   reportDockHeld({ impUrl: 'imp-network-dock', provider: 'gravity' })
   await setup.renderOnce()
   expect(setup.captureCharFrame().trim()).toBe('')
   reportDockHeld(null)
   await settle(setup, () => setup.captureCharFrame().includes('Acme Cloud'))
