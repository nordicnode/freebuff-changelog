 async function settle(
   setup: Awaited<ReturnType<typeof createTestRenderer>>,
   done: () => boolean,
   tries = 50,
 ) {
   for (let i = 0; i < tries && !done(); i++) {
     await Bun.sleep(2)
     await setup.renderOnce()
   }
 }
 
+// The served fetch resolves off the render loop; a loaded CI runner can take
