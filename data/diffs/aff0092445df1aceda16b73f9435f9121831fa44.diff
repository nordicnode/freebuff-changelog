+          reason: 'oom',
+          cyclePaths: [],
+          truncatedStrings: 0,
+        }
+        try {
+          const json = JSON.stringify(
+            value,
+            makeFallbackReplacer(true, retryReport),
+          )
+          return { json, fallback: retryReport }
+        } catch {
+          throw error
+        }
+      }
+      throw error
+    }
+  }
+}
