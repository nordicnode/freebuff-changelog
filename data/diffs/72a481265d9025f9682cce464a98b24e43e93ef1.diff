+    broadcast(event, data) { return send({ type: 'broadcast', event, data }); },
+    presence(data) { return send({ type: 'presence', data }); },
+    close() { stopped = true; clearTimeout(timer); pending?.abort(); retire(socket); onStatus('closed'); },
