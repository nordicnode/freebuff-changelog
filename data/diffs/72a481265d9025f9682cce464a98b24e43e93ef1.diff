+    ws.serializeAttachment(meta);
+    let value;
+    try {
+      value = JSON.parse(message);
+    } catch {
+      this.#close(ws, 1008, 'Invalid message');
+      return;
+    }
+    if (!value || typeof value !== 'object' || Array.isArray(value)) {
+      this.#close(ws, 1008, 'Invalid message');
+      return;
+    }
