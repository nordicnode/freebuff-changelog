+      room: saved.room,
+      userId: saved.userId,
+      connectionId: crypto.randomUUID(),
+      publish: saved.canPublish === 1,
+      presence: saved.canPresence === 1,
+      expiresAt: saved.sessionExpiresAt,
+      data: null,
+      rate: bucket(40),
+    };
