+const LOCAL = false;
+const PATH = '/.well-known/freebuff/realtime';
+const MAX_CONNECTIONS = 128,
+  MAX_ROOM_CONNECTIONS = 32,
+  MAX_ROOMS = 32;
+const MAX_MESSAGE = 16384,
+  MAX_PRESENCE = 1024,
+  MAX_TICKETS = 256;
+const TICKET_MS = 30000,
+  SESSION_MS = 300000;
+const encoder = new TextEncoder();
