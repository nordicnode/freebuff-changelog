+  ) => {
+    flushSync(() =>
+      root.render(
+        <QueryClientProvider client={queries}>
+          <FreebuffChatHeader
+            projectRoot="/tmp/project"
+            session={landing}
+            {...receipt}
+          />
+        </QueryClientProvider>,
+      ),
+    )
+    await setup.renderOnce()
+    return setup.captureCharFrame()
+  }
+
