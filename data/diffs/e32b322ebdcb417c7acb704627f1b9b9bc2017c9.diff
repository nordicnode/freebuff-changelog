+    { name: 'Ed25519' },
+    publicKey,
+    base64UrlDecode(headers[FREEBUFF_DEVICE_SIGNATURE_HEADER]!) as BufferSource,
+    new TextEncoder().encode(payload) as BufferSource,
+  )
