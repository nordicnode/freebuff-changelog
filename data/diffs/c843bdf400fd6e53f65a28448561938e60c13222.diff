diff --git a/common/src/templates/fetch-agent.ts b/common/src/templates/fetch-agent.ts
new file mode 100644
index 000000000..9113451c6
--- /dev/null
+++ b/common/src/templates/fetch-agent.ts
@@ -0,0 +1,24 @@
+import { db } from '@codebuff/common/db'
+import * as schema from '@codebuff/common/db/schema'
+import { and, eq } from 'drizzle-orm'
+
+export async function fetchAgent(
+  agentId: string,
+  version: string,
+  publisher: string,
+) {
+  // Find the agent template
+  const agent = await db
+    .select()
+    .from(schema.agentConfig)
+    .where(
+      and(
+        eq(schema.agentConfig.id, agentId),
+        eq(schema.agentConfig.version, version),
+        eq(schema.agentConfig.publisher_id, publisher),
+      ),
+    )
+    .then((rows) => rows[0])
+
+  return agent
+}
