+          : block.blocks
+        if (hasError || finalBlocks.length > 0) {
           return {
             ...block,
-            blocks: hasStreamedContent ? block.blocks : [{ type: 'text', content } as ContentBlock],
+            blocks: finalBlocks,
             status: hasError ? ('failed' as const) : ('complete' as const),
           }
         }
