diff --git a/common/src/desktop-cloud/repo-key.test.ts b/common/src/desktop-cloud/repo-key.test.ts
new file mode 100644
index 000000000..8893c6a5d
--- /dev/null
+++ b/common/src/desktop-cloud/repo-key.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, test } from 'bun:test'
+
+import { repoKey, repoKeyFromRemote } from './repo-key'
+
+describe('repoKeyFromRemote', () => {
+  test('SSH and HTTPS spellings of one remote agree', () => {
+    const expected = 'github.com/owner/repo'
+    expect(repoKeyFromRemote('git@github.com:Owner/Repo.git')).toBe(expected)
+    expect(repoKeyFromRemote('https://github.com/owner/repo')).toBe(expected)
+    expect(repoKeyFromRemote('https://user:token@github.com/owner/repo.git/')).toBe(expected)
+    expect(repoKeyFromRemote('ssh://git@github.com:22/owner/repo.git')).toBe(expected)
+  })
+
+  test('keeps the host and every path segment', () => {
+    expect(repoKeyFromRemote('git@gitlab.com:group/sub/repo.git')).toBe('gitlab.com/group/sub/repo')
+    expect(repoKeyFromRemote('git@gitlab.com:owner/repo.git')).not.toBe(repoKeyFromRemote('git@github.com:owner/repo.git'))
+  })
+
+  test('a path or file remote has no key', () => {
+    expect(repoKeyFromRemote('/home/me/code/repo')).toBeNull()
+    expect(repoKeyFromRemote('file:///home/me/code/repo')).toBeNull()
+    expect(repoKeyFromRemote('C:\\code\\repo')).toBeNull()
+    expect(repoKeyFromRemote('https://github.com/owner')).toBeNull()
+    expect(repoKeyFromRemote('')).toBeNull()
+  })
+})
+
+describe('repoKey', () => {
+  test('a subfolder keys separately from the root', () => {
+    expect(repoKey('github.com/o/r', '')).toBe('github.com/o/r')
+    expect(repoKey('github.com/o/r', 'packages/web')).toBe('github.com/o/r:packages/web')
+    expect(repoKey('github.com/o/r', 'packages\\web\\')).toBe('github.com/o/r:packages/web')
+  })
+})
diff --git a/common/src/desktop-cloud/repo-key.ts b/common/src/desktop-cloud/repo-key.ts
new file mode 100644
index 000000000..2e8fb63f6
--- /dev/null
+++ b/common/src/desktop-cloud/repo-key.ts
@@ -0,0 +1,48 @@
+/**
+ * The repository a local folder is a checkout of, as `host/owner/name[:subfolder]`, so two
+ * computers that open the same folder of the same remote join one Cloud project
+ * (docs/desktop/device-execution.md, "One project across computers").
+ *
+ * SSH and HTTPS spellings of one remote agree: credentials, ports, a `.git` suffix and case are
+ * dropped. The host stays, so `github.com/a/b` and `gitlab.com/a/b` are different repositories,
+ * and so does every path segment (GitLab subgroups). A path or `file://` remote is not a hosted
+ * repository and has no key.
+ */
+export function repoKeyFromRemote(remoteUrl: string | null | undefined): string | null {
+  const trimmed = remoteUrl?.trim()
+  if (!trimmed) return null
+  const scheme = /^([a-zA-Z][a-zA-Z0-9+.-]*):\/\//.exec(trimmed)
+  let host: string
+  let path: string
+  if (scheme) {
+    if (!['ssh', 'git', 'http', 'https', 'git+ssh', 'ssh+git'].includes(scheme[1]!.toLowerCase())) return null
+    const rest = trimmed.slice(scheme[0].length).replace(/^[^/@]*@/, '')
+    const match = /^([^/:]+)(?::\d+)?\/(.*)$/.exec(rest)
+    if (!match) return null
+    host = match[1]!
+    path = match[2]!
+  } else {
+    // scp-like `user@host:owner/name`; a bare `host:path` is ambiguous with a local path on Windows
+    const match = /^[^/@]+@([^/:]+):(.*)$/.exec(trimmed)
+    if (!match) return null
+    host = match[1]!
+    path = match[2]!
+  }
+  if (!/^[a-zA-Z0-9][a-zA-Z0-9.-]*$/.test(host)) return null
+  const parts = path
+    .replace(/[?#].*$/, '')
+    .replace(/\/+$/, '')
+    .replace(/\.git$/i, '')
+    .split('/')
+    .filter(Boolean)
+  if (parts.length < 2 || parts.some((part) => part === '.' || part === '..')) return null
+  return `${host}/${parts.join('/')}`.toLowerCase()
+}
+
+/** A folder inside the repository (`apps/web`) keys separately from its root. */
+export function repoKey(remoteKey: string, subfolder: string): string {
+  const relative = subfolder.split(/[\\/]+/).filter((part) => part && part !== '.').join('/')
+  return relative ? `${remoteKey}:${relative}` : remoteKey
+}
+
+export const REPO_KEY_MAX = 600
