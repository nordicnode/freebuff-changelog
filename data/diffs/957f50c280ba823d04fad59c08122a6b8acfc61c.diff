+      {
+        type: 'prompt',
+        prompt: '', // No new prompt
+        agentState,
+        fingerprintId: 'test',
+        costMode: 'max',
+        promptId: 'test',
+        toolResults: [],
+      },
+      TEST_USER_ID,
+      'test-session',
+      () => {}
+    )
+
+    expect(newAgentState.lastUserPromptIndex).toBe(initialIndex)
+  })
 })
 
