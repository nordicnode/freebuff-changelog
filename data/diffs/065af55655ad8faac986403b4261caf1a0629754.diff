diff --git a/common/src/constants/tools.ts b/common/src/constants/tools.ts
index fed9e15c5..246e190bc 100644
--- a/common/src/constants/tools.ts
+++ b/common/src/constants/tools.ts
@@ -25,3 +25,15 @@ export type ToolName = keyof typeof toolSchema
 
 // List of all available tools
 export const TOOL_LIST = Object.keys(toolSchema) as ToolName[]
+
+export const getToolCallString = (
+  toolName: ToolName,
+  params: Record<string, string>
+) => {
+  const openTag = `<${toolName}>`
+  const closeTag = `</${toolName}>`
+  const paramsString = Object.entries(params)
+    .map(([key, value]) => `<${key}>${value}</${key}>`)
+    .join('\n')
+  return `${openTag}\n${paramsString}\n${closeTag}`
+}
