+        return release
+      },
+      failure: null,
+      setSession: (session) =>
+        set({
+          session,
+          ...(session === null || session.status === 'active'
+            ? { lastRefund: null, pendingRefund: null }
+            : {}),
+        }),
+      setFailure: (failure) => set({ failure }),
+    }
+  },
+)
