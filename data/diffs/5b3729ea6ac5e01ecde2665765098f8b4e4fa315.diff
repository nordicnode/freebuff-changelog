new file mode 100644
index 000000000..622b7866a
--- /dev/null
+++ b/cli/src/ads/__tests__/ad-reports.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, test } from 'bun:test'
+import type { AdReport } from '@codebuff/common/ads/ad-report'
+import { createAdReportRegistry } from '../ad-reports'
+
+const AD = {
+  title: 'First ad',
+  url: 'https://example.com/first',
+  surface: 'cli',
+  impUrl: 'first',
+}
+
+describe('report targets and state', () => {
+  test('keyboard reports the original numbered snapshot after rotation', async () => {
+    const sent: AdReport[] = []
+    const registry = createAdReportRegistry(async (ad) => {
+      sent.push(ad)
+    })
+    const original = { ...AD }
+    const first = registry.register(original)
+    original.title = 'mutated later'
+    registry.register({ ...AD, title: 'Second ad', impUrl: 'second' })
+    expect(await registry.command('')).toContain(`${first.id}: First ad`)
+    expect(await registry.command(String(first.id))).toBe(
+      'Ad reported. Thank you.',
+    )
+    expect(sent).toEqual([AD])
+    expect(await registry.command('999')).toContain('Ad not found')
+  })
+
+  test('duplicates are blocked while sending and after success; failures allow retry', async () => {
+    let finish!: () => void
+    let calls = 0
+    const registry = createAdReportRegistry(async () => {
+      calls++
+      if (calls === 1) throw new Error('offline')
+      await new Promise<void>((resolve) => {
+        finish = resolve
+      })
+    })
+    const entry = registry.register(AD)
+    expect(registry.register({ ...AD })).toBe(entry)
+    expect(await registry.submit(entry)).toBe('error')
+    const retry = registry.submit(entry)
+    expect(entry.status).toBe('sending')
+    expect(await registry.submit(entry)).toBe('sending')
+    finish()
+    expect(await retry).toBe('sent')
+    expect(await registry.submit(entry)).toBe('sent')
+    expect(calls).toBe(2)
+  })
+
+  test('history is bounded without evicting mounted controls', async () => {
+    const registry = createAdReportRegistry(async () => {})
+    expect(await registry.command('')).toContain('No ads')
+    const mounted = registry.register(AD)
+    mounted.mounted++
+    const recent = registry.register({ ...AD, impUrl: 'old' })
+    for (let index = 0; index < 110; index++)
+      registry.register({ ...AD, impUrl: String(index) })
+    expect(await registry.command(String(mounted.id))).toBe(
+      'Ad reported. Thank you.',
+    )
+    expect(await registry.command(String(recent.id))).toContain('Ad not found')
+  })
+})
diff --git a/cli/src/ads/ad-reports.ts b/cli/src/ads/ad-reports.ts
new file mode 100644
index 000000000..2d24709d6
--- /dev/null
+++ b/cli/src/ads/ad-reports.ts
@@ -0,0 +1,87 @@
+import { toAdReport, type AdReport } from '@codebuff/common/ads/ad-report'
+import { sanitizeTerminalText } from '@codebuff/common/util/terminal-safe-text'
+
+import { reportAd } from '../utils/ad-report'
+
+export type AdReportStatus = 'idle' | 'sending' | 'sent' | 'error'
+export type ReportableAd = {
+  id: number
+  snapshot: AdReport
+  status: AdReportStatus
+  listeners: Set<() => void>
+  mounted: number
+}
+
+/** Keep recent snapshots for /ads:report after a rotation or slash-menu close. */
+export function createAdReportRegistry(
+  send: (ad: AdReport) => Promise<void> = reportAd,
+) {
+  let nextId = 1
+  const entries = new Map<string, ReportableAd>()
+  const status = (entry: ReportableAd, value: AdReportStatus) => {
+    entry.status = value
+    for (const listener of entry.listeners) listener()
+  }
+  const register = (ad: AdReport): ReportableAd => {
+    // Select and copy only report fields; no answers, prompt or targeting context.
+    const snapshot = Object.freeze(toAdReport(ad))
+    const key = JSON.stringify(snapshot)
+    const existing = entries.get(key)
+    if (existing) return existing
+    const entry: ReportableAd = {
+      id: nextId++,
+      snapshot,
+      status: 'idle',
+      listeners: new Set(),
+      mounted: 0,
+    }
+    entries.set(key, entry)
+    // Mounted cards keep their keyboard target. Bound only the recent history.
+    const recent = [...entries.entries()].filter(
+      ([, value]) => !value.mounted && value.status !== 'sending',
+    )
+    for (const [oldKey] of recent.slice(0, Math.max(0, recent.length - 100)))
+      entries.delete(oldKey)
+    return entry
+  }
+  const submit = async (entry: ReportableAd): Promise<AdReportStatus> => {
+    if (entry.status === 'sending' || entry.status === 'sent')
+      return entry.status
+    status(entry, 'sending')
+    try {
+      await send(entry.snapshot)
+      status(entry, 'sent')
+    } catch {
+      status(entry, 'error')
+    }
+    return entry.status
+  }
+  const command = async (args: string): Promise<string> => {
+    const input = args.trim()
+    if (!input) {
+      const shown = [...entries.values()].reverse().slice(0, 12)
+      if (!shown.length) return 'No ads have been shown in this session.'
+      return [
+        'Report an ad with /ads:report <number>:',
+        ...shown.map(
+          (entry) =>
+            `${entry.id}: ${sanitizeTerminalText(entry.snapshot.title)}${entry.status === 'sent' ? ' (reported)' : ''}`,
+        ),
+      ].join('\n')
+    }
+    const entry = /^\d+$/.test(input)
+      ? [...entries.values()].find((item) => item.id === Number(input))
+      : undefined
+    if (!entry) return 'Ad not found. Use /ads:report to list recent ads.'
+    const result = await submit(entry)
+    return result === 'sent'
+      ? 'Ad reported. Thank you.'
+      : result === 'sending'
+        ? 'Sending this ad report…'
+        : `Could not send the ad report. Retry with /ads:report ${entry.id}.`
+  }
+  return { register, submit, command }
+}
+
+export const adReports = createAdReportRegistry()
+export type AdReportRegistry = ReturnType<typeof createAdReportRegistry>
