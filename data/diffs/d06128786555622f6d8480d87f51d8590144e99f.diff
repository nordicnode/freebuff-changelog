index 000000000..46a2cb52e
--- /dev/null
+++ b/common/src/ads/sponsored-run-spec-client.ts
@@ -0,0 +1,169 @@
+/**
+ * The client's check of a sponsored RUN SPEC (`./sponsored-run-spec.ts`).
+ *
+ * The spec arrives on the funded Accept as parsed JSON from the network, and
+ * it decides the prompt, the skill the step driver walks and the only
+ * packages the run may install. So a client holds it to what the user
+ * consented to before running anything from it, and again when it reads a
+ * stored copy back for a resumed turn:
+ *
+ * - `v` is the version this client sent (`SPONSORED_RUN_SPEC_VERSION`);
+ * - `procedure` is the Accept's procedure byte for byte, and
+ *   `procedureSha256` is its hash and the one the grant pins;
+ * - `skill` is a valid skill that renders exactly that procedure
+ *   (`sponsoredSkillMatchesProcedure`), and is present whenever the
+ *   procedure names one: a spec never turns a skill run into free text;
+ * - `declaredPackages` is a valid package list equal to `skill.packages`, and
+ *   empty without a skill;
+ * - `promptTemplate` is a bounded string carrying both slots (filled at their
+ *   last occurrence by `fillSponsoredRunSpecPrompt`).
+ *
+ * The one check of a spec: Desktop, the CLI and Cloud all refuse exactly the
+ * same specs.
+ */
+
+import {
+  parseSponsoredDeclaredPackages,
+  type SponsoredDeclaredPackage,
+} from './sponsored-declared-installs'
+import {
+  SPONSORED_RUN_SPEC_SLOTS,
+  SPONSORED_RUN_SPEC_VERSION,
+  type SponsoredRunSpec,
+} from './sponsored-run-spec'
+import {
+  parseSponsoredSkill,
+  sponsoredSkillDirective,
+  sponsoredSkillMatchesProcedure,
+  sponsoredSkillSha256,
+} from './sponsored-skill'
+import { sha256Hex } from '../util/hash'
+
+/** A template longer than this is not a prompt any server of ours built. */
+export const SPONSORED_RUN_SPEC_TEMPLATE_MAX_CHARS = 100_000
+
+export type SponsoredRunSpecCheck =
+  | { ok: true; spec: SponsoredRunSpec }
+  | { ok: false; reason: string }
+
+function packageKey(pkg: SponsoredDeclaredPackage): string {
+  return JSON.stringify([pkg.ecosystem, pkg.name, pkg.version, pkg.dev === true])
+}
+
+/**
+ * The spec on a funded Accept, held to the procedure the user consented to
+ * and the hash the grant pins. `{ ok: false, reason }` names the first
+ * mismatch, for the log; never run anything from a refused spec.
+ */
+export function checkSponsoredRunSpec(
+  value: unknown,
+  expected: { procedure: string; procedureSha256: string },
+): SponsoredRunSpecCheck {
+  const refuse = (reason: string): SponsoredRunSpecCheck => ({ ok: false, reason })
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return refuse('not an object')
+  }
+  const raw = value as Record<string, unknown>
+  if (raw.v !== SPONSORED_RUN_SPEC_VERSION) {
+    return refuse(`unsupported version ${JSON.stringify(raw.v)}`)
+  }
+  if (typeof raw.procedure !== 'string' || raw.procedure !== expected.procedure) {
+    return refuse('procedure differs from the accepted one')
+  }
+  const hash = sha256Hex(raw.procedure)
+  if (raw.procedureSha256 !== hash || hash !== expected.procedureSha256) {
+    return refuse('procedureSha256 differs from the accepted procedure or grant')
+  }
+  const template = raw.promptTemplate
+  if (
+    typeof template !== 'string' ||
+    template.trim().length === 0 ||
+    template.length > SPONSORED_RUN_SPEC_TEMPLATE_MAX_CHARS
+  ) {
+    return refuse('promptTemplate is missing, empty or too long')
+  }
+  for (const slot of Object.values(SPONSORED_RUN_SPEC_SLOTS)) {
+    if (!template.includes(slot)) {
+      return refuse(`promptTemplate is missing the slot ${slot}`)
+    }
+  }
+  let skill: SponsoredRunSpec['skill'] = null
+  if (raw.skill != null) {
+    const parsed = parseSponsoredSkill(raw.skill)
+    if (!parsed.ok) return refuse('skill is not a valid skill')
+    if (!sponsoredSkillMatchesProcedure(parsed.skill, raw.procedure)) {
+      return refuse('skill does not render the accepted procedure')
+    }
+    skill = parsed.skill
+  } else if (sponsoredSkillDirective(raw.procedure)) {
+    return refuse('procedure names a skill and the spec carries none')
+  }
+  let declaredPackages: SponsoredDeclaredPackage[]
+  try {
+    declaredPackages = parseSponsoredDeclaredPackages(raw.declaredPackages)
+  } catch (error) {
+    return refuse(
+      `declaredPackages: ${error instanceof Error ? error.message : String(error)}`,
+    )
+  }
+  const want = (skill?.packages ?? []).map(packageKey).sort()
+  const got = declaredPackages.map(packageKey).sort()
+  if (want.length !== got.length || want.some((key, i) => key !== got[i])) {
+    return refuse(
+      skill
+        ? "declaredPackages differ from the skill's packages"
+        : 'declaredPackages must be empty without a skill',
+    )
+  }
+  return {
+    ok: true,
+    spec: {
+      v: SPONSORED_RUN_SPEC_VERSION,
+      procedure: raw.procedure,
+      procedureSha256: hash,
+      skill,
+      declaredPackages,
+      promptTemplate: template,
+    },
+  }
+}
+
+/**
+ * A spec kept with a run record, read back for a resumed turn: re-checked in
+ * full against itself, then held to the procedure hash and skill reference
+ * the run recorded at Accept. Untrusted until this passes (a row is a file
+ * on disk).
+ */
+export function storedSponsoredRunSpec(
+  value: unknown,
+  run: {
+    procedureSha256: string
+    skill?: { id: string; version: string; sha256: string } | null
+  },
+): SponsoredRunSpecCheck {
+  const procedure =
+    value && typeof value === 'object'
+      ? (value as { procedure?: unknown }).procedure
+      : undefined
+  if (typeof procedure !== 'string') {
+    return { ok: false, reason: 'stored spec has no procedure' }
+  }
+  const checked = checkSponsoredRunSpec(value, {
+    procedure,
+    procedureSha256: run.procedureSha256,
+  })
+  if (!checked.ok) return checked
+  const skill = checked.spec.skill
+  const ref = run.skill ?? null
+  if (
+    (skill === null) !== (ref === null) ||
+    (skill &&
+      ref &&
+      (skill.id !== ref.id ||
+        skill.version !== ref.version ||
+        sponsoredSkillSha256(skill) !== ref.sha256))
+  ) {
+    return { ok: false, reason: "stored spec's skill differs from the run's" }
+  }
+  return checked
+}
diff --git a/common/src/ads/sponsored-run-spec.ts b/common/src/ads/sponsored-run-spec.ts
new file mode 100644
index 000000000..4d9a3c8d7
--- /dev/null
+++ b/common/src/ads/sponsored-run-spec.ts
@@ -0,0 +1,128 @@
+/**
+ * The sponsored RUN SPEC: everything a client needs to run an accepted
+ * sponsored task, built by the server and delivered on the funded Accept.
+ *
+ * Before this, each client compiled its own copy of the run prompt (the
+ * consent framing, how-to-carry-it-out rules, the deferred-account rules and
+ * the final report) and resolved the skill, and so the packages it may
+ * install, from its own bundled registry first. A skill version or prompt
+ * change then needed a client release, and a build that could not resolve a
+ * new skill refused that skill's own pinned install (Exa 2.0.0, 2026-10-13).
+ *
+ * The server builds it with `buildSponsoredRunSpec`
+ * (`./sponsored-run-prompt.ts`).
+ *
+ * With a spec the server is the one source of truth: the client runs
+ * `promptTemplate` with its two slots filled, drives `skill`'s steps and
+ * installs only `declaredPackages`. It never substitutes a bundled skill or a
+ * prompt of its own. A client says it can run a spec with
+ * `runSpecVersion: SPONSORED_RUN_SPEC_VERSION` on the agentic offer request
+ * and on the Accept body; the server returns `runSpec` on the Accept only
+ * then, and a client that sends neither keeps the legacy path.
+ */
+
+
+import type { SponsoredDeclaredPackage } from './sponsored-declared-installs'
+import type { SponsoredSkill } from './sponsored-skill'
+
+/** The spec version a client can run (offer request + Accept body field `runSpecVersion`). */
+export const SPONSORED_RUN_SPEC_VERSION = 1 as const
+
+/** Whether a request's `runSpecVersion` asks for this server's run spec. */
+export function clientRunsSponsoredRunSpec(value: unknown): boolean {
+  return value === SPONSORED_RUN_SPEC_VERSION
+}
+
+/**
+ * The client-side facts the server cannot know, as literal slots in
+ * `promptTemplate`, both after the procedure. The client fills them with
+ * {@link fillSponsoredRunSpecPrompt} (an empty string when it has nothing),
+ * and changes nothing else.
+ */
+export const SPONSORED_RUN_SPEC_SLOTS = {
+  /** The user's own recent messages, rendered as the read-only background section. */
+  taskContext: '{{FREEBUFF_TASK_CONTEXT}}',
+  /** The credentials connected for this run, rendered as the credentials section. */
+  credentials: '{{FREEBUFF_CREDENTIALS}}',
+} as const
+
+export type SponsoredRunSpec = Readonly<{
+  v: typeof SPONSORED_RUN_SPEC_VERSION
+  /** The procedure exactly as consented to; equals the Accept's `procedure`. */
+  procedure: string
+  /** `sponsoredProcedureSha256(procedure)`; equals the grant's `procedureSha256`. */
+  procedureSha256: string
+  /**
+   * The skill the procedure renders, verified server-side
+   * (`sponsoredSkillMatchesProcedure`). Null only for a legacy free-text
+   * procedure, which is being retired.
+   */
+  skill: SponsoredSkill | null
+  /**
+   * The only packages the run may install (`evaluateSponsoredInstallCommand`):
+   * `skill.packages`, or empty for free text. Carried separately so a client
+   * never derives it from anything but this spec.
+   */
+  declaredPackages: readonly SponsoredDeclaredPackage[]
+  /**
+   * The full first-turn prompt for the accepting surface, with the
+   * {@link SPONSORED_RUN_SPEC_SLOTS} left in place for the client to fill.
+   */
+  promptTemplate: string
+}>
+
+/**
+ * Fills a spec's slots. The client renders each section with its own data
+ * (`renderSponsoredRunTaskContext` for the messages; its credentials note);
+ * an absent section is an empty string, and an empty credentials section
+ * takes its paragraph with it.
+ *
+ * Each slot is replaced exactly once, at its LAST occurrence in the template,
+ * in one pass over the template: the slots follow the procedure, so slot-like
+ * text in a procedure stays as written, and text a section brings in (the
+ * user's own messages, an advertiser name) is never read for a slot.
+ */
+export function fillSponsoredRunSpecPrompt(
+  promptTemplate: string,
+  sections: { taskContext: string; credentials: string },
+): string {
+  const fills = [
+    {
+      slot: SPONSORED_RUN_SPEC_SLOTS.taskContext,
+      text: sections.taskContext,
+      at: promptTemplate.lastIndexOf(SPONSORED_RUN_SPEC_SLOTS.taskContext),
+    },
+    {
+      slot: SPONSORED_RUN_SPEC_SLOTS.credentials,
+      text: sections.credentials,
+      at: promptTemplate.lastIndexOf(SPONSORED_RUN_SPEC_SLOTS.credentials),
+    },
+  ]
+    .filter((fill) => fill.at >= 0)
+    .sort((a, b) => b.at - a.at)
+  let filled = promptTemplate
+  // From the end, so an earlier slot's index still holds.
+  for (const { slot, text, at } of fills) {
+    let start = at
+    if (
+      slot === SPONSORED_RUN_SPEC_SLOTS.credentials &&
+      text === '' &&
+      filled.slice(at - 2, at) === '\n\n'
+    )
+      start = at - 2
+    filled = filled.slice(0, start) + text + filled.slice(at + slot.length)
+  }
+  return filled
+}
+
+/**
+ * The optional field on the funded Accept's 200
+ * (`POST /api/v1/ads/proposal/{id}/accept`), present only when the request
+ * sent `runSpecVersion`. The preview (`GET`) never carries one: the prompt
+ * depends on the accepting surface and the advertiser link, which only the
+ * funded Accept knows.
+ */
+export type SponsoredAcceptRunSpec = {
+  runSpec?: SponsoredRunSpec
+}
+
diff --git a/common/src/ads/sponsored-skill-client-support.test.ts b/common/src/ads/sponsored-skill-client-support.test.ts
new file mode 100644
index 000000000..2a6cb00f7
--- /dev/null
+++ b/common/src/ads/sponsored-skill-client-support.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, test } from 'bun:test'
+
+import { compareSponsoredSkillVersions } from './sponsored-skill'
+import {
+  SPONSORED_DESKTOP_SKILL_FETCH_MIN,
+  SPONSORED_SKILL_MIN_CLIENT,
+  sponsoredSkillClientRefusal,
+} from './sponsored-skill-client-support'
+import { SPONSORED_SKILLS } from './sponsored-skills/registry'
+
+const EXA_2 = { id: 'exa-web-search-feature', version: '2.0.0' }
+const EXA_1_1 = { id: 'exa-web-search-feature', version: '1.1.0' }
+const WITH_PACKAGES = { packages: [{ name: 'exa-js' }] }
+
+const refusal = (
+  clientVersion: string | null,
+  overrides: Partial<Parameters<typeof sponsoredSkillClientRefusal>[0]> = {},
+) =>
+  sponsoredSkillClientRefusal({
+    client: clientVersion?.startsWith('cli/') ? 'cli' : 'desktop',
+    clientVersion,
+    skillRef: EXA_2,
+    skill: WITH_PACKAGES,
+    ...overrides,
+  })
+
+describe('sponsoredSkillClientRefusal', () => {
+  test('Desktop builds without declared installs or the skill fetch are refused', () => {
+    expect(refusal('desktop/0.0.169')).toBe('desktop_too_old')
+    expect(refusal('desktop/0.0.170')).toBe('desktop_too_old')
+    expect(refusal('desktop/0.0.171')).toBe('desktop_too_old')
+  })
+
+  test('Desktop from the fetch build on runs it', () => {
+    expect(refusal('desktop/0.0.172')).toBeNull()
+    expect(refusal('desktop/0.0.173')).toBeNull()
+    expect(refusal('desktop/0.1.0')).toBeNull()
+  })
+
+  test('a CLI before Accept delivery runs only a skill its release bundles', () => {
+    expect(refusal('cli/0.2.28')).toBe('cli_too_old')
+    expect(refusal('cli/0.2.27', { skillRef: EXA_1_1 })).toBe('cli_too_old')
+    expect(refusal('cli/0.2.28', { skillRef: EXA_1_1 })).toBeNull()
+  })
+
+  test('a CLI with Accept delivery runs any skill', () => {
+    expect(refusal('cli/0.2.29')).toBeNull()
+    expect(refusal('cli/0.3.0')).toBeNull()
+    // ...but only one the server could read, since that is what it delivers.
+    expect(refusal('cli/0.2.29', { skill: null })).toBe('cli_too_old')
+    expect(refusal('cli/0.2.29', { skillRef: EXA_1_1, skill: null })).toBeNull()
+  })
+
+  test('dev builds pass; an unreadable version does not', () => {
+    expect(refusal('desktop/dev')).toBeNull()
+    expect(refusal('cli/dev')).toBeNull()
+    expect(refusal(null)).toBe('client_version_unknown')
+    expect(refusal('desktop/nightly')).toBe('client_version_unknown')
+    expect(refusal('cli/0.2.28', { client: 'desktop' })).toBe(
+      'client_version_unknown',
+    )
+  })
+
+  test('nothing to refuse: free text, no packages, or the web client', () => {
+    expect(refusal('desktop/0.0.169', { skillRef: null })).toBeNull()
+    expect(refusal('desktop/0.0.169', { skill: { packages: [] } })).toBeNull()
+    expect(refusal(null, { client: 'web' })).toBeNull()
+  })
+
+  test('a named skill that could not be read is treated as declaring packages', () => {
+    expect(refusal('desktop/0.0.171', { skill: null })).toBe('desktop_too_old')
+    expect(refusal('desktop/0.0.172', { skill: null })).toBeNull()
+    expect(refusal('cli/0.2.28', { skill: null })).toBe('cli_too_old')
+  })
+})
+
+describe('SPONSORED_SKILL_MIN_CLIENT', () => {
+  test('names only shipped skill versions that declare packages', () => {
+    for (const key of Object.keys(SPONSORED_SKILL_MIN_CLIENT)) {
+      const skill = SPONSORED_SKILLS.get(key)
+      expect(skill, key).toBeDefined()
+      expect(skill!.packages.length, key).toBeGreaterThan(0)
+    }
+  })
+
+  test('a run-spec client is never refused for its version', () => {
+    for (const clientVersion of [
+      'desktop/0.0.169',
+      'cli/0.2.20',
+      null,
+      'desktop/garbage',
+    ])
+      expect(refusal(clientVersion, { runSpecVersion: 1 })).toBeNull()
+  })
+
+  test('a run-spec client is refused only when the server has no skill', () => {
+    expect(refusal('cli/0.2.40', { runSpecVersion: 1, skill: null })).toBe(
+      'skill_unresolved',
+    )
+    expect(
+      refusal(null, { client: 'web', runSpecVersion: 1, skill: null }),
+    ).toBe('skill_unresolved')
+    expect(
+      refusal(null, { runSpecVersion: 1, skill: null, skillRef: null }),
+    ).toBeNull()
+  })
+
+  test('an unknown runSpecVersion keeps the version rule', () => {
+    expect(refusal('desktop/0.0.171', { runSpecVersion: 2 })).toBe(
+      'desktop_too_old',
+    )
+  })
+
+  test('never lowers Desktop below the fetch build', () => {
+    for (const [key, min] of Object.entries(SPONSORED_SKILL_MIN_CLIENT)) {
+      if (!min.desktop) continue
+      expect(
+        compareSponsoredSkillVersions(
+          min.desktop,
+          SPONSORED_DESKTOP_SKILL_FETCH_MIN,
+        ),
+        key,
+      ).toBeGreaterThanOrEqual(0)
+    }
+  })
+})
diff --git a/common/src/ads/sponsored-skill-client-support.ts b/common/src/ads/sponsored-skill-client-support.ts
new file mode 100644
index 000000000..1ac931aac
--- /dev/null
+++ b/common/src/ads/sponsored-skill-client-support.ts
@@ -0,0 +1,137 @@
+/**
+ * Whether a client build can run a skill's pinned installs.
+ *
+ * A sponsored run may install only the packages its skill declares
+ * (`evaluateSponsoredInstallCommand`), and the CLIENT supplies that list: the
+ * skill kept with the run, else its own bundled registry, else (Desktop only)
+ * the server's copy. A build that cannot resolve the skill runs with an empty
+ * list and refuses even the skill's own pinned install, so the run writes code
+ * against a package it never installed (2026-10-13/14: 9 of 30 Exa runs, on
+ * Desktop builds older than declared installs or the skill fetch, and every
+ * CLI build, none of which bundles exa-web-search-feature@2.0.0).
+ *
+ * So a skill that declares packages is offered, and accepted, only on a build
+ * that can resolve it:
+ *
+ *  - Desktop from {@link SPONSORED_DESKTOP_SKILL_FETCH_MIN}: the first build
+ *    with declared installs AND the server skill fetch, which resolves any
+ *    skill version whether or not the build bundles it.
+ *  - The CLI from {@link SPONSORED_CLI_SKILL_DELIVERY_MIN}, which takes the
+ *    skill the Accept delivers (#6709). An older CLI only runs a skill it
+ *    BUNDLES: the first such release is listed in
+ *    {@link SPONSORED_SKILL_MIN_CLIENT}.
+ *
+ * A skill that declares no packages, a free-text procedure, and the web client
+ * (server-run, always current) are never refused here.
+ *
+ * A client that runs the RUN SPEC (`runSpecVersion`, `./sponsored-run-spec.ts`)
+ * is never refused for its version: the Accept hands it the skill and its
+ * packages, and it resolves nothing itself. It is refused only when the
+ * SERVER cannot resolve the skill the procedure names
+ * (`skill_unresolved`), because then there is no spec to hand it.
+ */
+
+import { clientRunsSponsoredRunSpec } from './sponsored-run-spec'
+import { compareSponsoredSkillVersions } from './sponsored-skill'
+
+/** Desktop 0.0.172: declared installs (#6427) and the server skill fetch. */
+export const SPONSORED_DESKTOP_SKILL_FETCH_MIN = '0.0.172'
+
+/**
+ * The first CLI release that drives the skill delivered on the Accept (#6709,
+ * merged after 0.2.28 was cut), so it resolves a skill it does not bundle.
+ */
+export const SPONSORED_CLI_SKILL_DELIVERY_MIN = '0.2.29'
+
+/**
+ * Per skill version (`<id>@<version>`), the first build of each client that
+ * can run it, where that is later than the defaults above. `cli` is the
+ * first CLI release whose bundled registry contains the skill, when that is
+ * older than {@link SPONSORED_CLI_SKILL_DELIVERY_MIN}.
+ */
+export const SPONSORED_SKILL_MIN_CLIENT: Readonly<
+  Record<string, { desktop?: string; cli?: string }>
+> = {
+  // CLI 0.2.27 is the first with declared installs (#6427).
+  'supabase-persist-one-feature@1.0.0': { cli: '0.2.27' },
+  'exa-web-search-feature@1.0.0': { cli: '0.2.28' },
+  'exa-web-search-feature@1.1.0': { cli: '0.2.28' },
+  'archil-persist-files-on-disk@2.0.0': { cli: '0.2.28' },
+  'archil-persist-files-on-disk@2.0.1': { cli: '0.2.28' },
+  'respan-agent-setup@2.0.1': { cli: '0.2.28' },
+  'respan-agent-setup@2.0.2': { cli: '0.2.28' },
+  // Not bundled by any CLI before 0.2.29: exa-web-search-feature@2.0.0,
+  // respan-agent-setup@2.1.0, axonstream-realtime-one-feature@1.0.0.
+}
+
+export type SponsoredSkillClientRefusal =
+  /** A Desktop or CLI user agent whose version cannot be read. */
+  | 'client_version_unknown'
+  /** A Desktop older than the skill needs. */
+  | 'desktop_too_old'
+  /** A CLI that neither bundles the skill nor takes it from the Accept. */
+  | 'cli_too_old'
+  /**
+   * A run-spec client, and the server could not resolve the skill the
+   * procedure names, so it has no spec to deliver.
+   */
+  | 'skill_unresolved'
+
+/**
+ * Why `clientVersion` (`desktop/<v>` or `cli/<v>`, from
+ * `sponsoredClientVersionFromUserAgent`) cannot run the named skill, or null
+ * when it can.
+ *
+ * `skill` is the resolved skill, or null when the procedure names one that
+ * could not be read: that is treated as declaring packages, since an unknown
+ * verdict must not serve. `dev` builds always pass.
+ */
+export function sponsoredSkillClientRefusal(input: {
+  client: 'desktop' | 'cli' | 'web' | null
+  clientVersion: string | null
+  /** The skill the procedure names (`sponsoredSkillDirective`), or null for free text. */
+  skillRef: { id: string; version: string } | null
+  skill: { packages: readonly unknown[] } | null
+  /** The request's `runSpecVersion`, as sent. */
+  runSpecVersion?: unknown
+}): SponsoredSkillClientRefusal | null {
+  if (!input.skillRef) return null
+  if (clientRunsSponsoredRunSpec(input.runSpecVersion)) {
+    return input.skill ? null : 'skill_unresolved'
+  }
+  if (input.client !== 'desktop' && input.client !== 'cli') return null
+  if (input.skill && input.skill.packages.length === 0) return null
+
+  const prefix = `${input.client}/`
+  if (!input.clientVersion?.startsWith(prefix)) return 'client_version_unknown'
+  const version = input.clientVersion.slice(prefix.length)
+  if (version === 'dev') return null
+  if (!/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/.test(version)) {
+    return 'client_version_unknown'
+  }
+
+  const listed =
+    SPONSORED_SKILL_MIN_CLIENT[`${input.skillRef.id}@${input.skillRef.version}`]
+  if (input.client === 'desktop') {
+    const min = maxVersion(SPONSORED_DESKTOP_SKILL_FETCH_MIN, listed?.desktop)
+    return compareSponsoredSkillVersions(version, min) < 0
+      ? 'desktop_too_old'
+      : null
+  }
+  // The Accept delivers the skill only when the server could read it: with
+  // no skill here the CLI would get none and cannot fetch one later.
+  if (
+    input.skill &&
+    compareSponsoredSkillVersions(version, SPONSORED_CLI_SKILL_DELIVERY_MIN) >=
+      0
+  ) {
+    return null
+  }
+  return listed?.cli && compareSponsoredSkillVersions(version, listed.cli) >= 0
+    ? null
+    : 'cli_too_old'
+}
+
+function maxVersion(a: string, b: string | undefined): string {
+  return b && compareSponsoredSkillVersions(b, a) > 0 ? b : a
+}
