+export function expireMessages(
+  messages: CoreMessageWithTtl[],
+  endOf: 'agentStep' | 'userPrompt'
+): CoreMessageWithTtl[] {
+  return messages.filter(
+    (m) =>
+      (m.timeToLive === undefined && true) ||
+      (m.timeToLive === 'userPrompt' && endOf === 'agentStep') ||
+      (m.timeToLive === 'agentStep' && false)
+  )
