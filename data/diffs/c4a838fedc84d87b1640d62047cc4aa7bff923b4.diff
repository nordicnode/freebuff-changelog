+        client.withRetries(
+          async () => {
+            attempts += 1
+            throw error
+          },
+          {
+            maxAttempts: 3,
+            shouldRetry: (caught: Error & { retryable?: boolean }) =>
+              caught.retryable !== false,
+            sleep: async () => {},
+          },
+        ),
+      ).rejects.toBe(error)
+      expect(attempts).toBe(1)
+    })
   })
 }
