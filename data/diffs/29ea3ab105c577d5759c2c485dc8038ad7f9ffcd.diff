+    if (!parsed.ok) throw new Error(JSON.stringify(parsed.errors))
+    return parsed.skill
+  }
+
+  async function begin(f: ReturnType<typeof fakes>) {
+    const task = sponsoredTaskEvidence([
+      { variant: 'user', content: 'How do I deploy this?' },
+    ])!
