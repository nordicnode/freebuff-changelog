     ...(tier.dailyPremiumSessions < tier.dailySessions
       ? [
           `${tier.dailyPremiumSessions} of your ${tier.dailySessions} daily sessions can be GPT-6 Luna or GLM 5.3 Flash; the rest use the standard models`,
