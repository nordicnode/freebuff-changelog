+  sendMessage(ws, {
+    type: 'action',
+    data: action,
+  })
+}
+
+const onUserInput = async (
+  ws: WebSocket,
+  input: string,
+  fileContext: ProjectFileContext
+) => {
+  const { changes } = await promptClaudeAndGetFileChanges(
+    input,
+    fileContext,
+    (chunk) =>
+      sendAction(ws, {
+        type: 'response-chunk',
+        chunk,
+      })
+  )
+
+  sendAction(ws, {
+    type: 'change-files',
+    changes,
+  })
+}
