+export const onWebsocketAction = (
+  ws: WebSocket,
+  msg: ClientMessage & { type: 'action' }
+) => {
+  console.log('onAction', msg)
+
+  switch (msg.data.type) {
+    case 'user-input':
+      const { input, fileContext } = msg.data
+      onUserInput(ws, input, fileContext)
+      return
+  }
+}
