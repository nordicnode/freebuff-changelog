     env.FREEBUFF_SPONSORED_COMPUTE_ACCEPTANCE_PRICE_CENTS,
   )
   const modelId = env.FREEBUFF_SPONSORED_COMPUTE_MODEL_ID?.trim()
-  const campaigns = env.FREEBUFF_SPONSORED_COMPUTE_CAMPAIGN_IDS?.split(',').map(
-    (id) => id.trim(),
