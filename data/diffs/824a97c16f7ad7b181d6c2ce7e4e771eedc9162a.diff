+export function createRelaceCodebuffId(
+  userId: string,
+  initialCode: string,
+  editSnippet: string
+) {
+  const hash = createHash('sha256')
+    .update(initialCode)
+    .update(editSnippet)
+    .digest('hex')
+    .slice(0, 8) // Take first 8 characters for a shorter hash
+  return `codebuff-${userId}-${hash}`
