+function killProcessTreeSoftly(pid: number): void {
+  if (process.platform === 'win32') {
+    // /T = kill tree, no /F = soft kill
+    spawn('taskkill', ['/PID', String(pid), '/T'], {
+      stdio: 'ignore',
+      detached: true,
+    }).unref()
+  } else {
+    try {
+      process.kill(-pid, 'SIGTERM')
+    } catch (err) {
+      if ((err as any)?.code !== 'ESRCH') throw err
+    }
+  }
+}
