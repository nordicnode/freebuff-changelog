diff --git a/common/src/desktop-cloud/project-name.test.ts b/common/src/desktop-cloud/project-name.test.ts
index 7d799c557..8a1d77e79 100644
--- a/common/src/desktop-cloud/project-name.test.ts
+++ b/common/src/desktop-cloud/project-name.test.ts
@@ -1,22 +1,50 @@
 import { describe, expect, test } from 'bun:test'
-import { nextUntitledProjectName } from './project-name'
+import { isUntitledProjectName, nextUntitledProjectName, projectNameFromPrompt } from './project-name'
 
 describe('automatic project names', () => {
   test('starts with Untitled and increments after the highest existing number', () => {
     expect(nextUntitledProjectName([])).toBe('Untitled')
     expect(nextUntitledProjectName(['Untitled'])).toBe('Untitled 2')
     expect(nextUntitledProjectName(['Untitled 2', 'Untitled', 'Untitled 9'])).toBe('Untitled 10')
   })
 
   test('does not reuse gaps or depend on catalog ordering', () => {
     expect(nextUntitledProjectName(['Untitled 5', 'Untitled 2'])).toBe('Untitled 6')
   })
 
   test('matches case and surrounding whitespace without counting other titles', () => {
     expect(nextUntitledProjectName([
       null, undefined, 'My project', 'Untitled notes', 'Untitled 0',
       'Untitled 02', 'Untitled -3', 'Untitled 2.5', 'Untitled 1e3',
       'Untitled 99999999999999999999999', ' untitled 3 ',
     ])).toBe('Untitled 4')
   })
 })
+
+
+describe('projectNameFromPrompt', () => {
+  test('names what the first message asks to build', () => {
+    expect(projectNameFromPrompt('Make a classic Snake game I can play in the browser with the arrow keys.')).toBe('Classic Snake Game')
+    expect(projectNameFromPrompt('Build me a modern personal website with a home page.')).toBe('Modern Personal Website')
+    expect(projectNameFromPrompt('Build a simple expense tracker where I can add expenses')).toBe('Expense Tracker')
+    expect(projectNameFromPrompt('can you please create a todo app for my team')).toBe('Todo App')
+    expect(projectNameFromPrompt("I'd like to build a Discord bot that posts the weather")).toBe('Discord Bot')
+    expect(projectNameFromPrompt('fix the login page')).toBe('Fix the Login Page')
+    expect(projectNameFromPrompt('hello')).toBe('Hello')
+    expect(projectNameFromPrompt('A landing page for my SaaS startup')).toBe('Landing Page')
+  })
+  test('no words, no name', () => {
+    expect(projectNameFromPrompt('   ')).toBeNull()
+    expect(projectNameFromPrompt('!!!')).toBeNull()
+  })
+  test('stays short', () => {
+    expect(projectNameFromPrompt('Supercalifragilisticexpialidocious-extraordinarily-long-hyphenated-thing')!.length).toBeLessThanOrEqual(40)
+  })
+})
+
+test('isUntitledProjectName', () => {
+  expect(isUntitledProjectName('Untitled')).toBe(true)
+  expect(isUntitledProjectName('Untitled 3')).toBe(true)
+  expect(isUntitledProjectName('Untitled game')).toBe(false)
+  expect(isUntitledProjectName('Snake Game')).toBe(false)
+})
diff --git a/common/src/desktop-cloud/project-name.ts b/common/src/desktop-cloud/project-name.ts
index 0b5605ccf..e75afe552 100644
--- a/common/src/desktop-cloud/project-name.ts
+++ b/common/src/desktop-cloud/project-name.ts
@@ -1,14 +1,73 @@
 /** Number blank projects after the highest existing Untitled name. */
 export function nextUntitledProjectName(
   existingNames: Iterable<string | null | undefined>,
 ): string {
   let highest = 0
   for (const name of existingNames) {
     const match = name?.trim().match(/^untitled(?: ([1-9]\d*))?$/i)
     if (!match) continue
     const number = match[1] ? Number(match[1]) : 1
     if (Number.isSafeInteger(number) && number < Number.MAX_SAFE_INTEGER)
       highest = Math.max(highest, number)
   }
   return highest === 0 ? 'Untitled' : `Untitled ${highest + 1}`
 }
+
+/** "Untitled", "Untitled 2": a name nobody chose. */
+export function isUntitledProjectName(name: string | null | undefined): boolean {
+  return /^untitled(?: [1-9]\d*)?$/i.test(name?.trim() ?? '')
+}
+
+const LEAD_INS = [
+  /^(?:hi|hey|hello)\b[,!.]?\s*/i,
+  /^(?:please|pls)\s+/i,
+  /^(?:can|could|would|will) you\s+(?:please\s+)?/i,
+  /^i(?:'d| would)? (?:like|want|need)(?: you)? to\s+/i,
+  /^(?:help me|let's|lets)\s+/i,
+  /^(?:build|make|create|write|code|design|develop|generate|set up|start|add|implement|draft)\s+(?:me\s+|us\s+)?/i,
+  /^(?:a|an|the|my|our|some|simple|quick|basic|new)\s+/i,
+]
+/** Words that end what is being built ("a snake game THAT…"). */
+const STOP_WORDS = new Set([
+  'that', 'which', 'where', 'who', 'with', 'for', 'using', 'in', 'on', 'to', 'so', 'i', 'we', 'you',
+  'and', 'from', 'like', 'by', 'about', 'when', 'it', 'please',
+])
+const SMALL_WORDS = new Set(['a', 'an', 'the', 'of', 'and', 'or', 'to', 'in', 'on', 'for'])
+
+/**
+ * A project's name from the message that started it, so no project is left
+ * "Untitled": what is being built, title-cased ("Make a classic Snake game I
+ * can play" → "Classic Snake Game"). Null when the message has no words.
+ */
+export function projectNameFromPrompt(prompt: string): string | null {
+  let text = prompt.split(/[\n.!?]/).find((line) => line.trim())?.trim() ?? ''
+  for (let changed = true; changed; ) {
+    changed = false
+    for (const lead of LEAD_INS) {
+      const next = text.replace(lead, '')
+      if (next !== text && next.trim()) {
+        text = next.trim()
+        changed = true
+      }
+    }
+  }
+  const words: string[] = []
+  for (const raw of text.split(/\s+/)) {
+    const word = raw.replace(/^[^\p{L}\p{N}]+|[^\p{L}\p{N}'-]+$/gu, '')
+    if (!word) continue
+    if (words.length && STOP_WORDS.has(word.toLowerCase())) break
+    words.push(word)
+    if (words.length === 4) break
+  }
+  if (!words.length) return null
+  const name = words
+    .map((word, index) =>
+      index > 0 && SMALL_WORDS.has(word.toLowerCase())
+        ? word.toLowerCase()
+        : /[A-Z]/.test(word.slice(1))
+          ? word
+          : word[0]!.toUpperCase() + word.slice(1),
+    )
+    .join(' ')
+  return name.length > 40 ? name.slice(0, 40).trimEnd() : name
+}
