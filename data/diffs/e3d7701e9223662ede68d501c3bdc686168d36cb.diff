+ * count off simply never trips the guard.
+ */
+export function netOpenBrackets(text: string): number {
+  let open = 0
+  for (const ch of text) {
+    if (ch === '(' || ch === '[' || ch === '{') open++
+    else if (ch === ')' || ch === ']' || ch === '}') open--
+  }
+  return open
+}
+
