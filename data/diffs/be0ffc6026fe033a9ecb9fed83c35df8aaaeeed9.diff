+  '.wgsl': lang('WGSL'),
+  '.asm': lang('Assembly'),
+  '.s': lang('Assembly'),
+  '.vue': lang('Vue'),
+  '.svelte': lang('Svelte'),
+  '.astro': lang('Astro'),
+  '.html': lang('HTML', 'markup'),
+  '.htm': lang('HTML', 'markup'),
+  '.css': lang('CSS', 'markup'),
+  '.scss': lang('SCSS', 'markup'),
+  '.sass': lang('SCSS', 'markup'),
+  '.less': lang('Less', 'markup'),
+  '.xml': lang('XML', 'data'),
+  '.json': lang('JSON', 'data'),
+  '.jsonc': lang('JSON', 'data'),
+  '.yaml': lang('YAML', 'data'),
+  '.yml': lang('YAML', 'data'),
+  '.toml': lang('TOML', 'data'),
+  '.csv': lang('CSV', 'data'),
+  '.md': lang('Markdown', 'prose'),
+  '.mdx': lang('MDX', 'prose'),
+  '.rst': lang('reStructuredText', 'prose'),
+  '.txt': lang('Text', 'prose'),
+}
+
+const BY_FILENAME: Readonly<Record<string, Language>> = {
+  dockerfile: lang('Dockerfile'),
+  makefile: lang('Makefile'),
+  gemfile: lang('Ruby'),
+  rakefile: lang('Ruby'),
+  justfile: lang('Just'),
+}
+
+/** Lockfiles and generated bundles: real files, not code anyone wrote. */
+const UNCOUNTED_FILENAMES = new Set([
+  'package-lock.json',
+  'yarn.lock',
+  'pnpm-lock.yaml',
+  'bun.lock',
+  'bun.lockb',
+  'cargo.lock',
+  'poetry.lock',
+  'pipfile.lock',
+  'uv.lock',
+  'composer.lock',
+  'gemfile.lock',
+  'go.sum',
+  'podfile.lock',
+  'pubspec.lock',
+  'mix.lock',
+  'flake.lock',
+])
+
+// No node:path: this module also runs where Node's built-ins do not.
+function baseName(filePath: string): string {
+  const normalized = filePath.replace(/\\/g, '/')
+  return normalized.slice(normalized.lastIndexOf('/') + 1).toLowerCase()
+}
+
+function extension(base: string): string {
+  const dot = base.lastIndexOf('.')
+  return dot > 0 ? base.slice(dot) : ''
+}
+
+export function languageForPath(filePath: string): Language | null {
+  const base = baseName(filePath)
+  if (UNCOUNTED_FILENAMES.has(base)) return null
+  if (/\.min\.(js|css)$/.test(base) || base.endsWith('.map')) return null
+  if (BY_FILENAME[base]) return BY_FILENAME[base]
+  if (base.startsWith('dockerfile.')) return BY_FILENAME.dockerfile
+  return BY_EXTENSION[extension(base)] ?? null
+}
+
+const TEST_PATH =
+  /(^|\/)(__tests__|tests?|spec|e2e)\/|\.(test|spec)\.[a-z0-9]+$|(^|\/)test_[^/]+\.py$|_test\.(go|py)$/i
+
+export function isTestPath(filePath: string): boolean {
+  return TEST_PATH.test(filePath.replace(/\\/g, '/'))
+}
+
+/** Lines in a file's text, counting a final line with no newline. */
+export function countLines(content: string): number {
+  if (content.length === 0) return 0
+  let lines = 0
+  for (let i = 0; i < content.length; i++) {
+    if (content.charCodeAt(i) === 10) lines++
+  }
+  return content.charCodeAt(content.length - 1) === 10 ? lines : lines + 1
+}
+
+/** Most languages a profile lists, by lines. */
+export const WORKSPACE_STATS_MAX_LANGUAGES = 20
+
+export const workspaceStatsSchema = z.object({
+  fileCount: z.number().int().nonnegative(),
+  /** The listing stopped at a cap, so the project has at least this many. */
+  fileCountIsLowerBound: z.boolean(),
+  testFileCount: z.number().int().nonnegative(),
+  /** Lines in files of a programming language (`code` kind). */
+  codeLineCount: z.number().int().nonnegative(),
+  /** Some files were too large or too many to read, so lines are a floor. */
+  lineCountIsLowerBound: z.boolean(),
+  languages: z
+    .array(
+      z.object({
+        name: z.string().min(1).max(40),
+        kind: z.enum(['code', 'markup', 'data', 'prose']),
+        files: z.number().int().nonnegative(),
+        lines: z.number().int().nonnegative(),
+      }),
+    )
+    .max(WORKSPACE_STATS_MAX_LANGUAGES),
+})
+
+export type WorkspaceStats = z.infer<typeof workspaceStatsSchema>
+
+export type WorkspaceStatsFile = {
+  path: string
+  /** Lines in the file, when it was read; unread files count toward the file
+   *  and language totals but not the line totals. */
+  lines?: number
+}
+
+export function computeWorkspaceStats(params: {
+  files: readonly WorkspaceStatsFile[]
+  fileCountIsLowerBound: boolean
+}): WorkspaceStats {
+  const byLanguage = new Map<
+    string,
+    { name: string; kind: LanguageKind; files: number; lines: number }
+  >()
+  let testFileCount = 0
+  let codeLineCount = 0
+  let unread = false
+  for (const file of params.files) {
+    if (isTestPath(file.path)) testFileCount++
+    const language = languageForPath(file.path)
+    if (!language) continue
+    const entry = byLanguage.get(language.name) ?? {
+      ...language,
+      files: 0,
+      lines: 0,
+    }
+    entry.files++
+    if (file.lines === undefined) unread = true
+    else {
+      entry.lines += file.lines
+      if (language.kind === 'code') codeLineCount += file.lines
+    }
+    byLanguage.set(language.name, entry)
+  }
+  const languages = [...byLanguage.values()]
+    .sort((a, b) => b.lines - a.lines || b.files - a.files)
+    .slice(0, WORKSPACE_STATS_MAX_LANGUAGES)
+  return {
+    fileCount: params.files.length,
+    fileCountIsLowerBound: params.fileCountIsLowerBound,
+    testFileCount,
+    codeLineCount,
+    lineCountIsLowerBound: unread || params.fileCountIsLowerBound,
+    languages,
+  }
+}
+
+/** The budget a client reads files under to count lines. Past it, files still
+ *  count toward the totals but their lines do not. */
+export const WORKSPACE_STATS_READ_LIMITS = {
+  maxFiles: 10_000,
+  maxFileBytes: 1_000_000,
+  maxTotalBytes: 100_000_000,
+} as const
+
+/** Whether a path is worth reading to count lines. */
+export function shouldCountLines(filePath: string): boolean {
+  return languageForPath(filePath) !== null
+}
+
+/** The `size` section of a stored profile: the client's stats, keyed like the
+ *  template's fields. */
+export type WorkspaceProfileSize = {
+  file_count: number
+  file_count_is_lower_bound: boolean
+  test_file_count: number
+  code_line_count: number
+  line_count_is_lower_bound: boolean
+  languages: Array<{ name: string; kind: string; files: number; lines: number }>
+}
+
+/** What `workspace_profile.profile` holds: the template's sections as the
+ *  profiler answered them, plus the counted `size` section. */
+export type StoredWorkspaceProfile = Record<string, Record<string, unknown>>
+
+export function toWorkspaceProfileSize(
+  stats: WorkspaceStats,
+): WorkspaceProfileSize {
+  return {
+    file_count: stats.fileCount,
+    file_count_is_lower_bound: stats.fileCountIsLowerBound,
+    test_file_count: stats.testFileCount,
+    code_line_count: stats.codeLineCount,
+    line_count_is_lower_bound: stats.lineCountIsLowerBound,
+    languages: stats.languages.map((language) => ({ ...language })),
+  }
+}
+
+/**
+ * One profile to store: the (already normalized) answers, then `size` from the
+ * client's counts. `size` is written last, so it is always the counts and never
+ * anything the model's answer carried under that key.
+ */
+export function buildStoredWorkspaceProfile(
+  answers: WorkspaceProfile,
+  stats: WorkspaceStats,
+): StoredWorkspaceProfile {
+  return {
+    ...answers,
+    [WORKSPACE_PROFILE_SIZE_SECTION]: toWorkspaceProfileSize(stats),
+  }
+}
diff --git a/common/src/workspace-profile/template.ts b/common/src/workspace-profile/template.ts
new file mode 100644
index 000000000..564e742b0
--- /dev/null
+++ b/common/src/workspace-profile/template.ts
@@ -0,0 +1,295 @@
+/**
+ * The workspace-profile template: the sections the workspace profiler fills in
+ * about the project a session is working in (docs/freebuff-workspace-profile.md).
+ *
+ * The backend owns the template and serves it with the "is a profile due"
+ * answer, so a section can be added or reworded with a web deploy and no
+ * client release. A client only knows the shape below: sections of typed
+ * fields. It builds the agent's output schema from whatever template it was
+ * given, and the server checks the answer against the version it served.
+ *
+ * Every field may be left unknown (stored as `null`). The profiler fills in what it found
+ * evidence for and nothing else, so "unknown" is a real answer, not a failure.
+ */
+import z from 'zod/v4'
+
+import type { JsonObjectSchema, JsonSchema } from '../templates/initial-agents-dir/types/util-types'
+
+/**
+ * The stored profile's counted section: file count, lines of code and the
+ * language mix, filled in from the client's stats (`stats.ts`), never by the
+ * model. Reserved, so no template section can take this key.
+ */
+export const WORKSPACE_PROFILE_SIZE_SECTION = 'size'
+
+/** Longest value a free-text field keeps. Names, not sentences. */
+export const WORKSPACE_PROFILE_MAX_VALUE_LENGTH = 80
+
+/** Most values a list field keeps. */
+export const WORKSPACE_PROFILE_MAX_LIST_LENGTH = 30
+
+/** How long a stored profile stays fresh. Past it (or when the backend's
+ *  template is newer than the one the profile answered), the next session
+ *  profiles the project again. */
+export const WORKSPACE_PROFILE_REPORT_INTERVAL_MS = 7 * 24 * 60 * 60 * 1000
+
+const keySchema = z
+  .string()
+  .regex(/^[a-z][a-z0-9_]{0,47}$/, 'keys are snake_case')
+
+const optionSchema = z.string().min(1).max(WORKSPACE_PROFILE_MAX_VALUE_LENGTH)
+
+/**
+ * - `choice`: one of `options`.
+ * - `choices`: any of `options`. With `allowOther`, a name outside them is kept
+ *   as written.
+ * - `names`: a list of short names (frameworks, test runners).
+ * - `boolean`: yes or no.
+ */
+export const workspaceProfileFieldSchema = z.discriminatedUnion('kind', [
+  z.object({
+    key: keySchema,
+    kind: z.literal('choice'),
+    label: z.string().min(1).max(120),
+    guidance: z.string().max(600).optional(),
+    options: z.array(optionSchema).min(1).max(60),
+  }),
+  z.object({
+    key: keySchema,
+    kind: z.literal('choices'),
+    label: z.string().min(1).max(120),
+    guidance: z.string().max(600).optional(),
+    options: z.array(optionSchema).min(1).max(60),
+    allowOther: z.boolean().optional(),
+  }),
+  z.object({
+    key: keySchema,
+    kind: z.literal('names'),
+    label: z.string().min(1).max(120),
+    guidance: z.string().max(600).optional(),
+  }),
+  z.object({
+    key: keySchema,
+    kind: z.literal('boolean'),
+    label: z.string().min(1).max(120),
+    guidance: z.string().max(600).optional(),
+  }),
+])
+
+export type WorkspaceProfileField = z.infer<typeof workspaceProfileFieldSchema>
+
+export const workspaceProfileSectionSchema = z.object({
+  key: keySchema,
+  title: z.string().min(1).max(120),
+  guidance: z.string().max(600).optional(),
+  fields: z.array(workspaceProfileFieldSchema).min(1).max(20),
+})
+
+export type WorkspaceProfileSection = z.infer<
+  typeof workspaceProfileSectionSchema
+>
+
+export const workspaceProfileTemplateSchema = z
+  .object({
+    version: z.number().int().positive(),
+    sections: z.array(workspaceProfileSectionSchema).min(1).max(20),
+  })
+  .superRefine((template, ctx) => {
+    const sections = new Set<string>()
+    for (const section of template.sections) {
+      if (section.key === WORKSPACE_PROFILE_SIZE_SECTION) {
+        ctx.addIssue({
+          code: 'custom',
+          message: `section key ${WORKSPACE_PROFILE_SIZE_SECTION} is reserved for the counted section`,
+        })
+      }
+      if (sections.has(section.key)) {
+        ctx.addIssue({
+          code: 'custom',
+          message: `duplicate section ${section.key}`,
+        })
+      }
+      sections.add(section.key)
+      const fields = new Set<string>()
+      for (const field of section.fields) {
+        if (fields.has(field.key)) {
+          ctx.addIssue({
+            code: 'custom',
+            message: `duplicate field ${section.key}.${field.key}`,
+          })
+        }
+        fields.add(field.key)
+      }
+    }
+  })
+
+export type WorkspaceProfileTemplate = z.infer<
+  typeof workspaceProfileTemplateSchema
+>
+
+/** What the profiler answers for a single-value field it has no evidence for.
+ *  Stored as `null`. */
+const UNKNOWN = 'unknown'
+
+/** A field's stored value; `null` is unknown. */
+export type WorkspaceProfileValue = string | string[] | boolean | null
+
+/** `{ [sectionKey]: { [fieldKey]: value } }`, every template field present. */
+export type WorkspaceProfile = Record<
+  string,
+  Record<string, WorkspaceProfileValue>
+>
+
+function fieldJsonSchema(field: WorkspaceProfileField): JsonSchema {
+  const description = field.guidance
+    ? `${field.label}. ${field.guidance}`
+    : field.label
+  switch (field.kind) {
+    case 'choice':
+      return {
+        type: 'string',
+        enum: [...field.options, UNKNOWN],
+        description: `${description} "${UNKNOWN}" when there is no evidence.`,
+      }
+    case 'choices':
+      return {
+        type: 'array',
+        items: field.allowOther
+          ? { type: 'string' }
+          : { type: 'string', enum: field.options },
+        description: field.allowOther
+          ? `${description} Use these names where they fit: ${field.options.join(', ')}. Any other name as written. [] when none were found.`
+          : `${description} [] when none were found.`,
+      }
+    case 'names':
+      return {
+        type: 'array',
+        items: { type: 'string' },
+        description: `${description} [] when none were found.`,
+      }
+    case 'boolean':
+      return {
+        type: 'string',
+        enum: ['yes', 'no', UNKNOWN],
+        description: `${description} "${UNKNOWN}" when there is no evidence.`,
+      }
+  }
+}
+
+/** The JSON schema the profiler's `set_output` call must satisfy. */
+export function buildWorkspaceProfileOutputSchema(
+  template: WorkspaceProfileTemplate,
+): JsonObjectSchema {
+  const properties: Record<string, JsonSchema> = {}
+  for (const section of template.sections) {
+    const fields: Record<string, JsonSchema> = {}
+    for (const field of section.fields) fields[field.key] = fieldJsonSchema(field)
+    properties[section.key] = {
+      type: 'object',
+      description: section.guidance
+        ? `${section.title}. ${section.guidance}`
+        : section.title,
+      properties: fields,
+      required: section.fields.map((field) => field.key),
+    }
+  }
+  return {
+    type: 'object',
+    properties,
+    required: template.sections.map((section) => section.key),
+  }
+}
+
+function cleanName(value: unknown): string | null {
+  if (typeof value !== 'string') return null
+  const trimmed = value.replace(/\s+/g, ' ').trim()
+  if (!trimmed) return null
+  return trimmed.slice(0, WORKSPACE_PROFILE_MAX_VALUE_LENGTH)
+}
+
+function matchOption(options: readonly string[], value: string): string | null {
+  const lower = value.toLowerCase()
+  return options.find((option) => option.toLowerCase() === lower) ?? null
+}
+
+function cleanList(values: unknown, map: (value: string) => string | null) {
+  if (!Array.isArray(values)) return []
+  const out: string[] = []
+  const seen = new Set<string>()
+  for (const raw of values) {
+    const name = cleanName(raw)
+    const value =
+      name === null || name.toLowerCase() === UNKNOWN ? null : map(name)
+    if (value === null || seen.has(value.toLowerCase())) continue
+    seen.add(value.toLowerCase())
+    out.push(value)
+    if (out.length >= WORKSPACE_PROFILE_MAX_LIST_LENGTH) break
+  }
+  return out
+}
+
+function normalizeField(
+  field: WorkspaceProfileField,
+  raw: unknown,
+): WorkspaceProfileValue {
+  switch (field.kind) {
+    case 'choice': {
+      const name = cleanName(raw)
+      return name === null ? null : matchOption(field.options, name)
+    }
+    case 'choices':
+      return cleanList(raw, (name) =>
+        matchOption(field.options, name) ?? (field.allowOther ? name : null),
+      )
+    case 'names':
+      return cleanList(raw, (name) => name)
+    case 'boolean':
+      if (typeof raw === 'boolean') return raw
+      if (raw === 'yes') return true
+      if (raw === 'no') return false
+      return null
+  }
+}
+
+/**
+ * The profile as the template allows it: every template field present, values
+ * outside a field's options dropped (or matched case-insensitively), lists
+ * deduplicated and capped, keys the template does not name dropped. Never
+ * throws: an answer that is not an object normalizes to all-unknown.
+ *
+ * The client runs this before reporting and the server runs it again on what
+ * arrives, so what is stored never depends on the client having done so.
+ */
+export function normalizeWorkspaceProfile(
+  template: WorkspaceProfileTemplate,
+  raw: unknown,
+): WorkspaceProfile {
+  const answer =
+    raw && typeof raw === 'object' && !Array.isArray(raw)
+      ? (raw as Record<string, unknown>)
+      : {}
+  const profile: WorkspaceProfile = {}
+  for (const section of template.sections) {
+    const rawSection = answer[section.key]
+    const sectionAnswer =
+      rawSection && typeof rawSection === 'object' && !Array.isArray(rawSection)
+        ? (rawSection as Record<string, unknown>)
+        : {}
+    const values: Record<string, WorkspaceProfileValue> = {}
+    for (const field of section.fields) {
+      values[field.key] = normalizeField(field, sectionAnswer[field.key])
+    }
+    profile[section.key] = values
+  }
+  return profile
+}
+
+/** Whether the profile says anything at all, so an all-unknown answer (the
+ *  model gave up) is not stored as if it were a finding. */
+export function workspaceProfileHasFindings(profile: WorkspaceProfile): boolean {
+  return Object.values(profile).some((section) =>
+    Object.values(section).some((value) =>
+      Array.isArray(value) ? value.length > 0 : value !== null,
+    ),
+  )
+}
