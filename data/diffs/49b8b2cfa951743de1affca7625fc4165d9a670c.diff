+      )
+    const hasCnEduDomain = !!s.email && /\.edu\.cn$/i.test(s.email)
+    const nonApprovedRegion =
+      hasCjkName || hasChineseDomain || hasCnEduDomain
+    if (nonApprovedRegion) {
