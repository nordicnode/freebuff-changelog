+      if (hasCjkName) reasons.push('cjk-name')
+      if (hasChineseDomain) reasons.push('cn-provider')
+      if (hasCnEduDomain) reasons.push('cn-edu')
+      flags.push(`non-approved-region[${reasons.join(',')}]`)
