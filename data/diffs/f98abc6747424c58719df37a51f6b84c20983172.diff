+
+const THEME_PRIORITY: ThemeDetector[] = [
+  {
+    description: 'Terminal override (e.g., OPENAI_THEME)',
+    detect: detectTerminalOverrides,
+  },
+  {
+    description: 'IDE configuration (VS Code, JetBrains, Zed)',
