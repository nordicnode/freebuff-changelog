+        const name = key.name ?? ''
+        const isConfirm = name === 'return' || name === 'enter'
+        const isExit = name === 'escape' || name === 'esc'
+        if (!isConfirm && !isExit) return
+        key.preventDefault?.()
+        if (isConfirm) {
+          handleTakeover()
+        } else {
+          exitFreebuffCleanly()
+        }
+      },
+      [handleTakeover],
+    ),
+  )
