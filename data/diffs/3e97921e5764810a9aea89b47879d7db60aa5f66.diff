+  AgentRuntimeDeps & AgentRuntimeScopedDeps,
+  | 'fetchAgentFromDatabase'
+  | 'startAgentRun'
+  | 'finishAgentRun'
+  | 'addAgentStep'
+  | 'consumeCreditsWithFallback'
+  | 'promptAiSdkStream'
+  | 'promptAiSdk'
+  | 'promptAiSdkStructured'
+  | 'handleStepsLogChunk'
+  | 'requestToolCall'
+  | 'requestMcpToolData'
