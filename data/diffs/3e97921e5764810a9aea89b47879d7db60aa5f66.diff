+  // promptAiSdk: PromptAiSdkFn,
+  // promptAiSdkStructured: PromptAiSdkStructuredFn,
+
+  // Mutable State
+  databaseAgentCache: new Map(),
+  liveUserInputRecord: {},
+  sessionConnections: {},
+
+  // Analytics
