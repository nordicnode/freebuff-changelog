+    minute: '2-digit',
+    timeZone: zone,
+  }).format(at)
+  return new Intl.DateTimeFormat(undefined, {
+    hour: 'numeric',
+    ...(Number(minute) === 0 ? {} : { minute: '2-digit' as const }),
+    timeZone: zone,
+  }).format(at)
