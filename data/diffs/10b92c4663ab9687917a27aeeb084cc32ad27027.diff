     .map((prompt) => clip(prompt, RECENT_PROMPT_CHARS))
     .filter(Boolean)
     .slice(0, TURN_REVIEW_RECENT_PROMPTS)
   if (!lines.length) return TURN_REVIEW_PROMPT
