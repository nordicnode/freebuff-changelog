+    ).toMatchObject({ repositories: 1, perfectRate: 1 })
+    expect(
+      rows.reduce(
+        (n, r) => (r.facet === 'framework' ? n + r.repositories : n),
+        0,
+      ),
+    ).toBe(3)
+  })
+})
