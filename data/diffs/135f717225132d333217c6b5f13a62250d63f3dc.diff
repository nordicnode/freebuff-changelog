 export function sponsoredSkillConsentView(
   skill: SponsoredSkill,
 ): SponsoredSkillConsentView {
   return {
     key: sponsoredSkillKey(skill),
     sha256: sponsoredSkillSha256(skill),
     title: skill.consent.title,
