+      dependents.add(parentId)
+      // Recursively find parents of this parent
+      findParents(parentId)
+    }
+  }
+
+  // Start from each selected agent and find all its parents
+  for (const agentId of selectedAgentIds) {
+    findParents(agentId)
+  }
+
+  return dependents
+}
