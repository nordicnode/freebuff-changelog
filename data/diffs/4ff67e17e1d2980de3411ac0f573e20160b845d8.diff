+    project,
+    worktree: resolve(worktree),
+    runtime: resolve(runtime),
+    parent,
+    branch,
+    linkedWorktree: {
+      commonDir: ask('--git-common-dir'),
+      gitDir: ask('--git-dir'),
+      branchNamespace: 'freebuff',
+    },
+  }
+}
