+            <Host />
+          </ChatRuntimeProvider>
+        </QueryClientProvider>,
+      ),
+    )
+    await settle()
+    flushSync(() => {
+      runtime.isChainInProgressRef.current = true
+      runtime.setStreamStatus('streaming')
+      useChatStore
+        .getState()
+        .setInputValue({
