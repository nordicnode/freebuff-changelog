 const mergeStreamingSegments = (segments: ReactNode[]): ReactNode => {
   if (segments.length === 0) {
     return ''
   }
   if (segments.length === 1) {
     return segments[0]
   }
 
   return (
     <>
       {segments.map((segment, idx) => (
         <KeyedFragment key={`stream-segment-${idx}`}>
           {segment}
         </KeyedFragment>
       ))}
     </>
   )
 }
 
