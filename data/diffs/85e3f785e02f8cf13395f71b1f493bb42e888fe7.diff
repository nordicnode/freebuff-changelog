@@ -0,0 +1,16 @@
+/** Native inventory has its own attribution; never alias it to a web or iOS slot. */
+export const ANDROID_AD_SURFACE = 'android' as const
+export const ANDROID_AD_PLACEMENTS = [
+  {
+    id: 'Android-Chat-After-Assistant-Message',
+    label: 'Chat · after an answer',
+  },
+  {
+    id: 'Android-Coding-After-Assistant-Message',
+    label: 'Coding · after an answer',
+  },
+] as const
+
+export function isAndroidAdPlacement(id: string | null | undefined): boolean {
+  return ANDROID_AD_PLACEMENTS.some((slot) => slot.id === id)
+}
diff --git a/common/src/ads/mobile-placements.ts b/common/src/ads/mobile-placements.ts
new file mode 100644
index 000000000..c8852ce96
--- /dev/null
+++ b/common/src/ads/mobile-placements.ts
@@ -0,0 +1,17 @@
+import { isAndroidAdPlacement } from './android-placements'
+import { isIOSAdPlacement } from './ios-placements'
+
+export type MobileAdSurface = 'ios' | 'android'
+
+/** The native app that owns a placement, or null for every web/desktop slot. */
+export function mobileAdPlacementSurface(
+  id: string | null | undefined,
+): MobileAdSurface | null {
+  if (isIOSAdPlacement(id)) return 'ios'
+  if (isAndroidAdPlacement(id)) return 'android'
+  return null
+}
+
+export function isMobileAdPlacement(id: string | null | undefined): boolean {
+  return mobileAdPlacementSurface(id) !== null
+}
