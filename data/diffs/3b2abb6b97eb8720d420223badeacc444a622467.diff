+ */
+const REDUNDANT_OPTION_PATTERNS = [
+  /^custom$/i,
+  /^other$/i,
+  /^none\s*(of\s*the\s*above)?$/i,
+  /^something\s*else$/i,
+  /^enter\s*(my\s*)?own$/i,
