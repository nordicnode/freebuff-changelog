 function packageManager(
   pkg: PackageJson,
   files: ReadonlySet<string>,
 ): SponsoredCapability['packageManager'] {
   const declared =
     typeof pkg.packageManager === 'string'
       ? pkg.packageManager.split('@', 1)[0]
       : ''
   if (
     declared === 'bun' ||
