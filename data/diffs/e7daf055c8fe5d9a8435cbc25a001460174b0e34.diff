+        { deviceAuthId: 'd', userCode: 'u', expiresAt: Date.now() - 1 },
+        fetchImpl,
+      ),
+    ).rejects.toBeInstanceOf(ChatGptAuthError)
+    expect(calls).toHaveLength(0)
+  })
