         pid: child.pid,
         ...(os.platform() === 'win32' ? {} : { processGroupId: child.pid }),
       },
     ]
   })
 }
 
 function installExitSweep() {
   if (exitSweepInstalled) return
   exitSweepInstalled = true
   process.on('exit', () => {
     for (const child of liveChildren) {
       try {
         child.kill('SIGKILL')
       } catch {}
     }
   })
 }
 
