     weekday: 'short',
     hour: 'numeric',
     minute: '2-digit',
     timeZone: zone,
   })
   return `${fmt.format(friday)}–${fmt.format(sunday)} ${formatWindowTimeZoneLabel(sunday, zone)}`
 }
