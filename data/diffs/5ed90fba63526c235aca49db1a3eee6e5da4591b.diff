-  public readonly status = 402
-
-  constructor(message: string) {
-    super(message)
-    this.name = 'PaymentRequiredError'
-
-    if (Error.captureStackTrace) {
-      Error.captureStackTrace(this, PaymentRequiredError)
-    }
-  }
-}
-
-/**
