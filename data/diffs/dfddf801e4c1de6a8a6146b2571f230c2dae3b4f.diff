diff --git a/common/src/constants/desktop-funnel.ts b/common/src/constants/desktop-funnel.ts
new file mode 100644
index 000000000..a182827a8
--- /dev/null
+++ b/common/src/constants/desktop-funnel.ts
@@ -0,0 +1,77 @@
+import { z } from 'zod'
+
+export const DESKTOP_FUNNEL_EVENT = 'desktop.funnel_step'
+
+export const desktopFunnelStepSchema = z.enum([
+  'welcome', 'login', 'browser', 'provider', 'connect', 'survey', 'question',
+  'folder', 'composer', 'draft', 'model_picker', 'model_selection', 'send',
+  'turn', 'response',
+])
+export const desktopFunnelStateSchema = z.enum([
+  'shown', 'clicked', 'started', 'opened', 'selected', 'applied', 'succeeded',
+  'failed', 'skipped', 'back', 'cancelled', 'closed', 'received', 'visible',
+])
+
+const entityId = z.string().min(1).max(128).regex(/^[a-zA-Z0-9_-]+$/)
+const modelId = z.string().min(1).max(120).regex(/^[a-zA-Z0-9_./:@-]+$/)
+const harness = z.enum(['codebuff', 'claude-code', 'codex'])
+
+// Deliberately closed: no text, local paths, URLs, auth codes or arbitrary property bags.
+// Entity IDs are local transport only; Desktop hashes them before external capture.
+export const desktopFunnelPropertiesSchema = z.object({
+  event_id: z.string().uuid().optional(),
+  flow_id: z.string().uuid().optional(),
+  attempt_id: z.string().uuid().optional(),
+  thread_id: entityId.optional(),
+  input_id: entityId.optional(),
+  turn_id: entityId.optional(),
+  project_id: entityId.optional(),
+  login_surface: z.enum(['splash', 'gate', 'notice', 'feedback', 'unknown']).optional(),
+  login_phase: z.enum(['idle', 'starting', 'waiting', 'failed', 'connected']).optional(),
+  provider: z.enum(['github', 'google', 'apple', 'current_account', 'switch_account']).optional(),
+  question_id: z.enum(['referral_source', 'role', 'proficiency', 'intended_use', 'subscriptions']).optional(),
+  question_index: z.number().int().min(0).max(50).optional(),
+  question_count: z.number().int().min(0).max(50).optional(),
+  answered_count: z.number().int().min(0).max(50).optional(),
+  selection_count: z.number().int().min(0).max(100).optional(),
+  has_other_text: z.boolean().optional(),
+  project_kind: z.enum(['folder', 'no_folder', 'cloud', 'empty_local', 'cloud_repo', 'cloud_empty']).optional(),
+  harness: harness.optional(),
+  previous_harness: harness.optional(),
+  model: modelId.optional(),
+  previous_model: modelId.optional(),
+  selection_kind: z.enum(['default', 'unchanged', 'changed', 'reselected', 'blocked', 'unknown']).optional(),
+  reason: z.enum([
+    'dismiss', 'escape', 'outside', 'selection', 'navigation', 'error', 'blocked',
+    'paywall', 'setup', 'unavailable', 'already_selected', 'empty', 'http',
+    'save_failed', 'timeout', 'completed', 'skipped', 'partial', 'unknown',
+    'reopen', 'retry', 'cancel', 'unsupported', 'expired', 'invalid',
+    'already_connected', 'phone_required', 'closed', 'confirmation',
+    'running', 'compacting', 'moving', 'too_long',
+  ]).optional(),
+  duration_ms: z.number().int().min(0).max(7 * 24 * 60 * 60 * 1000).optional(),
+  initiator: z.enum(['user', 'suggestion', 'skill', 'mission', 'coordinator', 'thread_update', 'sponsored', 'api', 'unknown']).optional(),
+  queued: z.boolean().optional(),
+  restored: z.boolean().optional(),
+  has_attachments: z.boolean().optional(),
+  has_output: z.boolean().optional(),
+  output_kind: z.enum(['text', 'tool']).optional(),
+  execution_target: z.enum(['local', 'cloud']).optional(),
+}).strict()
+
+export const desktopFunnelEventSchema = desktopFunnelPropertiesSchema.extend({
+  step: desktopFunnelStepSchema,
+  state: desktopFunnelStateSchema,
+})
+
+export type DesktopFunnelStep = z.infer<typeof desktopFunnelStepSchema>
+export type DesktopFunnelState = z.infer<typeof desktopFunnelStateSchema>
+export type DesktopFunnelProperties = z.infer<typeof desktopFunnelPropertiesSchema>
+export type DesktopFunnelEvent = z.infer<typeof desktopFunnelEventSchema>
+
+export const DESKTOP_FUNNEL_LABELS = {
+  welcome: 'Welcome', login: 'Login', browser: 'Browser', provider: 'Provider',
+  connect: 'Connect', survey: 'Survey', question: 'Question', folder: 'Folder',
+  composer: 'Compose', draft: 'Type', model_picker: 'Models',
+  model_selection: 'Select', send: 'Send', turn: 'Complete', response: 'Reply',
+} satisfies Record<DesktopFunnelStep, string>
diff --git a/common/src/util/analytics-sampling.ts b/common/src/util/analytics-sampling.ts
index 862341596..c7f9fdbe5 100644
--- a/common/src/util/analytics-sampling.ts
+++ b/common/src/util/analytics-sampling.ts
@@ -18,50 +18,51 @@ const ALWAYS_TRACK_EVENTS = new Set<AnalyticsEvent>([
   AnalyticsEvent.APP_LAUNCHED,
   AnalyticsEvent.CHANGE_DIRECTORY,
   AnalyticsEvent.FINGERPRINT_GENERATED,
   AnalyticsEvent.INVALID_COMMAND,
   AnalyticsEvent.KNOWLEDGE_FILE_UPDATED,
   AnalyticsEvent.LOGIN,
   AnalyticsEvent.LOGIN_STARTED,
   AnalyticsEvent.LOGIN_FAILED,
   AnalyticsEvent.LOGIN_TIMEOUT,
   AnalyticsEvent.LOGIN_ABORTED,
   // Desktop surface events are low-volume; keep them whole so the app's launch /
   // login / activity funnels aren't decimated by the 1% default sample.
   AnalyticsEvent.DESKTOP_APP_LAUNCHED,
   // Both halves of the sign-in funnel, or its conversion rate is a ratio of two
   // differently-sampled numbers.
   AnalyticsEvent.DESKTOP_LOGIN_STARTED,
   AnalyticsEvent.DESKTOP_LOGIN,
   // Rare, and the only evidence a sign-in failed at all — a sampled one is a
   // support ticket with nothing behind it.
   AnalyticsEvent.DESKTOP_LOGIN_FAILED,
   AnalyticsEvent.DESKTOP_LOGOUT,
   AnalyticsEvent.DESKTOP_THREAD_CREATED,
   AnalyticsEvent.DESKTOP_PROJECT_OPENED,
   AnalyticsEvent.DESKTOP_PROJECT_CREATED,
   AnalyticsEvent.DESKTOP_TURN_COMPLETED,
+  AnalyticsEvent.DESKTOP_FUNNEL_STEP,
   // Low-volume recovery funnel. Sampling any stage independently would make
   // creation-to-success and repeated-failure rates impossible to measure.
   AnalyticsEvent.DESKTOP_FAILED_TURN_RECOVERY,
   // Rare reliability signal — every stalled turn must be counted, never sampled.
   AnalyticsEvent.DESKTOP_TURN_STALLED,
   // Its counterpart (an explained silence). Same reasoning: rare, and only
   // useful if every one is counted.
   AnalyticsEvent.DESKTOP_TURN_BACKGROUND_WAIT,
   // Feature adoption is measured as UNIQUE USERS per feature. At desktop's
   // scale a 1% sample would leave a feature used by 2% of users with
   // roughly zero sampled users — the number is unrecoverable from a sample, so
   // this one is never sampled. Volume is controlled at the emit site instead
   // (intent-only actions + per-session dedupe), not by throwing away users.
   AnalyticsEvent.DESKTOP_FEATURE_USED,
   // Ratios use summed disjoint durations, so numerator and denominator stay whole.
   AnalyticsEvent.DESKTOP_AD_DENSITY,
   AnalyticsEvent.DESKTOP_HARNESS_CHANGED,
   AnalyticsEvent.DESKTOP_MODEL_CHANGED,
   AnalyticsEvent.DESKTOP_SKILL_RUN,
   AnalyticsEvent.DESKTOP_CODEX_RESOLUTION,
   // Rare operational signal. Sampling would make per-version failure rates
   // misleading precisely when a Windows-only regression affects few installs.
   AnalyticsEvent.TERMINAL_BROKER_SPAWN_FAILED,
   AnalyticsEvent.TERMINAL_WATCHDOG_FAILED,
   AnalyticsEvent.TERMINAL_COMMAND_COMPLETED,
