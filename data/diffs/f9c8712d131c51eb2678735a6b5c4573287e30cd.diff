 PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
 LOG_DIR="$PROJECT_ROOT/debug/console"
 BUN="$PROJECT_ROOT/.bin/bun"
+APP_URL="$NEXT_PUBLIC_CODEBUFF_APP_URL"
 
 export PATH="$PROJECT_ROOT/.bin:$PATH"
 mkdir -p "$LOG_DIR"
