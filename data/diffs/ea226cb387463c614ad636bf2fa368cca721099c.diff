+  if (
+    low > 0 &&
+    low < text.length &&
+    text.charCodeAt(low - 1) >= 0xd800 &&
+    text.charCodeAt(low - 1) <= 0xdbff
+  ) {
+    low--
+  }
+  return text.slice(0, low)
