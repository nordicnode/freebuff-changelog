diff --git a/common/src/util/__tests__/freebuff-session-charge.test.ts b/common/src/util/__tests__/freebuff-session-charge.test.ts
new file mode 100644
index 000000000..4b1c0a952
--- /dev/null
+++ b/common/src/util/__tests__/freebuff-session-charge.test.ts
@@ -0,0 +1,76 @@
+import { describe, expect, test } from 'bun:test'
+
+import {
+  freebuffChargeChargedText,
+  freebuffChargeReturnText,
+  freebuffChargeSourceText,
+} from '../freebuff-session-charge'
+
+const NOW = new Date('2026-10-16T18:00:00.000Z')
+
+describe('freebuffChargeChargedText', () => {
+  test('a price is whole hours', () => {
+    expect(freebuffChargeChargedText({ charged: 15 })).toBe('3 hrs')
+    expect(freebuffChargeChargedText({ charged: 5 })).toBe('1 hr')
+  })
+})
+
+describe('freebuffChargeReturnText', () => {
+  test('nothing back once the hour is over', () => {
+    expect(freebuffChargeReturnText({ returned: 0 }, NOW)).toBe('None back')
+  })
+
+  test('null while the hour can still return something', () => {
+    expect(
+      freebuffChargeReturnText(
+        { returned: 0, settlesAt: '2026-10-16T18:30:00.000Z' },
+        NOW,
+      ),
+    ).toBeNull()
+  })
+
+  test('a settles time already past reads as settled', () => {
+    expect(
+      freebuffChargeReturnText(
+        { returned: 0, settlesAt: '2026-10-16T17:30:00.000Z' },
+        NOW,
+      ),
+    ).toBe('None back')
+  })
+
+  test('whole hours back', () => {
+    expect(freebuffChargeReturnText({ returned: 10 }, NOW)).toBe('2 hrs back')
+    expect(freebuffChargeReturnText({ returned: 5 }, NOW)).toBe('1 hr back')
+  })
+
+  test('a return smaller than an hour never reads as zero', () => {
+    // Legacy rows (before whole-hour refunds) and partial wallet shares.
+    expect(freebuffChargeReturnText({ returned: 4 }, NOW)).toBe(
+      'Under 1 hr back',
+    )
+    expect(freebuffChargeReturnText({ returned: 1 }, NOW)).toBe(
+      'Under 1 hr back',
+    )
+  })
+
+  test('a non-whole return keeps its whole hours and drops the rest', () => {
+    expect(freebuffChargeReturnText({ returned: 14 }, NOW)).toBe('2 hrs back')
+  })
+})
+
+describe('freebuffChargeSourceText', () => {
+  test('silent when the day paid for it', () => {
+    expect(
+      freebuffChargeSourceText({ charged: 15, chargedFromWallet: 0 }),
+    ).toBeNull()
+  })
+
+  test('names the wallet when the wallet paid', () => {
+    expect(
+      freebuffChargeSourceText({ charged: 15, chargedFromWallet: 15 }),
+    ).toBe('From your wallet')
+    expect(
+      freebuffChargeSourceText({ charged: 15, chargedFromWallet: 5 }),
+    ).toBe('Part from your wallet')
+  })
+})
diff --git a/common/src/util/freebuff-session-charge.ts b/common/src/util/freebuff-session-charge.ts
new file mode 100644
index 000000000..4782557e0
--- /dev/null
+++ b/common/src/util/freebuff-session-charge.ts
@@ -0,0 +1,48 @@
+import { formatHours, formatHoursShort } from './freebuff-hours'
+
+import type { FreebuffSessionLedgerEntry } from '../types/freebuff-usage'
+
+/**
+ * The two lines a per-session charge reads as, so the hub, the CLI and Desktop
+ * all describe one session's cost identically.
+ *
+ * Hours only, and never a fraction of one (`formatHours`, product 2026-10-15):
+ * a return smaller than an hour would otherwise read as "0 hours" for balance
+ * that really did come back, which is the opposite of what this list is for.
+ * It says "Under 1 hr back" instead.
+ */
+
+/** Where the session's charge was drawn from, for the row's own line. */
+export function freebuffChargeSourceText(
+  entry: Pick<FreebuffSessionLedgerEntry, 'charged' | 'chargedFromWallet'>,
+): string | null {
+  if (entry.chargedFromWallet <= 0) return null
+  return entry.chargedFromWallet >= entry.charged
+    ? 'From your wallet'
+    : 'Part from your wallet'
+}
+
+/**
+ * What came back from the hour, as text. `null` while the hour can still
+ * return something — the caller says when it settles, in the reader's own
+ * clock, which is the question behind every "my refund was 0" report.
+ */
+export function freebuffChargeReturnText(
+  entry: Pick<FreebuffSessionLedgerEntry, 'returned' | 'settlesAt'>,
+  now: Date = new Date(),
+): string | null {
+  if (entry.settlesAt && new Date(entry.settlesAt).getTime() > now.getTime())
+    return null
+  if (entry.returned <= 0) return 'None back'
+  // Positive but under an hour: the hour it belongs to is whole, so saying
+  // "0 hrs" would deny a return that happened.
+  if (formatHours(entry.returned) === '0') return 'Under 1 hr back'
+  return `${formatHoursShort(entry.returned)} back`
+}
+
+/** What the session took when it started: always a whole number of hours. */
+export function freebuffChargeChargedText(
+  entry: Pick<FreebuffSessionLedgerEntry, 'charged'>,
+): string {
+  return formatHoursShort(entry.charged)
+}
