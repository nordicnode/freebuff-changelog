   activeDates: readonly string[]
   todayDateKey: string
   windowDays: number
   /** 0 = Sunday. The weekday `todayDateKey` falls on, resolved by the caller
    *  in the streak time zone rather than from the viewer's clock. */
   todayWeekday: number
 }): FreebuffUsageCell[] {
