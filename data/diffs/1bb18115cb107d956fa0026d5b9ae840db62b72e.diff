+// Pattern matches (grouped by match type)
+const SENSITIVE_PATTERNS = {
+  prefix: ['id_rsa', 'id_ed25519', 'id_dsa', 'id_ecdsa'], // SSH private keys
+  suffix: ['_credentials'],
