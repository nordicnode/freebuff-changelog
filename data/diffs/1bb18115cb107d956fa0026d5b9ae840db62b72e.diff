+  const basenameLower = basename.toLowerCase()
+  const ext = path.extname(filePath).toLowerCase()
+
+  return (
+    isEnvFile(basename) ||
+    SENSITIVE_EXTENSIONS.has(ext) ||
+    SENSITIVE_BASENAMES.has(basename) ||
+    matchesPattern(basenameLower)
+  )
+}
