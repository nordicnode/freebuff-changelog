+      '[response interrupted]',
+    )
+  })
+
+  test('leaves completed AI responses untouched', () => {
+    const message = streamedShell({ isComplete: true })
+    const [result] = sanitizeRestoredMessages([message])
+
+    expect(result).toBe(message)
+  })
