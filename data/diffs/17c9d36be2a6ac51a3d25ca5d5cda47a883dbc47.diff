+  return {
+    verdict: review?.verdict ?? undefined,
+    action_count: review?.actions.length ?? 0,
+    offers_code_review: offers('review'),
+    offers_brainstorm: offers('brainstorm'),
+    offers_challenge: offers('challenge'),
+  }
+}
