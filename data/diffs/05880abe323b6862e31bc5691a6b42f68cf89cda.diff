+    })
+
+    test('should create client with custom base URL', () => {
+      const client = createCodebuffApiClient({ baseUrl: 'https://custom.api' })
+      expect(client.baseUrl).toBe('https://custom.api')
+    })
+
+    test('should store auth token', () => {
