+
+  test('kitty speaks its own image protocol', () => {
+    expect(facts({ TERM: 'xterm-kitty', KITTY_WINDOW_ID: '1' })).toMatchObject({
+      terminal: 'kitty',
+      images: 'kitty',
+      colors: 'truecolor',
+    })
