+      // moves the card without any event the card itself receives
+      first = setTimeout(measure, 0)
+      interval = setInterval(measure, TRANSCRIPT_VISIBILITY_POLL_MS)
+      ;(interval as { unref?: () => void }).unref?.()
+    }
