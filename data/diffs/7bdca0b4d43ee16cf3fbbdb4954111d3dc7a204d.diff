+
+  test('WSL from its env vars or the kernel release', () => {
+    expect(
+      facts({ WSL_DISTRO_NAME: 'Ubuntu', WT_SESSION: 'x' }, linuxHost),
+    ).toMatchObject({
+      remote: 'wsl',
+      terminal: 'windows_terminal',
+    })
+    expect(
+      facts({}, { ...linuxHost, release: '5.15.153.1-microsoft-standard-WSL2' })
