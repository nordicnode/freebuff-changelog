{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freebuff-changelog",
  "main": "worker.js",
  "compatibility_date": "2024-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "HOWTO_Q",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
