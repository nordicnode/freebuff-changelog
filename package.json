{
  "name": "freebuff-changelog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unofficial Freebuff changelog. Generates accurate changelog entries from CodebuffAI/freebuff snapshot-sync diffs and ships a zero-dependency static site for Cloudflare Pages.",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "generate": "node generator/cli.mjs generate",
    "catch-up": "node generator/cli.mjs catch-up",
    "catch-up:push": "node generator/cli.mjs catch-up --push",
    "backfill": "node generator/cli.mjs backfill --push",
    "watch": "node generator/cli.mjs watch --push",
    "build": "node generator/cli.mjs build",
    "preview": "node generator/cli.mjs preview",
    "test": "node --test generator/test/",
    "check": "node generator/cli.mjs build && node --test generator/test/"
  },
  "license": "MIT"
}
